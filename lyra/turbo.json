{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "src/**",
        "static/**",
        "vite.config.ts",
        "tsconfig*.json",
        "package.json"
      ]
    },
    "lint": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/{lyra,pluto,console,site/*}/src/**",
        "$TURBO_ROOT$/{lyra,pluto,console,site/*}/index.html"
      ]
    }
  }
}
