load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "tz",
    srcs = ["tz.cpp"],
    hdrs = ["tz.h"],
    # Written by x/go/tz/gen.go from the same data the Go library embeds.
    textual_hdrs = ["zoneinfo.inc"],
    visibility = ["//visibility:public"],
    deps = [
        "//x/cpp/date",
        "//x/cpp/errors",
    ],
)

cc_test(
    name = "tz_test",
    srcs = ["tz_test.cpp"],
    data = [
        "//x/go/tz:testdata/rules.tsv",
        "//x/go/tz:testdata/vectors.tsv",
    ],
    deps = [
        ":tz",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)
