load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "loop",
    srcs = select({
        "@platforms//os:windows": [
            "sleep_windows.cpp",
            "waitable_timer.cpp",
        ],
        "//conditions:default": ["sleep_posix.cpp"],
    }),
    hdrs = ["loop.h"] + select({
        "@platforms//os:windows": ["waitable_timer.h"],
        "//conditions:default": [],
    }),
    copts = select({
        "@platforms//os:windows": [
            "/D_WIN32_WINNT=0x0601",
            "/DWIN32_LEAN_AND_MEAN",
            "/DNOMINMAX",
        ],
        "//conditions:default": [],
    }),
    linkopts = select({
        "@platforms//os:windows": ["winmm.lib"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//x/cpp/breaker",
        "//x/cpp/errors",
        "//x/cpp/telem",
        "@abseil-cpp//absl/log",
    ],
)

cc_test(
    name = "loop_test",
    size = "small",
    srcs = [
        "loop_test.cpp",
    ],
    tags = ["no-asan"],  # Timing-sensitive tests that fail under ASan overhead
    deps = [
        "//x/cpp/loop",
        "@googletest//:gtest_main",
    ],
)
