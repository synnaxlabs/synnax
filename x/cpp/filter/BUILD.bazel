load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "filter",
    srcs = ["describe.cpp"],
    hdrs = [
        "builder.h",
        "describe.h",
        "json.gen.h",
        "proto.gen.h",
        "types.gen.h",
