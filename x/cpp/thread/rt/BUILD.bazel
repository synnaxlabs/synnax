load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "rt",
    srcs = ["manager.cpp"] + select({
        "@platforms//os:linux": [
            "discover_linux.cpp",
            "rt_linux.cpp",
        ],
        "@platforms//os:macos": [
            "discover_default.cpp",
            "rt_darwin.cpp",
        ],
        "@platforms//os:windows": [
            "discover_default.cpp",
            "rt_windows.cpp",
        ],
        "//conditions:default": [
            "discover_default.cpp",
            "rt_default.cpp",
        ],
    }),
    hdrs = [
        "rt.h",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//x/cpp/errors",
        "//x/cpp/log",
        "//x/cpp/telem",
        "@glog",
    ],
)

cc_test(
    name = "rt_test",
    srcs = [
        "rt_test.cpp",
    ],
    deps = [
        "//x/cpp/telem",
        "//x/cpp/test",
        "//x/cpp/thread/rt",
        "@googletest//:gtest_main",
    ],
)
