load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "testutil",
    hdrs = ["testutil.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//x/cpp/errors",
        "//x/cpp/telem",
        "@googletest//:gtest",
    ],
)

cc_test(
    name = "testutil_test",
    srcs = ["testutil_test.cpp"],
    tags = ["no-asan"],  # Tests ASSERT_EVENTUALLY_* macros with timeouts - timing-sensitive
    deps = [
        "//x/cpp/errors",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)
