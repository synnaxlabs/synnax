load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "x509",
    srcs = ["x509.cpp"],
    hdrs = ["x509.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//x/cpp/date",
        "//x/cpp/defer",
        "//x/cpp/errors",
        "//x/cpp/telem",
        "@mbedtls",
    ],
)

cc_test(
    name = "x509_test",
    size = "small",
    srcs = ["x509_test.cpp"],
    deps = [
        ":x509",
        "//x/cpp/telem",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)
