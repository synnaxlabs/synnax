load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "uuid",
    srcs = ["uuid.cpp"],
    hdrs = ["uuid.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//x/cpp/errors",
        "//x/cpp/json",
        "@boost.uuid",
    ],
)

cc_test(
    name = "uuid_test",
    size = "small",
    srcs = ["uuid_test.cpp"],
    deps = [
        ":uuid",
        "//x/cpp/test",
        "@googletest//:gtest_main",
    ],
)
