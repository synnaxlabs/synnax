{
  "name": "@synnaxlabs/media",
  "version": "0.56.0",
  "type": "module",
  "description": "Media Assets for Synnax Labs",
  "repository": "https://github.com/synnaxlabs/synnax/tree/main/x/media",
  "keywords": [
    "synnax",
    "media",
    "data acquisition",
    "big data",
    "telemetry",
    "control systems"
  ],
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint",
    "fix": "eslint --fix",
    "madge": "madge --circular src",
    "stylelint": "stylelint \"src/**/*.css\""
  },
  "dependencies": {
    "clsx": "catalog:",
    "react": "catalog:",
    "react-icons": "catalog:"
  },
  "devDependencies": {
    "@synnaxlabs/eslint-config": "workspace:^",
    "@synnaxlabs/madge": "workspace:^",
    "@synnaxlabs/stylelint-config": "workspace:^",
    "@synnaxlabs/tsconfig": "workspace:^",
    "@synnaxlabs/vite-plugin": "workspace:^",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/media.js"
    },
    "./dist/*": "./dist/*"
  }
}
