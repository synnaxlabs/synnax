package aliasimport

import (
	tu "github.com/synnaxlabs/x/testutil"
)

func Expect(any) Assertion { return Assertion{} }
func HaveOccurred() any    { return nil }

type Assertion struct{}

func (a Assertion) ToNot(any) {}

func returnsValErr() (int, error)            { return 0, nil }
func returnsTwoValErr() (int, string, error) { return 0, "", nil }

// The testutil import has an alias, so the fixes must qualify with the alias.
func example() {
	result := tu.MustSucceed(returnsValErr())
	_ = result
	_ = tu.MustSucceed[int]
}

func example2() {
	a, b := tu.MustSucceed2(returnsTwoValErr())
	_, _ = a, b
}
