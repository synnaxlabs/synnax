{
  "name": "@synnaxlabs/x",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "./dist/zod/parse.js"
  ],
  "description": "Common Utilities for Synnax Labs",
  "repository": "https://github.com/synnaxlabs/synnax/tree/main/x/ts",
  "keywords": [
    "synnax",
    "utilities",
    "data acquisition",
    "big data",
    "telemetry",
    "control systems"
  ],
  "scripts": {
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "test": "vitest",
    "cov": "vitest --coverage",
    "lint": "eslint",
    "fix": "eslint --fix"
  },
  "dependencies": {
    "async-mutex": "catalog:",
    "fflate": "catalog:",
    "nanoid": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "undici": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "undici": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@synnaxlabs/eslint-config": "catalog:",
    "@synnaxlabs/tsconfig": "catalog:",
    "@synnaxlabs/vite-plugin": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "undici": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "src",
    "!**/*.spec.*",
    "!**/*.bench.*",
    "!dist/eslint.config.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bench": {
      "types": "./dist/bench/index.d.ts",
      "default": "./dist/bench/index.js"
    },
    "./testutil": {
      "types": "./dist/testutil/index.d.ts",
      "default": "./dist/testutil/index.js"
    },
    "./testutil/keepAlive": {
      "types": "./dist/testutil/keepAlive.d.ts",
      "default": "./dist/testutil/keepAlive.js"
    },
    "./dist/*": "./dist/*"
  }
}
