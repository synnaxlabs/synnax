{
  "name": "@synnaxlabs/x",
  "version": "0.56.2",
  "type": "module",
  "description": "Common Utilities for Synnax Labs",
  "repository": "https://github.com/synnaxlabs/synnax/tree/main/x/ts",
  "keywords": [
    "synnax",
    "utilities",
    "data acquisition",
    "big data",
    "telemetry",
    "control systems"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check-types": "tsc --noEmit",
    "test": "vitest",
    "cov": "vitest --coverage",
    "lint": "eslint",
    "fix": "eslint --fix",
    "madge": "madge --circular src"
  },
  "dependencies": {
    "async-mutex": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@synnaxlabs/eslint-config": "workspace:^",
    "@synnaxlabs/madge": "workspace:^",
    "@synnaxlabs/tsconfig": "workspace:^",
    "@synnaxlabs/vite-plugin": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "fflate": "^0.8.2",
    "nanoid": "^6.0.1",
    "typescript": "catalog:",
    "uuid": "^14.0.1",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "src",
    "!**/*.spec.*",
    "!**/*.bench.*",
    "!**/mock/**",
    "!dist/eslint.config.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/x.js"
    },
    "./bench": {
      "types": "./dist/src/bench/index.d.ts",
      "default": "./dist/bench.js"
    },
    "./dist/*": "./dist/*"
  }
}
