{
  "name": "@synnaxlabs/pluto",
  "version": "0.55.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check-types": "tsc --noEmit",
    "watch": "vite build --watch",
    "test": "vitest",
    "cov": "vitest --coverage",
    "bench": "vitest bench",
    "dev": "vite",
    "lint": "eslint",
    "fix": "eslint --fix",
    "preview": "vite preview",
    "madge": "madge --circular src",
    "stylelint": "stylelint \"src/**/*.css\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/geist-mono": "catalog:",
    "@fontsource/inter": "catalog:",
    "@synnaxlabs/alamos": "workspace:^",
    "@synnaxlabs/lyra": "workspace:^",
    "@synnaxlabs/client": "workspace:^",
    "@synnaxlabs/freighter": "workspace:*",
    "@synnaxlabs/media": "workspace:*",
    "@synnaxlabs/x": "workspace:^",
    "@xyflow/react": "^12.10.2",
    "async-mutex": "catalog:",
    "clsx": "catalog:",
    "compromise": "catalog:",
    "compromise-dates": "catalog:",
    "d3-scale": "^4.0.2",
    "mathjs": "^15.2.0",
    "react": "catalog:",
    "react-color": "^2.19.3",
    "react-icons": "catalog:",
    "use-sync-external-store": "^1.6.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@juggle/resize-observer": "^3.4.0",
    "@synnaxlabs/eslint-config": "workspace:^",
    "@synnaxlabs/stylelint-config": "workspace:^",
    "@synnaxlabs/tsconfig": "workspace:^",
    "@synnaxlabs/vite-plugin": "workspace:^",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "catalog:",
    "@types/offscreencanvas": "catalog:",
    "@types/react": "catalog:",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "catalog:",
    "@types/use-sync-external-store": "^0.0.6",
    "@types/webgl2": "^0.0.12",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "madge": "catalog:",
    "react-dom": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/pluto.cjs",
  "module": "./dist/pluto.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/pluto.js",
      "require": "./dist/pluto.cjs"
    },
    "./ether": {
      "types": "./dist/src/ether.d.ts",
      "import": "./dist/ether.js",
      "require": "./dist/ether.cjs"
    },
    "./color": {
      "types": "./dist/src/color/index.d.ts",
      "import": "./dist/color.js",
      "require": "./dist/color.cjs"
    },
    "./dist/*": "./dist/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synnaxlabs/synnax.git",
    "directory": "pluto"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/synnaxlabs/synnax/issues"
  },
  "homepage": "https://github.com/synnaxlabs/synnax#readme"
}
