import Portal from "@/portal/layouts/Portal.astro";
import { failure, load } from "@/portal/page";
import { supportFor } from "@/portal/support";
import { Page } from "@/portal/ui/Page";
import { Support } from "@/portal/ui/support/Support";
import { list, type Listed } from "@/server/support/thread";

const loaded = await load(Astro);
if (loaded instanceof Response) return loaded;
const { portal, session } = loaded;

let error: string | undefined;
let view: Awaited<ReturnType<typeof supportFor>> | undefined;
let threads: Listed[] = [];
try {
    view = await supportFor(portal, session, Astro.url.searchParams.get("org"));
    threads = await list(portal.store, portal.tracker, view.organization.key);
} catch (err) {
    const f = failure(err);
    Astro.response.status = f.status;
    error = f.message;
}
---

<Portal
    title="Support"
    session={session}
    organizations={view?.organizations ?? []}
    organization={view?.organization}
>
    {
        view == null ? (
            <Page client:load title="Support" error={error} />
        ) : (
            <Support
                client:load
                organization={view.organization}
                threads={threads}
                staff={session.staff}
            />
        )
    }
</Portal>
