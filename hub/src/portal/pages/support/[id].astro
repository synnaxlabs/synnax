import Portal from "@/portal/layouts/Portal.astro";
import { failure, load } from "@/portal/page";
import { threadFor } from "@/portal/support";

const loaded = await load(Astro);
if (loaded instanceof Response) return loaded;
const { portal, session } = loaded;

let error = Astro.url.searchParams.get("error") ?? undefined;
let view: Awaited<ReturnType<typeof threadFor>> | undefined;
try {
    view = await threadFor(portal, session, Astro.params.id ?? "");
} catch (err) {
    const f = failure(err);
    Astro.response.status = f.status;
    error = f.message;
}
const thread = view?.thread;
const when = (d: Date): string => d.toISOString().slice(0, 16).replace("T", " ");
---

<Portal title={thread?.title ?? "Thread"} session={session} error={error}>
    {
        view != null && thread != null && (
            <>
                <p class="portal-muted">
                    <a href={`/support?org=${view.organization.key}`}>
                        {view.organization.name}
                    </a>
                    {" · "}
                    {thread.ref}
                    {" · "}
                    <span
                        class:list={["portal-badge", `portal-badge--${thread.status}`]}
                    >
                        {thread.status === "done" ? "done" : "open"}
                    </span>
                </p>
                <section class="portal-section portal-thread">
                    {thread.messages.length === 0 ? (
                        <p class="portal-muted">No messages yet.</p>
                    ) : (
                        thread.messages.map((m) => (
                            <article
                                class:list={[
                                    "portal-message",
                                    `portal-message--${m.from}`,
                                ]}
                            >
                                <header>
                                    <strong>
                                        {m.author ??
                                            (m.from === "customer" ? "You" : "Synnax")}
                                    </strong>
                                    <time datetime={m.at.toISOString()}>
                                        {when(m.at)}
                                    </time>
                                </header>
                                <p class="portal-prose">{m.text}</p>
                            </article>
                        ))
                    )}
                </section>
                {view.customerID != null && (
                    <form
                        method="post"
                        action={`/api/portal/support/threads/${thread.id}/reply`}
                        class="portal-form"
                    >
                        <label>
                            <span>Reply</span>
                            <textarea name="message" required class="portal-prose" />
                        </label>
                        <div class="portal-actions">
                            <button
                                type="submit"
                                class="portal-button portal-button--primary"
                            >
                                Send
                            </button>
                        </div>
                    </form>
                )}
            </>
        )
    }
</Portal>
