import Portal from "@/portal/layouts/Portal.astro";
import { requireStaff } from "@/portal/access";
import { failure, load } from "@/portal/page";
import { Page } from "@/portal/ui/Page";
import { Inbox, type InboxThread } from "@/portal/ui/staff/Inbox";
import { listAll, organizationsFor } from "@/server/organization";
import { listAll as listAllThreads } from "@/server/support/thread";

const loaded = await load(Astro);
if (loaded instanceof Response) return loaded;
const { portal, session } = loaded;

const organizations = await organizationsFor(portal.store, session);

let error: string | undefined;
let threads: InboxThread[] = [];
try {
    requireStaff(session);
    const [all, orgs] = await Promise.all([
        listAllThreads(portal.store, portal.tracker),
        listAll(portal.store),
    ]);
    const names = new Map(orgs.map((o) => [o.key, o.name]));
    threads = all.map((t) => ({
        ...t,
        organizationName:
            t.organization == null ? "Signed out" : (names.get(t.organization) ?? ""),
    }));
} catch (err) {
    const f = failure(err);
    Astro.response.status = f.status;
    error = f.message;
}
---

<Portal title="Inbox" session={session} organizations={organizations}>
    {
        error != null ? (
            <Page client:load title="Inbox" error={error} />
        ) : (
            <Inbox client:load threads={threads} />
        )
    }
</Portal>
