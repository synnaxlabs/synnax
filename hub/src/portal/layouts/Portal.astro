import Root from "@/layouts/Root.astro";
import { Sidebar } from "@/portal/ui/Sidebar";
import type { Organization } from "@/server/db/schema";
import type { Session } from "@/server/session";
import "@/portal/portal.css";

interface Props {
    title: string;
    session: Session;
    organizations: Organization[];
    organization?: Organization | null;
}

const { title, session, organizations, organization = null } = Astro.props;
---

<Root frontmatter={{ title }}>
    <nav class="page-nav portal-nav">
        <Sidebar
            client:load
            path={Astro.url.pathname}
            staff={session.staff}
            teams={organizations
                .filter((o) => o.kind === "team")
                .map((o) => ({ key: o.key, name: o.name }))}
            selected={organization?.kind === "team" ? organization.key : null}
        />
    </nav>
    <section class="portal">
        <slot />
    </section>
</Root>
