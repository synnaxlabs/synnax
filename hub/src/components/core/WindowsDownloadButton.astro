import { Button, Icon } from "@synnaxlabs/pluto";
import { assetURL } from "@/util/releases";

const version = await Astro.locals.releases.latest("core");
const url = assetURL("core", version, `synnax-setup-v${version}.exe`);
---

<Button.Button href={url} size="large" variant="filled">
    <Icon.Download />
    Download Synnax v{version} for Windows
</Button.Button>
