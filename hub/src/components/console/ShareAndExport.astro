import { Video } from "@/components/media/Media";

interface Props {
    type: string;
    video?: string;
}

const { type, video } = Astro.props;
---

<p>
    Select <code>Copy link</code> from the Projects or Component Toolbar. Anyone on the Core
    can open it from a browser.
</p>

<p>
    Select <code>Export</code> to save the {type} as a JSON file. Drag the file back into
    the Console to import it.
</p>

{video && <Video client:only="react" id={video} />}
