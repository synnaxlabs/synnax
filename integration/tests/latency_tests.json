{
  "$schema": "test_schema.json",
  "sequences": [
    {
      "sequence_name": "Core_Stress",
      "isolated": true,
      "tests": [{ "case": "latency/writer_open_close_stress" }]
    },
    {
      "sequence_name": "Driver_Latency",
      "isolated": true,
      "sequence_order": "sequential",
      "tests": [
        { "case": "latency/driver_ni_digital_write" },
        { "case": "latency/driver_state_wake" }
      ]
    },
    {
      "sequence_name": "Arc_Wait_Accuracy",
      "isolated": true,
      "tests": [
        {
          "case": "arc/wait_accuracy_samples",
          "parameters": { "rack_key": [65537, 65538] }
        }
      ]
    },
    {
      "sequence_name": "Bench_Latency",
      "isolated": true,
      "sequence_order": "asynchronous",
      "tests": [
        { "case": "latency/bench_response" },
        { "case": "latency/bench_report" }
      ]
    },
    {
      "sequence_name": "Async_ABC",
      "isolated": true,
      "sequence_order": "asynchronous",
      "tests": [
        {
          "case": "latency/abcd",
          "name": "async",
          "parameters": { "mode": ["a", "b", "c", "d"] }
        }
      ]
    }
  ]
}
