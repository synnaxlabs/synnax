{
  "name": "@synnaxlabs/drift",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "watch": "vite build --watch",
    "test": "vitest",
    "cov": "vitest --coverage",
    "lint": "eslint",
    "fix": "eslint --fix"
  },
  "dependencies": {
    "@synnaxlabs/x": "catalog:",
    "@tauri-apps/api": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@reduxjs/toolkit": "catalog:",
    "react": "catalog:",
    "react-redux": "catalog:"
  },
  "devDependencies": {
    "@reduxjs/toolkit": "catalog:",
    "@synnaxlabs/eslint-config": "catalog:",
    "@synnaxlabs/tsconfig": "catalog:",
    "@synnaxlabs/vite-plugin": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "async-mutex": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-redux": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/drift.js"
    },
    "./react": {
      "types": "./dist/src/react/index.d.ts",
      "default": "./dist/react.js"
    },
    "./tauri": {
      "types": "./dist/src/tauri/index.d.ts",
      "default": "./dist/tauri.js"
    }
  }
}
