--- a/src/core/BUILD
+++ b/src/core/BUILD
@@ -23,5 +23,7 @@ load(
     "grpc_upb_proto_library",
     "grpc_upb_proto_reflection_library",
 )
+
+load("@rules_cc//cc:cc_library.bzl", "cc_library")
 
 licenses(["reciprocal"])
@@ -34,6 +34,27 @@ package(
     ],
 )
 
+# grpc ships pre-generated upb/upbdefs sources under src/core/ext/{upb-gen,upbdefs-gen}
+# and puts those directories on the include path (see grpc_cc_library in
+# //bazel:grpc_build_system.bzl). The files are not owned by any target, so under a
+# toolchain that enforces strict header inclusion (layering_check / parse_headers, as
+# this package sets) every grpc_cc_library that includes a well-known-type upb header
+# (e.g. google/protobuf/any.upb.h) fails with "undeclared inclusion(s)". Declare the
+# checked-in headers as inputs so the inclusion check is satisfied; the include path
+# itself is still provided by grpc_cc_library.
+cc_library(
+    name = "upb_gen_hdrs",
+    hdrs = glob([
+        "ext/upb-gen/**/*.h",
+        "ext/upbdefs-gen/**/*.h",
+    ]),
+    features = [
+        "-parse_headers",
+        "-layering_check",
+    ],
+    visibility = ["//visibility:public"],
+)
+
 config_setting(
     name = "disable_latent_see",
     values = {"define": "GRPC_LATENT_SEE=none"},
