        "//conditions:default": [
            "-lm",
            "-ldl",
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//driver/daemon",
        "//driver/rack",
        "//x/cpp/args",
        "//x/cpp/breaker",
        "//x/cpp/cli",
        "//x/cpp/crash",
        "//x/cpp/log",
        "//x/cpp/shutdown",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:globals",
    ],
)
