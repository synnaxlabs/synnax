load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "cmd",
    srcs = [
        "exec.cpp",
        "//core/pkg/version",
    ],
    hdrs = ["cmd.h"],
    linkopts = select({
        "@platforms//os:windows": [
            "/DEFAULTLIB:ws2_32.lib",
            "/DEFAULTLIB:iphlpapi.lib",
            "/DEFAULTLIB:psapi.lib",
