load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "file",
    srcs = [
        "browser.cpp",
        "file.cpp",
    ] + select({
        "@platforms//os:windows": ["platform_windows.cpp"],
        "//conditions:default": ["platform_posix.cpp"],
    }),
    hdrs = ["file.h"],
    linkopts = select({
        "@platforms//os:windows": [
            "/DEFAULTLIB:ole32.lib",
            "/DEFAULTLIB:shell32.lib",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//driver/common",
        "//driver/task",
        "//x/cpp/errors",
        "//x/cpp/fs",
        "//x/cpp/json",
        "//x/cpp/strings",
        "//x/cpp/telem",
        "//x/cpp/x509",
    ],
)

cc_test(
    name = "file_test",
    srcs = [
        "browser_test.cpp",
        "file_test.cpp",
    ],
    deps = [
        ":file",
        "//x/cpp/defer",
        "//x/cpp/fs",
        "//x/cpp/testutil",
        "//x/cpp/uuid",
        "//x/cpp/x509/testutil",
        "@googletest//:gtest_main",
    ],
)
