load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "util",
    hdrs = ["util.h"],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "util_test",
    srcs = ["util_test.cpp"],
    deps = [
        ":util",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "bpf",
    srcs = ["bpf.cpp"],
    hdrs = ["bpf.h"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//driver/ethercat/errors",
        "//x/cpp/errors",
    ],
)

cc_test(
    name = "bpf_test",
    srcs = ["bpf_test.cpp"],
    deps = [
        ":bpf",
        "//driver/ethercat/errors",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "soem_api",
    srcs = select({
        "@platforms//os:linux": ["api_linux.cpp"],
        "@platforms//os:macos": ["api_darwin.cpp"],
        "//conditions:default": ["api_noop.cpp"],
    }),
    hdrs = ["api.h"],
    visibility = ["//driver/ethercat:__subpackages__"],
    deps = [
        "//driver/ethercat/errors",
        "//vendor/soem",
        "//x/cpp/errors",
    ] + select({
        "@platforms//os:macos": [":bpf"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "soem_mock_api",
    hdrs = ["mock_api.h"],
    visibility = ["//driver/ethercat:__subpackages__"],
    deps = [":soem_api"],
)

cc_library(
    name = "soem",
    srcs = ["master.cpp"],
    hdrs = ["master.h"],
    visibility = ["//driver/ethercat:__pkg__"],
    deps = [
        ":soem_api",
        ":util",
        "//driver/ethercat/errors",
        "//driver/ethercat/esi",
        "//driver/ethercat/master",
        "//driver/ethercat/slave",
        "//driver/ethercat/telem",
        "//x/cpp/errors",
        "@abseil-cpp//absl/log",
    ],
)

cc_test(
    name = "soem_test",
    srcs = ["master_test.cpp"],
    deps = [
        ":soem",
        ":soem_mock_api",
        "//driver/ethercat/errors",
        "//driver/ethercat/esi",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)
