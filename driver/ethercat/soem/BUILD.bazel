load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "util",
    hdrs = ["util.h"],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "util_test",
    srcs = ["util_test.cpp"],
    deps = [
        ":util",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "bpf",
    srcs = ["bpf.cpp"],
    hdrs = ["bpf.h"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//driver/ethercat/errors",
        "//x/cpp/errors",
    ],
)

cc_test(
    name = "bpf_test",
    srcs = ["bpf_test.cpp"],
    deps = [
        ":bpf",
        "//driver/ethercat/errors",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "sii",
    srcs = ["sii.cpp"],
    hdrs = ["sii.h"],
    deps = [
        "//driver/ethercat/dc",
        "//driver/ethercat/pdo",
        "//driver/ethercat/telem",
    ],
)

cc_test(
    name = "sii_test",
    srcs = ["sii_test.cpp"],
    deps = [
        ":sii",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "soem_api",
    srcs = select({
        "@platforms//os:linux": ["api_linux.cpp"],
        "@platforms//os:macos": ["api_darwin.cpp"],
        "@platforms//os:windows": ["api_windows.cpp"],
        "//conditions:default": ["api_noop.cpp"],
    }),
    hdrs = ["api.h"],
    linkopts = select({
        "@platforms//os:windows": ["/DEFAULTLIB:advapi32.lib"],
        "//conditions:default": [],
    }),
    visibility = ["//driver/ethercat:__subpackages__"],
    deps = [
        "//driver/ethercat/errors",
        "//vendor/soem",
        "//x/cpp/errors",
    ] + select({
        "@platforms//os:macos": [":bpf"],
        "@platforms//os:windows": [":util"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "filter",
    srcs = select({
        "@platforms//os:windows": ["filter_windows.cpp"],
        "//conditions:default": ["filter_noop.cpp"],
    }),
    hdrs = ["filter.h"],
    linkopts = select({
        "@platforms//os:windows": ["/DEFAULTLIB:advapi32.lib"],
        "//conditions:default": [],
    }),
    visibility = ["//driver/ethercat:__subpackages__"],
    deps = [
        "//driver/ethercat/errors",
        "//x/cpp/errors",
    ] + select({
        "@platforms//os:windows": [
            ":util",
            "//x/cpp/base64",
        ],
        "//conditions:default": [],
    }),
)

cc_test(
    name = "filter_test",
    srcs = ["filter_test.cpp"],
    linkopts = select({
        "@platforms//os:windows": ["/DEFAULTLIB:advapi32.lib"],
        "//conditions:default": [],
    }),
    deps = [
        ":filter",
        "//driver/ethercat/errors",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "api_windows_test",
    srcs = ["api_windows_test.cpp"],
    linkopts = ["/DEFAULTLIB:iphlpapi.lib"],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":soem_api",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "soem_mock_api",
    hdrs = ["mock_api.h"],
    visibility = ["//driver/ethercat:__subpackages__"],
    deps = [
        ":soem_api",
        "//x/cpp/binary",
        "//x/cpp/loop",
        "//x/cpp/telem",
    ],
)

cc_library(
    name = "soem",
    srcs = ["master.cpp"],
    hdrs = ["master.h"],
    visibility = ["//driver/ethercat:__pkg__"],
    deps = [
        ":sii",
        ":soem_api",
        ":util",
        "//driver/ethercat/coe",
        "//driver/ethercat/dc",
        "//driver/ethercat/errors",
        "//driver/ethercat/esi",
        "//driver/ethercat/esi:settings",
        "//driver/ethercat/master",
        "//driver/ethercat/slave",
        "//driver/ethercat/telem",
        "//x/cpp/binary",
        "//x/cpp/breaker",
        "//x/cpp/errors",
        "//x/cpp/loop",
        "//x/cpp/telem",
        "@abseil-cpp//absl/log",
    ],
)

cc_test(
    name = "soem_test",
    srcs = ["master_test.cpp"],
    deps = [
        ":soem",
        ":soem_mock_api",
        "//driver/ethercat/coe",
        "//driver/ethercat/errors",
        "//driver/ethercat/esi",
        "//driver/ethercat/esi:settings",
        "//driver/ethercat/master:contract",
        "//driver/ethercat/testutil:stg",
        "//x/cpp/loop/testutil",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)
