load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

# Copy the registry blob from the http_file repo to a local genfiles location
genrule(
    name = "registry_blob",
    srcs = ["@esi_registry_blob//file:registry_blob.inc"],
    outs = ["registry_blob.inc"],
    cmd = "cp $< $@",
)

cc_library(
    name = "esi",
    srcs = ["known_devices.cpp"],
    hdrs = ["known_devices.h"],
    # Linting the 38 MB device table this embeds takes minutes.
    tags = ["no-clang-tidy"],
    # The .inc file is fetched from GitHub releases via http_file
    textual_hdrs = [":registry_blob"],
    visibility = ["//driver/ethercat:__subpackages__"],
    deps = [
        "//driver/ethercat/slave",
        "//x/cpp/telem",
    ],
)

cc_library(
    name = "settings",
    srcs = ["settings.cpp"],
    hdrs = ["settings.h"],
    # Generated by the parser of synnaxlabs/esi from its supplements.
    textual_hdrs = ["registry_settings.inc"],
    visibility = ["//driver/ethercat:__subpackages__"],
    deps = [
        "//driver/ethercat/coe",
        "//driver/ethercat/dc",
        "//driver/ethercat/errors",
        "//driver/ethercat/telem",
        "//x/cpp/errors",
        "//x/cpp/json",
        "//x/cpp/telem",
    ],
)

cc_test(
    name = "settings_test",
    srcs = ["settings_test.cpp"],
    deps = [
        ":settings",
        "//driver/ethercat/coe",
        "//driver/ethercat/dc",
        "//driver/ethercat/errors",
        "//driver/ethercat/testutil:stg",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "known_devices_test",
    srcs = ["known_devices_test.cpp"],
    deps = [
        ":esi",
        "@googletest//:gtest_main",
    ],
)
