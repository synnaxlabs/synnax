        "//x/cpp/errors",
        "//x/cpp/json",
        "//x/cpp/telem",
        "//x/cpp/uuid",
        "@abseil-cpp//absl/log",
    ],
)

cc_binary(
    name = "server",
    srcs = ["main.cpp"],
    deps = [
        ":testutil",
        "//vendor/open62541",
        "@abseil-cpp//absl/log",
    ],
)

cc_test(
    name = "server_test",
    srcs = ["server_test.cpp"],
    deps = [
        ":testutil",
        "@googletest//:gtest_main",
    ],
)
