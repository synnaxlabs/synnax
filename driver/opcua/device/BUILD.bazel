load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "device",
    hdrs = [
        "device.h",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//client/cpp:synnax",
        "//client/cpp/errors",
        "//driver/opcua/connection",
        "//driver/opcua/types",
        "//driver/secret",
        "//x/cpp/errors",
        "//x/cpp/json",
    ],
)

cc_test(
    name = "device_test",
    srcs = ["device_test.cpp"],
    tags = ["requires-core"],
    deps = [
        ":device",
        "//client/cpp/testutil",
        "//driver/errors",
        "//driver/opcua/testutil",
        "//x/cpp/errors",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)
