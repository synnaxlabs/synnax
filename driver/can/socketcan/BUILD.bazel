load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "socketcan",
    srcs = select({
        "@platforms//os:linux": ["linux.cpp"],
        "//conditions:default": ["unsupported.cpp"],
    }),
    hdrs = ["socketcan.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//client/cpp/can",
        "//driver/can",
        "//x/cpp/errors",
        "//x/cpp/telem",
    ],
)

# On Linux the test runs against vcan0 and skips when it is absent.
cc_test(
    name = "socketcan_test",
    srcs = select({
        "@platforms//os:linux": ["socketcan_test.cpp"],
        "//conditions:default": ["unsupported_test.cpp"],
    }),
    deps = [
        ":socketcan",
        "//x/cpp/test",
        "@googletest//:gtest_main",
    ],
)
