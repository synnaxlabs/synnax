load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

# NI's NI-XNET C API header, from github.com/ni/grpc-device imports/include.
cc_library(
    name = "nixnet_official",
    hdrs = ["official/nixnet.h"],
)

cc_library(
    name = "nixnet",
    srcs = [
        "nixnet.cpp",
        "prod.cpp",
    ],
    hdrs = [
        "api.h",
        "nixnet.h",
        "prod.h",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":nixnet_official",
        "//driver/can",
        "//driver/errors",
        "//x/cpp/binary",
        "//x/cpp/errors",
        "//x/cpp/lib",
    ],
)

cc_library(
    name = "mock",
    testonly = True,
    hdrs = ["mock.h"],
    visibility = ["//visibility:public"],
    deps = [":nixnet"],
)

cc_test(
    name = "nixnet_test",
    srcs = ["nixnet_test.cpp"],
    deps = [
        ":mock",
        ":nixnet",
        "//x/cpp/test",
        "@googletest//:gtest_main",
    ],
)
