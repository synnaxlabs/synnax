load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "canlib",
    srcs = [
        "canlib.cpp",
        "prod.cpp",
    ],
    hdrs = [
        "abi.h",
        "api.h",
        "canlib.h",
        "prod.h",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//driver/can",
        "//driver/errors",
        "//x/cpp/errors",
        "//x/cpp/lib",
        "@abseil-cpp//absl/log",
    ],
)

cc_library(
    name = "mock",
    testonly = True,
    hdrs = ["mock.h"],
    visibility = ["//visibility:public"],
    deps = [":canlib"],
)

cc_test(
    name = "canlib_test",
    srcs = ["canlib_test.cpp"],
    deps = [
        ":canlib",
        ":mock",
        "//x/cpp/test",
        "@googletest//:gtest_main",
    ],
)
