load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "can",
    srcs = [
        "can.cpp",
        "timing.cpp",
    ],
    hdrs = [
        "can.h",
        "timing.h",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//client/cpp/can",
        "//driver/errors",
        "//x/cpp/errors",
        "//x/cpp/telem",
    ],
)

cc_library(
    name = "vendor",
    srcs = ["vendor.cpp"],
    hdrs = ["vendor.h"],
    visibility = ["//driver/can:__subpackages__"],
    deps = [
        ":can",
        "//driver/errors",
        "//x/cpp/errors",
        "//x/cpp/lib",
    ],
)

cc_test(
    name = "vendor_test",
    srcs = ["vendor_test.cpp"],
    deps = [
        ":vendor",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "task",
    srcs = [
        "factory.cpp",
        "link.cpp",
        "read.cpp",
        "scan_task.cpp",
        "write.cpp",
    ],
    hdrs = [
        "factory.h",
        "link.h",
        "read.h",
        "scan_task.h",
        "write.h",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":can",
        "//client/cpp/can",
        "//driver/bus",
        "//driver/common",
        "//driver/task",
        "@abseil-cpp//absl/log",
    ],
)

# The cases of the can::Bus contract. A test that links them instantiates
# BusContract with its rigs.
cc_library(
    name = "contract",
    testonly = True,
    srcs = ["contract.cpp"],
    hdrs = ["contract.h"],
    visibility = ["//driver/can:__subpackages__"],
    deps = [
        ":can",
        "//x/cpp/testutil",
        "@googletest//:gtest",
    ],
    alwayslink = True,
)

# Runs the contract on the loopback model, and on an adapter when
# SYNNAX_TEST_CAN_BENCH names one. socketcan_test runs it on vcan0.
cc_test(
    name = "contract_test",
    srcs = ["contract_test.cpp"],
    deps = [
        ":contract",
        "//driver/can/backends",
        "//driver/can/loopback",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "can_test",
    srcs = [
        "can_test.cpp",
        "timing_test.cpp",
    ],
    deps = [
        ":can",
        "//driver/can/loopback",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "task_test",
