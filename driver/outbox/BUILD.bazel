load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_proto_grpc_cpp//:defs.bzl", "cpp_grpc_library")

proto_library(
    name = "call_proto",
    srcs = ["pb/call.proto"],
)

cpp_grpc_library(
    name = "call_grpc",
    output_mode = "NO_PREFIX",
    protos = [":call_proto"],
)

cc_library(
    name = "outbox",
    srcs = ["outbox.cpp"],
    hdrs = ["outbox.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":call_grpc",
        "//client/cpp/errors",
        "//client/cpp/ranger",
        "//client/cpp/status",
        "//driver/journal",
        "//x/cpp/breaker",
        "//x/cpp/color",
        "//x/cpp/errors",
        "//x/cpp/telem",
        "//x/cpp/uuid",
        "@abseil-cpp//absl/log",
    ],
)

cc_test(
    name = "outbox_test",
    srcs = ["outbox_test.cpp"],
    data = glob(["testdata/*.bin"]),
    deps = [
        ":call_grpc",
        ":outbox",
        "//client/cpp/errors",
        "//client/cpp/ranger",
        "//driver/journal",
        "//freighter/cpp/testutil",
        "//x/cpp/color",
        "//x/cpp/telem",
        "//x/cpp/testutil",
        "//x/cpp/uuid",
        "@googletest//:gtest_main",
    ],
)
