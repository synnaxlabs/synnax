load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "serial",
    srcs = [
        "line.cpp",
        "port.cpp",
    ] + select({
        "@platforms//os:linux": [
            "linux.cpp",
            "posix.cpp",
        ],
        "@platforms//os:macos": [
            "macos.cpp",
            "posix.cpp",
        ],
        "@platforms//os:windows": ["windows.cpp"],
    }),
    hdrs = [
        "errors.h",
        "line.h",
        "native.h",
        "port.h",
    ] + select({
        "@platforms//os:windows": [],
        "//conditions:default": ["posix.h"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//client/cpp/serial",
        "//driver/transport",
        "//x/cpp/errors",
        "//x/cpp/telem",
        "@asio//:asio_no_openssl",
    ],
)

cc_test(
    name = "port_test",
    size = "small",
    srcs = [
        "port_test.cpp",
        "pty.h",
    ] + select({
        "@platforms//os:macos": ["macos_test.cpp"],
        "//conditions:default": [],
    }),
    # The tests play the device on a pseudo-terminal, which Windows lacks.
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":serial",
        "//driver/transport",
        "//x/cpp/defer",
        "//x/cpp/telem",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "native_test",
    size = "small",
    srcs = select({
        "@platforms//os:windows": ["windows_test.cpp"],
        "//conditions:default": ["posix_test.cpp"],
    }),
    deps = [
        ":serial",
        "//driver/transport",
        "//x/cpp/testutil",
        "@asio//:asio_no_openssl",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "line_test",
    size = "small",
    srcs = ["line_test.cpp"] + select({
        "@platforms//os:linux": ["line_linux_test.cpp"],
        "@platforms//os:macos": ["line_macos_test.cpp"],
        "@platforms//os:windows": ["line_windows_test.cpp"],
    }),
    deps = [
        ":serial",
        "//driver/transport",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)
