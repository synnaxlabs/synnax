load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "serial",
    srcs = ["line.cpp"] + select({
        "@platforms//os:linux": ["linux.cpp"],
        "@platforms//os:macos": ["macos.cpp"],
        "//conditions:default": [],
    }),
    hdrs = ["line.h"],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//client/cpp/serial",
        "//driver/transport",
        "//x/cpp/errors",
    ],
)

cc_test(
    name = "line_test",
    size = "small",
    srcs = ["line_test.cpp"] + select({
        "@platforms//os:linux": ["line_linux_test.cpp"],
        "@platforms//os:macos": ["line_macos_test.cpp"],
        "//conditions:default": [],
    }),
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":serial",
        "//driver/transport",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)
