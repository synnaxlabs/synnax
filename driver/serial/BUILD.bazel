load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "serial",
    srcs = [
        "native.h",
        "port.cpp",
    ] + select({
        "@platforms//os:linux": ["linux.cpp"],
        "@platforms//os:macos": ["macos.cpp"],
        "@platforms//os:windows": ["windows.cpp"],
    }),
    hdrs = [
        "port.h",
        "scan.h",
    ],
    linkopts = select({
        "@platforms//os:windows": ["advapi32.lib"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//client/cpp/serial",
        "//driver/errors",
        "//driver/transport",
        "//x/cpp/errors",
        "//x/cpp/telem",
        "@asio//:asio_no_openssl",
    ],
)

# The tests drive the port through a pseudo-terminal, which Windows lacks.
cc_test(
    name = "serial_test",
    size = "small",
    srcs = [
        "port_test.cpp",
        "pty.h",
    ] + select({
        "@platforms//os:linux": [
            "linux_test.cpp",
            "termios2.cpp",
        ],
        "@platforms//os:macos": ["macos_test.cpp"],
        "//conditions:default": [],
    }),
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":serial",
        "//x/cpp/test",
        "@googletest//:gtest_main",
    ],
)
