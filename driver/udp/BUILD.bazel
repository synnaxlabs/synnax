load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "udp",
    srcs = ["socket.cpp"],
    hdrs = ["socket.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//client/cpp/udp",
        "//driver/transport",
        "//x/cpp/errors",
        "//x/cpp/telem",
        "@asio//:asio_no_openssl",
    ],
)

# The multicast test loops a datagram back through the host's default interface, which
# the sandbox blocks without network access.
cc_test(
    name = "udp_test",
    size = "small",
    srcs = ["socket_test.cpp"],
    tags = ["requires-network"],
    deps = [
        ":udp",
        "//x/cpp/test",
        "@asio//:asio_no_openssl",
        "@googletest//:gtest_main",
    ],
)
