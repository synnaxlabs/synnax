load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "udp",
    srcs = ["socket.cpp"] + select({
        "@platforms//os:windows": ["icmp_windows.cpp"],
        "//conditions:default": ["icmp_posix.cpp"],
    }),
    hdrs = [
        "icmp.h",
        "socket.h",
    ],
    linkopts = select({
        "@platforms//os:windows": ["ws2_32.lib"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//driver/transport",
        "//x/cpp/errors",
        "//x/cpp/telem",
        "@asio//:asio_no_openssl",
    ],
)

cc_test(
    name = "udp_test",
    srcs = ["socket_test.cpp"],
    deps = [
        ":udp",
        "//driver/transport",
        "//x/cpp/errors",
        "//x/cpp/telem",
        "//x/cpp/testutil",
        "@asio//:asio_no_openssl",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "tasks",
    srcs = ["factory.cpp"],
    hdrs = ["udp.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":udp",
        "//client/cpp/udp",
        "//driver/bus:device",
        "//driver/bus:holders",
        "//driver/bus:tasks",
        "//driver/common",
        "//driver/task",
        "//driver/transport",
        "//x/cpp/breaker",
        "//x/cpp/errors",
        "//x/cpp/telem",
    ],
)

cc_test(
    name = "tasks_test",
    size = "small",
    srcs = ["tasks_test.cpp"],
    deps = [
        ":tasks",
        "//client/cpp/channel",
        "//client/cpp/icd",
        "//client/cpp/udp",
        "//driver/bus:holders",
        "//driver/bus:tasks",
        "//driver/common",
        "//driver/icd:receiver",
        "//driver/icd:sender",
        "//driver/pipeline/testutil",
        "//driver/task",
        "//driver/transport",
        "//x/cpp/breaker",
        "//x/cpp/telem",
        "//x/cpp/testutil",
        "//x/cpp/uuid",
        "@asio//:asio_no_openssl",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "configure_test",
    srcs = ["configure_test.cpp"],
    tags = ["requires-core"],
    deps = [
        ":tasks",
        "//client/cpp/channel",
        "//client/cpp/icd",
        "//client/cpp/testutil",
        "//client/cpp/udp",
        "//driver/task",
        "//x/cpp/breaker",
        "//x/cpp/telem",
        "//x/cpp/testutil",
        "//x/cpp/uuid",
        "@googletest//:gtest_main",
    ],
)
