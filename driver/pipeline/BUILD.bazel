cc_test(
    name = "pipeline_test",
    srcs = [
        "acquisition_test.cpp",
        "base_test.cpp",
        "control_test.cpp",
    ],
    deps = [
        "//driver/pipeline",
        "//driver/pipeline/mock",
        "//x/cpp/test",
        "@abseil-cpp//absl/log",
        "@googletest//:gtest_main",
    ],
)
