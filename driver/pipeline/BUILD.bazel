load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "pipeline",
    srcs = [
        "acquisition.cpp",
        "control.cpp",
    ],
    hdrs = [
        "acquisition.h",
        "base.h",
        "control.h",
    ],
    visibility = ["//visibility:public"],
