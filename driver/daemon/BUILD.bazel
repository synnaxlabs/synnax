load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

config_setting(
    name = "nilinuxrt",
    values = {
        "define": "platform=nilinuxrt",
    },
)

cc_library(
    name = "daemon",
    srcs = select({
        ":nilinuxrt": [
            "common.cpp",
            "common.h",
            "daemon_nilinuxrt.cpp",
        ],
        "@platforms//os:linux": [
            "common.cpp",
            "common.h",
            "daemon_linux.cpp",
        ],
        "@platforms//os:macos": [
            "common.cpp",
            "common.h",
            "daemon_darwin.cpp",
        ],
        "@platforms//os:windows": ["daemon_windows.cpp"],
    }),
    hdrs = ["daemon.h"],
    linkopts = select({
        ":nilinuxrt": [],
        "@platforms//os:linux": [
            "-lsystemd",
        ],
        "@platforms//os:macos": [],
        "@platforms//os:windows": [
            "/DEFAULTLIB:advapi32.lib",
            "/DEFAULTLIB:ole32.lib",
            "/DEFAULTLIB:shell32.lib",
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//x/cpp/env",
        "//x/cpp/errors",
        "//x/cpp/shutdown",
        "//x/cpp/thread",
        "@abseil-cpp//absl/log",
    ],
)

# Exercises the systemd sd_notify protocol, so it only runs where daemon_linux.cpp is
# the selected implementation: Linux, excluding the NI Linux RT configuration.
cc_test(
    name = "daemon_test",
    size = "small",
    srcs = ["daemon_test.cpp"],
    target_compatible_with = select({
        ":nilinuxrt": ["@platforms//:incompatible"],
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":daemon",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "common_test",
    size = "small",
    srcs = [
        "common.h",
        "common_test.cpp",
    ],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":daemon",
        "//x/cpp/errors",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)
