load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "names",
    hdrs = ["names.h"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "modbus",
    srcs = [
        "block.h",
        "channels.h",
        "factory.cpp",
        "modbus.h",
        "read_task.h",
        "scan_task.cpp",
        "scan_task.h",
        "write_task.h",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":names",
        "//client/cpp/modbus",
        "//driver/common",
        "//driver/errors",
        "//driver/modbus/device",
        "//driver/modbus/util",
        "//driver/pipeline",
        "//driver/task",
        "//vendor/libmodbus",
        "//x/cpp/breaker",
        "//x/cpp/defer",
        "//x/cpp/errors",
        "//x/cpp/telem",
    ],
)

cc_test(
    name = "modbus_test",
    srcs = [
        "read_task_test.cpp",
        "write_task_test.cpp",
    ],
    tags = ["requires-core"],
    visibility = ["//visibility:public"],
    deps = [
        "//client/cpp/testutil",
        "//driver/modbus",
        "//driver/modbus/testutil",
        "//driver/pipeline/testutil",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "io_test",
    srcs = [
        "block_test.cpp",
        "reader_test.cpp",
        "writer_test.cpp",
    ],
    deps = [
        "//driver/modbus",
        "//driver/modbus/testutil",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "scan_task_test",
    srcs = ["scan_task_test.cpp"],
    visibility = ["//visibility:public"],
    deps = [
        "//client/cpp/testutil",
        "//driver/modbus",
        "//driver/modbus/testutil",
        "//driver/pipeline/testutil",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "rtu_test",
    srcs = ["rtu_test.cpp"],
    # The test slave serves RTU on a POSIX pseudo-terminal.
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//driver/modbus",
        "//driver/modbus/testutil",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)
