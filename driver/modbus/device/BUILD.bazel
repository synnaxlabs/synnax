load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "device",
    srcs = select({
        "@platforms//os:windows": [
            "error_windows.cpp",
            "serial_windows.cpp",
        ],
        "//conditions:default": [
            "error_posix.cpp",
            "serial_posix.cpp",
        ],
    }),
    hdrs = ["device.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//driver/errors",
        "//vendor/libmodbus",
        "//x/cpp/errors",
        "//x/cpp/json",
        "//x/cpp/telem",
    ],
)

cc_test(
    name = "device_test",
    srcs = ["device_test.cpp"],
    visibility = ["//visibility:public"],
    deps = [
        ":device",
        "//driver/modbus/testutil",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)
