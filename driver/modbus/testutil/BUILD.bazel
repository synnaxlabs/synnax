load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "testutil",
    srcs = select({
        "@platforms//os:windows": ["pseudo_terminal_windows.cpp"],
        "//conditions:default": ["pseudo_terminal_posix.cpp"],
    }),
    hdrs = [
        "pseudo_terminal.h",
        "slave.h",
    ],
    linkopts = select({
        "@platforms//os:linux": ["-lutil"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//driver/modbus/util",
        "//vendor/libmodbus",
        "//x/cpp/errors",
        "//x/cpp/telem",
        "@abseil-cpp//absl/log",
    ],
)

cc_test(
    name = "slave_test",
    srcs = ["slave_test.cpp"],
    deps = [
        ":testutil",
        "//vendor/libmodbus",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "slave",
    srcs = ["main.cpp"],
    linkopts = select({
        "@platforms//os:windows": ["ws2_32.lib"],
        "//conditions:default": [],
    }),
    deps = [
        "//driver/modbus/testutil",
        "//driver/modbus/util",
        "//vendor/libmodbus",
        "//x/cpp/errors",
        "@abseil-cpp//absl/log",
    ],
)
