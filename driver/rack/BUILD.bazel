load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

config_setting(
    name = "nilinuxrt",
    values = {
        "define": "platform=nilinuxrt",
    },
)

cc_library(
    name = "rack",
    srcs = [
        "args.cpp",
        "env.cpp",
        "factories.cpp",
        "factories.h",
        "file.cpp",
        "persist.cpp",
        "rack.cpp",
        "remote.cpp",
        "unavailable.h",
    ] + select({
        "@platforms//os:macos": ["factories_darwin.cpp"],
        "@platforms//os:linux": ["factories_linux.cpp"],
        "@platforms//os:windows": ["factories_windows.cpp"],
    }),
    hdrs = ["rack.h"],
    defines = select({
        ":nilinuxrt": ["SYNNAX_NILINUXRT"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//client/cpp/auth",
        "//client/cpp/errors",
        "//driver/arc",
        "//driver/common",
        "//driver/errors",
        "//driver/ethercat",
        "//driver/http",
        "//driver/labjack:names",
        "//driver/modbus:names",
        "//driver/ni:names",
        "//driver/opcua",
        "//driver/rack/status",
        "//driver/task",
        "//x/cpp/args",
        "//x/cpp/env",
        "//x/cpp/kv",
        "//x/cpp/log",
        "//x/cpp/os",
        "//x/cpp/path",
        "//x/cpp/profile",
        "//x/cpp/thread",
        "//x/cpp/thread/rt",
        "//x/cpp/uuid",
    ] + select({
        ":nilinuxrt": [],
        "//conditions:default": ["//driver/modbus"],
    }) + select({
        "@platforms//os:macos": ["//driver/labjack"],
        "@platforms//os:linux": ["//driver/ni"],
        "@platforms//os:windows": [
            "//driver/labjack",
            "//driver/ni",
        ],
    }),
)

cc_test(
    name = "factories_test",
    srcs = ["factories_test.cpp"],
    deps = [
        "//driver/labjack:names",
        "//driver/ni:names",
        "//driver/rack",
        "//driver/task",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "factories_darwin_test",
    srcs = ["factories_darwin_test.cpp"],
    tags = ["requires-core"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//client/cpp/testutil",
        "//driver/ni:names",
        "//driver/rack",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "factories_linux_test",
    srcs = ["factories_linux_test.cpp"],
    tags = ["requires-core"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//client/cpp/testutil",
        "//driver/labjack:names",
        "//driver/rack",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "rack_test",
    srcs = [
        "config_test.cpp",
    ],
    tags = ["requires-core"],
    deps = [
        "//client/cpp/testutil",
        "//driver/rack",
        "@googletest//:gtest_main",
    ],
)
