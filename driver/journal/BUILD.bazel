load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "journal",
    srcs = ["journal.cpp"],
    hdrs = ["journal.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//x/cpp/binary",
        "//x/cpp/errors",
        "//x/cpp/fs:file",
        "//x/cpp/telem",
        "@abseil-cpp//absl/crc:crc32c",
    ],
)

cc_test(
    name = "journal_test",
    srcs = ["journal_test.cpp"],
    data = glob(["testdata/*.bin"]),
    deps = [
        ":journal",
        "//x/cpp/fs:file",
        "//x/cpp/testutil",
        "@abseil-cpp//absl/crc:crc32c",
        "@googletest//:gtest_main",
    ],
)
