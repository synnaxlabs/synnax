load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "file",
    srcs = ["file.cpp"] + select({
        "@platforms//os:windows": ["file_windows.cpp"],
        "//conditions:default": ["file_posix.cpp"],
    }),
    hdrs = ["file.h"],
    copts = select({
        "@platforms//os:windows": [
            "/DWIN32_LEAN_AND_MEAN",
            "/DNOMINMAX",
        ],
        "//conditions:default": [],
    }),
    deps = ["//x/cpp/errors"],
)

cc_test(
    name = "file_test",
    srcs = ["file_test.cpp"],
    deps = [
        ":file",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)
