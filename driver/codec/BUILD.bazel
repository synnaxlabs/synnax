load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "codec",
    srcs = [
        "arinc429.cpp",
        "bits.cpp",
        "matcher.cpp",
        "plan.cpp",
    ],
    hdrs = [
        "arinc429.h",
        "bits.h",
        "errors.h",
        "matcher.h",
        "plan.h",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//client/cpp/library",
        "//driver/errors",
        "//x/cpp/errors",
        "//x/cpp/telem",
