)

cc_test(
    name = "codec_test",
    srcs = [
        "arinc429_test.cpp",
        "bits_test.cpp",
        "golden_test.cpp",
        "matcher_test.cpp",
        "plan_test.cpp",
    ],
    data = ["testdata/vectors.json"],
    deps = [
        ":codec",
        "//x/cpp/json",
        "//x/cpp/test",
        "//x/cpp/uuid",
        "@googletest//:gtest_main",
        "@nlohmann_json//:json",
    ],
)
