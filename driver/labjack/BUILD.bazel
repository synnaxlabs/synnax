load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "names",
    hdrs = ["names.h"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "labjack",
    srcs = [
        "factory.cpp",
    ],
    hdrs = [
        "labjack.h",
        "read_task.h",
        "scan_task.h",
        "write_task.h",
    ],
    linkopts = select({
        "@platforms//os:windows": ["/DEFAULTLIB:ws2_32.lib"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":names",
        ":store",
        "//client/cpp:synnax",
        "//client/cpp/labjack",
        "//client/cpp/labjack/device",
        "//driver/common",
        "//driver/labjack/device",
        "//driver/labjack/ljm",
        "//driver/pipeline",
        "//driver/task",
        "//driver/transform",
        "//x/cpp/breaker",
        "//x/cpp/json",
        "//x/cpp/lib",
        "//x/cpp/loop",
        "@abseil-cpp//absl/log",
        "@nlohmann_json//:json",
    ],
)

cc_library(
    name = "store",
    hdrs = ["store.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//client/cpp:synnax",
        "//client/cpp/labjack/device",
        "//driver/common",
        "//x/cpp/errors",
        "//x/cpp/telem",
    ],
)

cc_test(
    name = "store_test",
    srcs = ["store_test.cpp"],
    tags = ["requires-core"],
    deps = [
        ":store",
        "//client/cpp/testutil",
        "//driver/common",
        "//x/cpp/filter",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "testutil",
    testonly = True,
    hdrs = ["testutil.h"],
    deps = [
        "//client/cpp:synnax",
        "//client/cpp/labjack/device",
        "//x/cpp/testutil",
        "@googletest//:gtest",
    ],
)

cc_test(
    name = "labjack_test",
    srcs = [
        "factory_test.cpp",
        "read_task_test.cpp",
        "scan_task_test.cpp",
        "write_task_test.cpp",
    ],
    tags = ["requires-core"],
    deps = [
        "//client/cpp/testutil",
        "//driver/labjack",
        "//driver/labjack:store",
        "//driver/labjack:testutil",
        "//driver/labjack/device:mock",
        "//x/cpp/filter",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)
