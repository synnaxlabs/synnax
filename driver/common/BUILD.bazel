load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "common",
    hdrs = [
        "common.h",
        "factory.h",
        "read_task.h",
        "sample_clock.h",
        "scan_task.h",
        "status.h",
        "sync.h",
        "write_task.h",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//client/cpp/device",
        "//client/cpp/rack:key",
        "//client/cpp/status",
        "//client/cpp/task",
        "//driver/bypass/pipeline",
        "//driver/errors",
        "//driver/pipeline",
        "//driver/task",
        "//driver/transform",
        "//x/cpp/breaker",
        "//x/cpp/filter",
        "//x/cpp/json",
        "//x/cpp/loop",
        "//x/cpp/strings",
        "//x/cpp/telem",
        "//x/cpp/thread",
        "@abseil-cpp//absl/log",
    ],
)

cc_binary(
    name = "write_task_bench",
    srcs = ["write_task_bench.cpp"],
    deps = [
        "//driver/common",
        "@google_benchmark//:benchmark_main",
    ],
)

cc_test(
    name = "common_test",
    srcs = [
        "common_test.cpp",
        "read_task_test.cpp",
        "sample_clock_test.cpp",
        "scan_task_test.cpp",
        "status_test.cpp",
        "sync_test.cpp",
        "testutil.h",
        "write_task_test.cpp",
    ],
    deps = [
        "//client/cpp/testutil",
        "//driver/common",
        "//driver/pipeline/testutil",
        "//x/cpp/defer",
        "//x/cpp/sync",
        "//x/cpp/testutil",
        "//x/cpp/uuid",
        "@abseil-cpp//absl/base:log_severity",
        "@abseil-cpp//absl/log:log_entry",
        "@abseil-cpp//absl/log:log_sink",
        "@abseil-cpp//absl/log:log_sink_registry",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "scan_task_core_test",
    srcs = ["scan_task_core_test.cpp"],
    tags = ["requires-core"],
    deps = [
        "//client/cpp/testutil",
        "//driver/common",
        "//driver/task",
        "//x/cpp/testutil",
        "//x/cpp/uuid",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "factory_test",
    srcs = ["factory_test.cpp"],
    tags = ["requires-core"],
    deps = [
        "//client/cpp/testutil",
        "//driver/common",
        "//driver/pipeline/testutil",
        "//x/cpp/sync",
        "//x/cpp/testutil",
        "//x/cpp/uuid",
        "@googletest//:gtest_main",
    ],
)
