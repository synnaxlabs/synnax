load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "names",
    hdrs = ["names.h"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "ni",
    srcs = [
        "factory.cpp",
        "probe.cpp",
        "scan_task.cpp",
    ],
    hdrs = [
        "ni.h",
        "probe.h",
        "read_task.h",
        "scan_task.h",
        "write_task.h",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":names",
        "//client/cpp:synnax",
        "//client/cpp/ni",
        "//driver/common",
        "//driver/ni/channel",
        "//driver/ni/daqmx",
        "//driver/ni/errors",
        "//driver/ni/hardware",
        "//driver/ni/syscfg",
        "//driver/pipeline",
        "//driver/task",
        "//x/cpp/breaker",
        "//x/cpp/json",
        "//x/cpp/lib",
        "//x/cpp/loop",
        "@nlohmann_json//:json",
    ],
)

cc_test(
    name = "ni_test",
    srcs = [
        "factory_test.cpp",
        "read_task_test.cpp",
        "write_task_test.cpp",
    ],
    tags = ["requires-core"],
    deps = [
        "//client/cpp/testutil",
        "//driver/ni",
        "//driver/ni/daqmx:mock",
        "//driver/pipeline/testutil",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "probe_test",
    srcs = ["probe_test.cpp"],
    deps = [
        "//client/cpp/ni",
        "//driver/ni",
        "//driver/ni/daqmx:mock",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "scan_task_test",
    srcs = ["scan_task_test.cpp"],
    tags = ["requires-core"],
    deps = [
        "//client/cpp/testutil",
        "//driver/ni",
        "//driver/ni/daqmx:mock",
        "//driver/pipeline/testutil",
        "//x/cpp/lib",
        "//x/cpp/testutil",
        "@abseil-cpp//absl/base:log_severity",
        "@abseil-cpp//absl/log:globals",
