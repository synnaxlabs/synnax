load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "syscfg",
    srcs = [
        "prod.cpp",
        "sugared.cpp",
    ],
    hdrs = [
        "api.h",
        "prod.h",
        "sugared.h",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//driver/errors",
        "//driver/ni/errors",
        "//driver/ni/syscfg:syscfg_official",
        "//x/cpp/lib",
        "//x/cpp/os",
    ],
)

cc_library(
    name = "syscfg_official",
    srcs = [
        "nisyscfg.h",
        "nisyscfg_errors.h",
        "nisyscfg_wide.h",
    ],
    deps = [],
)

cc_test(
    name = "syscfg_test",
    srcs = ["sugared_test.cpp"],
    deps = [
        ":syscfg",
        "//driver/ni/errors",
        "//x/cpp/test",
        "@googletest//:gtest_main",
    ],
)
