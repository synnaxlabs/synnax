load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "daqmx",
    srcs = [
        "prod.cpp",
        "sugared.cpp",
    ],
    hdrs = [
        "api.h",
        "prod.h",
        "sugared.h",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//driver/errors",
        "//driver/ni/daqmx:nidaqmx_official",
        "//driver/ni/errors",
        "//x/cpp/lib",
        "//x/cpp/os",
    ],
)

cc_library(
    name = "mock",
    testonly = True,
    hdrs = ["mock.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":daqmx",
        "@nlohmann_json//:json",
    ],
)

cc_library(
    name = "nidaqmx_official",
    hdrs = [
        "nidaqmx.h",
    ],
    deps = [],
)

cc_test(
    name = "mock_test",
    srcs = ["mock_test.cpp"],
    deps = [
        ":mock",
        "@googletest//:gtest_main",
    ],
)
