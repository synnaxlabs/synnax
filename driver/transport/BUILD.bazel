load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "transport",
    srcs = ["connection.cpp"],
    hdrs = [
        "connection.h",
        "errors.h",
        "transport.h",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//driver/errors",
        "//x/cpp/errors",
        "//x/cpp/json",
        "//x/cpp/telem",
        "@asio//:asio_no_openssl",
    ],
)

cc_test(
    name = "transport_test",
    srcs = [
        "connection_test.cpp",
        "transport_test.cpp",
    ],
    deps = [
        ":transport",
        "//x/cpp/errors",
        "//x/cpp/json",
        "//x/cpp/telem",
        "//x/cpp/testutil",
        "@asio//:asio_no_openssl",
        "@googletest//:gtest_main",
    ],
)
