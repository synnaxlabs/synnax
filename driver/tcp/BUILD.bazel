load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "tcp",
    srcs = ["client.cpp"],
    hdrs = ["client.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//client/cpp/tcp",
        "//driver/transport",
        "//x/cpp/errors",
        "//x/cpp/telem",
        "@asio//:asio_no_openssl",
    ],
)

cc_test(
    name = "tcp_test",
    size = "small",
    srcs = ["client_test.cpp"],
    deps = [
        ":tcp",
        "//x/cpp/test",
        "@asio//:asio_no_openssl",
        "@googletest//:gtest_main",
    ],
)
