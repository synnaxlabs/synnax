load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

filegroup(
    name = "clang_tidy_config",
    srcs = [".clang-tidy"],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "clang_tidy",
    srcs = ["scripts/clang_tidy_wrapper.sh"],
    visibility = ["//visibility:public"],
)

# The lint config with findings left as warnings, so each action passes and keeps the
# fixes it exports. scripts/clang_tidy_fix.sh lints with it.
genrule(
    name = "clang_tidy_fix_config",
    srcs = [".clang-tidy"],
    outs = ["clang_tidy_fix_config.yaml"],
    cmd = "sed '/^WarningsAsErrors:/d' $< > $@",
    visibility = ["//visibility:public"],
)
