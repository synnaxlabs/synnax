{
  "extends": "@synnaxlabs/tsconfig/base.json",
  "compilerOptions": {
    "types": ["node", "react", "react-dom", "pluralize"],
    "paths": { "@/*": ["./src/*"] },
    "declaration": false,
    "declarationMap": false,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "scripts/**/*.ts", "eslint.config.ts", "stylelint.config.ts"]
}
