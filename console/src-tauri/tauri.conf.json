{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Synnax",
  "build": {
    "beforeBuildCommand": "pnpm build-vite",
    "beforeDevCommand": "pnpm dev-vite",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "signCommand": "powershell -File scripts\\Sign.ps1 %1"
    },
    "macOS": {
      "entitlements": null,
      "frameworks": [],
      "providerShortName": null
    },
    "linux": { "deb": { "depends": [] } }
  },
  "identifier": "com.synnaxlabs.dev",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4NDVGQTU1RTMxN0M3MjAKUldRZ3h4ZmpWZnBGeUpLeHNMdlE0aGNUcHZrU3M0REpxMGtJdmN2ZGs0OVBUQ0Nrb3Z5SFdacjEK",
      "endpoints": ["https://docs.synnaxlabs.com/releases/console/latest.json"],
      "requireSignedVersion": true
    },
    "deep-link": { "mobile": [], "desktop": { "schemes": ["synnax"] } },
    "fs": { "scopeDroppedPaths": false }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "height": 810,
        "resizable": true,
        "title": "Synnax",
        "width": 1080,
        "minWidth": 625,
        "minHeight": 425,
        "visible": false,
        "acceptFirstMouse": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 23 },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-eval' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' data: ipc: http://ipc.localhost http: https: ws: wss:",
        "worker-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' http://localhost:8097",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' data: ipc: http://ipc.localhost http: https: ws: wss:",
        "worker-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  }
}
