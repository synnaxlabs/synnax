{
  "name": "@synnaxlabs/console",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "tauri dev",
    "kill": "bash ~/Desktop/synnaxlabs/synnax/console/scripts/kill-dev.zsh",
    "build": "tsc --noEmit && tauri build",
    "dev-vite": "cross-env VITE_IS_DEV=true vite --force",
    "build-vite": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "fix": "eslint --fix",
    "stylelint": "stylelint \"src/**/*.css\"",
    "test": "vitest",
    "cov": "vitest --coverage",
    "madge": "madge --circular src",
    "devtools": "pnpm react-devtools",
    "react-devtools": "npx react-devtools"
  },
  "dependencies": {
