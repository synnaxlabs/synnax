    "pluralize": "catalog:",
    "posthog-js": "catalog:",
    "proxy-memoize": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-redux": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
