{
  "name": "@synnaxlabs/console",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "tauri dev",
    "kill": "bash ~/Desktop/synnaxlabs/synnax/console/scripts/kill-dev.zsh",
    "build": "tsc --noEmit && tauri build",
    "dev-desktop": "node scripts/tauri_desktop.ts dev",
    "build-desktop": "tsc --noEmit && node scripts/tauri_desktop.ts build",
    "dev-vite": "VITE_IS_DEV=true vite --force",
    "build-vite": "vite build",
    "preview": "vite preview",
    "lint": "eslint && stylelint \"src/**/*.css\"",
    "fix": "eslint --fix && stylelint --fix \"src/**/*.css\"",
    "test": "vitest",
    "cov": "vitest --coverage --project console --project desktop --project chromium",
    "install-browsers": "playwright install chromium webkit",
    "devtools": "pnpm dlx react-devtools"
  },
  "dependencies": {
    "@reduxjs/toolkit": "catalog:",
    "@synnaxlabs/client": "catalog:",
