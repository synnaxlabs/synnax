# Runs clang-tidy as an aspect under --config=clang-tidy. The registry does not have it.
bazel_dep(name = "bazel_clang_tidy", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.10.0", dev_dependency = True)

# Python targets get no generated __init__.py files. Each package must ship its own.
rules_python_config = use_extension(
    "@rules_python//python/extensions:config.bzl",
    "config",
)
rules_python_config.explicit_init_py(default = True)

archive_override(
    module_name = "bazel_clang_tidy",
    integrity = "sha256-Y1MQt22yPSQvyrVfgE9shIxZPJGs9LEnYBXTq65gfAQ=",
    strip_prefix = "bazel_clang_tidy-8dc8c879c9e25ddf3ede2fecc695d3162023fe14",
    urls = ["https://github.com/erenon/bazel_clang_tidy/archive/8dc8c879c9e25ddf3ede2fecc695d3162023fe14.tar.gz"],
)

# The clang-tidy that --config=clang-tidy runs, from its PyPI wheels. Bazel fetches only
# the host's wheel. Keep the version equal to the clang-format version in
# scripts/install_clang_format.sh.
http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

CLANG_TIDY_BUILD = """
package(default_visibility = ["//visibility:public"])

filegroup(name = "clang_tidy", srcs = ["clang_tidy/data/bin/clang-tidy"])

filegroup(
    name = "clang_apply_replacements",
    srcs = ["clang_tidy/data/bin/clang-apply-replacements"],
)

filegroup(
    name = "resource_dir",
    srcs = glob(["clang_tidy/data/lib/clang/*/include/**"]),
)
"""

http_archive(
    name = "clang_tidy_linux_aarch64",
    build_file_content = CLANG_TIDY_BUILD,
    sha256 = "87596cd77dedfdea23ced1d13e57e869dcaee99745bfe942796196da3c197671",
    type = "zip",
    urls = ["https://files.pythonhosted.org/packages/7d/95/ba9463f94319dddd0c3a9d3f65d432ddf71fe9b203dcd7ea63bcff8999e2/clang_tidy-23.1.4-py2.py3-none-manylinux_2_26_aarch64.manylinux_2_28_aarch64.whl"],
)

http_archive(
    name = "clang_tidy_linux_x86_64",
    build_file_content = CLANG_TIDY_BUILD,
    sha256 = "6bb31e4f319ecbe14acb75f23c3050d0f1d4b1d92ea1c66091bc76e4eac2c1ac",
    type = "zip",
    urls = ["https://files.pythonhosted.org/packages/80/85/9b483f300124a9245ec6da8975612f1841e26da13b27ad8d17f2006e13bd/clang_tidy-23.1.4-py2.py3-none-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl"],
)

http_archive(
    name = "clang_tidy_macos_arm64",
    build_file_content = CLANG_TIDY_BUILD,
    sha256 = "08e977575e9f800c1c806f2001a3cdfd01323491aec05e86dd24be9a5c2585f4",
    type = "zip",
    urls = ["https://files.pythonhosted.org/packages/0c/59/637ce45a6cfa15ddb926e1feeee8077b9ebeb2956548375f24e16d51a908/clang_tidy-23.1.4-py2.py3-none-macosx_11_0_arm64.whl"],
