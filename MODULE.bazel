module(name = "synnax")

bazel_dep(name = "abseil-cpp", version = "20260817.0")

# Nothing loads apple_support. It registers the macOS C++ toolchain, which accepts the
# Xcode 27 SDK that the rules_cc default rejects. Other modules bring it in today.
bazel_dep(name = "apple_support", version = "2.12.0")

# The one TLS library. gRPC, curl, and cpp-httplib all use it by default. Later versions
# declare ASN1_STRING_get_length, which curl 8.23.0 also defines.
bazel_dep(name = "boringssl", version = "0.20260929.0")
bazel_dep(name = "boost.uuid", version = "1.90.0.bcr.1")
bazel_dep(name = "cpp-httplib", version = "0.63.0")
bazel_dep(name = "curl", version = "8.23.0")
bazel_dep(name = "google_benchmark", version = "1.10.0")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1")
bazel_dep(name = "gperftools", version = "2.19.1")
bazel_dep(name = "grpc", version = "1.85.1")
bazel_dep(name = "mbedtls", version = "3.6.8")
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "rules_cc", version = "0.2.28")
