module(name = "synnax")

bazel_dep(name = "protobuf", version = "35.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "gflags", version = "2.2.2.bcr.1")
bazel_dep(name = "glog", version = "0.7.1.bcr.1")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "google_benchmark", version = "1.9.5")
bazel_dep(name = "gperftools", version = "2.18.1")
bazel_dep(name = "rules_proto_grpc_cpp", version = "5.8.0")
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.1")
bazel_dep(name = "grpc", version = "1.81.1")
bazel_dep(name = "boost.uuid", version = "1.90.0.bcr.1")
bazel_dep(name = "curl", version = "8.12.0.bcr.1")
bazel_dep(name = "cpp-httplib", version = "0.46.0")
bazel_dep(name = "openssl", version = "3.5.5.bcr.4")

single_version_override(
    module_name = "grpc",
    patch_strip = 1,
    patches = [
        "//patches:grpc-address-sorting-add-load.patch",
        "//patches:grpc-xxhash-add-load.patch",
    ],
)

# Override boringssl (pulled transitively by cpp-httplib) to use openssl instead.
local_path_override(
    module_name = "boringssl",
    path = "vendor/boringssl",
)

bazel_dep(name = "apple_support", version = "1.24.5", dev_dependency = True)

bazel_dep(name = "rules_cc", version = "0.2.20")
bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "rules_rust", version = "0.70.0")

# ESI registry blob from GitHub releases
esi = use_extension("//vendor:esi.bzl", "esi")
use_repo(esi, "esi_registry_blob")
