module(name = "synnax")

bazel_dep(name = "abseil-cpp", version = "20250814.1")
bazel_dep(name = "boost.uuid", version = "1.90.0.bcr.1")
bazel_dep(name = "cpp-httplib", version = "0.46.0")
bazel_dep(name = "curl", version = "8.12.0.bcr.1")
bazel_dep(name = "google_benchmark", version = "1.9.5")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "gperftools", version = "2.18.1")
bazel_dep(name = "grpc", version = "1.83.0")
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "35.1")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_proto_grpc_cpp", version = "5.8.0")

single_version_override(
    module_name = "grpc",
    patch_strip = 1,
    patches = [
        # grpc's TLS targets #include <openssl/ssl.h> while depending only on libssl.
        # Our openssl provider (unlike grpc's native boringssl) does not re-export the
        # public headers from :ssl, so layering_check rejects the include. Disable
        # layering_check on grpc's library macro, matching how grpc builds upstream.
        "//patches:grpc-disable-layering-check.patch",
        # grpc puts its checked-in src/core/ext/{upb-gen,upbdefs-gen} dirs on the
        # include path but no target owns those files, so strict header-inclusion
        # checking (parse_headers, set on the //src/core package) rejects every
        # grpc_cc_library that includes a well-known-type upb header. Declare the
        # checked-in headers as inputs so the inclusion check passes.
        "//patches:grpc-declare-upb-gen-headers.patch",
        "//patches:grpc-add-upb-gen-headers-dep.patch",
    ],
)

# cpp-httplib hard-depends on boringssl while curl (and our HTTP driver through it)
# depends on openssl; linking both into one binary collides their shared OpenSSL-ABI
# symbols. Redirect every boringssl reference to the openssl shim so there is a single
# TLS provider. The shim owns the openssl version; nothing else needs to depend on it.
local_path_override(
    module_name = "boringssl",
    path = "vendor/boringssl",
)

# ESI registry blob from GitHub releases
esi = use_extension("//vendor:esi.bzl", "esi")
use_repo(esi, "esi_registry_blob")
