archive_override(
    module_name = "bazel_clang_tidy",
    integrity = "sha256-ltpuk1zMkQRc+SjbxX8iUIonKcUff7P1YXgBew3rmzw=",
    strip_prefix = "bazel_clang_tidy-c4d35e0d0b838309358e57a2efed831780f85cd0",
    urls = ["https://github.com/erenon/bazel_clang_tidy/archive/c4d35e0d0b838309358e57a2efed831780f85cd0.tar.gz"],
)

# The clang-tidy that --config=clang-tidy runs, from its PyPI wheels. Bazel fetches only
# the host's wheel. Keep the version equal to the clang-format version in
# scripts/install_clang_format.sh.
http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

CLANG_TIDY_BUILD = """
package(default_visibility = ["//visibility:public"])

filegroup(name = "clang_tidy", srcs = ["clang_tidy/data/bin/clang-tidy"])

filegroup(
    name = "clang_apply_replacements",
    srcs = ["clang_tidy/data/bin/clang-apply-replacements"],
)

filegroup(
    name = "resource_dir",
    srcs = glob(["clang_tidy/data/lib/clang/*/include/**"]),
)
"""

http_archive(
    name = "clang_tidy_linux_aarch64",
    build_file_content = CLANG_TIDY_BUILD,
    sha256 = "5639a8e65df6701ac144ee6b9e73aef4bdd3706cdc5849de1a5147c5aeaddf24",
    type = "zip",
    urls = ["https://files.pythonhosted.org/packages/3d/6f/1c50dacbc9ae537e0e40be27fa7b0a56e60dcc0a1fffd0d9b280b1ed6749/clang_tidy-23.1.3-py2.py3-none-manylinux_2_26_aarch64.manylinux_2_28_aarch64.whl"],
)

