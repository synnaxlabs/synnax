    },
    {
        name: "OPC UA",
        kind: "Industrial protocol",
        detail: "Subscribe to server data with its timestamps and source-reported quality. Use supported write interfaces for supervisory commands.",
        Logo: OPCUA,
        width: 120,
        height: 32,
        color: "#81a6d3",
    },
    {
