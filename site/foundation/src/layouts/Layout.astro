import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import geistMonoLatin from "@fontsource/geist-mono/files/geist-mono-latin-400-normal.woff2?url";
import Footer from "@synnaxlabs/site-common/Footer.astro";
import Head from "@synnaxlabs/site-common/Head.astro";
import Header from "@/components/Header.astro";
import "@/styles/main.css";

const title = "Foundation | Synnax";
const description =
    "The industrial data and supervisory control plane. Bridge distributed physical infrastructure with high-level software.";
const canonical = new URL("/", Astro.site).href;
const columns = [
    {
        title: "Foundation",
        links: [
            { label: "How it works", href: "/#system" },
            { label: "Integrations", href: "/#integrations" },
            { label: "Use cases", href: "/#applications" },
            { label: "In the field", href: "/#deployments" },
            { label: "Engineering", href: "/#architecture" },
            { label: "Our principles", href: "/#principles" },
        ],
    },
    {
        title: "Synnax",
        links: [
            { label: "About us", href: "https://www.synnaxlabs.com/company" },
            { label: "Get in touch", href: "/#contact" },
            { label: "Privacy policy", href: "https://www.synnaxlabs.com/privacy" },
            { label: "Terms of service", href: "https://www.synnaxlabs.com/terms" },
        ],
    },
];
---

<!doctype html>
<html lang="en">
    <head>
        <Head
            title={title}
            description={description}
            canonical={canonical}
            siteName="Foundation by Synnax"
        />
        <meta name="theme-color" content="#040506" />
        <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
        <link
            rel="preload"
            href={geistMonoLatin}
            as="font"
            type="font/woff2"
            crossorigin
        />
    </head>
    <body class="foundation-page">
        <a class="skip-link" href="#main">
            Skip to content
        </a>
        <Header />
        <main id="main">
            <slot />
        </main>
        <Footer home="https://www.synnaxlabs.com" columns={columns} />
    </body>
</html>

<style is:global>
    .foundation-page footer .footer-content {
        max-width: calc(var(--max-width) - 2 * var(--content-padding));
    }

    .foundation-page footer .footer-column-header {
        font-size: 11px;
        color: #9daabd;
    }

    .foundation-page footer .footer-link-column a {
        font-size: 14px;
        color: #aeb8c6;
    }

    .foundation-page footer .footer-link-column {
        gap: 16px;
        min-width: 0;
    }

    .foundation-page footer .footer-muted {
        color: #929eaf;
    }

    @media (width <= 800px) {
        .foundation-page footer .footer-main {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 32px 20px;
        }

        .foundation-page footer .footer-link-column:last-child {
            grid-column: 1 / -1;
        }

        .foundation-page footer .footer-bottom-bar {
            align-items: start;
            gap: 28px;
        }

        .foundation-page footer .footer-bottom-right {
            flex-flow: row wrap;
            justify-content: start;
            gap: 20px;
        }

        .foundation-page footer .footer-built-in {
            align-items: start;
        }

        .foundation-page footer .footer-link-column a {
            display: flex;
            align-items: center;
            min-height: 36px;
        }

        .foundation-page footer .footer-link-column {
            gap: 8px;
        }
    }
</style>

<script>
    import { z } from "zod";

    // Zod otherwise probes for eval, which the policy refuses.
    z.config({ jitless: true });
</script>
