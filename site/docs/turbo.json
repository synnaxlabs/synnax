{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "cache": false,
      "inputs": ["src/**", "astro.config.ts", "tsconfig*.json", "package.json"],
      "env": ["DOCS_VERSION"],
      "passThroughEnv": ["DOCS_GITHUB_TOKEN"]
    },
    "lint": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/{lyra,pluto,console,site/*}/src/**",
        "$TURBO_ROOT$/{lyra,pluto,console,site/*}/index.html"
      ]
    }
  }
}
