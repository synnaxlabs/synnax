import Header from "@/components/layout/Header.astro";
import "@/styles/main.css";
import PostHog from "@/components/analytics/PostHog.astro";
import { ClientRouter } from "astro:transitions";
import favicon from "@synnaxlabs/media/static/logo/icon-white-favicon.svg";
import { SEO } from "astro-seo";
import Footer from "@synnaxlabs/site-common/Footer.astro";
import { enabled } from "@/flags";
import { sectionOf } from "@/pages/_nav";
import { normalizeRoute } from "@/util/route";
const {
    frontmatter: { title, description, url, image, flag },
    article,
} = Astro.props;
// A page behind a flag that is off does not exist.
const hidden = flag != null && !enabled(flag);
if (hidden) Astro.response.status = 404;
const DEFAULT_OG_IMAGE =
    "https://synnax.nyc3.cdn.digitaloceanspaces.com/docs/og-default.png";
const ogImage = image || DEFAULT_OG_IMAGE;
// Query strings (the ?client= switcher) and trailing slashes must not split a page
// into duplicates.
const route = normalizeRoute(Astro.url.pathname);
const canonicalUrl = new URL(route, Astro.site).href;
const section = sectionOf(route);
const cleanTitle = title?.replace(/`/g, "");
const pageTitle = cleanTitle && section ? `${cleanTitle} | ${section}` : cleanTitle;
const fullTitle = pageTitle ? `${pageTitle} | Synnax` : "Synnax";

const FOOTER_COLUMNS = [
    {
        title: "Documentation",
        links: [
            { label: "Reference", href: "/reference/" },
            { label: "Concepts", href: "/reference/concepts/overview" },
            { label: "Client libraries", href: "/reference/client/quick-start" },
            { label: "Control", href: "/reference/control/get-started" },
        ],
    },
    {
        title: "Resources",
        links: [
            { label: "Blog", href: "/blog/" },
            { label: "Releases", href: "/releases/" },
            { label: "GitHub", href: "https://github.com/synnaxlabs/synnax" },
        ],
    },
    {
        title: "Company",
        links: [
            { label: "About", href: "https://www.synnaxlabs.com/company" },
            { label: "Contact", href: "https://synnaxlabs.com/#contact" },
            { label: "Privacy policy", href: "/privacy-policy" },
        ],
    },
];
---

<html lang="en">
    <head>
        <PostHog />
        <SEO
            title={pageTitle}
            titleTemplate="%s | Synnax"
            titleDefault="Synnax"
            description={description}
            canonical={canonicalUrl}
            openGraph={{
                basic: {
                    title: fullTitle,
                    type: article == null ? "website" : "article",
                    image: ogImage,
                    url: canonicalUrl,
                },
                optional: {
                    description: description,
                    siteName: "Synnax",
                },
                image: {
                    alt: cleanTitle || "Synnax",
                },
                article,
            }}
            twitter={{
                card: "summary_large_image",
                title: fullTitle,
                description: description,
                image: ogImage,
            }}
            extend={{
                link: [
                    {
                        rel: "icon",
                        href: favicon.src,
                    },
                    {
                        rel: "alternate",
                        type: "application/rss+xml",
                        title: "Synnax blog",
                        href: "/blog/rss.xml",
                    },
                ],
                meta: [
                    {
                        name: "viewport",
                        content: "width=device-width, initial-scale=1.0",
                    },
                ],
            }}
        />
        <ClientRouter />
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
        <slot name="head" />
    </head>
    <body>
        <Header url={url} transition:persist />
        <main>
            {hidden ? (
                <section class="not-found">
                    <h1>Page not found</h1>
                </section>
            ) : (
                <slot />
            )}
        </main>
        <Footer home="https://synnaxlabs.com" columns={FOOTER_COLUMNS} />
    </body>
    <script>
        import { addCodeButtonListeners } from "@/components/code/codeUtil";
        import { startPinningHashTarget } from "@/util/hash";
        import { startUpdatingIframeHref } from "@/util/iframe";
        const bindClickHandlersToHeadingAnchors = () => {
            const anchors =
                document.querySelectorAll<HTMLAnchorElement>(".heading-anchor");
            anchors.forEach((anchor) => {
                if (anchor.previousElementSibling?.classList.contains("no-link"))
                    anchor.style.display = "none";
                anchor.addEventListener("click", () => {
                    const url = window.location.href;
                    const newUrl = url.split("#")[0];
                    const hash = anchor.getAttribute("href");
                    navigator.clipboard.writeText(newUrl + hash);
                });
            });
        };

        addCodeButtonListeners();
        startUpdatingIframeHref();
        bindClickHandlersToHeadingAnchors();
        startPinningHashTarget();
        document.addEventListener("astro:after-swap", () => {
            addCodeButtonListeners();
            startUpdatingIframeHref();
            bindClickHandlersToHeadingAnchors();
        });
    </script>
</html>
