import Header from "@/components/layout/Header.astro";
import Mark from "@/components/platform/Mark.astro";
import Lightbox from "@/components/media/Lightbox.astro";
import "@/styles/main.css";
import Analytics from "@synnaxlabs/site-common/Analytics.astro";
import { ClientRouter } from "astro:transitions";
import Footer from "@synnaxlabs/site-common/Footer.astro";
import Head from "@synnaxlabs/site-common/Head.astro";
import { sectionOf } from "@/components/nav/tree";
import { REFERENCE_PAGES } from "@/pages/_nav";
import { normalizeRoute } from "@/util/route";
import { rootOf } from "@/util/version";
import VersionBanner from "@/components/version/Banner.astro";
import { VERSION } from "@/version";
const {
    frontmatter: { title, heading, description, image },
    article,
} = Astro.props;
// Query strings (the ?client= switcher) and trailing slashes must not split a page
// into duplicates.
const route = normalizeRoute(Astro.url.pathname);
const canonicalUrl = new URL(route, Astro.site).href;
const section = sectionOf(REFERENCE_PAGES, route);
const cleanTitle = title?.replace(/`/g, "");
// An overview page has the name of its section, so the section shows once.
const pageTitle =
    cleanTitle && section && section !== cleanTitle
        ? `${cleanTitle} | ${section}`
        : cleanTitle;
// The home page names the whole site, so its heading is the full title.
const fullTitle =
    route === "/reference" && heading != null
        ? heading
        : pageTitle
          ? `${pageTitle} | Synnax`
          : "Synnax";

// Pages no version owns live on the root, so other versions link there.
const root = rootOf(VERSION);
const FOOTER_COLUMNS = [
    {
        title: "Documentation",
        links: [
            { label: "Reference", href: "/reference/" },
            { label: "Channels", href: "/reference/channels" },
            { label: "Client libraries", href: "/reference/client/quick-start" },
            { label: "Control", href: "/reference/control" },
        ],
    },
    {
        title: "Resources",
        links: [
            { label: "Blog", href: `${root}/blog/` },
            { label: "Releases", href: `${root}/releases/` },
            { label: "Reliability", href: `${root}/reliability/` },
            { label: "GitHub", href: "https://github.com/synnaxlabs/synnax" },
        ],
    },
    {
        title: "Company",
        links: [
            { label: "About", href: "https://www.synnaxlabs.com/company" },
            { label: "Contact", href: "https://synnaxlabs.com/#contact" },
            { label: "Privacy policy", href: `${root}/privacy-policy` },
            { label: "Terms of service", href: `${root}/terms-of-service` },
        ],
    },
];
---

<html lang="en" transition:animate="none">
    <head>
        <Head
            title={fullTitle}
            description={description}
            canonical={canonicalUrl}
            image={image || undefined}
            imageAlt={cleanTitle || "Synnax"}
            article={article}
            unindexed={VERSION != null && VERSION.status !== "latest"}
        />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Synnax blog"
            href={`${root}/blog/rss.xml`}
        />
        <ClientRouter />
        <Mark />
        <slot name="head" />
    </head>
    <body>
        <Header version={VERSION} transition:persist />
        <VersionBanner version={VERSION} />
        <slot name="subheader" />
        <main>
            <slot />
        </main>
        <Footer home="https://synnaxlabs.com" columns={FOOTER_COLUMNS} />
        <Lightbox />
        <Analytics privacy={`${root}/privacy-policy`} />
    </body>
    <script>
        import { QUERY as CLIENT_QUERY } from "@/components/client/choice";
        import { addCodeButtonListeners } from "@/components/code/codeUtil";
        import { start as startLightbox } from "@/components/media/lightbox";
        import { start as startVideos } from "@/components/media/video";
        import { start as startCollapse } from "@/components/nav/collapse";
        import { start as startOnThisPage } from "@/components/nav/onThisPage";
        import { start as startSidebar } from "@/components/nav/sidebar";
        import { QUERY as PLATFORM_QUERY } from "@/components/platform/choice";
        import { start as startTabs } from "@/components/tabs/sync";
        import { startPinningHashTarget } from "@/util/hash";
        import { startUpdatingIframeHref } from "@/util/iframe";
        import { onDemand } from "@/util/island";

        startSidebar();
        startCollapse();
        startVideos();
        startLightbox();
        // Before the tabs, so the outline hears the first tab change.
        startOnThisPage();
        startTabs({ client: CLIENT_QUERY, platform: PLATFORM_QUERY, context: {} });
        onDemand({
            selector: '[data-island="search"]',
            load: () => import("@/components/search/mount"),
            hotkey: (e) => (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k",
        });
        onDemand({
            selector: '[data-island="feedback"]',
            load: () => import("@/components/feedback/mount"),
        });
        const bindClickHandlersToHeadingAnchors = () => {
            const anchors =
                document.querySelectorAll<HTMLAnchorElement>(".heading-anchor");
            anchors.forEach((anchor) => {
                if (anchor.previousElementSibling?.classList.contains("no-link"))
                    anchor.style.display = "none";
                anchor.addEventListener("click", () => {
                    const url = window.location.href;
                    const newUrl = url.split("#")[0];
                    const hash = anchor.getAttribute("href");
                    navigator.clipboard.writeText(newUrl + hash);
                });
            });
        };

        addCodeButtonListeners();
        startUpdatingIframeHref();
        bindClickHandlersToHeadingAnchors();
        startPinningHashTarget();
        document.addEventListener("astro:after-swap", () => {
            addCodeButtonListeners();
            startUpdatingIframeHref();
            bindClickHandlersToHeadingAnchors();
        });
    </script>
</html>
