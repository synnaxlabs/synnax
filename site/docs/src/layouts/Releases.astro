import type { MarkdownHeading } from "astro";
import { getCollection, render } from "astro:content";
import { semver } from "@synnaxlabs/x";
import { Divider } from "@synnaxlabs/lyra/divider";

import OutlineBar from "@/components/nav/OutlineBar.astro";
import Root from "@/layouts/Root.astro";
import { Flex } from "@synnaxlabs/lyra/flex";
import IndexHero from "@/components/hero/Index.astro";
import ReleasesArtwork from "@/components/hero/ReleasesArtwork.astro";
import { Releases as ReleasesComponents } from "@/components/releases";
import { NOTES_PAGE, shippedOn } from "@/util/releaseNotes";

const entries = (await getCollection("releases")).sort((a, b) =>
    semver.compare(b.data.version, a.data.version),
);
const notes = await Promise.all(
    entries.map(async (entry) => {
        const text = entry.data.version.split(".").slice(0, 2).join(".");
        const { Content } = await render(entry);
        const date = await shippedOn(Astro.locals.releases, entry.data);
        return {
            data: entry.data,
            Content,
            slug: text.replaceAll(".", ""),
            text,
            date,
        };
    }),
);
const headings: MarkdownHeading[] = notes.map(({ slug, text }) => ({
    depth: 6,
    slug,
    text,
}));
---

<Root frontmatter={{ title: "Releases", description: NOTES_PAGE.description }}>
    <OutlineBar slot="subheader" headings={headings} select="article h6" />
    <section>
        <Flex.Box direction="y" className="releases" el="article" grow>
            <IndexHero
                title="Releases"
                description="Latest updates and improvements to Synnax."
            >
                <ReleasesArtwork slot="art" />
                <a href="https://www.linkedin.com/company/synnaxlabs/">
                    Follow us on LinkedIn
                </a>
                <a href="https://github.com/synnaxlabs/synnax/releases">
                    View releases on GitHub
                </a>
            </IndexHero>
            {notes.map(({ data, Content, slug, text }, i) => (
                <>
                    {i > 0 && <Divider.Divider x />}
                    <div class="release-wrapper">
                        <h6 id={slug}>{text}</h6>
                        <ReleasesComponents.Release {...data}>
                            <Content />
                        </ReleasesComponents.Release>
                    </div>
                </>
            ))}
        </Flex.Box>
        <ReleasesComponents.List releases={notes} />
    </section>
</Root>

<style is:global>
    main:has(.releases) {
        overflow-x: clip;
    }

    main > section:has(.releases) {
        max-width: 1400px;
        overflow: visible;
    }

    .releases {
        flex: 1 1 840px;
        min-width: 0;
        padding: 5rem 8rem;

        @media (width <= 800px) {
            padding-inline: 2rem;
        }

        & .release-wrapper {
            position: relative;
        }

        & h6 {
            position: absolute;
            width: 100%;
            height: 100%;
            opacity: 0;
            margin: 0 !important;
        }

        & video:not(.docs-hero video),
        img:not(.diagram img, .docs-hero img) {
            width: 100%;
            border-radius: 1.5rem !important;
            border: var(--pluto-border);
            margin: 3rem 0;
            box-shadow: var(--pluto-shadow-v1);

            @media (prefers-color-scheme: dark) {
                box-shadow: 0 0 2rem 0 rgb(50 50 50 / 10%);
            }
        }
    }
</style>
