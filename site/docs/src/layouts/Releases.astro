import type { MarkdownHeading } from "astro";

import OutlineBar from "@/components/nav/OutlineBar.astro";
import Root from "@/layouts/Root.astro";
import { Flex } from "@synnaxlabs/lyra/flex";
import IndexHero from "@/components/hero/Index.astro";
import ReleasesArtwork from "@/components/hero/ReleasesArtwork.astro";
import { Releases as ReleasesComponents } from "@/components/releases";
const { headings, frontmatter } = Astro.props;
---

<Root frontmatter={{ title: "Releases", description: frontmatter.description }}>
    <OutlineBar
        slot="subheader"
        headings={headings.filter(({ depth }: MarkdownHeading) => depth === 6)}
        select="article h6"
    />
    <section>
        <Flex.Box direction="y" className="releases" el="article" grow>
            <IndexHero
                title="Releases"
                description="Latest updates and improvements to Synnax."
            >
                <ReleasesArtwork slot="art" />
                <a href="https://www.linkedin.com/company/synnaxlabs/">
                    Follow us on LinkedIn
                </a>
                <a href="https://github.com/synnaxlabs/synnax/releases">
                    View releases on GitHub
                </a>
            </IndexHero>
            <slot />
        </Flex.Box>
        <ReleasesComponents.List headings={headings} />
    </section>
</Root>

<style is:global>
    main:has(.releases) {
        overflow-x: clip;
    }

    main > section:has(.releases) {
        max-width: 1400px;
        overflow: visible;
    }

    .releases {
        flex: 1 1 840px;
        min-width: 0;
        padding: 5rem 8rem;

        @media (width <= 800px) {
            padding-inline: 2rem;
        }

        & .release-wrapper {
            position: relative;
        }

        & h6 {
            position: absolute;
            width: 100%;
            height: 100%;
            opacity: 0;
            margin: 0 !important;
        }

        & video:not(.docs-hero video),
        img:not(.diagram img, .docs-hero img) {
            width: 100%;
            border-radius: 1.5rem !important;
            border: var(--pluto-border);
            margin: 3rem 0;
            box-shadow: var(--pluto-shadow-v1);

            @media (prefers-color-scheme: dark) {
                box-shadow: 0 0 2rem 0 rgb(50 50 50 / 10%);
            }
        }
    }
</style>
