// Local review only. Public presentation and logo use require partner approval.
import Blog from "@/layouts/Blog.astro";
import Artwork from "@/components/scratch/partnership/Artwork.astro";
import { announcement } from "@/components/scratch/partnership/content";

export const prerender = false;
if (!import.meta.env.DEV) return new Response("Not found", { status: 404 });
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow, noarchive");
const frontmatter = {
    title: "Welcoming Rigetti Computing",
    description: announcement[0],
    outline: false,
};
---

<Blog frontmatter={frontmatter} headings={[]}>
    <div class="partnership-post-art">
        <Artwork direction="instrument" id="partnership-post-hero" />
    </div>
    {announcement.slice(1).map((paragraph) => (
        <p>{paragraph}</p>
    ))}
</Blog>

<style>
    .partnership-post-art {
        margin: 4rem 0 5rem;
    }

    @media (width > 1100px) {
        .partnership-post-art {
            width: calc(100% + 10rem);
            margin-inline: -5rem;
        }
    }
</style>
