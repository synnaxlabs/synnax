import Root from "@/layouts/Root.astro";
import { Flex } from "@synnaxlabs/lyra/flex";
import IndexHero from "@/components/hero/Index.astro";
import BlogArtwork from "@/components/hero/BlogArtwork.astro";
import OneBillionRowsTile from "@/components/blog/OneBillionRowsTile.astro";
import ArcTile from "@/components/blog/ArcTile.astro";
import DesktopTile from "@/components/blog/DesktopTile.astro";
---

<Root
    frontmatter={{
        title: "Blog",
        description:
            "Articles from the Synnax team on hardware control, data acquisition, and time-series performance.",
    }}
>
    <section>
        <Flex.Box direction="y" className="blog" el="article" grow>
            <IndexHero
                title="Blog"
                description="Articles and insights from the Synnax team."
            >
                <BlogArtwork slot="art" />
            </IndexHero>
            <Flex.Box direction="y" className="blog-entries" gap={6}>
                <DesktopTile />
                <ArcTile />
                <OneBillionRowsTile />
            </Flex.Box>
        </Flex.Box>
    </section>
</Root>

<style is:global>
    main:has(.blog) {
        overflow-x: clip;
    }

    main > section:has(.blog) {
        max-width: 1150px;
        overflow: visible;
    }

    .blog {
        flex: 1 1 840px;
        min-width: 0;
        padding: 5rem 8rem;
    }

    .blog-entries {
        padding-top: 3rem;
        padding-bottom: 20rem;
    }

    a.blog-entry {
        text-decoration: none !important;
    }

    @media (width <= 800px) {
        .blog {
            padding: 3rem;
        }
    }
</style>
