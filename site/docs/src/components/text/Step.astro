import { Text } from "@synnaxlabs/lyra/text";

export interface StepTextProps extends Text.TextProps {
    step: string | number;
}

const { step, level, name = "Step", ...rest } = Astro.props;
---

<Text.Text className="no-link" el="span" level={level} {...rest}>
    <span class="step-label">{`${name} ${step}`}</span>
    <slot />
</Text.Text>

<style is:global>
    /* A step heading carries its number as an eyebrow, so the numbered lists inside the
       step keep the only step markers. */
    .lyra-text:has(> .step-label) {
        flex-wrap: wrap;
        color: inherit;
    }

    .step-label {
        flex-basis: 100%;
        margin-bottom: 0.5rem;
        font:
            500 14px/20px "Geist Mono",
            monospace;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--pluto-gray-l8);
    }
</style>
