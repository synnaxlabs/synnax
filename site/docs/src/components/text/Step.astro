import { Icon } from "@synnaxlabs/lyra/icon";
import { Text } from "@synnaxlabs/lyra/text";
export interface StepTextProps extends Text.TextProps {
    step: string | number;
}
const { step, level, name = "Step", ...rest } = Astro.props;
// A step always sits inside a Markdown heading, so it renders a span, not a heading.
---

<Text.Text className="no-link" el="span" level={level} {...rest}>
    <span
        style={{
            color: "var(--pluto-gray-l8)",
            display: "inline-flex",
            alignItems: "center",
        }}
    >
        {`${name} ${step}`}
        <Icon.Arrow.Right style={{ margin: "0 1rem" }} />{" "}
    </span>
    <slot />
</Text.Text>
