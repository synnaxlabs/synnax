import "@synnaxlabs/lyra/dist/tooltip/Frame.css";

import { Button } from "@synnaxlabs/lyra/button";
import { Icon } from "@synnaxlabs/lyra/icon";
import { Text } from "@synnaxlabs/lyra/text";

import { Keys } from "@/components/keys/Keys";
import { SHORTCUT } from "@/components/nav/collapse";
import { Page as P } from "@/components/nav/Page";
import { REFERENCE_PAGES } from "@/pages/_nav";

const TREE_ID = "page-nav-tree";
---

<nav class="page-nav" transition:persist>
    <div class="page-nav__panel">
        <div class="page-nav__header">
            <Button.Button
                variant="text"
                size="small"
                className="page-nav__toggle"
                aria-label="Collapse sidebar"
                aria-expanded="true"
                aria-controls={TREE_ID}
                data-page-nav-toggle
            >
                <Icon.Sidebar />
            </Button.Button>
        </div>
        <P id={TREE_ID} nodes={REFERENCE_PAGES} currentPage={Astro.url.pathname} />
    </div>
    <div
        class="lyra-tooltip page-nav__tooltip"
        role="tooltip"
        id="page-nav-tooltip"
        hidden
    >
        <Text.Text level="small" color={11}>
            <span data-tooltip-label></span>
            <Keys trigger={["Control", SHORTCUT]} level="small" data-tooltip-keys />
        </Text.Text>
    </div>
</nav>

<style is:global>
    /* Lyra's flex display would otherwise override the hidden attribute. */
    .reference-tree [role="treeitem"][hidden] {
        display: none;
    }
</style>
