import type { MarkdownHeading } from "astro";
import { Divider } from "@synnaxlabs/lyra/divider";
import { Flex } from "@synnaxlabs/lyra/flex";
import { Icon } from "@synnaxlabs/lyra/icon";
import { Text } from "@synnaxlabs/lyra/text";
import { type Client } from "@/components/client/choice";
import { INFO as CLIENTS } from "@/components/client/Client";
import Feedback from "@/components/feedback/Feedback.astro";
import Outline from "@/components/nav/Outline.astro";
import { type Platform } from "@/components/platform/choice";
import { INFO as PLATFORMS } from "@/components/platform/Platform";
import { Picker } from "@/components/tabs/Picker";
import { type Entry, outlined } from "@/util/outline";

interface Props {
    headings?: MarkdownHeading[];
    /** Restores the inline code and step labels the heading list drops. */
    outline?: Record<string, Entry>;
    clients?: Client[];
    platforms?: Platform[];
    hideFeedback?: boolean;
}

const {
    headings = [],
    outline = {},
    clients = [],
    platforms = [],
    hideFeedback = false,
} = Astro.props;
const shown = outlined(headings);
const hasHeadings = shown.length > 0;
---

<Flex.Box el="nav" className="on-this-page" gap="medium">
    {hasHeadings && (
        <Flex.Box direction="y" gap={2} className="on-this-page__header">
            <Text.Text level="small" weight={500} color={8}>
                <Icon.Log />
                On this page
            </Text.Text>
        </Flex.Box>
    )}
    {hasHeadings && (
        <Flex.Box
            direction="y"
            gap={2}
            className="on-this-page__content styled-scrollbar"
        >
            {platforms.length > 0 && (
                <Picker
                    query="platform"
                    options={PLATFORMS.filter(({ key }) => platforms.includes(key))}
                />
            )}
            {clients.length > 0 && (
                <Picker
                    query="client"
                    options={CLIENTS.filter(({ key }) => clients.includes(key))}
                />
            )}
            <Outline headings={shown} outline={outline} />
        </Flex.Box>
    )}
    {!hideFeedback && (
        <Flex.Box direction="y" gap={2}>
            {hasHeadings && <Divider.Divider direction="x" />}
            <Flex.Box direction="x" justify="end">
                <Feedback />
            </Flex.Box>
        </Flex.Box>
    )}
    <slot />
</Flex.Box>

<style is:global>
    nav.on-this-page {
        position: sticky;
        top: calc(var(--nav-height) + 7rem);
        width: 235px;
        align-self: flex-start;
        max-height: calc(100vh - var(--nav-height) - 11rem);
        margin-bottom: 10rem;

        .on-this-page__header {
            flex-shrink: 0;
        }

        .on-this-page__content {
            flex: 1;
            min-height: 0;
            overflow-x: hidden;
            overflow-y: auto;
            padding-top: 2rem;
            padding-bottom: 2rem;
            mask-image: linear-gradient(
                to bottom,
                transparent 0,
                black 2rem,
                black calc(100% - 2rem),
                transparent 100%
            );
            -webkit-mask-image: linear-gradient(
                to bottom,
                transparent 0,
                black 2rem,
                black calc(100% - 2rem),
                transparent 100%
            );
        }

        .pluto-dialog {
            margin-bottom: 1rem;
        }

        flex-shrink: 0;
    }
</style>
