import Artwork from "./Artwork.astro";
import type { Direction } from "./content";

interface Props {
    direction: Direction;
    id: string;
}

const { direction, id } = Astro.props;
---

<figure class="rigetti-figure">
    <Artwork direction={direction} id={id} />
</figure>

<style>
    /* The frame clips the corners of the artwork. */
    .rigetti-figure {
        margin: 5rem 0 var(--docs-block-gap);
        border: var(--pluto-border);
        border-radius: 1.5rem;
        box-shadow: var(--pluto-shadow-v1);
        overflow: hidden;

        @media (prefers-color-scheme: dark) {
            box-shadow: none;
        }

        & :global(.partnership-art) {
            border-radius: 0;
        }
    }
</style>
