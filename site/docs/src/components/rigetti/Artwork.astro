import Cryostat from "./Cryostat.astro";
import type { Direction } from "./content";

interface Props {
    direction: Direction;
    id: string;
    compact?: boolean;
}
const { direction, id, compact = false } = Astro.props;
---

<div
    class:list={["partnership-art", direction, { compact }]}
    role="img"
    aria-label={
        direction === "instrument"
            ? "Synnax and Rigetti Computing. A conceptual dilution refrigerator with suspended plates, cables, and blue and teal accents."
            : "Between experiments: the fridge warms from operating temperature to room temperature for a processor change, then cools back down. Experiments are paused throughout this interval and resume at operating temperature. Schematic, not to scale."
    }
>
    {direction === "instrument" && (
        <div class="art-topline" aria-hidden="true">
            <span>
                SYNNAX <span class="topline-separator">/</span> PARTNERSHIPS
            </span>
            <span>QUANTUM COMPUTING</span>
        </div>
    )}

    {direction === "instrument" && (
        <>
            <div class="instrument-grid" aria-hidden="true" />
            <div class="art-title" aria-hidden="true">
                <span>Synnax</span>
                <span class="join">×</span>
                <span>
                    Rigetti
                    <br />
                    Computing
                </span>
            </div>
            <div class="cryostat">
                <Cryostat id={`${id}-cryostat`} compact={compact} />
            </div>
            <div class="instrument-caption" aria-hidden="true">
                <span class="caption-rule" />
                QUANTUM PROCESSOR TESTING
            </div>
        </>
    )}

    {direction === "cycle" && (
        <div class="cycle-diagram" aria-hidden="true">
            <div class="cycle-heading">
                <span class="cycle-title">Between experiments</span>
                <span class="cycle-note">Rigetti × Synnax</span>
            </div>
            <div class="cycle-chart">
                <div class="cycle-stages">
                    <span class="cycle-stage">
                        <span class="cycle-number">1</span>
                    </span>
                    <span class="cycle-stage">
                        <span class="cycle-number">2</span>
                    </span>
                    <span class="cycle-stage">
                        <span class="cycle-number">3</span>
                    </span>
                </div>
                <div class="cycle-temperatures">
                    <span>
                        Room
                        <br />
                        temperature
                    </span>
                    <span>
                        Operating
                        <br />
                        temperature
                    </span>
                </div>
                <svg
                    class="cycle-profile"
                    viewBox="0 0 500 160"
                    preserveAspectRatio="none"
                    fill="none"
                >
                    <defs>
                        <linearGradient id={`${id}-guide-fade`} x2="0" y2="1">
                            <stop stop-color="white" />
                            <stop offset="1" stop-color="white" stop-opacity="0" />
                        </linearGradient>
                        <mask id={`${id}-guides`}>
                            <rect
                                width="500"
                                height="160"
                                fill={`url(#${id}-guide-fade)`}
                            />
                        </mask>
                    </defs>
                    <path class="cycle-guides" d="M 0 20 H 500 M 0 140 H 500" />
                    <path
                        class="cycle-boundaries"
                        mask={`url(#${id}-guides)`}
                        d="M 100 0 V 160 M 200 0 V 160 M 300 0 V 160 M 400 0 V 160"
                    />
                    <path
                        class="cycle-transition"
                        d="M 100 140 C 140 140 150 20 200 20 H 300 C 350 20 360 140 400 140"
                    />
                    <path class="cycle-running" d="M 0 140 H 100 M 400 140 H 500" />
                </svg>
                <span class="cycle-track-label">Experiments</span>
                <div class="cycle-availability">
                    <span class="cycle-active">Running</span>
                    <span class="cycle-paused">
                        <span>Paused</span>
                    </span>
                    <span class="cycle-active">Running</span>
                </div>
            </div>
            <div class="cycle-key">
                <div>
                    <span class="cycle-number">1</span>
                    <span class="cycle-step">Warmup</span>
                    <span class="cycle-detail">To room temperature</span>
                </div>
                <div>
                    <span class="cycle-number">2</span>
                    <span class="cycle-step">Change processor</span>
                    <span class="cycle-detail">At room temperature</span>
                </div>
                <div>
                    <span class="cycle-number">3</span>
                    <span class="cycle-step">Cool down</span>
                    <span class="cycle-detail">To operating temperature</span>
                </div>
            </div>
        </div>
    )}
</div>

<style>
    .partnership-art {
        container-type: inline-size;
        position: relative;
        isolation: isolate;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        color: light-dark(#202c3d, #e0e7ef);
        background: light-dark(#eff2f5, #10171f);
        font-family: var(--pluto-font-family);
        border-radius: 12px;
    }

    .art-topline {
        position: absolute;
        inset: 5.8% 5.2% auto;
        display: flex;
        justify-content: space-between;
        gap: 16px;
        z-index: 3;
        font: 400 0.85cqw / 1.5 var(--pluto-code-font-family);
        letter-spacing: 0.095em;
        color: light-dark(#5b6575, #99a8b8);
    }

    .topline-separator {
        margin: 0 1.2cqw;
        opacity: 0.45;
    }

    .art-title {
        position: absolute;
        z-index: 2;
        font-size: 5.3cqw;
        line-height: 1.08;
        font-weight: 450;
        letter-spacing: -0.055em;
    }

    .instrument .art-title {
        top: 26%;
        left: 7%;
        display: flex;
        flex-direction: column;
    }

    .join {
        font-size: 3cqw;
        font-weight: 250;
        color: light-dark(#7b8a9c, #70859a);
        padding: 1.6cqw 0 1.9cqw;
    }

    .instrument-grid {
        position: absolute;
        inset: 14% 5.2% 13% 49%;
        background-image:
            linear-gradient(light-dark(#526d8710, #9aaec00b) 1px, transparent 1px),
            linear-gradient(
                90deg,
                light-dark(#526d8710, #9aaec00b) 1px,
                transparent 1px
            );
        background-size: 4.2cqw 4.2cqw;
        mask-image: linear-gradient(
            to bottom,
            transparent,
            black 15%,
            black 80%,
            transparent
        );
    }

    .cryostat {
        position: absolute;
        inset: 10% 3% 1% 40%;
    }

    .cryostat :global(svg) {
        display: block;
        width: 100%;
        height: 100%;
    }

    .instrument-caption {
        position: absolute;
        bottom: 7%;
        left: 7%;
        display: flex;
        align-items: center;
        gap: 1.2cqw;
        font: 400 0.84cqw / 1.5 var(--pluto-code-font-family);
        letter-spacing: 0.06em;
        color: light-dark(#647184, #93a3b2);
    }

    .caption-rule {
        width: 2.7cqw;
        height: 1px;
        background: #3774d0;
    }

    .cycle {
        aspect-ratio: auto;
        color: var(--pluto-text-color);
        background: var(--pluto-gray-l0);
    }

    .cycle-diagram {
        padding: 28px 28px 26px;
    }

    .cycle-heading {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 28px;
    }

    .cycle-title {
        font-size: 16px;
        font-weight: 500;
        letter-spacing: -0.015em;
    }

    .cycle-note {
        color: var(--pluto-gray-l8);
        font: 11px / 1.4 var(--pluto-font-family);
    }

    .cycle-chart {
        display: grid;
        grid-template-columns: 100px minmax(0, 1fr);
        grid-template-rows: 28px 140px 42px;
    }

    .cycle-stages,
    .cycle-availability {
        grid-column: 2;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .cycle-stages {
        grid-row: 1;
        grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .cycle-stage:first-child {
        grid-column: 2;
    }

    .cycle-stage:nth-child(2) {
        grid-column: 3;
    }

    .cycle-stage:nth-child(3) {
        grid-column: 4;
    }

    .cycle-stage .cycle-number {
        transform: translateX(-50%);
    }

    .cycle-number {
        display: grid;
        place-items: center;
        width: 20px;
        height: 20px;
        border: 1px solid var(--pluto-gray-l3);
        border-radius: 5px;
        background: var(--pluto-gray-l2);
        color: var(--pluto-gray-l9);
        font: 500 11px / 1 var(--pluto-code-font-family);
    }

    .cycle-temperatures {
        grid-column: 1;
        grid-row: 2;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 0 12px 0 0;
        color: var(--pluto-gray-l8);
        font-size: 12px;
        line-height: 1.4;
    }

    .cycle-profile {
        grid-column: 2;
        grid-row: 2;
        display: block;
        width: 100%;
        height: 100%;
    }

    .cycle-profile path {
        vector-effect: non-scaling-stroke;
    }

    .cycle-guides {
        stroke: var(--pluto-gray-l3);
        stroke-dasharray: 1 4;
    }

    .cycle-boundaries {
        stroke: var(--pluto-gray-l4);
    }

    .cycle-transition {
        stroke: var(--pluto-gray-l9);
        stroke-width: 1.75;
    }

    .cycle-running {
        stroke: var(--pluto-gray-l9);
        stroke-width: 1.75;
    }

    .cycle-track-label {
        grid-row: 3;
        align-self: center;
        color: var(--pluto-gray-l10);
        font-size: 12px;
        font-weight: 500;
    }

    .cycle-availability {
        grid-row: 3;
        align-items: center;
        gap: 0 6px;
        font: 500 11px / 1 var(--pluto-code-font-family);
    }

    .cycle-availability > span {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 30px;
        border-radius: 6px;
    }

    .cycle-active {
        color: var(--pluto-primary-z);
        background: linear-gradient(
            to bottom,
            color-mix(in srgb, var(--pluto-primary-z) 16%, var(--pluto-gray-l0)),
            color-mix(in srgb, var(--pluto-primary-z) 7%, var(--pluto-gray-l0))
        );
        box-shadow:
            inset 0 0 0 1px var(--pluto-primary-z-50),
            inset 0 1px 0 var(--pluto-gray-l0-50);
    }

    .cycle-paused {
        grid-column: span 3;
        color: var(--pluto-gray-l8);
        background: repeating-linear-gradient(
            -45deg,
            var(--pluto-gray-l3) 0 1px,
            transparent 1px 6px
        );
        box-shadow: inset 0 0 0 1px var(--pluto-gray-l4);
    }

    .cycle-paused > span {
        padding: 3px 8px;
        background: var(--pluto-gray-l0);
        border-radius: 3px;
    }

    .cycle-key {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-top: 22px;
        padding-top: 22px;
        border-top: 1px solid var(--pluto-gray-l3);
    }

    .cycle-key > div {
        display: grid;
        grid-template-columns: 20px minmax(0, 1fr);
        gap: 4px 10px;
        align-content: start;
    }

    .cycle-key .cycle-number {
        grid-row: span 2;
    }

    .cycle-step {
        color: var(--pluto-gray-l11);
        font-size: 13px;
        line-height: 20px;
        font-weight: 500;
    }

    .cycle-detail {
        color: var(--pluto-gray-l8);
        font-size: 12px;
        line-height: 1.4;
    }

    @container (width < 520px) {
        .cycle-diagram {
            padding: 20px 14px;
        }

        .cycle-heading {
            flex-direction: column;
            gap: 6px;
            margin-bottom: 24px;
        }

        .cycle-chart {
            grid-template-columns: 72px minmax(0, 1fr);
        }

        .cycle-availability {
            gap: 0 4px;
            font: 500 10px / 1 var(--pluto-font-family);
        }

        .cycle-track-label {
            font-size: 11px;
        }

        .cycle-temperatures {
            font-size: 10px;
        }

        .cycle-key {
            grid-template-columns: minmax(0, 1fr);
            gap: 16px;
        }

        .cycle-key > div {
            gap: 0 10px;
        }
    }

    .compact .art-topline,
    .compact .instrument-caption {
        display: none;
    }

    .compact .art-title {
        font-size: 6.6cqw;
    }

    .compact.instrument .art-title {
        top: 18%;
    }
</style>
