import { type ComponentType } from "react";

import Icon from "@/components/part/Icon.astro";

interface Props {
    /** The icon of the part's block in the diagram. */
    icon: ComponentType;
}

const { icon } = Astro.props;
---

<li class="part-item">
    <span class="part-item__head">
        <Icon icon={icon} />
    </span>
    <div class="part-item__body">
        <slot />
    </div>
</li>

<style>
    .part-item__head {
        display: flex;
        align-items: center;
    }

    .part-item__body {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        min-width: 0;

        & > :global(*) {
            margin: 0;
        }
    }

    /* On a phone, the icon sits beside the title and the text takes the full width. */
    @media (width <= 600px) {
        .part-item {
            display: grid;
            grid-template-columns: 6rem minmax(0, 1fr);
            gap: 2rem 3rem;
            align-items: center;
        }

        .part-item__body {
            display: contents;

            & > :global(*) {
                grid-column: 1 / -1;
            }

            & > :global(h3:first-child) {
                grid-column: 2;
            }
        }
    }
</style>
