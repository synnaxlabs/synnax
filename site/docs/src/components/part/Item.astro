import { type ComponentType } from "react";

interface Props {
    /** The icon of the part's block in the diagram. */
    icon: ComponentType;
}

const { icon: Icon } = Astro.props;
---

<li class="part-item">
    <span class="part-item__head">
        <span class="part-item__icon">
            <Icon />
        </span>
    </span>
    <div class="part-item__body">
        <slot />
    </div>
</li>

<style is:global>
    article .part-item__head {
        display: flex;
        align-items: center;
    }

    /* The icon chip of a block in `Diagram.Block`. */
    article .part-item__icon {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        width: 6rem;
        height: 6rem;
        border: var(--pluto-border-width) solid var(--pluto-primary-p1);
        border-radius: 1rem;
        background: var(--pluto-primary-z-20);
        color: var(--pluto-primary-p1);

        & svg {
            width: 3rem;
            height: 3rem;
        }
    }

    article .part-item__body {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        min-width: 0;

        & > * {
            margin: 0;
        }
    }

    /* On a phone, the icon sits beside the title and the text takes the full width. */
    @media (width <= 600px) {
        article :is(.part-flow, .part-list) > li.part-item {
            display: grid;
            grid-template-columns: 6rem minmax(0, 1fr);
            gap: 2rem 3rem;
            align-items: center;

            & .part-item__body {
                display: contents;
            }

            & .part-item__body > * {
                grid-column: 1 / -1;
            }

            & .part-item__body > h3:first-child {
                grid-column: 2;
                margin: 0;
            }
        }
    }
</style>
