import { Button } from "@synnaxlabs/lyra/button";
import { Icon } from "@synnaxlabs/lyra/icon";

const {
    tabindex,
    variant,
    wrap = false,
    hideCopyButton = false,
    ...rest
} = Astro.props;
let className = "astro-code-wrapper";
if (variant != null) className += ` ${variant}`;
if (wrap) className += " wrap";
---

<div class={className} tabindex={tabindex}>
    {!hideCopyButton && (
        <Button.Button variant="outlined" size="medium" square aria-label="Copy code">
            <>
                <Icon.Copy className="copy" />
                <Icon.Check className="check" />
            </>
        </Button.Button>
    )}
    <pre {...rest} class="styled-scrollbar"><slot /></pre>
</div>

<style is:global>
    .error > .astro-code-wrapper {
        .astro-code {
            border: 1px solid var(--pluto-error-z);
            background-color: var(--pluto-error-z-15) !important;
        }

        button {
            display: none;
        }
    }

    .warning > .astro-code-wrapper {
        .astro-code {
            border: 1px solid var(--pluto-warning-z);
            background-color: var(--pluto-warning-z-15) !important;
        }

        button {
            display: none;
        }
    }

    .astro-code-wrapper {
        position: relative;

        &.wrap {
            /* make sure the code block doesn't overflow the container */
            overflow-x: hidden;
        }

        /* Pinned, so a block in a list item does not take the item's text metrics. At
           13px, a line of 88 characters, the width Prettier formats to, fits the
           column. */
        pre {
            margin: 0;
            font-size: var(--pluto-tiny-size);
            line-height: 1.5;
        }

        margin: 5rem 0 var(--docs-block-gap);

        button {
            opacity: 0;
            position: absolute;
            right: 2.3rem;
            top: 2.3rem;
            transition: opacity 0.2s ease-in-out;
            z-index: 2;

            & .lyra-icon {
                width: 1em !important;
                height: 1em !important;
            }

            .check {
                display: none;
            }
        }

        &:hover button,
        & button:focus-visible {
            opacity: 1;
        }

        .astro-code {
            padding: var(--docs-block-padding);
            position: relative;
            border: var(--pluto-border);
            border-radius: 1rem;
            overflow: auto visible !important;

            /* Chrome/Safari/Edge */
            &::-webkit-scrollbar {
                height: 0.75rem;
            }

            &::-webkit-scrollbar-track {
                background: transparent;
            }

            &::-webkit-scrollbar-thumb {
                background-color: var(--pluto-gray-l4);
                border-radius: 0.5rem;
            }

            &::-webkit-scrollbar-thumb:hover {
                background-color: var(--pluto-gray-l5);
            }
        }
    }

    table .astro-code-wrapper {
        margin: 0;

        .astro-code {
            padding: 0.5rem 1rem;
            border-radius: var(--pluto-border-radius);
        }

        button {
            display: none;
        }
    }

    /* In a pane, a code block is a band across the full pane, split from the prose by
       hairlines, and its code lines up with the prose. */
    article :is(.lyra-tabs__content, .docs-details > .content) > .astro-code-wrapper {
        --band: var(--docs-block-padding);

        margin: var(--band) calc(-1 * var(--band));

        .astro-code {
            border: none;
            border-block: 1px solid var(--pluto-gray-l3);
            border-radius: 0;
        }

        &:first-child {
            margin-top: calc(-1 * var(--band));

            .astro-code {
                border-top: none;
            }
        }

        &:last-child {
            margin-bottom: calc(-1 * var(--band));

            .astro-code {
                border-bottom: none;
            }
        }
    }

    article
        :is(.lyra-tabs__content, .docs-details > .content)
        > p:has(+ .astro-code-wrapper) {
        margin-bottom: 0;
    }

    /* A lead-in sentence or a heading owns the gap to the code block under it. */
    p:has(+ .astro-code-wrapper) {
        margin-bottom: 2rem;
    }

    p + .astro-code-wrapper,
    .lyra-note + .astro-code-wrapper,
    :is(h2, h3, h4, h5, h6) + .astro-code-wrapper {
        margin-top: 0;
    }
</style>
