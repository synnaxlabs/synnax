import Code from "astro/components/Code.astro";
import { grammar as arcGrammar } from "@synnaxlabs/arc";
import { theme } from "@synnaxlabs/site-common/shiki";

import { kinds } from "@/components/arc/diagnostic";
import { Problem } from "@/components/problem";
import { InlineCode } from "@/components/text/InlineCode";

interface Props {
    /** The first digit of the codes to list. */
    band: number;
}
---

<Problem.List>
    {kinds(Astro.props.band).map(({ code, severity, message, problem, example }) =>
        message === "" ? (
            <Problem.Item code={code} severity={severity} symptom={problem} />
        ) : (
            <Problem.Item code={code} severity={severity} message={message}>
                <Problem.Cause>
                    <InlineCode text={problem} />
                </Problem.Cause>
                <Problem.Example>
                    <Code code={example} lang={arcGrammar} theme={theme} />
                </Problem.Example>
            </Problem.Item>
        ),
    )}
</Problem.List>
