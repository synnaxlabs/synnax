import Code from "astro/components/Code.astro";
import { grammar as arcGrammar } from "@synnaxlabs/arc";
import { theme } from "@synnaxlabs/site-common/shiki";

import { BANDS, kinds } from "@/components/arc/diagnostic";
import { Problem } from "@/components/problem";
import { InlineCode } from "@/components/text/InlineCode";
---

<ul class="docs-entry-list arc-kinds" role="list">
    {kinds().map(({ code, severity, message, problem, example }, i, all) => {
        const id = code.toLowerCase();
        return (
            <>
                {code[1] !== all[i - 1]?.code[1] && (
                    <li class="arc-kinds__band">{BANDS[code[1]]}</li>
                )}
                <li>
                    <details class="arc-kind" id={id}>
                        <summary>
                            <Problem.Head
                                id={id}
                                titles={[message]}
                                exact
                                code={code}
                                severity={severity}
                            />
                        </summary>
                        <div class="arc-kind__body">
                            <p>
                                <InlineCode text={problem} />
                            </p>
                            {example === "" ? (
                                <p class="arc-kind__none">No example</p>
                            ) : (
                                <Code code={example} lang={arcGrammar} theme={theme} />
                            )}
                        </div>
                    </details>
                </li>
            </>
        );
    })}
</ul>

<script>
    import { start } from "@/components/arc/kinds";

    start();
</script>

<style>
    .arc-kinds > li {
        padding: 0.75rem 0;
    }

    .arc-kinds > .arc-kinds__band {
        padding-top: 4rem;
        font-size: var(--pluto-p-size);
        font-weight: 600;
        color: var(--pluto-gray-l8);
    }

    .arc-kinds > .arc-kinds__band:first-child {
        padding-top: 0.75rem;
    }

    /* One width for each code puts the titles in one column. */
    .arc-kinds :global(.problem__label) {
        flex: none;
        width: 3.75em;
        font-variant-numeric: tabular-nums;
    }

    /* A block summary has no marker. */
    .arc-kind > summary {
        display: block;
        width: auto;

        &::-webkit-details-marker {
            display: none;
        }
    }

    .arc-kind__none {
        font-size: var(--pluto-small-size);
        color: var(--pluto-gray-l8);
    }

    .arc-kind__body {
        margin: 1.5rem 0 1rem;

        & > :global(:first-child) {
            margin-top: 0;
        }

        & > :global(:last-child) {
            margin-bottom: 0;
        }
    }
</style>
