// Marks a video or image that is not captured yet. Replace it before the page ships.

import { Text } from "@synnaxlabs/lyra/text";

interface Props {
    kind: "video" | "image";
    /** What the capture shows. */
    shot: string;
}

const { kind, shot } = Astro.props;
---

<div class="docs-media-placeholder">
    <Text.Text level="small" weight={500} color={9}>
        {kind === "video" ? "Video to record" : "Image to capture"}
    </Text.Text>
    <Text.Text level="small" color={8}>
        {shot}
    </Text.Text>
</div>

<style is:global>
    article .docs-media-placeholder {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin: 4rem 0;
        padding: 4rem;
        border: 1px dashed var(--pluto-gray-l6);
        border-radius: 1rem;
        background: var(--pluto-gray-l1);
    }
</style>
