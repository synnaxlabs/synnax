import Buttons from "@/components/download/Buttons.astro";

const version = await Astro.locals.releases.latest("console");
---

<Buttons
    product="console"
    version={version}
    platforms={[
        { name: "macOS", asset: `Synnax_${version}_aarch64.dmg`, agent: /Macintosh/ },
        {
            name: "Windows",
            asset: `Synnax_${version}_x64-setup.exe`,
            agent: /Windows NT/,
        },
    ]}
/>
