import { Triggers } from "@synnaxlabs/lyra/triggers";

import { find } from "@/components/console/tour/steps";

interface Props {
    /** The key of the step in the tour's step list. */
    step: string;
}

const { title, trigger, key, anchor } = find(Astro.props.step);
---

<section class="docs-tour__step" id={anchor} data-step={key} hidden>
    <h2 class="docs-tour__step-title">
        {title}
        {trigger != null && <Triggers.Text trigger={[trigger]} level="small" />}
    </h2>
    <slot />
</section>
