import Enterprise from "@/components/edition/Enterprise.astro";
import { Video } from "@/components/media/Media";

interface Props {
    type: string;
    video?: string;
}

const { type, video } = Astro.props;
---

<Enterprise>
    <p>
        Select <code>Copy link</code> from the projects or component toolbar. Anyone on
        the Core can open it from a browser.
    </p>
</Enterprise>

<p>
    Select <code>Export</code> to save the {type} as a JSON file. Drag the file back
    into the Console to import it.
</p>

{video && <Video id={video} />}
