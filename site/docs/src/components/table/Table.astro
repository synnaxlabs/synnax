import { Icon } from "@synnaxlabs/lyra/icon";
import { createElement } from "react";
import { renderToStaticMarkup } from "react-dom/server";

// A cell that only says Yes or No shows a mark instead, except in the first column.
const MARKS: Record<string, string> = {
    Yes: renderToStaticMarkup(
        createElement(Icon.Check, {
            className: "docs-mark docs-mark--yes",
            "aria-label": "Yes",
        }),
    ),
    No: renderToStaticMarkup(
        createElement(Icon.Subtract, {
            className: "docs-mark docs-mark--no",
            "aria-label": "No",
        }),
    ),
};

const props = Astro.props;
const html = await Astro.slots.render("default");
const ENTITIES: Record<string, string> = { "&lt;": "<", "&gt;": ">", "&amp;": "&" };
// Leaves the text escaped, so it can go back into the HTML as an attribute.
const strip = (cell: string): string => cell.replace(/<[^>]+>/g, "").trim();
const text = (cell: string): string =>
    strip(cell).replace(/&(lt|gt|amp);/g, (e) => ENTITIES[e]);
const labels = [...html.matchAll(/<th\b[^>]*>([\s\S]*?)<\/th>/g)].map((m) =>
    strip(m[1]),
);
const cells = [...html.matchAll(/<tr\b[^>]*>([\s\S]*?)<\/tr>/g)]
    .map((m) => [...m[1].matchAll(/<td\b[^>]*>([\s\S]*?)<\/td>/g)].map((c) => c[1]))
    .filter((r) => r.length > 0);
const rows = cells.map((r) => r.map(text));
// A quantity may have a comparison before it and a short unit after it: "< 1 µs",
// "10 kHz". A number in code is a literal value, not a quantity.
const COMPARISON = String.raw`(?:[<>≤≥~]\s*)?`;
const NUMBER = String.raw`[-+]?[\d.,]*\d[\d.,]*`;
const UNIT = String.raw`\s*(?:%|[a-zA-Zµ°Ω]{1,4}(?:\/\w{1,3})?)?`;
const QUANTITY = new RegExp(`^${COMPARISON}${NUMBER}${UNIT}$`);
const isNumber = (cell: string, raw: string): boolean =>
    !raw.includes("<code") && QUANTITY.test(cell);
// An ellipsis or an empty cell does not stop a column of numbers from aligning right.
const isFiller = (cell: string): boolean => /^(\.\.\.|…|)$/.test(cell);
// The first column names the item, so it aligns left even when it holds numbers.
const numeric = labels.map(
    (_, i) =>
        i > 0 &&
        rows.some((r, j) => isNumber(r[i] ?? "", cells[j][i] ?? "")) &&
        rows.every(
            (r, j) => isNumber(r[i] ?? "", cells[j][i] ?? "") || isFiller(r[i] ?? ""),
        ),
);
// A short cell holds at most a name of a few words.
const SHORT_LENGTH = 24;
// A phone keeps a short table as a table, and stacks any other table into entries.
const compact =
    labels.length <= 3 && rows.every((r) => r.every((c) => c.length <= SHORT_LENGTH));
const numClass = (i: number): string => (numeric[i] ? ' class="num"' : "");
const labeled = html
    .replace(/<tr\b[^>]*>[\s\S]*?<\/tr>/g, (row) => {
        let i = 0;
        return row.replace(/<td\b([^>]*)>([\s\S]*?)<\/td>/g, (_, attrs, body) => {
            const col = i++;
            const label = `data-label="${labels[col] ?? ""}"`;
            const value = text(body);
            const empty = value === "" ? " data-empty" : "";
            const whole =
                (col === 0 && value.length <= SHORT_LENGTH) || isNumber(value, body)
                    ? " data-whole"
                    : "";
            const cell = `${label}${empty}${whole}${numClass(col)}${attrs}`;
            const content = (col > 0 ? MARKS[value] : undefined) ?? body;
            return `<td ${cell}><span>${content}</span></td>`;
        });
    })
    .replace(/<tr\b[^>]*>(?:(?!<\/tr>)[\s\S])*?<th\b[\s\S]*?<\/tr>/, (row) => {
        let i = 0;
        return row.replace(/<th\b/g, () => `<th${numClass(i++)}`);
    });
---

<div class="table-wrapper styled-scrollbar" data-shape={compact ? "compact" : "stack"}>
    <table {...props} set:html={labeled} />
</div>

<style>
    .table-wrapper {
        overflow-x: auto;
        padding-bottom: 0.5rem;
    }

    /* The first column names each row, so it stays in view while the table scrolls. */
    .table-wrapper :global(:is(td, th):first-child) {
        position: sticky;
        left: 0;
        z-index: 1;
        padding-right: 2rem;
        background: var(--pluto-gray-l0);
    }

    /* While a table scrolls, the far edge fades until the last column shows, and a
       divider marks the columns under the first. Longhands, because the minifier
       folds a timeline into an invalid shorthand. */
    @supports (animation-timeline: scroll()) {
        .table-wrapper {
            scroll-timeline: --table-scroll x;
            animation-name: table-edge;
            animation-timing-function: linear;
            animation-fill-mode: both;
            animation-timeline: --table-scroll;
        }

        .table-wrapper :global(:is(td, th):first-child) {
            animation-name: table-column;
            animation-timing-function: linear;
            animation-fill-mode: both;
            animation-timeline: --table-scroll;
        }
    }

    @keyframes table-edge {
        0%,
        95% {
            mask-image: linear-gradient(to left, transparent, #000 6rem);
        }

        100% {
            mask-image: none;
        }
    }

    @keyframes table-column {
        0% {
            box-shadow: inset -1px 0 0 transparent;
        }

        2%,
        100% {
            box-shadow: inset -1px 0 0 var(--pluto-gray-l4);
        }
    }

    /* A short name in the first column and a number with its unit stay on one line. */
    .table-wrapper :global(td[data-whole]) {
        white-space: nowrap;
    }

    /* On a phone, each entry has its title on top, then one line per field with the
       label in its own column. A cell's label and value are grid items of the entry. */
    @media (width <= 800px) {
        /* Code in a cell wraps between words before the table scrolls. */
        .table-wrapper :global(td code) {
            white-space: normal;
        }

        .table-wrapper[data-shape="stack"] {
            & :global(thead) {
                display: none;
            }

            & :global(tr) {
                display: grid;
                grid-template-columns: minmax(10rem, 2fr) minmax(0, 3fr);
                align-items: baseline;
                gap: 1rem 2rem;
                padding: 2.5rem 0;
            }

            /* A grid row leaves the collapsed table borders, so the outer edges of the
               first and last entries draw unless they are cleared. */
            & :global(tbody tr:first-child) {
                padding-top: 0;
                border-top: none;
            }

            & :global(tbody tr:last-child) {
                padding-bottom: 0;
                border-bottom: none;
            }

            & :global(td) {
                display: contents;
            }

            & :global(td:first-child > span) {
                grid-column: 1 / -1;
                margin-bottom: 0.5rem;
                font-size: var(--pluto-p-size);
                font-weight: 550;
                color: var(--pluto-gray-l11);
            }

            /* An entry leaves out a field that has no value. */
            & :global(td[data-empty]) {
                display: none;
            }

            & :global(td:not(:first-child))::before {
                content: attr(data-label);
                font-size: round(2.1667rem, 1px);
                color: var(--pluto-gray-l8);
            }

            & :global(td.num) {
                text-align: start;
            }

            /* A value has a narrow column, so even one long token breaks in it. */
            & :global(td code) {
                overflow-wrap: anywhere;
            }
        }
    }
</style>
