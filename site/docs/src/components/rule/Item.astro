import { toAnchor } from "@/util/anchor";

interface Props {
    title: string;
    /** The anchor for the rule. Defaults to the title in kebab case. */
    id?: string;
}

const { title, id = toAnchor(title) } = Astro.props;
---

<li class="rule-item" id={id}>
    <a class="rule-item__number" href={`#${id}`} aria-hidden="true" tabindex="-1"></a>
    <div class="rule-item__body">
        <p class="rule-item__title">{title}</p>
        <slot />
    </div>
</li>

<style is:global>
    .rule-item {
        counter-increment: rule;
        display: grid;
        grid-template-columns: 7rem minmax(0, 1fr);
        color: var(--docs-body-color);
    }

    .rule-item__number {
        font:
            500 12px/28px "Geist Mono",
            monospace;
        font-variant-numeric: tabular-nums;
        color: var(--pluto-gray-l7);
        text-decoration: none;

        &::before {
            content: counter(rule, decimal-leading-zero);
        }

        &:hover {
            color: var(--pluto-primary-z);
            text-decoration: none;
        }
    }

    .rule-item__body {
        & > * {
            margin: 0;
        }

        & > .rule-item__title {
            margin-bottom: 0.5rem;
            font-weight: 550;
            letter-spacing: -0.01em;
            color: var(--pluto-gray-l11);
        }
    }

    @media (width <= 800px) {
        .rule-item {
            grid-template-columns: 5rem minmax(0, 1fr);
        }
    }
</style>
