interface Props {
    title: string;
    /** The anchor for the rule. Defaults to the title in kebab case. */
    id?: string;
}

const {
    title,
    id = title
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-|-$/g, ""),
} = Astro.props;
---

<li class="rule-item" id={id}>
    <a class="rule-item__number" href={`#${id}`} aria-hidden="true" tabindex="-1"></a>
    <div class="rule-item__body">
        <p class="rule-item__title">{title}</p>
        <slot />
    </div>
</li>
