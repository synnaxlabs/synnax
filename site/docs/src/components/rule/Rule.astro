---

<div class="rule magicpattern">
    <slot />
</div>

<style>
    .rule {
        margin: 0 0 5rem 0;
        & .title {
            position: absolute;
            top: 1.5rem;
            left: 2rem;
            margin: 0;
        }

        &.magicpattern {
            background-size: cover;
            background-position: center center;
            background-repeat: repeat;
            background-image: url("./pattern.svg");
        }

        padding: 5rem 5rem;
        position: relative;
        border-radius: 2rem;
        text-align: center;
        background: var(--pluto-gray-l1);
        border: var(--pluto-border);
        border-color: var(--pluto-primary-z-40);
        * {
            font-weight: 500;
            color: var(--pluto-dark-gray-l10);
            font-size: 2.75rem;
        }
    }
</style>
