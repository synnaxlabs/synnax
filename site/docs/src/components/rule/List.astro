---

<ol class="rule-list" role="list">
    <slot />
</ol>

<style is:global>
    .rule-list {
        counter-reset: rule;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--pluto-gray-l3);
    }

    .rule-list > .rule-item {
        counter-increment: rule;
        display: grid;
        grid-template-columns: 7rem minmax(0, 1fr);
        margin: 0;
        padding: 3.5rem 0;
        border-bottom: 1px solid var(--pluto-gray-l3);
        color: var(--docs-body-color);

        &:last-child {
            padding-bottom: 0;
            border-bottom: none;
        }
    }

    .rule-item__number {
        font:
            500 12px/28px "Geist Mono",
            monospace;
        font-variant-numeric: tabular-nums;
        color: var(--pluto-gray-l7);
        text-decoration: none;

        &::before {
            content: counter(rule, decimal-leading-zero);
        }

        &:hover {
            color: var(--pluto-primary-z);
            text-decoration: none;
        }
    }

    .rule-item__body {
        & > * {
            margin: 0;
        }

        & > .rule-item__title {
            margin-bottom: 0.5rem;
            font-weight: 550;
            letter-spacing: -0.01em;
            color: var(--pluto-gray-l11);
        }
    }

    @media (max-width: 800px) {
        .rule-list > .rule-item {
            grid-template-columns: 5rem minmax(0, 1fr);
        }
    }
</style>
