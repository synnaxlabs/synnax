interface Props {
    columns?: 2 | 3;
}

const { columns = 3 } = Astro.props;
---

<div class="docs-card-grid" data-columns={columns}>
    <slot />
</div>

<style is:global>
    .docs-card-grid {
        display: grid;
        grid-template-columns: repeat(var(--docs-card-columns), minmax(0, 1fr));
        gap: 3rem;
        margin: 2.5rem 0;

        &[data-columns="2"] {
            --docs-card-columns: 2;
        }

        &[data-columns="3"] {
            --docs-card-columns: 3;
        }

        @media (width <= 900px) {
            &[data-columns] {
                --docs-card-columns: 2;
            }
        }

        @media (width <= 600px) {
            &[data-columns] {
                --docs-card-columns: 1;
            }
        }
    }
</style>
