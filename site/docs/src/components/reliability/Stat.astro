import { Flex } from "@synnaxlabs/lyra/flex";
import { Text } from "@synnaxlabs/lyra/text";

interface Props {
    label: string;
    value: string;
    status?: "success" | "warning" | "error";
}

const { label, value, status } = Astro.props;
---

<Flex.Box y gap="tiny">
    <Text.Text level="h2" variant="code" status={status} className="reliability-stat">
        {value}
    </Text.Text>
    <Text.Text level="small" color={8}>
        {label}
    </Text.Text>
</Flex.Box>

<style is:global>
    .reliability-stat {
        font-variant-numeric: tabular-nums;
    }
</style>
