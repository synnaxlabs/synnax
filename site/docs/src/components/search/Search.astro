import { Search as S } from "@/components/search/Search";
---

<div data-island="search">
    <S />
</div>

<style is:global>
    .search-box {
        position: relative;
        max-width: 280px;
        width: 280px;

        & button {
            color: var(--pluto-gray-l8);
            font-size: var(--pluto-small-size);
            font-weight: 400;

            /* The shortcut chip takes the page fill, so it stands out of the box. */
            --pluto-keycap-bg: var(--pluto-gray-l0);
            --pluto-keycap-border-color: var(--pluto-gray-l5);

            & * {
                color: var(--pluto-gray-l8);
                font-size: var(--pluto-small-size);
                font-weight: 400;
            }

            & .search-box__keys {
                margin-left: auto;
            }
        }
    }

    @media (width <= 1100px) {
        .search-box {
            width: auto;
            max-width: none;

            & button {
                width: auto;
                min-width: unset;
                justify-content: center;
                font-size: 0;
                gap: 0;
                aspect-ratio: 1;
                padding: 0;
            }

            & button > .lyra-icon {
                font-size: var(--pluto-small-size);
            }

            .search-box__keys {
                display: none;
            }
        }
    }

    .search-results__content {
        & .search-results__input {
            --pluto-h2-size: 3.5rem;
            --pluto-h2-line-height: 4.5rem;

            flex-shrink: 0;
            flex-grow: 0;
        }

        width: 800px;
        max-width: 100%;
        height: 460px;
        min-width: 200px;

        & a:hover {
            text-decoration: none !important;
        }

        & .lyra-list__scroll {
            flex: 1;
        }
    }

    .search-results__section {
        display: block;
        padding: 2rem 1.5rem 0.75rem;
        font-weight: 550;
        color: var(--pluto-gray-l9);

        &:first-child {
            padding-top: 1rem;
        }
    }

    /* The icon spans both lines: the title with its path, then the excerpt. */
    .search-result {
        display: grid;
        grid-template-columns: 4.5rem minmax(0, max-content) minmax(0, 1fr) auto;
        grid-template-areas:
            "icon title path enter"
            "icon excerpt excerpt enter";
        align-items: center;
        align-content: center;
        gap: 0.25rem 2rem;
        padding: 1.25rem 1.5rem;
        height: auto;
        white-space: normal;
        text-decoration: none;

        --pluto-btn-bg: transparent;

        & > * {
            min-width: 0;
        }
    }

    /* The pointer and the arrow keys move the active result, which Enter opens. */
    .search-result.lyra--hovered {
        --pluto-btn-bg: var(--pluto-primary-z-10);

        & .search-result__icon {
            background: var(--pluto-primary-z);
            border-color: var(--pluto-primary-z);
            color: var(--pluto-text-on-primary);
        }

        & .search-result__enter {
            visibility: visible;
        }
    }

    .search-result__icon {
        grid-area: icon;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 4.5rem;
        height: 4.5rem;
        border: var(--pluto-border);
        border-color: var(--pluto-gray-l4);
        border-radius: 1rem;
        background: var(--pluto-gray-l1);
        color: var(--pluto-gray-l9);

        & svg {
            width: 2.25rem;
            height: 2.25rem;
        }
    }

    .search-result__title {
        grid-area: title;
        font-size: var(--pluto-p-size);
        line-height: var(--pluto-p-line-height);
        font-weight: 500;
        color: var(--pluto-gray-l11);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .search-result__path {
        grid-area: path;
        display: flex;
        font-size: var(--pluto-small-size);
        line-height: var(--pluto-small-line-height);
        color: var(--pluto-gray-l9);
        white-space: nowrap;
        overflow: hidden;

        & > span + span::before {
            content: "/";
            margin: 0 0.75rem;
            color: var(--pluto-gray-l6);
        }
    }

    .search-result__excerpt {
        grid-area: excerpt;
        font-size: var(--pluto-small-size);
        line-height: var(--pluto-small-line-height);
        color: var(--pluto-gray-l9);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .search-result__enter {
        grid-area: enter;
        visibility: hidden;
    }

    /* A match darkens in an excerpt. A title is already bold, so its matches take an
       underline. */
    .search-result b {
        font-weight: inherit;
        color: inherit;
    }

    .search-result__excerpt b {
        font-weight: 600;
        color: var(--pluto-gray-l11);
    }

    .search-result__title b {
        text-decoration: underline;
        text-decoration-color: var(--pluto-gray-l7);
        text-underline-offset: 0.5rem;
    }

    .search-results__footer {
        flex-shrink: 0;
        padding: 1.25rem 2rem;
        background: var(--pluto-gray-l1);

        & .lyra-text {
            color: var(--pluto-gray-l9);
        }
    }

    /* A phone has no keys to hint at, and too little width for the path beside the
       title. Without the footer, the list is the last box, so it takes the corners. */
    @media (hover: none) {
        .search-result__enter,
        .search-results__footer {
            display: none;
        }

        .search-results__list {
            border-bottom-left-radius: inherit;
            border-bottom-right-radius: inherit;
        }
    }

    @media (width <= 600px) {
        .search-result {
            grid-template-columns: 4.5rem minmax(0, 1fr);
            grid-template-areas:
                "icon title"
                "icon path"
                "icon excerpt";
        }

        /* An empty line would take part of the icon's height as a gap. */
        .search-result:not(:has(.search-result__path)) {
            grid-template-areas:
                "icon title"
                "icon excerpt";
        }
    }
</style>
