import Cryostat from "./Cryostat.astro";
import type { Direction } from "./content";

interface Props {
    direction: Direction;
    id: string;
    compact?: boolean;
}
const { direction, id, compact = false } = Astro.props;
const loopLines = Array.from({ length: 29 }, (_, i) => {
    const t = i / 28;
    return `M ${210 + t * 90},${170 + t * 82} C ${345 + t * 30},${30 + t * 105} ${650 - t * 35},${-2 + t * 123} ${814 - t * 64},${119 + t * 78} C ${985 - t * 120},${246 + t * 25} ${855 - t * 72},${451 - t * 113} ${651 - t * 31},${456 - t * 106} C ${456 + t * 12},${468 - t * 92} ${371 + t * 40},${303 + t * 18} ${210 + t * 90},${170 + t * 82}`;
});
---

<div
    class:list={["partnership-art", direction, { compact }]}
    role="img"
    aria-label={
        direction === "instrument"
            ? "Synnax and Rigetti Computing. A conceptual dilution refrigerator with suspended plates, cables, and blue and teal accents."
            : direction === "mesh"
              ? "Synnax and Rigetti Computing on a restrained mesh of blue, teal, magenta, and yellow."
              : "Synnax and Rigetti Computing. Fine blue and teal lines form a continuous warmup and cool down cycle."
    }
>
    <div class="art-topline" aria-hidden="true">
        <span>
            SYNNAX <span class="topline-separator">/</span> PARTNERSHIPS
        </span>
        <span>QUANTUM COMPUTING</span>
    </div>

    {direction === "instrument" && (
        <>
            <div class="instrument-grid" aria-hidden="true" />
            <div class="art-title" aria-hidden="true">
                <span>Synnax</span>
                <span class="join">×</span>
                <span>
                    Rigetti
                    <br />
                    Computing
                </span>
            </div>
            <div class="cryostat">
                <Cryostat id={`${id}-cryostat`} compact={compact} />
            </div>
            <div class="instrument-caption" aria-hidden="true">
                <span class="caption-rule" />
                DILUTION REFRIGERATOR
            </div>
        </>
    )}

    {direction === "mesh" && (
        <>
            <div class="mesh-field" aria-hidden="true" />
            <svg
                class="mesh-contours"
                viewBox="0 0 1200 700"
                fill="none"
                aria-hidden="true"
            >
                {Array.from({ length: 16 }, (_, i) => (
                    <path
                        d={`M ${575 + i * 28},-50 C ${360 + i * 36},${180 + i * 3} ${690 + i * 26},${270 - i * 5} ${708 + i * 29},${450 - i * 3} S ${510 + i * 40},740 ${730 + i * 45},800`}
                    />
                ))}
            </svg>
            <div class="art-title" aria-hidden="true">
                <span>Synnax</span>
                <span class="join">×</span>
                <span>Rigetti Computing</span>
            </div>
            <div class="mesh-footer" aria-hidden="true">
                <span>A NEW PARTNERSHIP</span>
                <span class="palette-marks">
                    <i />
                    <i />
                    <i />
                    <i />
                    <i />
                </span>
            </div>
        </>
    )}

    {direction === "cycle" && (
        <>
            <div class="art-title" aria-hidden="true">
                <span>
                    Synnax <span class="inline-join">×</span>
                    <br />
                    Rigetti Computing
                </span>
            </div>
            <svg
                class="cycle-lines"
                viewBox="0 0 1050 550"
                fill="none"
                aria-hidden="true"
            >
                <defs>
                    <linearGradient
                        id={`${id}-cycle-gradient`}
                        x1="210"
                        y1="90"
                        x2="850"
                        y2="410"
                        gradientUnits="userSpaceOnUse"
                    >
                        <stop offset="0" stop-color="#3774d0" />
                        <stop offset="0.42" stop-color="#347cba" />
                        <stop offset="0.8" stop-color="#168f99" />
                        <stop offset="1" stop-color="#00b5ad" />
                    </linearGradient>
                </defs>
                <g stroke={`url(#${id}-cycle-gradient)`} stroke-width="1">
                    {loopLines.map((d) => (
                        <path d={d} />
                    ))}
                </g>
                <g class="cycle-points">
                    <circle cx="282" cy="200" r="3" />
                    <path d="M 282 200 L 164 290 H 92" />
                    <circle cx="793" cy="352" r="3" />
                    <path d="M 793 352 L 885 428 H 962" />
                </g>
                <g class="cycle-labels">
                    <text x="92" y="310">
                        WARMUP
                    </text>
                    <text x="962" y="450" text-anchor="end">
                        COOL DOWN
                    </text>
                </g>
            </svg>
            <div class="cycle-footer" aria-hidden="true">
                THE WORK BETWEEN EXPERIMENTS
            </div>
        </>
    )}
</div>

<style>
    .partnership-art {
        container-type: inline-size;
        position: relative;
        isolation: isolate;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        color: light-dark(#202c3d, #e0e7ef);
        background: light-dark(#eff2f5, #10171f);
        font-family: var(--pluto-font-family);
        border-radius: 12px;
    }
    .art-topline {
        position: absolute;
        inset: 5.8% 5.2% auto;
        display: flex;
        justify-content: space-between;
        gap: 16px;
        z-index: 3;
        font: 400 0.85cqw / 1.5 var(--pluto-code-font-family);
        letter-spacing: 0.095em;
        color: light-dark(#5b6575, #99a8b8);
    }
    .topline-separator {
        margin: 0 1.2cqw;
        opacity: 0.45;
    }
    .art-title {
        position: absolute;
        z-index: 2;
        font-size: 5.3cqw;
        line-height: 1.08;
        font-weight: 450;
        letter-spacing: -0.055em;
    }
    .instrument .art-title {
        top: 26%;
        left: 7%;
        display: flex;
        flex-direction: column;
    }
    .join {
        font-size: 3cqw;
        font-weight: 250;
        color: light-dark(#7b8a9c, #70859a);
        padding: 1.6cqw 0 1.9cqw;
    }
    .instrument-grid {
        position: absolute;
        inset: 14% 5.2% 13% 49%;
        background-image:
            linear-gradient(light-dark(#526d8710, #9aaec00b) 1px, transparent 1px),
            linear-gradient(
                90deg,
                light-dark(#526d8710, #9aaec00b) 1px,
                transparent 1px
            );
        background-size: 4.2cqw 4.2cqw;
        mask-image: linear-gradient(
            to bottom,
            transparent,
            black 15%,
            black 80%,
            transparent
        );
    }
    .cryostat {
        position: absolute;
        inset: 10% 3% 1% 40%;
    }
    .cryostat :global(svg) {
        display: block;
        width: 100%;
        height: 100%;
    }
    .instrument-caption {
        position: absolute;
        bottom: 7%;
        left: 7%;
        display: flex;
        align-items: center;
        gap: 1.2cqw;
        font: 400 0.84cqw / 1.5 var(--pluto-code-font-family);
        letter-spacing: 0.06em;
        color: light-dark(#647184, #93a3b2);
    }
    .caption-rule {
        width: 2.7cqw;
        height: 1px;
        background: #3774d0;
    }
    .mesh {
        background: light-dark(#e6e8ec, #1c2736);
    }
    .mesh-field {
        position: absolute;
        inset: 0;
        background:
            radial-gradient(
                ellipse at 98% 4%,
                light-dark(#00b5ad55, #00b5ad32),
                transparent 65%
            ),
            radial-gradient(
                ellipse at 1% 95%,
                light-dark(#10007f2c, #10007f38),
                transparent 67%
            ),
            radial-gradient(
                ellipse at 85% 95%,
                light-dark(#ffc5042e, #ffc50410),
                transparent 52%
            ),
            radial-gradient(
                ellipse at 48% 100%,
                light-dark(#ef476f23, #ef476f19),
                transparent 60%
            ),
            radial-gradient(
                ellipse at 20% 10%,
                light-dark(#0084e92d, #0084e920),
                transparent 80%
            );
    }
    .mesh .art-title {
        inset: 27% auto auto 7%;
        display: flex;
        flex-direction: column;
        font-size: 5.9cqw;
    }
    .mesh .join {
        padding: 1.6cqw 0 2cqw;
    }
    .mesh-contours {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        stroke: light-dark(#ffffff62, #b0c6d325);
        stroke-width: 1;
    }
    .mesh-footer {
        position: absolute;
        inset: auto 5.2% 6%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font: 400 0.85cqw / 1.5 var(--pluto-code-font-family);
        letter-spacing: 0.1em;
        color: light-dark(#62677a, #9ba8b9);
    }
    .palette-marks {
        display: flex;
        gap: 0.45cqw;
    }
    .palette-marks i {
        width: 1cqw;
        height: 0.28cqw;
        background: #3774d0;
    }
    .palette-marks i:nth-child(2) {
        background: #10007f;
    }
    .palette-marks i:nth-child(3) {
        background: #00b5ad;
    }
    .palette-marks i:nth-child(4) {
        background: #ef476f;
    }
    .palette-marks i:nth-child(5) {
        background: #ffc504;
    }
    .cycle {
        background: light-dark(#f1f3f3, #11191d);
    }
    .cycle .art-title {
        top: 17%;
        left: 7%;
        font-size: 3.9cqw;
        line-height: 1.13;
    }
    .inline-join {
        font-weight: 250;
        color: light-dark(#92a0aa, #5f7588);
        margin-left: 0.5cqw;
    }
    .cycle-lines {
        position: absolute;
        width: 81%;
        height: 81%;
        right: -4%;
        bottom: -3%;
    }
    .cycle-points {
        stroke: light-dark(#829aa9, #637e90);
        stroke-width: 0.8;
    }
    .cycle-points circle {
        fill: light-dark(#f1f3f3, #11191d);
    }
    .cycle-labels {
        fill: light-dark(#617688, #8fa7b4);
        font: 12px var(--pluto-code-font-family);
        letter-spacing: 1px;
    }
    .cycle-footer {
        position: absolute;
        inset: auto auto 6% 5.2%;
        font: 400 0.85cqw / 1.5 var(--pluto-code-font-family);
        letter-spacing: 0.08em;
        color: light-dark(#667889, #8fa7b4);
    }
    .compact .art-topline,
    .compact .mesh-footer,
    .compact .cycle-footer,
    .compact .instrument-caption {
        display: none;
    }
    .compact .art-title {
        font-size: 6.6cqw;
    }
    .compact.instrument .art-title {
        top: 18%;
    }
    .compact.mesh .art-title {
        top: 18%;
    }
    .compact.cycle .art-title {
        font-size: 5.3cqw;
        top: 13%;
    }
    .compact .cycle-labels,
    .compact .cycle-points {
        display: none;
    }
</style>
