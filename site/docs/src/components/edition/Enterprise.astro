    <Badge edition="enterprise" />
    <slot />
</div>

<style is:global>
    .edition-block {
        margin: 2rem 0;
        padding: 0.5rem 0 0.5rem 2rem;
        border-left: 2px solid var(--pluto-primary-z-30);

        > .edition-badge {
            margin-bottom: 1.25rem;
        }

        > p:last-child {
            margin-bottom: 0;
        }
    }
</style>
