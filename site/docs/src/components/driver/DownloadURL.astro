import Inline from "@/components/code/Inline.astro";
import { assetURL } from "@/util/releases";
const { os } = Astro.props;

const version = await Astro.locals.releases.latest("driver");
let asset = `synnax-driver-v${version}-${os.toLowerCase()}`;
if (os === "ni-linux-rt") asset = "install-driver-nilinuxrt.sh";
if (os === "windows") asset = `synnax-driver-v${version}-windows.exe`;
const url = assetURL("driver", version, asset);
let cmd = `curl -LO ${url}`;
if (os === "ni-linux-rt")
    cmd += ` && chmod +x install-driver-nilinuxrt.sh && ./install-driver-nilinuxrt.sh`;
if (os === "windows")
    cmd = `Invoke-WebRequest -Uri "${url}" -OutFile "synnax-driver.exe"`;
---

<Inline
    lang={os === "windows" ? "powershell" : "bash"}
    theme="css-variables"
    code={cmd}
/>
