import { Icon } from "@synnaxlabs/lyra/icon";

interface Props {
    open?: boolean;
}

const { open = false } = Astro.props;
---

<details class="docs-details" open={open}>
    <summary>
        <slot name="summary" />
        <Icon.Caret.Right className="indicator" />
    </summary>
    <div class="content">
        <slot />
    </div>
</details>

<style is:global>
    /* A disclosure is a pane like a tab set: a header bar, then a panel with the same
       padding, frame, and code bands. */
    .docs-details {
        interpolate-size: allow-keywords;
        margin: 4rem 0 var(--docs-block-gap);
        border: var(--pluto-border);
        border-radius: 1.5rem;
        overflow: hidden;
        background: var(--pluto-gray-l0);

        /* The margins collapse, so this cancels the gap above and leaves 2rem. */
        & + .docs-details {
            margin-top: calc(var(--docs-block-gap) * -1 + 2rem);
        }

        &::details-content {
            height: 0;
            overflow: clip;
            transition:
                height 0.25s ease,
                content-visibility 0.25s allow-discrete;
        }

        &[open]::details-content {
            height: auto;
        }

        & > summary {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            width: 100%;
            min-height: 7rem;
            padding: 0 var(--docs-block-padding);
            background: var(--pluto-gray-l1);
            cursor: pointer;
            transition: background-color 0.2s;

            &::marker,
            &::-webkit-details-marker {
                display: none;
                content: none;
            }

            &:hover {
                background: var(--pluto-gray-l2);
            }

            /* The title flows as text, so a link or code in it sits with no gap. */
            & > :not(.indicator) {
                display: block;
                flex: 1;
                min-width: 0;
                margin: 0;
                color: var(--pluto-gray-l10);

                & svg {
                    margin-right: 1rem;
                    vertical-align: -0.125em;
                    color: var(--pluto-gray-l8);
                }
            }

            & code {
                padding: 0;
                border: none;
                background: none;
            }

            & .indicator {
                flex-shrink: 0;
                width: 2.5rem;
                height: 2.5rem;
                color: var(--pluto-gray-l8);
                transition: transform 0.2s;
            }
        }

        &[open] > summary {
            border-bottom: var(--pluto-border);

            & .indicator {
                transform: rotate(90deg);
            }
        }

        & > .content {
            padding: var(--docs-block-padding);
        }
    }
</style>
