import { Breadcrumb } from "@/components/article/Breadcrumb";
import NextPrev from "@/components/article/NextPrev.astro";
import { Badge } from "@/components/edition/Badge";
import { InlineCode } from "@/components/text/InlineCode";
import { Text } from "@synnaxlabs/lyra/text";
const {
    title,
    description,
    url,
    next,
    prev,
    nextURL,
    prevURL,
    nextGroup,
    prevGroup,
    showBreadcrumb = true,
    published,
    author,
    authorImage,
    authorLink,
    edition,
} = Astro.props;

const visibleTitleLength = String(title ?? "").replace(/`/g, "").length;
const publishedLabel =
    published &&
    new Date(published).toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
        timeZone: "UTC",
    });
---

<article data-edition={edition}>
    <div class="article-top">
        {showBreadcrumb && url.split("/").length > 2 && (
            <Breadcrumb url={url} title={title} />
        )}
        {edition && <Badge edition={edition} />}
    </div>
    {published && (
        <div class="blog-meta">
            <time class="blog-published" datetime={published}>
                {publishedLabel}
            </time>
        </div>
    )}
    <Text.Text
        className="article-title"
        el="h1"
        level={visibleTitleLength > 30 ? "h2" : "h1"}
    >
        <span>
            <InlineCode text={title} />
        </span>
    </Text.Text>
    <p class="article-description">{description}</p>
    {author && (
        <a
            class="blog-author"
            href={authorLink}
            target="_blank"
            rel="noopener noreferrer"
        >
            {authorImage && (
                <img class="blog-author__photo" src={authorImage} alt={author} />
            )}
            <span class="blog-author__name">
                Written by <strong>{author}</strong>
            </span>
        </a>
    )}
    <slot />
    <NextPrev
        prev={prev}
        next={next}
        prevURL={prevURL}
        nextURL={nextURL}
        prevGroup={prevGroup}
        nextGroup={nextGroup}
    />
</article>

<style is:global>
    article {
        position: relative;
        flex-basis: 840px;
        flex-shrink: 1;
        flex-grow: 1;
        margin-bottom: 25rem;
        min-width: 0;
        overflow-x: clip;
        .article-title {
            display: inline-block;
            width: fit-content;
        }

        & .pluto-breadcrumb {
            flex-wrap: wrap;
            row-gap: 0.5rem;
            & a.pluto-text {
                white-space: nowrap;
                color: var(--pluto-gray-l8);
                font-weight: 375;
                font-size: var(--pluto-p-size);
                &:last-child {
                    color: var(--pluto-gray-l10);
                    font-weight: 450;
                }
                &:hover {
                    color: var(--pluto-gray-l10);
                    text-decoration: none;
                }
            }
        }

        & .pluto-icon--caret-right {
            transform: translateY(0px);
            width: 2rem;
            height: 2rem;
            color: var(--pluto-gray-l6);
            &:first-child {
                display: none;
            }
        }

        padding: 5rem 8rem;
        @media (max-width: 1100px) {
            padding-right: 2rem;
        }

        @media (max-width: 800px) {
            padding: 5rem 2rem;
            margin-bottom: 0;
        }

        .article-title::after {
            content: "";
            display: block;
            width: 100px;
            margin-top: 2.3rem;
            height: 2px;
            background: var(--pluto-primary-z);
        }

        .article-top {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 1rem 2rem;
            > .edition-badge {
                margin-left: auto;
            }
        }
        .article-description {
            color: var(--pluto-gray-l9);
            font-size: var(--pluto-h4-size);
            line-height: var(--pluto-h4-line-height);
            font-weight: 350;
            margin-top: 1.15rem;
            margin-bottom: 6.9rem;

            & + :is(h2, h2.pluto-text) {
                margin-top: 4rem;
            }

            & + .blog-author {
                margin-top: -4rem;
            }
        }

        .pluto-divider {
            border-top: var(--pluto-border);
            margin: 5rem 0;

            & + :is(h2, h2.pluto-text) {
                margin-top: 4rem !important;
            }

            & + :is(h3, h3.pluto-text) {
                margin-top: 3rem;
            }

            /* Hide empty h2 generated by MDX ## syntax before Step component */
            & + h2:not(.no-link):has(+ h2.no-link) {
                margin: 0;
                height: 0;
                overflow: hidden;
            }

            /* Step h2 following the hidden empty h2 after a divider */
            & + h2:not(.no-link) + h2.no-link {
                margin-top: 4rem !important;
            }
        }

        p .pluto-icon {
            vertical-align: middle;
        }

        /* Padding carries the vertical space, so inline and block content match. */
        .pluto-note {
            display: block;
            margin: var(--docs-block-gap) 0;
            padding: var(--docs-block-padding) var(--note-padding-inline, 3.5rem);
            font-size: var(--pluto-small-size);
            font-family: var(--pluto-font-family);
            font-weight: 450;
            line-height: var(--pluto-small-line-height);
            @media (max-width: 800px) {
                font-size: calc(var(--pluto-small-size) * 0.9);
            }
            & :is(p, li) {
                font: inherit;
            }
            & > :first-child {
                margin-top: 0;
            }
            & > :last-child {
                margin-bottom: 0;
            }
        }

        .pluto-note.compact {
            --note-padding-inline: 2rem;
        }

        table {
            width: 100%;
            display: table;
        }

        figure {
            margin: 5rem 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            figcaption {
                font-family: var(--pluto-font-family);
                font-size: var(--pluto-small-size);
                line-height: var(--pluto-small-line-height);
                color: var(--pluto-gray-l8);
                font-style: italic;
                text-align: center;
                text-wrap: balance;
            }
            img {
                width: 100%;
                margin-bottom: 2rem;
                margin-top: -2rem;
            }
        }
    }

    /* A pane owns the space at its edges, so the first and last blocks in it drop their
       outer margins. A tab panel and a disclosure are both panes. */
    article :is(.pluto-tabs__content, .docs-details > .content) {
        & > :first-child {
            margin-top: 0;
        }

        & > :last-child {
            margin-bottom: 0;
        }
    }

    /* Registered so that it resolves against the line height of the item, not the
       circle. */
    @property --docs-step-line {
        syntax: "<length>";
        inherits: true;
        initial-value: 28px;
    }

    /* Every ordered list in an article is a list of steps: a numbered circle per step,
       joined by a line, with the content of each step in one column. The built-in
       list-item counter keeps the start of a list that continues after a block. */
    article ol:not([class]) {
        margin: 3rem 0;
        padding: 0;
        list-style: none;

        & > li {
            --docs-step-line: 1lh;
            position: relative;
            margin: 0;
            padding: 0 0 3rem 6rem;

            &::before {
                content: counter(list-item);
                position: absolute;
                top: calc(var(--docs-step-line) / 2 - 12px);
                left: 0;
                display: grid;
                place-items: center;
                width: 24px;
                height: 24px;
                box-sizing: border-box;
                border: 1px solid var(--pluto-gray-l4);
                border-radius: 50%;
                background: var(--pluto-gray-l0);
                font:
                    500 12px/1 "Geist Mono",
                    monospace;
                color: var(--pluto-gray-l9);
            }

            &::after {
                content: "";
                position: absolute;
                top: calc(var(--docs-step-line) / 2 + 16px);
                bottom: 4px;
                left: 12px;
                border-left: 1px solid var(--pluto-gray-l3);
            }

            &:last-child {
                padding-bottom: 0;
                &::after {
                    display: none;
                }
            }

            & > * {
                margin: 0;
            }

            & > * + * {
                margin-top: 2rem;
            }
        }
    }

    /* A wide block is centered on the prose and kept clear of the page navigation
       on both sides. */
    @media (min-width: 801px) {
        main > section:has(.docs-wide),
        main > section article:has(.docs-wide) {
            overflow-x: visible;
        }

        article .docs-wide {
            --docs-wide-width: max(
                100%,
                min(1080px, 100vw - 2 * (var(--docs-page-nav-width) + 4rem))
            );
            width: var(--docs-wide-width);
            margin-inline: calc((100% - var(--docs-wide-width)) / 2);
        }
    }
</style>
