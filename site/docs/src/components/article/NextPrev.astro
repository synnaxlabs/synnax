import { InlineCode } from "@/components/text/InlineCode";
import { Divider } from "@synnaxlabs/lyra/divider";
import { Flex } from "@synnaxlabs/lyra/flex";
import { Icon } from "@synnaxlabs/lyra/icon";
import { Text } from "@synnaxlabs/lyra/text";
const { next, prev, nextURL, prevURL, nextGroup, prevGroup } = Astro.props;
---

<Flex.Box className="next-prev" empty>
    {(next != null || prev != null) && <Divider.Divider direction="x" />}
    <Flex.Box direction="x" justify="between">
        <Flex.Box direction="x" el="a" className="link" href={prevURL}>
            {prev != null && (
                <>
                    <Icon.Caret.Left />
                    <Flex.Box direction="y">
                        <Text.Text level="small" className="next-prev__label">
                            {prevGroup == null
                                ? "Previous"
                                : `Previous in ${prevGroup}`}
                        </Text.Text>
                        <Text.Text className="next-prev__title">
                            <InlineCode text={prev} />
                        </Text.Text>
                    </Flex.Box>
                </>
            )}
        </Flex.Box>
        <Flex.Box direction="x" el="a" className="link link--next" href={nextURL}>
            {next != null && (
                <>
                    <Flex.Box direction="y">
                        <Text.Text level="small" className="next-prev__label">
                            {nextGroup == null ? "Next" : `Next in ${nextGroup}`}
                        </Text.Text>
                        <Text.Text className="next-prev__title">
                            <InlineCode text={next} />
                        </Text.Text>
                    </Flex.Box>
                    <Icon.Caret.Right />
                </>
            )}
        </Flex.Box>
    </Flex.Box>
</Flex.Box>

<style is:global>
    .next-prev {
        margin-top: 8rem;

        .link {
            align-items: center;
            gap: 1.5rem;
            cursor: pointer;

            & > .lyra-flex {
                gap: 0.5rem;
            }

            &:hover {
                text-decoration: none !important;

                .next-prev__title {
                    text-decoration: underline;
                    text-decoration-color: var(--pluto-gray-l6);
                }

                .lyra-icon {
                    color: var(--pluto-gray-l11);
                    transform: translateX(-0.5rem);
                }
            }
        }

        .link--next {
            text-align: end;

            & > .lyra-flex {
                align-items: flex-end;
            }

            &:hover .lyra-icon {
                transform: translateX(0.5rem);
            }
        }

        .next-prev__label {
            font-weight: 500;
            color: var(--pluto-gray-l8);
        }

        .next-prev__title {
            margin: 0;
            font-weight: 500;
            color: var(--pluto-gray-l11);
        }

        code {
            background: none;
            border: none;
            padding: 0;
            color: inherit;
            font-size: inherit;
            line-height: inherit;
        }

        .lyra-icon {
            transition: transform 0.2s ease;
            color: var(--pluto-gray-l8);
            width: 3rem;
            height: 3rem;
        }
    }
</style>
