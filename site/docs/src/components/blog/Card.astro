import { Icon } from "@synnaxlabs/lyra/icon";

interface Props {
    href: string;
    title: string;
    summary: string;
    published: string;
    category: string;
}

const { href, title, summary, published, category } = Astro.props;
const date = new Date(published).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
});
---

<a class="blog-card" href={href}>
    <slot name="background" />
    <div class="blog-card__content">
        <div class="blog-card__meta">
            <span>{category}</span>
            <time datetime={published}>{date}</time>
        </div>
        <h2>{title}</h2>
        <p>{summary}</p>
        <span class="blog-card__read">
            Read article
            <Icon.Arrow.Right />
        </span>
    </div>
    <div class="blog-card__art" aria-hidden="true">
        <slot />
    </div>
</a>

<style>
    .blog-card {
        position: relative;
        isolation: isolate;
        display: flex;
        width: 100%;
        min-height: 48rem;
        overflow: hidden;
        background: var(--pluto-gray-l1);
        border: 1px solid var(--pluto-gray-l5);
        border-radius: 2rem;
        text-decoration: none;
        transition:
            border-color 0.2s,
            box-shadow 0.2s;

        @media (prefers-color-scheme: light) {
            background: var(--pluto-gray-l0);
            box-shadow: var(--pluto-shadow-v1);
        }

        &:hover {
            border-color: var(--pluto-gray-l7);
        }

        &:focus-visible {
            outline: 2px solid var(--pluto-primary-z);
            outline-offset: 4px;
        }
    }

    .blog-card__content {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        width: 50%;
        padding: 6rem 6.5rem;
    }

    .blog-card__meta {
        display: flex;
        align-items: center;
        gap: 2rem;
        color: var(--pluto-gray-l8);
        font-family: var(--pluto-code-font-family);
        font-size: var(--pluto-tiny-size);
        letter-spacing: 0.06em;
        line-height: 1;
        text-transform: uppercase;

        & span {
            display: flex;
            align-items: center;
            gap: 2rem;

            &::after {
                content: "";
                width: 3rem;
                height: 1px;
                background: var(--pluto-gray-l6);
            }
        }
    }

    h2 {
        max-width: 18ch;
        margin: 4rem 0 0;
        color: var(--pluto-gray-l10);
        font-size: var(--pluto-h2-size);
        font-weight: 550;
        line-height: 1.2;
        letter-spacing: -0.02em;
        text-wrap: balance;
    }

    p {
        max-width: 40ch;
        margin: 2rem 0 0;
        color: var(--pluto-gray-l9);
        font-size: var(--pluto-p-size);
        line-height: 1.6;
        text-wrap: pretty;
    }

    .blog-card__read {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: auto;
        padding-top: 5rem;
        color: var(--pluto-gray-l10);
        font-size: var(--pluto-small-size);
        font-weight: 500;
        transition: color 0.2s;

        & :global(svg) {
            width: 2.5rem;
            height: 2.5rem;
            transition: transform 0.2s;
        }
    }

    .blog-card:is(:hover, :focus-visible) .blog-card__read {
        color: var(--pluto-primary-z);

        & :global(svg) {
            transform: translateX(0.75rem);
        }
    }

    .blog-card__art {
        position: absolute;
        z-index: 1;
        inset: 0 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 55%;
        pointer-events: none;
    }

    @media (width <= 900px) {
        .blog-card__content {
            width: 56%;
            padding: 5rem;
        }

        .blog-card__art {
            width: 48%;
        }
    }

    @media (width <= 600px) {
        .blog-card {
            flex-direction: column;
        }

        .blog-card__content {
            width: 100%;
            padding: 5rem 5rem 0;
        }

        .blog-card__read {
            padding-top: 4rem;
        }

        .blog-card__art {
            position: relative;
            width: 100%;
            height: 36rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .blog-card,
        .blog-card__read,
        .blog-card__read :global(svg) {
            transition: none;
        }
    }
</style>
