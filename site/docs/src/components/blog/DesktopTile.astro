import { Text } from "@synnaxlabs/lyra/text";
---

<a href="/blog/introducing-synnax-desktop" class="docs-desktop-tile">
    <span class="date">
        <Text.Text level="small" color={8} weight={400}>
            Nov 2, 2026
        </Text.Text>
    </span>
    <div class="content">
        <Text.Text level="h3" color={10}>
            Introducing Synnax Desktop
        </Text.Text>
        <div class="summary">
            <Text.Text level="p" color={9} weight={400}>
                One or two lines on what Desktop is and who it is for.
            </Text.Text>
        </div>
    </div>
    <div class="art" aria-hidden="true">
        <div class="glow"></div>
        <svg class="icon" viewBox="0 0 212 212" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient
                    id="docs-desktop-tile-gradient"
                    x1="0"
                    y1="1"
                    x2="1"
                    y2="0"
                >
                    <stop offset="0" stop-color="#33309a"></stop>
                    <stop offset="1" stop-color="#278ce4"></stop>
                </linearGradient>
            </defs>
            <rect
                width="212"
                height="212"
                rx="46"
                fill="url(#docs-desktop-tile-gradient)"
            ></rect>
            <path
                transform="translate(36 40) scale(0.69)"
                fill="#fff"
                d="M52.61,168.82A14.81,14.81,0,0,1,39.78,146.6L94.22,52.33c5.7-9.88,20-9.88,25.9.42l51.77,89.67a6.88,6.88,0,0,0,2.48,2.49l15.42,8.9a6.78,6.78,0,0,0,9.26-9.27L119.87,7.41a14.8,14.8,0,0,0-25.65,0L2,167.12a14.81,14.81,0,0,0,12.83,22.22H170.39a6.79,6.79,0,0,0,3.39-12.66l-12.05-7a6.83,6.83,0,0,0-3.39-.91Z"
            ></path>
        </svg>
    </div>
</a>

<style>
    .docs-desktop-tile {
        position: relative;
        display: flex;
        height: 300px;
        padding: 5rem;
        overflow: hidden;
        border: var(--pluto-border-l6);
        border-radius: 2rem;
        background:
            radial-gradient(
                40% 90% at 82% 50%,
                color-mix(in oklab, #278ce4 10%, transparent),
                transparent
            ),
            var(--pluto-gray-l1);
        box-shadow: var(--pluto-shadow-v1);
        text-decoration: none;
        transition: box-shadow 0.2s;

        &:hover {
            --pluto-shadow-v1:
                0px 1px 1px rgb(0 0 0 / 6%), 0px 4px 8px -4px rgb(0 0 0 / 10%),
                0px 16px 24px -8px rgb(0 0 0 / 20%);

            & .glow {
                opacity: 0.55;
            }

            & .icon {
                rotate: -4deg;
                translate: 0 -4px;
            }
        }

        & :global(h3) {
            margin: 0;
        }
    }

    .date {
        position: absolute;
        top: 3rem;
        right: 3rem;
        z-index: 2;
        padding: 0.75rem 1.5rem;
        border: var(--pluto-border);
        border-radius: 1rem;
        background-color: var(--pluto-gray-l2);
    }

    .content {
        z-index: 2;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
    }

    .summary {
        max-width: 450px;
    }

    .art {
        position: absolute;
        top: 50%;
        right: 12%;
        width: 150px;
        aspect-ratio: 1;
        translate: 0 -50%;
    }

    .glow {
        position: absolute;
        inset: -20%;
        border-radius: 50%;
        background: linear-gradient(45deg, #33309a, #278ce4);
        filter: blur(48px);
        opacity: 0.35;
        transition: opacity 0.3s;
    }

    .icon {
        position: relative;
        display: block;
        width: 100%;
        height: 100%;
        rotate: -8deg;
        filter: drop-shadow(0 12px 24px rgb(10 12 40 / 35%));
        transition:
            rotate 0.3s,
            translate 0.3s;
    }

    @media (prefers-reduced-motion: reduce) {
        .glow,
        .icon {
            transition: none;
        }
    }

    /* On a phone, the date sits above the title, and the icon moves to the bottom
       right corner, under the text. */
    @media (width <= 600px) {
        .docs-desktop-tile {
            flex-direction: column;
            gap: 2rem;
            padding: 4rem;
        }

        .date {
            position: static;
            align-self: flex-start;
        }

        .content {
            flex: 1;
            height: auto;
        }

        .art {
            top: auto;
            right: -2rem;
            bottom: -2rem;
            width: 110px;
            translate: none;
            opacity: 0.6;
        }
    }
</style>
