// Uncommitted review card; rendered on the blog index only in development.
import Artwork from "@/components/scratch/partnership/Artwork.astro";
import { announcement } from "@/components/scratch/partnership/content";
---

<a class="partnership-tile" href="/blog/rigetti-computing">
    <div class="partnership-tile__copy">
        <span class="partnership-tile__category">Partnerships</span>
        <div>
            <h2>Welcoming Rigetti Computing</h2>
            <p>{announcement[4]}</p>
        </div>
        <span class="partnership-tile__link">Read the announcement</span>
    </div>
    <div class="partnership-tile__art">
        <Artwork direction="instrument" id="partnership-index-tile" compact />
    </div>
</a>

<style>
    a.partnership-tile {
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
        gap: 4rem;
        padding: 4rem;
        min-height: 42rem;
        color: var(--pluto-gray-l10);
        background: var(--pluto-gray-l1);
        border: 1px solid var(--pluto-gray-l4);
        border-radius: 2rem;
        text-decoration: none;
        transition: border-color 160ms ease;
    }

    a.partnership-tile:hover {
        border-color: var(--pluto-gray-l6);
        text-decoration: none;
    }

    a.partnership-tile:focus-visible {
        outline: 2px solid var(--pluto-primary-z);
        outline-offset: 4px;
    }

    .partnership-tile__copy {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: flex-start;
        gap: 3rem;
        min-width: 0;
    }

    .partnership-tile__category {
        color: var(--pluto-gray-l8);
        font-size: var(--pluto-small-size);
    }

    .partnership-tile h2 {
        color: var(--pluto-gray-l10);
        margin: 0 0 1.5rem;
        font-size: var(--pluto-h3-size);
        font-weight: 500;
        line-height: 1.25;
        letter-spacing: -0.025em;
    }

    .partnership-tile p {
        margin: 0;
        color: var(--pluto-gray-l9);
        font-size: var(--pluto-p-size);
        line-height: 1.65;
        font-weight: 400;
    }

    .partnership-tile__link {
        color: light-dark(#356fc5, #8ab8ff);
        font-size: var(--pluto-small-size);
    }

    .partnership-tile__art {
        display: flex;
        align-items: center;
        min-width: 0;
    }

    @media (width < 700px) {
        a.partnership-tile {
            grid-template-columns: minmax(0, 1fr);
            padding: 3rem;
            gap: 3rem;
        }

        .partnership-tile__art {
            order: -1;
        }
    }
</style>
