---

<figure class="labjack-wiring">
    <svg
        viewBox="0 0 720 250"
        role="img"
        aria-label="A type K thermocouple with its yellow positive lead on AIN0 and its red negative lead on GND of a LabJack T7"
    >
        <path class="cable" d="M0 120 H64"></path>
        <text class="caption" x="0" y="100">
            USB
        </text>

        <rect class="device" x="64" y="52" width="200" height="136" rx="12"></rect>
        <text class="title" x="64" y="34">
            LabJack T7
        </text>

        <text class="terminal" x="88" y="99">
            AIN0
        </text>
        <circle class="screw" cx="232" cy="94" r="13"></circle>
        <path class="slot" d="M224 94 H240"></path>

        <text class="terminal" x="88" y="151">
            GND
        </text>
        <circle class="screw" cx="232" cy="146" r="13"></circle>
        <path class="slot" d="M224 146 H240"></path>

        <path class="wire positive" d="M245 94 C 380 94, 430 114, 600 118"></path>
        <path class="wire negative" d="M245 146 C 380 146, 430 126, 600 122"></path>
        <text class="lead" x="330" y="82">
            + yellow
        </text>
        <text class="lead" x="330" y="174">
            − red
        </text>

        <circle class="junction" cx="610" cy="120" r="10"></circle>
        <text class="caption" x="610" y="160" text-anchor="middle">
            Type K junction
        </text>
    </svg>
</figure>

<style>
    /* The tint of an inset hero in the pink-orange palette, to match the stills. */
    .labjack-wiring {
        margin: 3rem 0 var(--docs-block-gap);
        padding: clamp(1.5rem, 7vw, 4rem) clamp(1rem, 8vw, 5rem);
        border-radius: 1.5rem;
        background: linear-gradient(
            135deg in oklab,
            color-mix(in oklab, #ff007b 18%, var(--pluto-gray-l2)),
            color-mix(in oklab, #ff9b42 18%, var(--pluto-gray-l3))
        );
        box-shadow: inset 0 0 0 1px var(--pluto-gray-l4);

        & svg {
            display: block;
            width: 100%;
            height: auto;
        }
    }

    text {
        font-family: var(--pluto-font-family);
        fill: var(--pluto-gray-l10);
    }

    .title {
        font-size: 17px;
        font-weight: 500;
    }

    .terminal {
        font-family: var(--pluto-code-font-family);
        font-size: 16px;
    }

    .caption,
    .lead {
        font-size: 14px;
        fill: var(--pluto-gray-l8);
    }

    .device {
        fill: var(--pluto-gray-l1);
        stroke: var(--pluto-gray-l5);
        stroke-width: 1.5;
    }

    .screw {
        fill: var(--pluto-gray-l4);
        stroke: var(--pluto-gray-l6);
        stroke-width: 1.5;
    }

    .slot {
        stroke: var(--pluto-gray-l8);
        stroke-width: 2.5;
        stroke-linecap: round;
    }

    .cable {
        stroke: var(--pluto-gray-l7);
        stroke-width: 8;
        stroke-linecap: round;
    }

    .wire {
        fill: none;
        stroke-width: 5;
        stroke-linecap: round;
    }

    .positive {
        stroke: #f4ca25;
    }

    .negative {
        stroke: #f5242e;
    }

    .junction {
        fill: var(--pluto-gray-l7);
        stroke: var(--pluto-gray-l9);
        stroke-width: 1.5;
    }
</style>
