import Inline from "@/components/code/Inline.astro";
const { os } = Astro.props;

const version = await Astro.locals.releases.latest("core");
const code = `sudo synnax update --file ./synnax-v${version}-${os.toLowerCase()}`;
---

<Inline lang="bash" code={code} theme="css-variables" />
