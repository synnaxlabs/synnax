import { Flex } from "@synnaxlabs/lyra/flex";
import { Icon } from "@synnaxlabs/lyra/icon";
import { Text } from "@synnaxlabs/lyra/text";
import "@/styles/release-diagrams.css";
import {
    type Release,
    releaseAnchor,
    releaseDate,
    releaseLinks,
} from "@/util/releaseNotes";

interface Props extends Release {
    title: string;
    breakingChanges?: boolean;
}

const { version, title, breakingChanges, desktopVersion } = Astro.props;
let { date } = Astro.props;
if (date == null) {
    const publishedAt = await Astro.locals.releases.publishedAt("core", version);
    if (publishedAt != null) date = releaseDate(publishedAt);
}
const majorMinor = (v: string) => v.split(".").slice(0, 2).join(".");
const firstPart = majorMinor(version);
const links = releaseLinks({ ...Astro.props, date });
---

<div class="release-frame">
    <Flex.Box direction="x" id={releaseAnchor(version)} className="release" empty>
        <Flex.Box direction="y" className="meta" align="start" gap="large">
            <Flex.Box direction="y" className="info" empty>
                <Text.Text level="h3" weight={500}>
                    Version {firstPart}
                </Text.Text>
                {desktopVersion != null && (
                    <Text.Text className="desktop-version" href={links?.desktop}>
                        Desktop {majorMinor(desktopVersion)}
                    </Text.Text>
                )}
                <Text.Text color={8}>{date ?? "Unreleased"}</Text.Text>
                {breakingChanges ? (
                    <Text.Text className="breaking-changes" level="small">
                        Breaking changes
                    </Text.Text>
                ) : (
                    <Text.Text className="no-breaking-changes" level="small">
                        No breaking changes
                    </Text.Text>
                )}
            </Flex.Box>
            {links != null && (
                <Flex.Box direction="x" className="links" align="center" gap="large">
                    <Text.Text href={links.github}>
                        <Icon.Logo.Github className="link" />
                    </Text.Text>
                    <Text.Text href={links.python}>
                        <Icon.Python className="link" />
                    </Text.Text>
                    {links.typescript != null && (
                        <Text.Text href={links.typescript}>
                            <Icon.TypeScript className="link" />
                        </Text.Text>
                    )}
                </Flex.Box>
            )}
        </Flex.Box>
        <Flex.Box direction="y" className="details">
            <Text.Text level="h2" className="title">
                {title}
            </Text.Text>
            <article>
                <slot />
            </article>
        </Flex.Box>
    </Flex.Box>
</div>

<style is:global>
    /* The notes keep at least 100rem, which fits a code block. The version column
       shrinks first, to 32rem. Below both, the version moves above the notes. The sum
       is above the widest page that hides the History list, so the layout never
       returns to two columns as the window narrows. */
    .release-frame {
        container: release / inline-size;
    }

    .release {
        padding: 10rem 0;
        max-width: 1150px;
        position: relative;
        margin: 0 auto;

        > .meta {
            height: fit-content;
            position: sticky;
            top: 120px;
            padding-top: 1rem;
            padding-left: 3rem;
            flex: 1 1 375px;
            min-width: 32rem;
        }

        > .details {
            flex: 3 0 100rem;
            min-width: 0;
        }

        .desktop-version {
            color: var(--pluto-gray-l10);

            &:hover {
                color: var(--pluto-gray-l11);
            }
        }

        .breaking-changes {
            color: var(--pluto-error-z);
        }

        .no-breaking-changes {
            color: var(--pluto-success-z);
        }

        .link {
            height: 3.25rem;
            width: 3.25rem;

            &.lyra-icon--logo-github {
                transform: scale(1.2);
            }

            color: var(--pluto-gray-l7);
            transition: all 0.2s ease-in-out;

            &:hover {
                color: var(--pluto-gray-l10);
            }
        }
    }

    @container release (width < 132rem) {
        .release.release {
            flex-direction: column;
            max-width: 125rem;

            > .meta {
                position: static;
                flex: none;
                min-width: 0;
                padding: 0 0 5rem;
                flex-flow: row wrap;
                align-items: flex-end;
                justify-content: space-between;
                gap: 2rem 4rem;
            }

            > .meta > .info {
                flex-flow: row wrap;
                align-items: baseline;
                column-gap: 3rem;

                > h3 {
                    flex-basis: 100%;
                    margin-bottom: 1rem;
                }
            }

            > .details {
                flex: none;
            }

            > .details > .title {
                margin-top: 0;
            }
        }
    }
</style>
