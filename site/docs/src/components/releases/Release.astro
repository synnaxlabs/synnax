import { Flex } from "@synnaxlabs/lyra/flex";
import { Icon } from "@synnaxlabs/lyra/icon";
import { Text } from "@synnaxlabs/lyra/text";
import "@/styles/release-diagrams.css";
import { releaseAnchor } from "@/util/releaseNotes";
const {
    date,
    version,
    title,
    breakingChanges,
    npmVersion = version,
    desktopVersion,
} = Astro.props;
const majorMinor = (v: string) => v.split(".").slice(0, 2).join(".");
const firstPart = majorMinor(version);
const [major, minor] = version.split(".").map(Number);
// From v0.59, each product has its own tag, and the Core's tag stands for the release.
const tag = major === 0 && minor < 59 ? `synnax-v${version}` : `core/v${version}`;
---

<Flex.Box direction="x" id={releaseAnchor(version)} className="release" empty>
    <Flex.Box direction="y" className="meta" align="start" gap="large">
        <Flex.Box direction="y" empty>
            <Text.Text level="h3" weight={500}>
                Version {firstPart}
            </Text.Text>
            {desktopVersion != null && (
                <Text.Text
                    className="desktop-version"
                    href={`https://github.com/synnaxlabs/synnax/releases/tag/desktop/v${desktopVersion}`}
                >
                    Desktop {majorMinor(desktopVersion)}
                </Text.Text>
            )}
            <Text.Text color={8}>{date}</Text.Text>
            {breakingChanges ? (
                <Text.Text className="breaking-changes" level="small">
                    Breaking changes
                </Text.Text>
            ) : (
                <Text.Text className="no-breaking-changes" level="small">
                    No breaking changes
                </Text.Text>
            )}
        </Flex.Box>
        <Flex.Box direction="x" align="center" gap="large">
            <Text.Text href={`https://github.com/synnaxlabs/synnax/tree/${tag}`}>
                <Icon.Logo.Github className="link" />
            </Text.Text>
            <Text.Text href={`https://pypi.org/project/synnax/${firstPart}/`}>
                <Icon.Python className="link" />
            </Text.Text>
            {npmVersion != null && (
                <Text.Text
                    href={`https://npmjs.com/package/@synnaxlabs/client/v/${npmVersion}`}
                >
                    <Icon.TypeScript className="link" />
                </Text.Text>
            )}
        </Flex.Box>
    </Flex.Box>
    <Flex.Box direction="y" className="details">
        <Text.Text level="h2" className="title">
            {title}
        </Text.Text>
        <article>
            <slot />
        </article>
    </Flex.Box>
</Flex.Box>

<style is:global>
    .release {
        padding: 10rem 0;
        max-width: 1150px;
        position: relative;
        margin: 0 auto;

        .meta {
            height: fit-content;
            position: sticky;
            top: 120px;
            padding-top: 1rem;
            padding-left: 3rem;
            flex-basis: 375px;
            flex-grow: 1;
        }

        .details {
            flex-basis: 600px;
            flex-grow: 3;
            min-width: 0;
        }

        .desktop-version {
            color: var(--pluto-gray-l10);

            &:hover {
                color: var(--pluto-gray-l11);
            }
        }

        .breaking-changes {
            color: var(--pluto-error-z);
        }

        .no-breaking-changes {
            color: var(--pluto-success-z);
        }

        .link {
            height: 3.25rem;
            width: 3.25rem;

            &.lyra-icon--logo-github {
                transform: scale(1.2);
            }

            color: var(--pluto-gray-l7);
            transition: all 0.2s ease-in-out;

            &:hover {
                color: var(--pluto-gray-l10);
            }
        }
    }

    @media (width <= 800px) {
        .release {
            flex-direction: column !important;

            .meta {
                position: unset;
                flex-basis: fit-content;
                padding-left: 0;
                padding-bottom: 4rem;
            }
        }
    }
</style>
