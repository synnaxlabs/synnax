import { type Product, train } from "@/util/releases";

export interface Props {
    /** Defaults to the Core. */
    product?: Product;
    /** Shows the newest release on the train before the documented one. */
    previous?: boolean;
    /** Shows only the major and minor version, such as `0.62`. */
    train?: boolean;
}

const { product = "core", previous = false } = Astro.props;
const { releases } = Astro.locals;
const version = previous
    ? await releases.previous(product)
    : await releases.documented(product);
---

{Astro.props.train ? train(version) : version}
