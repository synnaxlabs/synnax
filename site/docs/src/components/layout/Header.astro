import { Logo } from "@synnaxlabs/lyra/logo";
import { Button } from "@synnaxlabs/lyra/button";
import { Divider } from "@synnaxlabs/lyra/divider";
import { Flex } from "@synnaxlabs/lyra/flex";
import { Icon } from "@synnaxlabs/lyra/icon";
import Search from "@/components/search/Search.astro";
import { Page } from "@/components/nav/Page";
import { REFERENCE_PAGES } from "@/pages/_nav";
import Drawer from "@synnaxlabs/site-common/Drawer.astro";
import MenuButton from "@synnaxlabs/site-common/MenuButton.astro";
const url = Astro.url.pathname;
const version = await Astro.locals.releases.latest("core").catch(() => null);
const label = version?.split(".").slice(0, -1).join(".");
---

<Flex.Box className="main-header" justify="center" align="center" el="header" empty>
    <Flex.Box className="header-row" justify="center" align="center">
        <Flex.Box
            className="header-content"
            direction="x"
            justify="between"
            align="center"
        >
            <Flex.Box direction="x" align="center" gap={4}>
                <a href="https://synnaxlabs.com" class="logo-link">
                    <Logo.Logo variant="title" />
                </a>
                <Flex.Box direction="x" className="header-nav" align="center" gap={1}>
                    <Button.Button
                        variant="text"
                        className={`nav-link ${url.includes("reference") ? "nav-link--active" : ""}`}
                        href="/reference/"
                    >
                        Reference
                    </Button.Button>
                    <Button.Button
                        variant="text"
                        className={`nav-link ${url.includes("blog") ? "nav-link--active" : ""}`}
                        href="/blog/"
                    >
                        Blog
                    </Button.Button>
                    <Button.Button
                        variant="text"
                        className={`nav-link ${url.includes("releases") ? "nav-link--active" : ""}`}
                        href="/releases/"
                    >
                        Releases
                    </Button.Button>
                    <Button.Button
                        variant="text"
                        className={`nav-link ${url.includes("reliability") ? "nav-link--active" : ""}`}
                        href="/reliability/"
                    >
                        Reliability
                    </Button.Button>
                </Flex.Box>
            </Flex.Box>
            <Flex.Box direction="x" align="center" gap="small">
                <Search />
                <Button.Button
                    className="version-button"
                    variant="outlined"
                    href="https://github.com/synnaxlabs/synnax"
                >
                    <p class="version">{label}</p>
                    <Icon.Logo.Github />
                </Button.Button>
                <Button.Button
                    className="login-button"
                    variant="filled"
                    href="https://portal.synnaxlabs.com/login"
                >
                    Log in
                </Button.Button>
                <MenuButton />
                <Drawer home="https://synnaxlabs.com">
                    <div class="mobile-drawer-links">
                        <a href="/reference/" class="mobile-drawer-link">
                            Reference
                        </a>
                        <a href="/blog/" class="mobile-drawer-link">
                            Blog
                        </a>
                        <a href="/releases/" class="mobile-drawer-link">
                            Releases
                        </a>
                        <a href="/reliability/" class="mobile-drawer-link">
                            Reliability
                        </a>
                        <Divider.Divider x className="mobile-drawer-divider" />
                        <span class="mobile-drawer-section-label">Reference</span>
                    </div>
                    <div class="mobile-drawer-tree">
                        <Page nodes={REFERENCE_PAGES} currentPage={url} />
                    </div>
                </Drawer>
            </Flex.Box>
        </Flex.Box>
    </Flex.Box>
</Flex.Box>

<style is:global>
    /* The inset of the header content, which the drawer and the outline bar share. */
    :root {
        --header-inset: 7rem;
    }

    .main-header {
        z-index: 4;
        position: sticky;
        top: 0;

        /* A backdrop filter on the header would contain the drawer's fixed position,
        so the closed drawer would widen the page. */
        &::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: -1;
            background: var(--pluto-gray-l1-80);
            -webkit-backdrop-filter: blur(3rem);
            backdrop-filter: blur(3rem);
        }

        .header-row {
            height: var(--nav-height);
            border-bottom: var(--pluto-border);
            border-color: var(--pluto-gray-l4);
            width: 100%;
        }

        .header-content {
            width: 100%;
            max-width: var(--max-width);
            padding: 0 var(--header-inset);
        }

        /* The link fills the header height without moving the logo, so the full
           height is a touch target. */
        .logo-link {
            --logo-height: 4.5rem;

            text-decoration: none;
            display: flex;
            align-items: center;
            padding-block: calc((var(--nav-height) - var(--logo-height)) / 2);
            margin-block: calc((var(--logo-height) - var(--nav-height)) / 2);

            & .synnax-logo--title {
                height: var(--logo-height);
            }
        }

        .nav-link {
            font-size: var(--pluto-small-size);
            font-weight: 400;
            color: var(--pluto-gray-l8);
            text-decoration: none;

            &:hover {
                color: var(--pluto-gray-l10);
                text-decoration: none;
            }
        }

        .nav-link--active {
            color: var(--pluto-gray-l10);
        }

        .login-button {
            text-decoration: none;
            font-size: 2rem;
            font-weight: 500;
        }

        .version-button {
            text-decoration: none;

            & p {
                color: var(--pluto-gray-l8);
                font-size: var(--pluto-small-size);
                font-weight: 400;
                text-decoration: none;
            }

            & .lyra-icon {
                color: var(--pluto-gray-l9);
                height: 2.5rem;
                width: 2.5rem;
            }
        }

        .mobile-menu-btn,
        .mobile-drawer {
            display: none;
        }

        .mobile-drawer {
            --mobile-drawer-inset: var(--header-inset);
        }
    }

    .mobile-drawer-tree {
        flex: 1;
        overflow-y: auto;
        padding-bottom: 2rem;

        .lyra-tree {
            max-height: calc(100vh - 15rem);
            padding-top: 5rem;
            mask-image: linear-gradient(
                to bottom,
                transparent 0,
                black 5rem,
                black calc(100% - 5rem),
                transparent 100%
            );
        }
    }

    @media (pointer: coarse) {
        .mobile-drawer-tree .lyra-list__item {
            padding-top: 1.75rem;
            padding-bottom: 1.75rem;
        }
    }

    /* The menu opens the page list wherever the page nav sidebar is hidden. */
    @media (width <= 1023px) {
        .main-header {
            .mobile-menu-btn {
                display: flex;
            }

            .mobile-drawer {
                display: flex;
            }
        }
    }

    @media (width <= 800px) {
        :root {
            --header-inset: 3rem;
        }

        .main-header {
            .header-nav {
                display: none;
            }

            .version-button {
                display: none;
            }

            /* Search matches the menu button: a bare icon that fills the header
               height. */
            .search-box button {
                width: var(--nav-height);
                height: var(--nav-height);
                border-color: transparent;
                background: none;
            }

            .search-box button > .lyra-icon {
                font-size: 3rem;
                color: var(--pluto-gray-l9);
            }
        }
    }

    @media (width <= 800px) and (hover: none) {
        .main-header {
            z-index: 100;
            position: fixed;
            top: 0;
            width: 100%;
        }

        body {
            padding-top: var(--nav-height);
        }
    }
</style>
