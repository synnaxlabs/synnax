---

<dl class="problem__body">
    <slot />
</dl>

<style is:global>
    .problem__body {
        display: grid;
        grid-template-columns: max-content minmax(0, 1fr);
        align-items: baseline;
        gap: 1rem 3rem;
        margin: 2rem 0 4rem;
    }

    .problem__label {
        font-size: var(--pluto-small-size);
        font-weight: 500;
        color: var(--pluto-gray-l8);
    }

    .problem__value {
        margin: 0;
        color: var(--docs-body-color);

        & > :first-child {
            margin-top: 0;
        }

        & > :last-child {
            margin-bottom: 0;
        }
    }

    /* A phone puts each label above its value, so the value keeps the full width. */
    @media (max-width: 600px) {
        .problem__body {
            grid-template-columns: minmax(0, 1fr);
            gap: 0.5rem;
        }

        .problem__value + .problem__label {
            margin-top: 1.5rem;
        }
    }
</style>
