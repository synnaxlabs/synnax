interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
---

<header class="index-hero">
    <div class="index-hero__copy">
        <h1>{title}</h1>
        <p>{description}</p>
        {Astro.slots.has("default") && (
            <div class="index-hero__links">
                <slot />
            </div>
        )}
    </div>
    <div class="index-hero__art" aria-hidden="true">
        <slot name="art" />
    </div>
</header>

<style>
    .index-hero {
        container-type: inline-size;
        position: relative;
        isolation: isolate;
        display: flex;
        align-items: center;
        width: 100%;
        margin-bottom: 4rem;
    }

    .index-hero__copy {
        position: relative;
        z-index: 1;
        width: min(100%, 420px);
        padding-block: 10rem 6rem;
    }

    .index-hero__copy::before {
        content: "";
        position: absolute;
        z-index: -1;
        inset: -60px -120px -60px -100px;
        background: var(--pluto-gray-l0);
        opacity: 0.35;
        mask-image: radial-gradient(ellipse, black, transparent 78%);
        pointer-events: none;
    }

    h1 {
        margin: 0;
        font-size: var(--pluto-h1-size);
        font-weight: 550;
        line-height: 1.2;
        letter-spacing: -0.03em;
        color: var(--pluto-gray-l10);
    }

    p {
        max-width: 340px;
        margin: 2rem 0 0;
        color: var(--pluto-gray-l9);
        font-size: 16px;
        line-height: 1.65;
        text-wrap: pretty;
    }

    .index-hero__links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        margin-top: 22px;
        font-size: 12px;
        line-height: 1.5;
    }

    .index-hero__links :global(a) {
        color: var(--pluto-gray-l9);
        text-decoration: none;
        text-underline-offset: 4px;
        transition: color 0.15s;
    }

    .index-hero__links :global(a:hover) {
        color: var(--pluto-primary-z);
        text-decoration: underline;
    }

    .index-hero__art {
        position: absolute;
        z-index: -1;
        top: -120px;
        left: calc(50% - 60vw);
        width: 120vw;
        height: clamp(760px, 75vw, 1200px);
        display: flex;
        align-items: center;
        pointer-events: none;
        mask-image:
            linear-gradient(110deg, rgb(0 0 0 / 40%), black 75%),
            linear-gradient(
                to bottom,
                transparent,
                black 12%,
                black 50%,
                transparent 96%
            );
        mask-composite: intersect;
    }

    .index-hero__art :global(svg) {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    @container (width < 620px) {
        p {
            font-size: 15px;
        }
    }

    @container (width < 480px) {
        .index-hero__copy {
            width: 100%;
            padding: 6rem 0 4rem;
        }

        .index-hero__art {
            top: -80px;
            left: calc(50% - 700px);
            width: 1400px;
            height: 880px;
        }

        p {
            max-width: 300px;
            margin-top: 12px;
        }
    }
</style>
