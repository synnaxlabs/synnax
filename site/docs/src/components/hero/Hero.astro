import { Image, type ImageProps, Video } from "@/components/media/Media";

interface Rect {
    x: number;
    y: number;
    width: number;
    height: number;
}

interface Still {
    version: string;
    stills: { window: Partial<Record<string, Rect>> };
}

/** The version and regions Studio recorded for each hero still, by Studio id. */
const STILLS: Record<string, Still> = Object.fromEntries(
    Object.entries(
        import.meta.glob<Still>("./stills/**/*.json", {
            eager: true,
            import: "default",
        }),
    ).map(([file, still]) => [file.slice("./stills/".length, -".json".length), still]),
);

const PALETTES = {
    "blue-violet": ["#3774d0", "#a855f7"],
    "violet-pink": ["#7c3aed", "#ff007b"],
    "pink-orange": ["#ff007b", "#ff9b42"],
    "teal-blue": ["#0fa3a3", "#3774d0"],
    "blue-pink": ["#3774d0", "#ff007b"],
    "orange-yellow": ["#ff9b42", "#f4ca25"],
    "violet-blue": ["#a855f7", "#3774d0"],
    "green-blue": ["#50c878", "#3774d0"],
    "red-orange": ["#f5242e", "#ff9b42"],
    "green-teal": ["#50c878", "#0fa3a3"],
    "teal-violet": ["#0fa3a3", "#a855f7"],
} as const;

interface BaseProps {
    /**
     * `soft` is a muted diagonal between the two colors. `deep` glows them from
     * opposite corners of a dark base.
     */
    tone: "soft" | "deep";
    /** The two colors of the gradient. */
    palette: keyof typeof PALETTES;
}

interface StillProps extends BaseProps {
    /** The Studio id of a hero still, from a `hero` entry in `studio/videos.ts`. */
    still: string;
    /**
     * Where the window sits on the gradient. `bleed` runs it off the right and bottom
     * edges. `layered` dims that window and lifts its bottom toolbar out in front.
     * `centered` runs it off the bottom edge only.
     */
    layout: "bleed" | "layered" | "centered";
}

/**
 * Where a picture or video that Studio did not capture sits on the gradient. `framed`
 * shows all of it, with the gradient on every side. `bleed` runs it off the right and
 * bottom edges, for media whose subject is at its top left.
 */
type MediaLayout = "framed" | "bleed";

interface ImageMediaProps extends BaseProps {
    /** A docs image id, for a picture that Studio did not capture. */
    image: string;
    themed?: boolean;
    extension?: ImageProps["extension"];
    layout: MediaLayout;
}

interface VideoMediaProps extends BaseProps {
    /** A docs video id, for a video that Studio did not capture. */
    video: string;
    themed?: boolean;
    layout: MediaLayout;
}

export type Props = StillProps | ImageMediaProps | VideoMediaProps;

const props = Astro.props;
const { layout, tone, palette } = props;
const [from, to] = PALETTES[palette];
let toolbar: Rect | undefined;
let still: string | undefined;
if ("still" in props) {
    const recorded = STILLS[props.still];
    if (recorded == null)
        throw new Error(
            `no hero still ${props.still}: add a hero entry to studio/videos.ts and run pnpm batch`,
        );
    still = `${props.still}/${recorded.version}/window`;
    toolbar = recorded.stills.window.toolbar;
    if (layout === "layered" && toolbar == null)
        throw new Error(
            `the ${props.still} still records no toolbar for the layered layout`,
        );
}
const style = [
    `--from: ${from}`,
    `--to: ${to}`,
    ...(toolbar != null
        ? [
              `--toolbar-x: ${toolbar.x}`,
              `--toolbar-y: ${toolbar.y}`,
              `--toolbar-width: ${toolbar.width}`,
              `--toolbar-height: ${toolbar.height}`,
          ]
        : []),
].join("; ");
---

<div class:list={["docs-hero", layout, tone, { media: still == null }]} style={style}>
    <div class="window">
        {still != null ? (
            <Image id={still} extension="webp" loading="eager" />
        ) : "image" in props ? (
            <Image
                id={props.image}
                themed={props.themed}
                extension={props.extension}
                loading="eager"
            />
        ) : (
            "video" in props && <Video id={props.video} themed={props.themed} />
        )}
    </div>
    {layout === "layered" && still != null && (
        <div class="toolbar">
            <Image id={still} extension="webp" loading="eager" />
        </div>
    )}
</div>

<style>
    .docs-hero {
        position: relative;
        overflow: hidden;
        container-type: inline-size;
        aspect-ratio: 16 / 10;
        margin: 5rem 0 var(--docs-block-gap);
        border-radius: 2rem;
        box-shadow: inset 0 0 0 1px rgb(255 255 255 / 8%);

        @media (width > 1100px) {
            width: calc(100% + 10rem);
            margin-inline: -5rem;
        }

        /* Sizes are in CSS pixels at the 792 px desktop width, and scale with it. */
        & > * {
            --px: calc(100cqw / 792);
        }
    }

    /* Turns `from` back and `to` forward in hue and lightens `to`, which keeps the two
       colors apart at half strength when `to` follows `from` on the hue wheel. */
    .soft {
        --a: oklch(from var(--from) l c calc(h - 18));
        --b: oklch(from var(--to) l c calc(h + 18));

        background:
            radial-gradient(90% 70% at 0% 0%, rgb(255 255 255 / 4%), transparent 60%),
            linear-gradient(
                135deg in oklab,
                color-mix(in oklab, var(--a) 52%, #2c3044),
                color-mix(in oklab, var(--b) 52%, #6b7089)
            );
    }

    .deep {
        background:
            radial-gradient(
                75% 95% at 0% 0%,
                color-mix(in oklab, var(--from) 85%, transparent),
                transparent 70%
            ),
            radial-gradient(
                70% 90% at 100% 100%,
                color-mix(in oklab, var(--to) 65%, transparent),
                transparent 70%
            ),
            #282c41;
    }

    .window,
    .toolbar {
        position: absolute;
        overflow: hidden;

        & :global(:is(img, video)) {
            display: block;
            width: 100%;
            height: auto;
            margin: 0;
            border-radius: 0;
        }
    }

    .window {
        /* A 12 px corner at full size, scaled with the window. */
        --scale: 0.75;

        border-radius: calc(12 * var(--scale) * var(--px));
        box-shadow:
            0 0 0 1px rgb(255 255 255 / 18%),
            0 24px 56px -20px rgb(10 12 40 / 40%);
    }

    :is(.bleed, .layered) .window {
        top: calc(50 * var(--px));
        left: calc(56 * var(--px));
        width: calc(960 * var(--px));
    }

    .layered .window::after {
        content: "";
        position: absolute;
        inset: 0;
        background: rgb(0 0 0 / 28%);
    }

    /* The toolbar's box in the still, shown at full size. */
    .toolbar {
        top: calc(276 * var(--px));
        left: calc(150 * var(--px));
        width: calc(var(--toolbar-width) * var(--px));
        height: calc(var(--toolbar-height) * var(--px));
        border-radius: calc(10 * var(--px));
        box-shadow: 0 40px 80px -24px rgb(0 0 20 / 75%);

        & :global(img) {
            width: calc(1280 * var(--px));
            margin-top: calc(var(--toolbar-y) * -1 * var(--px));
            margin-left: calc(var(--toolbar-x) * -1 * var(--px));
        }
    }

    /* The left of the window, at the scale of its corner. */
    .centered .window {
        --scale: 0.62;

        top: calc(54 * var(--px));
        left: calc(72 * var(--px));
        width: calc(648 * var(--px));
        height: 100%;

        & :global(img) {
            width: calc(794 * var(--px));
        }
    }

    /* Media from before Studio sits nearer the corner than a still. */
    .media.bleed .window {
        top: calc(30 * var(--px));
        left: calc(32 * var(--px));
    }

    /* The whole picture, with the gradient around it. */
    .framed {
        aspect-ratio: auto;

        & .window {
            position: relative;
            width: calc(728 * var(--px));
            margin: calc(30 * var(--px)) auto calc(34 * var(--px));
        }
    }
</style>
