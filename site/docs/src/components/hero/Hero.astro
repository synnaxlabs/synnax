import type { ComponentProps } from "astro/types";

import Image from "@/components/media/Image.astro";
import { Video } from "@/components/media/Media";

interface Rect {
    x: number;
    y: number;
    width: number;
    height: number;
}

interface Still {
    version: string;
    width: number;
    height: number;
    /** The regions of each still, by the name the capture gave the still. */
    stills: Partial<Record<string, Partial<Record<string, Rect>>>>;
}

/** The space kept around a zoomed region, in pixels of the still. */
const REGION_MARGIN = 16;
/** The smallest area a zoomed hero shows, so a small region keeps its surroundings. */
const MIN_REGION = { width: 560, height: 320 };

/** grow widens [start, start + size) to at least `min` around its center, in [0, max). */
const grow = (
    start: number,
    size: number,
    min: number,
    max: number,
): [number, number] => {
    const width = Math.min(Math.max(size, min), max);
    const from = Math.min(Math.max(start + size / 2 - width / 2, 0), max - width);
    return [from, width];
};

/** The version and regions Studio recorded for each hero still, by Studio id. */
const STILLS: Record<string, Still> = Object.fromEntries(
    Object.entries(
        import.meta.glob<Still>("./stills/**/*.json", {
            eager: true,
            import: "default",
        }),
    ).map(([file, still]) => [file.slice("./stills/".length, -".json".length), still]),
);

const PALETTES = {
    "blue-violet": ["#3774d0", "#a855f7"],
    "violet-pink": ["#7c3aed", "#ff007b"],
    "pink-orange": ["#ff007b", "#ff9b42"],
    "teal-blue": ["#0fa3a3", "#3774d0"],
    "blue-pink": ["#3774d0", "#ff007b"],
    "orange-yellow": ["#ff9b42", "#f4ca25"],
    "violet-blue": ["#a855f7", "#3774d0"],
    "green-blue": ["#50c878", "#3774d0"],
    "red-orange": ["#f5242e", "#ff9b42"],
    "green-teal": ["#50c878", "#0fa3a3"],
    "teal-violet": ["#0fa3a3", "#a855f7"],
} as const;

interface BaseProps {
    /** The two colors of the gradient. */
    palette: keyof typeof PALETTES;
    /** Describes what the hero shows, for screen readers. */
    alt: string;
}

interface CoverProps {
    inset?: false;
    /**
     * `soft` is a muted diagonal between the two colors. `deep` glows them from
     * opposite corners of a dark base.
     */
    tone: "soft" | "deep";
}

interface InsetProps {
    /**
     * Shows a feature inside a page: in the text column, shorter, and in a faint tint
     * of the palette. A page has one hero without `inset`, at its top.
     */
    inset: true;
}

interface StillProps extends BaseProps {
    /** The Studio id of a hero still, from a `hero` entry in `studio/videos.ts`. */
    still: string;
    /** The name of the still to show, from the capture. Defaults to `window`. */
    view?: string;
    /**
     * Where the window sits on the gradient. `bleed` runs it off the right and bottom
     * edges. `layered` dims that window and lifts its bottom toolbar out in front.
     * `centered` runs it off the bottom edge only. `framed` shows all of it, for a
     * subject at the middle of the window. `zoomed` shows only `region`, enlarged, for
     * a subject too small to read in the whole window.
     */
    layout: "bleed" | "layered" | "centered" | "framed" | "zoomed";
    /** The region of the still that the `zoomed` layout shows. */
    region?: string;
}

/**
 * Where an image or a video, not a hero still, sits on the gradient. `framed` shows all
 * of it, with the gradient on every side. `bleed` runs it off the right and bottom
 * edges, for media whose subject is at its top left.
 */
type MediaLayout = "framed" | "bleed";

interface ImageMediaProps extends BaseProps {
    /** A docs image id, for a picture that Studio did not capture. */
    image: string;
    themed?: boolean;
    extension?: ComponentProps<typeof Image>["extension"];
    layout: MediaLayout;
}

interface VideoMediaProps extends BaseProps {
    /** A docs video id. A new video must be an entry in `studio/videos.ts`. */
    video: string;
    themed?: boolean;
    layout: MediaLayout;
}

export type Props = (StillProps | ImageMediaProps | VideoMediaProps) &
    (CoverProps | InsetProps);

const props = Astro.props;
const { layout, palette, alt } = props;
const [from, to] = PALETTES[palette];
let toolbar: Rect | undefined;
let zoom: Rect | undefined;
let stillWidth = 0;
let still: string | undefined;
if ("still" in props) {
    const recorded = STILLS[props.still];
    if (recorded == null)
        throw new Error(
            `no hero still ${props.still}: add a hero entry to studio/videos.ts and run pnpm batch`,
        );
    const view = props.view ?? "window";
    const regions = recorded.stills[view];
    if (regions == null)
        throw new Error(`the ${props.still} capture records no ${view} still`);
    still = `${props.still}/${recorded.version}/${view}`;
    toolbar = regions.toolbar;
    stillWidth = recorded.width;
    if (layout === "zoomed") {
        const region = props.region != null ? regions[props.region] : undefined;
        if (region == null)
            throw new Error(
                `the ${view} still of ${props.still} records no ${props.region} region`,
            );
        const [x, width] = grow(
            region.x - REGION_MARGIN,
            region.width + 2 * REGION_MARGIN,
            MIN_REGION.width,
            recorded.width,
        );
        const [y, height] = grow(
            region.y - REGION_MARGIN,
            region.height + 2 * REGION_MARGIN,
            MIN_REGION.height,
            recorded.height,
        );
        zoom = { x, y, width, height };
    }
    if (layout === "layered" && toolbar == null)
        throw new Error(
            `the ${props.still} still records no toolbar for the layered layout`,
        );
    if (layout === "layered" && props.inset === true)
        throw new Error(`the ${props.still} hero cannot be both layered and inset`);
}
// The window is at most 960 of the hero's 792 units wide, and the toolbar still is 1280.
const WINDOW_SIZES = "min(122vw, 960px)";
const TOOLBAR_SIZES = "min(162vw, 1300px)";
const style = [
    `--from: ${from}`,
    `--to: ${to}`,
    ...(toolbar != null
        ? [
              `--toolbar-x: ${toolbar.x}`,
              `--toolbar-y: ${toolbar.y}`,
              `--toolbar-width: ${toolbar.width}`,
              `--toolbar-height: ${toolbar.height}`,
          ]
        : []),
    ...(zoom != null
        ? [
              `--still-width: ${stillWidth}`,
              `--region-x: ${zoom.x}`,
              `--region-y: ${zoom.y}`,
              `--region-width: ${zoom.width}`,
              `--region-height: ${zoom.height}`,
          ]
        : []),
].join("; ");
---

<div
    class:list={[
        "docs-hero",
        layout,
        props.inset === true ? "inset" : props.tone,
        { media: still == null },
    ]}
    style={style}
>
    <div class="window">
        {still != null ? (
            <Image id={still} extension="webp" alt={alt} sizes={WINDOW_SIZES} />
        ) : "image" in props ? (
            <Image
                id={props.image}
                themed={props.themed}
                extension={props.extension}
                alt={alt}
                sizes={WINDOW_SIZES}
            />
        ) : (
            "video" in props && (
                <Video id={props.video} themed={props.themed} label={alt} />
            )
        )}
    </div>
    {layout === "layered" && still != null && (
        <div class="toolbar">
            <Image id={still} extension="webp" alt="" sizes={TOOLBAR_SIZES} />
        </div>
    )}
</div>

<style>
    .docs-hero {
        position: relative;
        overflow: hidden;
        container-type: inline-size;
        aspect-ratio: 16 / 10;
        margin: 5rem 0 var(--docs-block-gap);
        border-radius: 2rem;
        box-shadow: inset 0 0 0 1px rgb(255 255 255 / 8%);

        @media (width > 1100px) {
            &:not(.inset) {
                width: calc(100% + 10rem);
                margin-inline: -5rem;
            }
        }

        /* Sizes are in CSS pixels at the 792 px desktop width, and scale with it. */
        & > * {
            --px: calc(100cqw / 792);
        }
    }

    /* Turns `from` back and `to` forward in hue and lightens `to`, which keeps the two
       colors apart at half strength when `to` follows `from` on the hue wheel. */
    .soft,
    .inset {
        --a: oklch(from var(--from) l c calc(h - 18));
        --b: oklch(from var(--to) l c calc(h + 18));
    }

    .soft {
        background:
            radial-gradient(90% 70% at 0% 0%, rgb(255 255 255 / 4%), transparent 60%),
            linear-gradient(
                135deg in oklab,
                color-mix(in oklab, var(--a) 52%, #2c3044),
                color-mix(in oklab, var(--b) 52%, #6b7089)
            );
    }

    .deep {
        background:
            radial-gradient(
                75% 95% at 0% 0%,
                color-mix(in oklab, var(--from) 85%, transparent),
                transparent 70%
            ),
            radial-gradient(
                70% 90% at 100% 100%,
                color-mix(in oklab, var(--to) 65%, transparent),
                transparent 70%
            ),
            #282c41;
    }

    .window,
    .toolbar {
        position: absolute;
        overflow: hidden;

        & :global(:is(img, video)) {
            display: block;
            width: 100%;
            height: auto;
            margin: 0;
            border-radius: 0;
        }
    }

    .window {
        /* A 12 px corner at full size, scaled with the window. */
        --scale: 0.75;

        border-radius: calc(12 * var(--scale) * var(--px));
        box-shadow:
            0 0 0 1px rgb(255 255 255 / 18%),
            0 24px 56px -20px rgb(10 12 40 / 40%);
    }

    :is(.bleed, .layered) .window {
        top: calc(50 * var(--px));
        left: calc(56 * var(--px));
        width: calc(960 * var(--px));
    }

    .layered .window::after {
        content: "";
        position: absolute;
        inset: 0;
        background: rgb(0 0 0 / 28%);
    }

    /* The toolbar's box in the still, shown at full size. */
    .toolbar {
        top: calc(276 * var(--px));
        left: calc(150 * var(--px));
        width: calc(var(--toolbar-width) * var(--px));
        height: calc(var(--toolbar-height) * var(--px));
        border-radius: calc(10 * var(--px));
        box-shadow: 0 40px 80px -24px rgb(0 0 20 / 75%);

        & :global(img) {
            width: calc(1280 * var(--px));
            margin-top: calc(var(--toolbar-y) * -1 * var(--px));
            margin-left: calc(var(--toolbar-x) * -1 * var(--px));
        }
    }

    /* The left of the window, at the scale of its corner. */
    .centered .window {
        --scale: 0.62;

        top: calc(54 * var(--px));
        left: calc(72 * var(--px));
        width: calc(648 * var(--px));
        height: 100%;

        & :global(img) {
            width: calc(794 * var(--px));
        }
    }

    /* Media from before Studio sits nearer the corner than a still. */
    .media.bleed:not(.inset) .window {
        top: calc(30 * var(--px));
        left: calc(32 * var(--px));
    }

    /* The whole picture, with the gradient around it. */
    .framed {
        aspect-ratio: auto;

        & .window {
            position: relative;
            width: calc(728 * var(--px));
            margin: calc(30 * var(--px)) auto calc(34 * var(--px));
        }

        &:not(.media, .inset) .window {
            --scale: 0.57;
        }
    }

    /* The region of the still, enlarged to the width of a framed window. */
    .zoomed {
        aspect-ratio: auto;

        & .window {
            --zoom: calc(728 / var(--region-width));

            position: relative;
            width: calc(728 * var(--px));
            height: calc(var(--region-height) * var(--zoom) * var(--px));
            margin: calc(30 * var(--px)) auto calc(34 * var(--px));

            & :global(img) {
                width: calc(var(--still-width) * var(--zoom) * var(--px));
                max-width: none;
                margin-top: calc(var(--region-y) * var(--zoom) * -1 * var(--px));
                margin-left: calc(var(--region-x) * var(--zoom) * -1 * var(--px));
            }
        }
    }

    /* Over the page gray, so it follows the theme and stays quieter than the cover. */
    .inset {
        margin-top: 3rem;
        border-radius: 1.5rem;
        background: linear-gradient(
            135deg in oklab,
            color-mix(in oklab, var(--a) 26%, var(--pluto-gray-l2)),
            color-mix(in oklab, var(--b) 26%, var(--pluto-gray-l3))
        );
        box-shadow: inset 0 0 0 1px var(--pluto-gray-l4);

        &:not(.framed, .zoomed) {
            aspect-ratio: 12 / 5;
        }

        &.bleed .window {
            --scale: 0.61;

            top: calc(36 * var(--px));
            left: calc(40 * var(--px));
            width: calc(780 * var(--px));
        }

        &.framed .window {
            --scale: 0.47;

            width: calc(600 * var(--px));
            margin: calc(28 * var(--px)) auto;
        }
    }
</style>
