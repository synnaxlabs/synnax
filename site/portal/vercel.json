{
  "installCommand": "npx --yes pnpm@12.14.0 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@12.14.0 --dir ../.. build:portal && npm run db:migrate",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/expiry",
      "schedule": "0 9 * * *"
    }
  ]
}
