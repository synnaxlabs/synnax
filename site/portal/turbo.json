{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "src/**",
        "public/**",
        "astro.config.ts",
        "tsconfig*.json",
        "package.json"
      ],
      "env": ["LICENSE_KID", "MAIL_FROM", "VERCEL_ENV"]
    },
    "lint": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/{lyra,pluto,console,site/*}/src/**",
        "$TURBO_ROOT$/{lyra,pluto,console,site/*}/index.html"
      ]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/core/pkg/service/license/testdata/**"]
    },
    "cov": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/core/pkg/service/license/testdata/**"]
    }
  }
}
