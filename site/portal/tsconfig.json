{
  "extends": "@synnaxlabs/tsconfig/base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "types": ["react", "react-dom"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "scripts/**/*",
    "drizzle.config.ts",
