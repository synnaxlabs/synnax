import Portal from "@/layouts/Portal.astro";
import { loadScoped } from "@/page";
import { Licenses } from "@/ui/licenses";
import { listForOrganization } from "@/server/license/list";

const loaded = await loadScoped(Astro, "team");
if (loaded instanceof Response) return loaded;
const { portal, session, organizations, scope } = loaded;
const licenses = await listForOrganization(portal.store.query, scope.key);
---

<Portal
    title="Licenses"
    session={session}
    organizations={organizations}
    scope={scope}
    tab="licenses"
>
    <Licenses.Licenses
        client:load
        organization={scope}
        licenses={licenses}
        now={portal.now()}
    />
</Portal>
