import Portal from "@/layouts/Portal.astro";
import { licenseFor } from "@/access";
import { failure, loadScoped } from "@/page";
import { Page } from "@/ui/Page";
import { License } from "@/ui/licenses/License";
import { listForLicense } from "@/server/event";

const loaded = await loadScoped(Astro);
if (loaded instanceof Response) return loaded;
const { portal, session, organizations, scope } = loaded;

let error: string | undefined;
let view: Awaited<ReturnType<typeof licenseFor>> | undefined;
let events: Awaited<ReturnType<typeof listForLicense>> = [];
let actors: Record<string, string> = {};
try {
    view = await licenseFor(portal, session, Astro.params.key ?? "");
    events = await listForLicense(portal.store, view.license.key);
    const machines = new Set(view.activations.map((a) => a.key));
    actors = await portal.directory.names(
        [...new Set(events.map((e) => e.actor))].filter((a) => !machines.has(a)),
    );
} catch (err) {
    const f = failure(err);
    Astro.response.status = f.status;
    error = f.message;
}
---

<Portal
    title={view?.license.label ?? "License"}
    session={session}
    organizations={organizations}
    scope={view?.organization ?? scope}
    tab={view == null ? null : "licenses"}
>
    {view == null ? (
        <Page title="License" error={error} />
    ) : (
        <License
            client:load
            license={view.license}
            organization={view.organization}
            activations={view.activations}
            events={events}
            actors={actors}
            staff={session.staff}
            now={portal.now()}
        />
    )}
</Portal>
