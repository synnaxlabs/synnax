import Portal from "@/layouts/Portal.astro";
import { loadScoped } from "@/page";
import { Licenses } from "@/ui/licenses";
import { listActivatable } from "@/server/license/list";

const loaded = await loadScoped(Astro);
if (loaded instanceof Response) return loaded;
const { portal, session, organizations, scope } = loaded;
const choices = await listActivatable(
    portal.store.query,
    organizations.filter((o) => o.kind === "team").map((o) => o.key),
    portal.now(),
);
const selected = Astro.url.searchParams.get("license");
---

<Portal
    title="Activate a machine"
    session={session}
    organizations={organizations}
    scope={scope}
    tab={scope.kind === "team" ? "licenses" : null}
>
    <Licenses.Activate
        client:load
        choices={choices}
        selected={choices.some((c) => c.license.key === selected) ? selected : null}
    />
</Portal>
