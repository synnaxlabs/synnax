import Root from "@/layouts/Root.astro";
import { load } from "@/page";
import { parse } from "@/server/license/fingerprint";
import { MAX_NAME_LENGTH } from "@/server/license/limits";
import { findActivatable, findSeat, listActivatable } from "@/server/license/list";
import { organizationsFor } from "@/server/organization";
import { Licenses } from "@/ui/licenses";
import "@/styles/portal.css";

const loaded = await load(Astro);
if (loaded instanceof Response) return loaded;
const { portal, session } = loaded;
const organizations = await organizationsFor(portal.store, session);
const choices = await listActivatable(
    portal.store.query,
    organizations.filter((o) => o.kind === "team").map((o) => o.key),
    portal.now(),
);
const params = Astro.url.searchParams;
const requested = params.get("license");
// Staff open the page from the license of a team they are not on.
if (
    session.staff &&
    requested != null &&
    !choices.some((c) => c.license.key === requested)
) {
    const found = await findActivatable(portal.store.query, requested, portal.now());
    if (found != null) choices.unshift(found);
}
const raw = params.get("fingerprint");
let fingerprint: string[] | null = null;
try {
    if (raw != null) fingerprint = parse(raw);
} catch {
    // The page asks for the fingerprint again.
}
const seat =
    fingerprint == null
        ? undefined
        : await findSeat(
              portal.store.query,
              choices.map((c) => c.license.key),
              fingerprint,
          );
const opened = seat?.license ?? requested;
const name = (seat?.name ?? params.get("name") ?? "").slice(0, MAX_NAME_LENGTH);
---

<Root title="Activate a machine" userID={session.userID}>
    <section class="portal-auth-page portal-auth-page--wide">
        <Licenses.Activate
            client:load
            choices={choices}
            selected={choices.some((c) => c.license.key === opened) ? opened : null}
            machine={
                fingerprint == null
                    ? null
                    : { fingerprint, name, seat: seat?.license ?? null }
            }
            damaged={raw != null && fingerprint == null}
            handoff={params.get("handoff")}
            email={session.email}
        />
    </section>
</Root>
