import Portal from "@/layouts/Portal.astro";
import { requireStaff } from "@/access";
import { failure, loadScoped } from "@/page";
import { Page } from "@/ui/Page";
import { Licenses } from "@/ui/admin/Licenses";
import { type Owned, listAll } from "@/server/license/list";
import { type Listed } from "@/server/directory";

const loaded = await loadScoped(Astro);
if (loaded instanceof Response) return loaded;
const { portal, session, organizations, scope } = loaded;

let error: string | undefined;
let teams: Listed[] = [];
let licenses: Owned[] = [];
try {
    requireStaff(session);
    teams = await portal.directory.teams();
    licenses = await listAll(portal.store.query);
} catch (err) {
    const f = failure(err);
    Astro.response.status = f.status;
    error = f.message;
}
---

<Portal
    title="Admin"
    session={session}
    organizations={organizations}
    scope={scope}
    tab="admin"
>
    {error != null ? (
        <Page title="All licenses" error={error} />
    ) : (
        <Licenses client:load teams={teams} licenses={licenses} now={portal.now()} />
    )}
</Portal>
