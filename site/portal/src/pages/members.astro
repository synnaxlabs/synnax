import Portal from "@/layouts/Portal.astro";
import { loadScoped } from "@/page";
import { Members } from "@/ui/members";

const loaded = await loadScoped(Astro, "team");
if (loaded instanceof Response) return loaded;
const { portal, session, organizations, scope } = loaded;
if (scope.clerkOrgID == null)
    throw new Error(`team ${scope.key} has no Clerk organization`);
const roster = await portal.directory.roster(scope.clerkOrgID);
---

<Portal
    title="Members"
    session={session}
    organizations={organizations}
    scope={scope}
    tab="members"
>
    <Members.Members
        client:load
        name={scope.name}
        clerkOrgID={scope.clerkOrgID}
        roster={roster}
        userID={session.userID}
    />
</Portal>
