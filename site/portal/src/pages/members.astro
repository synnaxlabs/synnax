import Portal from "@/layouts/Portal.astro";
import { loadScoped } from "@/page";
import { ADMIN_ROLE } from "@/server/directory";
import { list } from "@/server/invitation";
import { Members } from "@/ui/members";

const loaded = await loadScoped(Astro, "team");
if (loaded instanceof Response) return loaded;
const { portal, session, organizations, scope } = loaded;
if (scope.clerkOrgID == null)
    throw new Error(`team ${scope.key} has no Clerk organization`);
const roster = await portal.directory.roster(scope.clerkOrgID);
const admin = roster.some((m) => m.userID === session.userID && m.role === ADMIN_ROLE);
const invitations = admin ? await list(portal.store.query, scope.key) : [];
---

<Portal
    title="Members"
    session={session}
    organizations={organizations}
    scope={scope}
    tab="members"
>
    <Members.Members
        client:load
        organization={scope}
        roster={roster}
        invitations={invitations}
        userID={session.userID}
        now={portal.now()}
    />
</Portal>
