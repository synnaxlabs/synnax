import Admin from "@/layouts/Admin.astro";
import { requireStaff, teamFor } from "@/access";
import { failure, loadScoped } from "@/page";
import { Page } from "@/ui/Page";
import { Admin as Console } from "@/ui/admin";
import { type Team } from "@/server/member";
import { type Held, listForOrganization } from "@/server/license/list";

const loaded = await loadScoped(Astro);
if (loaded instanceof Response) return loaded;
const { portal, session, organizations, scope } = loaded;

let error: string | undefined;
let team: Team | undefined;
let licenses: Held[] = [];
try {
    requireStaff(session);
    team = await teamFor(portal, session, Astro.params.key ?? "");
    licenses = await listForOrganization(portal.store.query, team.key);
} catch (err) {
    const f = failure(err);
    Astro.response.status = f.status;
    error = f.message;
    team = undefined;
}
---

<Admin
    title={team?.name ?? "Organization"}
    session={session}
    organizations={organizations}
    scope={scope}
>
    {team == null ? (
        <Page title="Organization" error={error} />
    ) : (
        <Console.Organization
            client:load
            team={team}
            tab="licenses"
            licenses={licenses}
            now={portal.now()}
        />
    )}
</Admin>
