import Admin from "@/layouts/Admin.astro";
import { requireStaff } from "@/access";
import { failure, loadScoped } from "@/page";
import { Page } from "@/ui/Page";
import { Admin as Console } from "@/ui/admin";
import { type Entry, list } from "@/server/user";

const loaded = await loadScoped(Astro);
if (loaded instanceof Response) return loaded;
const { portal, session, organizations, scope } = loaded;

let error: string | undefined;
let entries: Entry[] = [];
try {
    requireStaff(session);
    entries = await list(portal.store, portal.directory, portal.now());
} catch (err) {
    const f = failure(err);
    Astro.response.status = f.status;
    error = f.message;
}
---

<Admin
    title="Users"
    session={session}
    organizations={organizations}
    scope={scope}
    section="users"
>
    {error != null ? (
        <Page title="Users" error={error} />
    ) : (
        <Console.Users client:load entries={entries} now={portal.now()} />
    )}
</Admin>
