import Admin from "@/layouts/Admin.astro";
import { requireStaff } from "@/access";
import { failure, loadScoped } from "@/page";
import { Page } from "@/ui/Page";
import { Admin as Console } from "@/ui/admin";
import { listTeams, type Summary } from "@/server/organization";

const loaded = await loadScoped(Astro);
if (loaded instanceof Response) return loaded;
const { portal, session, organizations, scope } = loaded;

let error: string | undefined;
let teams: Summary[] = [];
try {
    requireStaff(session);
    teams = await listTeams(portal.store, portal.directory);
} catch (err) {
    const f = failure(err);
    Astro.response.status = f.status;
    error = f.message;
}
---

<Admin
    title="Organizations"
    session={session}
    organizations={organizations}
    scope={scope}
    section="organizations"
>
    {error != null ? (
        <Page title="Organizations" error={error} />
    ) : (
        <Console.Organizations client:load teams={teams} now={portal.now()} />
    )}
</Admin>
