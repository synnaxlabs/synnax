import Portal from "@/layouts/Portal.astro";
import { loadScoped } from "@/page";
import { scoped } from "@/shell";
import { Overview } from "@/ui/overview";
import { machinesFor } from "@/server/license/desktop";
import { listForOrganization } from "@/server/license/list";

const loaded = await loadScoped(Astro);
if (loaded instanceof Response) return loaded;
const { portal, session, organizations, scope } = loaded;
const team = scope.kind === "team";
const licenses = team ? await listForOrganization(portal.store.query, scope.key) : [];
const machines = team ? [] : await machinesFor(portal.store.query, scope.key);
---

<Portal
    title="Overview"
    session={session}
    organizations={organizations}
    scope={scope}
    tab="overview"
>
    {team ? (
        <Overview.Team
            client:load
            organization={scope}
            licenses={licenses}
            now={portal.now()}
        />
    ) : (
        <Overview.Personal
            client:load
            machines={machines}
            devices={scoped("/devices", scope)}
            now={portal.now()}
        />
    )}
</Portal>
