import Portal from "@/layouts/Portal.astro";
import { loadScoped } from "@/page";
import { Settings } from "@/ui/settings/Settings";

const loaded = await loadScoped(Astro);
if (loaded instanceof Response) return loaded;
const { session, organizations, scope } = loaded;
---

<Portal
    title="Settings"
    session={session}
    organizations={organizations}
    scope={scope}
    tab={null}
>
    <Settings client:load name={session.name} email={session.email} />
</Portal>
