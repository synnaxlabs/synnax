import Portal from "@/layouts/Portal.astro";
import { loadScoped } from "@/page";
import { Devices } from "@/ui/devices/Devices";
import { machinesFor } from "@/server/license/desktop";

const loaded = await loadScoped(Astro, "personal");
if (loaded instanceof Response) return loaded;
const { portal, session, organizations, scope } = loaded;
const machines = await machinesFor(portal.store.query, scope.key);
---

<Portal
    title="Devices"
    session={session}
    organizations={organizations}
    scope={scope}
    tab="devices"
>
    <Devices client:load machines={machines} now={portal.now()} />
</Portal>
