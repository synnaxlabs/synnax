import Root from "@/layouts/Root.astro";
import { landing } from "@/shell";
import { SignIn } from "@/ui/auth/SignIn";
import "@/styles/portal.css";

if (Astro.locals.auth().userId != null) return Astro.redirect("/", 303);
---

<Root title="Sign in">
    <section class="portal-auth-page">
        <SignIn client:load target={landing(Astro.url.searchParams)} />
    </section>
</Root>
