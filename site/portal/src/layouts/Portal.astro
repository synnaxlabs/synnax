import { Button } from "@synnaxlabs/lyra/button";
import { Logo } from "@synnaxlabs/media";

import Root from "@/layouts/Root.astro";
import { scoped, type Tab, tabs } from "@/shell";
import { Shell } from "@/ui/shell";
import type { Organization } from "@/server/db/schema";
import type { Session } from "@/server/session";
import "@/styles/portal.css";

interface Props {
    title: string;
    session: Session;
    organizations: Organization[];
    /** scope is the organization the page acts for. */
    scope: Organization;
    /** tab is the active tab, or null for a page outside the tab row. */
    tab: Tab | null;
}

const { title, session, organizations, scope, tab } = Astro.props;
const option = (o: Organization) => ({
    key: o.key,
    name: o.kind === "personal" ? session.name : o.name,
    kind: o.kind,
});
---

<Root title={title}>
    <header class="portal-bar">
        <div class="portal-bar__start">
            <a class="portal-bar__logo" href={scoped("/", scope)} aria-label="Synnax">
                <Logo variant="icon" />
            </a>
            <span class="portal-bar__separator" aria-hidden="true">
                /
            </span>
            <Shell.Scope
                client:load
                options={organizations.map(option)}
                selected={option(scope)}
            />
        </div>
        <div class="portal-bar__actions">
            <a class="portal-bar__link" href="https://docs.synnaxlabs.com">
                Docs
            </a>
            <Shell.Account client:load name={session.name} image={session.image} />
        </div>
    </header>
    <nav class="portal-tabs">
        {tabs(scope, session.staff).map((link) => (
            <Button.Button
                variant="text"
                weight={link.tab === tab ? 500 : 400}
                className="portal-tab"
                href={link.href}
                aria-current={link.tab === tab ? "page" : undefined}
            >
                {link.label}
            </Button.Button>
        ))}
    </nav>
    <main>
        <section class="portal">
            <slot />
        </section>
    </main>
</Root>
