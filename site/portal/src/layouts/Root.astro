import faviconICO from "@synnaxlabs/lyra/static/logo/icon-white-favicon.ico?no-inline";
import faviconSVG from "@synnaxlabs/lyra/static/logo/icon-white-favicon.svg?no-inline";
import Analytics from "@synnaxlabs/site-common/Analytics.astro";
import "@/styles/main.css";

interface Props {
    title: string;
    /** The logged-in user, to link the visitor to once cookies are on. */
    userID?: string;
}

const { title, userID } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="robots" content="noindex" />
        <link rel="icon" href={faviconICO} sizes="48x48" />
        <link rel="icon" type="image/svg+xml" href={faviconSVG} />
        <title>{title} | Synnax</title>
    </head>
    <body>
        <slot />
        <Analytics
            privacy="https://www.synnaxlabs.com/privacy"
            userID={userID}
            sensitive
        />
    </body>
</html>
