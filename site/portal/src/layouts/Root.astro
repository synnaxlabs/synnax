        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="robots" content="noindex" />
        <link rel="icon" href="/favicon.svg" />
        <title>{title} | Synnax</title>
    </head>
    <body>
        <slot />
    </body>
</html>
