import { cdn } from "@/cdn";

interface Props {
    /** The CDN path of the 2560 pixel wide encode. */
    wide: string;
    /** The CDN path of the 1280 pixel wide encode, served to narrow viewports. */
    narrow: string;
    width: number;
    height: number;
    class?: string;
}

const { wide, narrow, width, height, class: className } = Astro.props;
const sources = [{ media: "(max-width: 900px)", src: cdn(narrow) }, { src: cdn(wide) }];
---

<video
    class={className}
    width={width}
    height={height}
    muted
    loop
    playsinline
    preload="none"
    data-lazy-video
>
    {sources.map(({ media, src }) => (
        <source media={media} src={src} type="video/mp4" />
    ))}
</video>
<noscript>
    <video
        class={className}
        width={width}
        height={height}
        muted
        loop
        playsinline
        autoplay
    >
        {sources.map(({ media, src }) => (
            <source media={media} src={src} type="video/mp4" />
        ))}
    </video>
</noscript>

<style is:global>
    @media (scripting: none) {
        /* Overrides the display rule each section sets on its video. */
        video[data-lazy-video] {
            display: none !important;
        }
    }
</style>

<script>
    // Defers each download until its video is within one viewport of the screen.
    const observer = new IntersectionObserver(
        (entries) => {
            for (const { target, isIntersecting } of entries) {
                if (!isIntersecting) continue;
                const video = target as HTMLVideoElement;
                observer.unobserve(video);
                video.autoplay = true;
                video.load();
            }
        },
        { rootMargin: "100% 0px" },
    );
    document
        .querySelectorAll<HTMLVideoElement>("video[data-lazy-video]")
        .forEach((video) => observer.observe(video));
</script>
