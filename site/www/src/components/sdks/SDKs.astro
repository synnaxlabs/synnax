import { highlighter } from "@synnaxlabs/site-common/shiki";
import { EcosystemDiagram } from "@/components/sdks/EcosystemDiagram";
import { type Samples, SDKShowcase } from "@/components/sdks/SDKShowcase";
import SectionHero from "@/components/common/SectionHero.astro";

const highlight = await highlighter(["python", "typescript"]);

// -- Stream --

const pyStream = `import synnax as sy

client = sy.Synnax()

with client.open_streamer(
    ["temperature", "pressure"],
) as s:
    for frame in s:
        print(frame)`;

const tsStream = `import Synnax from "@synnaxlabs/client";

const client = new Synnax();

const streamer = await client.openStreamer(
    ["temperature", "pressure"],
);
for await (const frame of streamer) {
    console.log(frame);
}`;

// -- Write --

const pyWrite = `import synnax as sy

client = sy.Synnax()

with client.open_writer(
    sy.TimeStamp.now(),
    ["time", "sensor"],
) as w:
    w.write({
        "time": sy.TimeStamp.now(),
        "sensor": 25.3,
    })
    w.commit()`;

const tsWrite = `import Synnax from "@synnaxlabs/client";

const client = new Synnax();

const writer = await client.openWriter({
    start: TimeStamp.now(),
    channels: ["time", "sensor"],
});
await writer.write({
    time: Date.now(),
    sensor: 25.3,
});
await writer.commit();
await writer.close();`;

// -- Read --

const pyRead = `import synnax as sy

client = sy.Synnax()

data = client.read(
    sy.TimeRange(start, end),
    ["temperature", "pressure"],
)
print(data.to_df())`;

const tsRead = `import Synnax from "@synnaxlabs/client";

const client = new Synnax();

const data = await client.read(
    start.range(end),
    ["temperature", "pressure"],
);
console.log(data.at(-1));`;

const samples: Samples = {
    python: {
        stream: highlight(pyStream, "python"),
        write: highlight(pyWrite, "python"),
        read: highlight(pyRead, "python"),
    },
    typescript: {
        stream: highlight(tsStream, "typescript"),
        write: highlight(tsWrite, "typescript"),
        read: highlight(tsRead, "typescript"),
    },
};
---

<SectionHero id="sdks" label="7 -> Extend with SDKs" class="sdks">
    Build on the platform
    <Fragment slot="description">
        Use Synnax as a framework to build advanced industrial systems. Connect AI
        models, embed real-time processing, and interface with external controllers
        through native client libraries in Python and TypeScript.
    </Fragment>
</SectionHero>

<div class="sdks-content">
    <EcosystemDiagram client:visible />
    <SDKShowcase client:visible samples={samples} />
</div>

