import { Logo } from "@synnaxlabs/lyra/logo";
import { Flex } from "@synnaxlabs/lyra/flex";
import { Button } from "@synnaxlabs/lyra/button";
import { Divider } from "@synnaxlabs/lyra/divider";
import Arrow from "@/components/common/Arrow.astro";
import { Nav } from "@/components/Nav";
import Drawer from "@synnaxlabs/site-common/Drawer.astro";
import MenuButton from "@synnaxlabs/site-common/MenuButton.astro";
---

<Flex.Box className="header" el="header" justify="center" align="center" empty>
    <Flex.Box className="header-content" direction="x" justify="between" align="center">
        <a href="/" class="logo-link">
            <Logo.Logo variant="title" />
        </a>
        <Flex.Box x gap={4} align="center">
            <div class="header-nav">
                <Nav />
            </div>
            <Flex.Box x gap="small" align="center" className="header-actions">
                <Button.Button href="/#contact" className="header-contact">
                    Talk to an engineer
                </Button.Button>
                <Button.Button
                    variant="filled"
                    href="https://docs.synnaxlabs.com/releases/desktop/download"
                    data-event="desktop_download_clicked"
                    data-location="header"
                >
                    Download
                </Button.Button>
            </Flex.Box>
            <MenuButton />
        </Flex.Box>
    </Flex.Box>
</Flex.Box>

<Drawer home="/">
    <div class="mobile-drawer-links">
        <span class="mobile-drawer-section-label">Product</span>
        <a href="/#visualize" class="mobile-drawer-link mobile-product-link">
            <span class="mobile-product-section">2 &rarr;</span> Visualize and operate
        </a>
        <a href="/#automate" class="mobile-drawer-link mobile-product-link">
            <span class="mobile-product-section">3 &rarr;</span> Automate and control
        </a>
        <a href="/#review" class="mobile-drawer-link mobile-product-link">
            <span class="mobile-product-section">4 &rarr;</span> Review and analyze
        </a>
        <a href="/#stream" class="mobile-drawer-link mobile-product-link">
            <span class="mobile-product-section">5 &rarr;</span> Stream and process
        </a>
        <a href="/#integrations" class="mobile-drawer-link mobile-product-link">
            <span class="mobile-product-section">6 &rarr;</span> Device integrations
        </a>
        <a href="/#sdks" class="mobile-drawer-link mobile-product-link">
            <span class="mobile-product-section">7 &rarr;</span> Extend with SDKs
        </a>
        <Divider.Divider x className="mobile-drawer-divider" />
        <a href="/company" class="mobile-drawer-link">
            Company
        </a>
        <a href="https://docs.synnaxlabs.com/reference" class="mobile-drawer-link">
            Docs
        </a>
        <Divider.Divider x className="mobile-drawer-divider" />
        <Flex.Box y gap="small" className="mobile-drawer-cta">
            <Button.Button
                variant="filled"
                size="huge"
                level="p"
                full="x"
                justify="center"
                href="https://docs.synnaxlabs.com/releases/desktop/download"
                data-event="desktop_download_clicked"
                data-location="drawer"
            >
                Download Synnax Desktop
                <Arrow direction="down" />
            </Button.Button>
            <Button.Button
                size="huge"
                level="p"
                full="x"
                justify="center"
                href="/#contact"
            >
                Talk to an engineer
                <Arrow direction="right" />
            </Button.Button>
        </Flex.Box>
    </div>
</Drawer>

<style is:global>
    .header {
        position: sticky;
        top: 0;
        z-index: 10;
        width: 100%;
        height: var(--nav-height);
        background: var(--pluto-gray-l0-90);
        backdrop-filter: blur(2rem);
        -webkit-backdrop-filter: blur(2rem);
        border-bottom: var(--pluto-border);
        transition:
            background 0.25s ease,
            border-color 0.25s ease;
    }

    .header--top {
        background: transparent;
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
        border-bottom-color: transparent;
    }

    .header .header-content {
        width: 100%;
        max-width: var(--max-width);
        padding: 0 var(--content-padding);
    }

    /* The drawer header repeats the page header, so the logo keeps its place and size
       when the drawer opens. */
    :is(.header, .mobile-drawer-header) .logo-link {
        text-decoration: none;
        display: flex;
        align-items: center;

        & .synnax-logo--title {
            height: 4.5rem;
        }
    }

    .header .header-actions .lyra-btn {
        padding: clamp(0.6rem, 0.3rem + 0.5vw, 1rem) clamp(1.2rem, 0.8rem + 0.8vw, 2rem);
        font-weight: 550;
        border-radius: var(--pluto-border-radius-small);
    }

    .header .lyra-btn.lyra-btn--text .lyra-icon {
        color: var(--pluto-gray-l8);
        height: 3rem;
        width: 3rem;

        &:hover {
            color: var(--pluto-gray-l10);
        }
    }

    .nav-divider {
        align-self: center;
        height: 2rem;
    }

    /* Nav link styles */
    .nav-links .nav-link,
    .nav-links .nav-link a {
        text-transform: none;
        font-weight: 500;
        color: var(--pluto-gray-l8);
        text-decoration: none;
        cursor: pointer;

        &:hover {
            color: var(--pluto-gray-l10);
            text-decoration: none;
        }
    }

    .nav-link-trigger {
        cursor: pointer;

        .nav-caret {
            color: var(--pluto-gray-l6);
            height: 1.8rem;
            width: 1.8rem;
            transition: transform 0.2s ease;
        }

        &:hover .nav-caret {
            color: var(--pluto-gray-l8);
        }
    }

    /* Product dropdown */
    .nav-dropdown-wrap {
        position: relative;
    }

    .product-dropdown {
        position: absolute;
        top: calc(100% + 1.5rem);
        left: 50%;
        width: 680px;
        padding: 2rem;
        box-shadow:
            0 4px 12px rgb(0 0 0 / 15%),
            0 16px 40px rgb(0 0 0 / 20%);
        z-index: 20;
        visibility: hidden;
        opacity: 0;
        transform: translateX(-50%) translateY(-6px) scale(0.98);

        /* Stays open briefly after the pointer leaves. */
        transition:
            visibility 0s 0.15s,
            opacity 0s 0.15s,
            transform 0s 0.15s;

        /* Keeps the hover alive while the pointer crosses the gap below the link. */
        &::before {
            content: "";
            position: absolute;
            bottom: 100%;
            left: 0;
            right: 0;
            height: 1.5rem;
        }
    }

    .nav-dropdown-wrap:hover .product-dropdown,
    .nav-dropdown-wrap:focus-within .product-dropdown {
        visibility: visible;
        opacity: 1;
        transform: translateX(-50%);
        transition:
            opacity 0.15s cubic-bezier(0.16, 1, 0.3, 1),
            transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .product-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    .product-card {
        display: block;
        padding: 2rem;
        border-radius: 0.8rem;
        text-decoration: none;
        color: inherit;
        transition: background 0.15s ease;

        &:hover {
            background: var(--pluto-gray-l2);
            text-decoration: none;
        }

        .product-card__icon-wrap {
            width: 3.6rem;
            height: 3.6rem;
            min-width: 3.6rem;
            border-radius: 0.6rem;
            background: var(--pluto-gray-l2);
            border: var(--pluto-border);
            border-color: var(--pluto-gray-l5);
        }

        &:hover .product-card__icon-wrap {
            background: var(--pluto-gray-l3);
            border-color: var(--pluto-gray-l5);
        }

        .product-card__icon {
            height: 1.8rem;
            width: 1.8rem;
            color: var(--pluto-gray-l9);
        }

        .product-card__section {
            font-family: var(--pluto-code-font-family);
            color: var(--pluto-gray-l7);
        }

        .product-card__title {
            font-weight: 500;
            color: var(--pluto-gray-l10);
        }

        .product-card__desc {
            color: var(--pluto-gray-l8);
            line-height: 1.4;
        }
    }

    /* ── Mobile drawer ───────────────────────────────────────── */

    .header .mobile-menu-btn,
    .mobile-drawer {
        display: none;
    }

    .mobile-drawer {
        --mobile-drawer-inset: var(--content-padding);
    }

    .mobile-product-link {
        padding-left: calc(var(--mobile-drawer-inset) + 0.5rem);
    }

    .mobile-product-section {
        font-family: var(--pluto-code-font-family);
        color: var(--pluto-gray-l6);
        font-size: 1.5rem;
        margin-right: 0.5rem;
    }

    .mobile-drawer .mobile-drawer-cta {
        margin: 0.5rem var(--mobile-drawer-inset);

        .lyra-btn {
            font-size: 2.5rem;
            font-weight: 550;
            border-radius: var(--pluto-border-radius-small);
        }
    }

    /* The pair crowds the nav at this width, so only Download stays. */
    @media (width <= 900px) {
        .header-actions .header-contact {
            display: none;
        }
    }

    @media (width <= 600px) {
        .header {
            .header-nav,
            .header-actions {
                display: none;
            }
        }

        .header .mobile-menu-btn {
            display: flex;
        }

        .mobile-drawer {
            display: flex;
        }
    }
</style>

<script>
    import { start } from "@/components/header";

    start();
</script>
