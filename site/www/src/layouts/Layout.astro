import favicon from "@synnaxlabs/media/static/logo/icon-white-favicon.svg";
import { SEO } from "astro-seo";
import "@/styles/main.css";
import Header from "@/components/Header.astro";
import Footer from "@synnaxlabs/site-common/Footer.astro";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Synnax",
    description = "The observability and control platform for hardware systems.",
} = Astro.props;

const FOOTER_COLUMNS = [
    {
        title: "Product",
        links: [
            { label: "Visualize & Operate", href: "/#visualize" },
            { label: "Automate & Control", href: "/#automate" },
            { label: "Store & Review", href: "/#review" },
            { label: "Stream & Process", href: "/#stream" },
            { label: "Integrations", href: "/#integrations" },
            { label: "SDKs", href: "/#sdks" },
        ],
    },
    {
        title: "Resources",
        links: [
            { label: "Documentation", href: "https://docs.synnaxlabs.com" },
            { label: "Sponsorships", href: "/sponsorships" },
        ],
    },
    {
        title: "Company",
        href: "/company",
        links: [
            { label: "Contact", href: "/#contact" },
            { label: "Privacy Policy", href: "/privacy" },
        ],
    },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <SEO title={title} description={description} />
        <link rel="icon" type="image/svg+xml" href={favicon.src} />
    </head>
    <body>
        <Header />
        <main>
            <slot />
        </main>
        <Footer home="/" columns={FOOTER_COLUMNS} />
    </body>
</html>

<style is:global>
    main {
        width: 100%;
    }

    section {
        max-width: var(--max-width);
        margin: 0 auto;
        padding-left: var(--content-padding);
        padding-right: var(--content-padding);
    }
</style>
