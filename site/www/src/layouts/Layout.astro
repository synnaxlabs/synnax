import "@/styles/main.css";
import Header from "@/components/Header.astro";
import Footer from "@synnaxlabs/site-common/Footer.astro";
import Head from "@synnaxlabs/site-common/Head.astro";

interface Props {
    /** The page title, before " | Synnax". The home page leaves it unset. */
    title?: string;
    description: string;
}

const { title, description } = Astro.props;
const HOME_TITLE = "Synnax | Hardware data acquisition, control, and analysis";
const fullTitle = title == null ? HOME_TITLE : `${title} | Synnax`;
// Query strings and trailing slashes must not split a page into duplicates.
const pathname = Astro.url.pathname.replace(/(.)\/$/, "$1");
const canonical = new URL(pathname, Astro.site).href;

const FOOTER_COLUMNS = [
    {
        title: "Product",
        links: [
            { label: "Visualize and operate", href: "/#visualize" },
            { label: "Automate and control", href: "/#automate" },
            { label: "Store and review", href: "/#review" },
            { label: "Stream and process", href: "/#stream" },
            { label: "Integrations", href: "/#integrations" },
            { label: "SDKs", href: "/#sdks" },
        ],
    },
    {
        title: "Resources",
        links: [
            { label: "Documentation", href: "https://docs.synnaxlabs.com/reference" },
            { label: "Reliability", href: "https://docs.synnaxlabs.com/reliability/" },
            { label: "Sponsorships", href: "/sponsorships" },
        ],
    },
    {
        title: "Company",
        href: "/company",
        links: [
            { label: "Contact", href: "/#contact" },
            { label: "Privacy policy", href: "/privacy" },
        ],
    },
];
---

<!doctype html>
<html lang="en">
    <head>
        <Head title={fullTitle} description={description} canonical={canonical} />
        <slot name="head" />
    </head>
    <body>
        <Header />
        <main>
            <slot />
        </main>
        <Footer home="/" columns={FOOTER_COLUMNS} />
    </body>
</html>

<style is:global>
    main {
        width: 100%;
    }

    section {
        max-width: var(--max-width);
        margin: 0 auto;
        padding-left: var(--content-padding);
        padding-right: var(--content-padding);
    }
</style>
