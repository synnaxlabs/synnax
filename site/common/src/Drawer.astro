import { Logo } from "@synnaxlabs/media";

import "./drawer.css";

interface Props {
    /** Where the logo in the drawer header links to. */
    home: string;
}

const { home } = Astro.props;
---

<div class="mobile-overlay" data-mobile-close></div>
<nav class="mobile-drawer">
    <div class="mobile-drawer-header">
        <a href={home} class="logo-link">
            <Logo variant="title" />
        </a>
        <button class="mobile-close-btn" aria-label="Close menu" data-mobile-close>
            <span class="mobile-close-icon"></span>
        </button>
    </div>
    <slot />
</nav>

<script>
    import { start } from "./drawer";
    start();
</script>
