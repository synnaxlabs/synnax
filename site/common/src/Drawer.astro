import { Button } from "@synnaxlabs/lyra/button";
import { Icon } from "@synnaxlabs/lyra/icon";
import { Logo } from "@synnaxlabs/lyra/logo";

import "./drawer.css";

interface Props {
    /** Where the logo in the drawer header links to. */
    home: string;
}

const { home } = Astro.props;
---

<div class="mobile-overlay" data-mobile-close></div>
<nav class="mobile-drawer">
    <div class="mobile-drawer-header">
        <a href={home} class="logo-link">
            <Logo.Logo variant="title" />
        </a>
        <Button.Button
            variant="text"
            size="large"
            square
            className="mobile-close-btn"
            aria-label="Close menu"
            data-mobile-close
        >
            <Icon.Close />
        </Button.Button>
    </div>
    <slot />
</nav>

<script>
    import { start } from "./drawer";
    start();
</script>
