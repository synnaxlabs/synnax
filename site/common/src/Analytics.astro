<div
    class="consent"
    hidden
    data-user={user}
    data-text-masked={textMasked ? "" : undefined}
    transition:persist
>
    <Text.Text level="small" className="consent-name">
        Cookies
    </Text.Text>
    <Text.Text level="p" className="consent-message">
        Can we use cookies to learn how people use our websites?
    </Text.Text>
    <Text.Text level="small" className="consent-description">
        If you reject, we count visits without cookies.{" "}
        <a href={privacy}>Privacy policy</a>
    </Text.Text>
    <div class="consent-actions">
        <Button.Button size="small" data-consent="reject">
            Reject
        </Button.Button>
        <Button.Button size="small" data-consent="accept">
            Accept
        </Button.Button>
    </div>
</div>

<style is:global>
    /* The Console's notification card, in the corner. Sizes are fixed, so the card
       reads the same on sites with different type scales. */
    .consent {
        position: fixed;
        z-index: 100;
        left: 20px;
        bottom: 20px;
        width: 340px;
        padding: 16px;
        border: var(--pluto-border-l6);
        border-radius: var(--pluto-border-radius-medium);
        background: color-mix(in srgb, var(--pluto-gray-l2) 94%, transparent);
        box-shadow: var(--pluto-shadow-lift);
        -webkit-backdrop-filter: var(--pluto-frost);
        backdrop-filter: var(--pluto-frost);

        &[hidden] {
            display: none;
        }
        .pluto-text {
            display: block;
            font-size: 14px;
            line-height: 20px;
        }
        .consent-name,
        .consent-description {
            color: var(--pluto-gray-l9);
            font-size: 13px;
        }
        .consent-name {
            margin-bottom: 4px;
        }
        .consent-message {
            font-weight: 500;
            text-wrap: balance;
        }
        .consent-description {
            margin-top: 4px;
            a {
                white-space: nowrap;
            }
        }
        .consent-actions {
            display: flex;
            gap: 8px;
            margin-top: 16px;
            .pluto-btn {
                flex: 1;
                justify-content: center;
            }
        }
    }

    @media (max-width: 700px) {
        .consent {
            left: 12px;
            right: 12px;
            bottom: 12px;
            width: auto;
        }
    }
</style>

<script>
    import { start } from "./analytics";

    const card = document.querySelector<HTMLElement>(".consent");
    if (card == null) throw new Error("the consent card is missing");
    void start({
        posthog: () => window.posthog,
        fetch: window.fetch.bind(window),
        card,
        user: card.dataset.user ?? null,
        textMasked: card.dataset.textMasked != null,
    });
</script>
