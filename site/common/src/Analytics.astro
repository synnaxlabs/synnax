import { Button } from "@synnaxlabs/lyra/button";
import { Text } from "@synnaxlabs/lyra/text";

interface Props {
    /** The privacy policy, as the site links to it. */
    privacy: string;
    /** The account to link the visitor to once cookies are on. */
    user?: string;
    /** Hides all text in recordings, for pages that show other people's data. */
    textMasked?: boolean;
}

const { privacy, user, textMasked = false } = Astro.props;
---

<script is:inline>
