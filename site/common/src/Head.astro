import { SEO, type SEOProps } from "astro-seo";

type Article = NonNullable<NonNullable<SEOProps["openGraph"]>["article"]>;

interface Props {
    /** The full page title. */
    title: string;
    description?: string;
    /** The canonical URL of the page. */
    canonical: string;
    /** The Open Graph image. Defaults to the Synnax card. */
    image?: string;
    imageAlt?: string;
    /** Marks the page as an article for Open Graph. */
    article?: Article;
}

const DEFAULT_IMAGE =
    "https://synnax.nyc3.cdn.digitaloceanspaces.com/docs/og-default.png";

const {
    title,
    description,
    canonical,
    image = DEFAULT_IMAGE,
    imageAlt = "Synnax",
    article,
} = Astro.props;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<SEO
    title={title}
    description={description}
    canonical={canonical}
    openGraph={{
        basic: {
            title,
            type: article == null ? "website" : "article",
            image,
            url: canonical,
        },
        optional: { description, siteName: "Synnax" },
        image: { alt: imageAlt },
        article,
    }}
    twitter={{ card: "summary_large_image", title, description, image }}
/>
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
