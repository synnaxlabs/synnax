{
  "name": "@synnaxlabs/client",
  "version": "0.0.0",
  "description": "The Synnax Client Library",
  "keywords": [
    "synnax",
    "grpc",
    "transport",
    "client",
    "data acquisition",
    "big data",
    "telemetry",
    "control systems"
  ],
  "homepage": "https://github.com/synnaxlabs/synnax/tree/main/client/ts",
  "bugs": {
    "url": "https://github.com/synnaxlabs/synnax/issues"
  },
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synnaxlabs/synnax.git",
    "directory": "client/ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "watch": "vite build --watch",
    "test": "vitest",
    "bench": "vitest bench --config vitest.bench.config.ts",
    "cov": "vitest --coverage",
    "lint": "eslint",
    "fix": "eslint --fix",
    "install-browsers": "playwright install chromium firefox webkit",
    "smoke": "smoke/run.sh"
  },
  "dependencies": {
    "@synnaxlabs/alamos": "catalog:",
    "@synnaxlabs/freighter": "catalog:",
    "@synnaxlabs/x": "catalog:",
    "immer": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "undici": "catalog:node22",
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "undici": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@synnaxlabs/eslint-config": "catalog:",
    "@synnaxlabs/tsconfig": "catalog:",
    "@synnaxlabs/vite-plugin": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "eslint": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "undici": "catalog:node22",
    "vite": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "!**/*.spec.*",
    "!**/*.bench.*",
    "!dist/eslint.config.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/client.js"
    },
    "./testutil": {
      "types": "./dist/src/testutil/index.d.ts",
      "default": "./dist/testutil.js"
    }
  }
}
