{
  "name": "@synnaxlabs/client",
  "version": "0.57.3",
  "description": "The Synnax Client Library",
  "keywords": [
    "synnax",
    "grpc",
    "transport",
    "client",
    "data acquisition",
    "big data",
    "telemetry",
    "control systems"
  ],
  "homepage": "https://github.com/synnaxlabs/synnax/tree/main/client/ts",
  "bugs": {
    "url": "https://github.com/synnaxlabs/synnax/issues"
  },
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synnaxlabs/synnax.git",
    "directory": "client/ts"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check-types": "tsc --noEmit",
    "watch": "tsc --noEmit && vite build --watch",
    "test": "vitest",
    "bench": "vitest bench",
    "cov": "vitest --coverage",
    "lint": "eslint",
    "fix": "eslint --fix",
    "madge": "madge --circular src"
  },
  "dependencies": {
    "@synnaxlabs/alamos": "catalog:",
    "@synnaxlabs/freighter": "catalog:",
    "@synnaxlabs/x": "catalog:",
    "immer": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@synnaxlabs/eslint-config": "catalog:",
    "@synnaxlabs/madge": "catalog:",
    "@synnaxlabs/tsconfig": "catalog:",
    "@synnaxlabs/vite-plugin": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "!**/*.spec.*",
    "!**/*.bench.*",
    "!dist/eslint.config.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/client.js"
    },
    "./testutil": {
      "types": "./dist/src/testutil/index.d.ts",
      "default": "./dist/testutil.js"
    }
  }
}
