{
  "name": "@synnaxlabs/client",
  "version": "0.56.2",
  "description": "The Synnax Client Library",
  "keywords": [
    "synnax",
    "grpc",
    "transport",
    "client",
    "data acquisition",
    "big data",
    "telemetry",
    "control systems"
  ],
  "homepage": "https://github.com/synnaxlabs/synnax/tree/main/client/ts",
  "bugs": {
    "url": "https://github.com/synnaxlabs/synnax/issues"
  },
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synnaxlabs/synnax.git",
    "directory": "client/ts"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check-types": "tsc --noEmit",
    "watch": "tsc --noEmit && vite build --watch",
    "test": "vitest",
    "cov": "vitest --coverage",
    "lint": "eslint",
    "fix": "eslint --fix",
    "madge": "madge --circular src"
  },
  "dependencies": {
    "@synnaxlabs/freighter": "workspace:^",
    "@synnaxlabs/x": "workspace:^",
    "async-mutex": "catalog:",
    "immer": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@synnaxlabs/eslint-config": "workspace:^",
    "@synnaxlabs/tsconfig": "workspace:^",
    "@synnaxlabs/vite-plugin": "workspace:^",
    "@vitest/coverage-v8": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "@synnaxlabs/madge": "workspace:^",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/client.js"
    },
    "./testutil": {
      "types": "./dist/src/testutil/index.d.ts",
      "default": "./dist/testutil.js"
    }
  }
}
