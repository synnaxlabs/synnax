# The client version is the VERSION manifest, bumped with the other packages.
genrule(
    name = "version",
    srcs = ["VERSION"],
    outs = ["version.h"],
    cmd = """
        echo '#pragma once' > $@ &&
        echo '#define SYNNAX_CLIENT_VERSION \"'$$(cat $(execpath VERSION))'\"' >> $@
    """,
    visibility = ["//visibility:public"],
)
