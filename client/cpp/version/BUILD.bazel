# The version is the SYNNAX_VERSION define; .bazelrc defaults it to 0.0.0 for dev builds.
genrule(
    name = "version",
    outs = ["version.h"],
    cmd = """
        echo '#pragma once' > $@ &&
        echo '#define SYNNAX_VERSION \"$(SYNNAX_VERSION)\"' >> $@
    """,
    visibility = ["//visibility:public"],
)
