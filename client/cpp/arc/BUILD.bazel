load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "arc",
    srcs = [
        "arc.cpp",
    ],
    hdrs = [
        "actions.gen.h",
        "arc.h",
        "json.gen.h",
        "proto.gen.h",
        "types.gen.h",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//arc/cpp/graph",
        "//arc/cpp/ir",
        "//arc/cpp/program",
        "//arc/cpp/text",
        "//client/cpp/errors",
        "//client/cpp/resource",
        "//client/cpp/status",
        "//client/cpp/task",
        "//core/pkg/api/arc:arc_grpc",
        "//core/pkg/transport/grpc:api_grpc",
        "//freighter/cpp:freighter",
        "//freighter/cpp/grpc",
        "//x/cpp/crdt",
        "//x/cpp/filter",
        "//x/cpp/patch",
        "//x/cpp/pb",
        "//x/cpp/spatial",
        "//x/go/filter:filter_grpc",
        "@grpc//:grpc++",
    ],
)

cc_test(
    name = "arc_test",
    srcs = ["arc_test.cpp"],
    tags = ["requires-core"],
    deps = [
        ":arc",
        "//client/cpp:synnax",
        "//client/cpp/testutil",
        "//x/cpp/pb",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "actions_test",
    srcs = ["actions_test.cpp"],
    deps = [
        ":arc",
        "//x/cpp/json",
        "//x/cpp/testutil",
        "@googletest//:gtest_main",
    ],
)
