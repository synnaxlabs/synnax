; synnax_clib Windows export allowlist. Keep in sync with the SYNNAX_EXPORT
; functions in synnax.h. Only these symbols are exported from the DLL; gRPC and
; protobuf internals stay hidden to avoid collisions.
EXPORTS
    synnax_client_open
    synnax_client_close
    synnax_client_version
    synnax_channel_retrieve_keys
    synnax_writer_open
    synnax_writer_write
    synnax_writer_commit
    synnax_writer_close
