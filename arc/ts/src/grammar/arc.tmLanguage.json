{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Arc",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#for-statement"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#flow-operators"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#tasks"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.arc",
          "match": "//.*$"
        },
        {
          "name": "comment.block.arc",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "for-statement": {
      "patterns": [
        {
          "name": "meta.for-statement.arc",
          "begin": "\\bfor\\b",
          "beginCaptures": {
            "0": {
              "name": "keyword.control.arc"
            }
          },
          "end": "(?=\\{)",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#flow-operators"
            },
            {
              "include": "#types"
            },
            {
              "include": "#functions"
            },
            {
              "include": "#identifiers"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.arc",
          "match": "\\b(if|else|return|for|break|continue)\\b"
        },
        {
          "name": "keyword.operator.logical.arc",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.other.arc",
          "match": "\\b(func|sequence|stage|next|authority|import|as)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.arc",
          "begin": "(rf|fr|f|r)?(\"|`)",
          "end": "\\2",
          "beginCaptures": {
            "1": { "name": "storage.type.string.arc" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.arc",
              "match": "\\\\([\\\\\"`/bfnrt]|u[0-9a-fA-F]{4})"
            },
            {
              "name": "meta.template.expression.arc",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.template-expression.begin.arc" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.definition.template-expression.end.arc" }
              },
              "patterns": [{ "include": "$self" }]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.unit.arc",
          "match": "\\b(\\d+(_\\d+)*(\\.\\d+(_\\d+)*)?([eE][+-]?\\d+(_\\d+)*)?)(samples|percent|meter|count|mbar|torr|byte|min|nmi|ton|pPa|nPa|uPa|mPa|kPa|MPa|GPa|bar|psi|atm|kHz|khz|MHz|mhz|GHz|ghz|rad|deg|rev|bit|KiB|MiB|GiB|pct|ns|us|ms|fm|pm|nm|um|mm|cm|dm|km|in|ft|yd|mi|fg|pg|ng|ug|mg|kg|lb|oz|Pa|Hz|hz|fV|pV|nV|uV|mV|kV|MV|fA|pA|nA|uA|mA|kA|MA|fK|pK|nK|uK|mK|kK|KB|MB|GB|s|h|d|m|g|V|A|K)\\b",
          "captures": {
            "1": {
              "name": "constant.numeric.float.arc"
            }
          }
        },
        {
          "name": "constant.numeric.hex.arc",
          "match": "\\b0[xX][0-9a-fA-F]+(_[0-9a-fA-F]+)*\\b"
        },
        {
          "name": "constant.numeric.binary.arc",
          "match": "\\b0[bB][01]+(_[01]+)*\\b"
        },
        {
          "name": "constant.numeric.float.arc",
          "match": "\\b\\d+(_\\d+)*\\.\\d+(_\\d+)*([eE][+-]?\\d+(_\\d+)*)?\\b"
        },
        {
          "name": "constant.numeric.integer.arc",
          "match": "\\b\\d+(_\\d+)*\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.arc",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|str)\\b"
        },
        {
          "name": "support.type.composite.arc",
          "match": "\\b(series|chan)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.arc",
          "match": "[+\\-*/%]|\\*\\*|\\^"
        },
        {
          "name": "keyword.operator.comparison.arc",
          "match": "==|!=|<=?|>=?"
        },
        {
          "name": "keyword.operator.assignment.declare.arc",
          "match": ":="
        },
        {
          "name": "keyword.operator.assignment.stateful.arc",
          "match": "\\$="
        },
        {
          "name": "keyword.operator.assignment.compound.arc",
          "match": "\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.assignment.arc",
          "match": "="
        },
        {
          "name": "keyword.operator.transition.arc",
          "match": "=>"
        }
      ]
    },
    "flow-operators": {
      "patterns": [
        {
          "name": "keyword.operator.flow.arc",
          "match": "->"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.arc",
          "begin": "\\b(func)\\s+(\\w+)\\s*\\(",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.arc"
            },
            "2": {
              "name": "entity.name.function.arc"
            }
          },
          "end": "\\)",
          "patterns": [
            {
              "include": "#function-parameters"
            }
          ]
        },
        {
          "name": "support.function.builtin.arc",
          "match": "\\b(len|now|pow|interval|wait|range)\\b(?=\\s*[({])"
        },
        {
          "name": "entity.name.function.arc",
          "match": "\\b\\w+\\b(?=\\s*\\()"
        }
      ]
    },
    "tasks": {
      "patterns": [
        {
          "name": "meta.sequence.definition.arc",
          "begin": "\\b(sequence)\\s+(\\w+)\\s*\\{",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.arc"
            },
            "2": {
              "name": "entity.name.function.arc"
            }
          },
          "end": "\\}",
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "name": "meta.stage.definition.arc",
          "begin": "\\b(stage)\\s+(\\w+)\\s*\\{",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.arc"
            },
            "2": {
              "name": "entity.name.function.arc"
            }
          },
          "end": "\\}",
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "name": "meta.stage.invocation.arc",
          "begin": "\\b(?!(?:i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|str|series|chan|if|else|return|func|sequence|stage)\\b)(\\w+)\\s*\\{",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.arc"
            }
          },
          "end": "\\}",
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.arc",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "function-parameters": {
      "patterns": [
        {
          "include": "#types"
        },
        {
          "include": "#identifiers"
        },
        {
          "name": "punctuation.separator.arc",
          "match": ","
        }
      ]
    }
  },
  "scopeName": "source.arc"
}
