load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

config_setting(
    name = "nilinuxrt",
    values = {"define": "platform=nilinuxrt"},
)

cc_library(
    name = "loop",
    srcs = select({
        "@platforms//os:linux": ["loop_linux.cpp"],
        "@platforms//os:macos": ["loop_darwin.cpp"],
        "@platforms//os:windows": ["loop_windows.cpp"],
        "//conditions:default": ["loop_polling.cpp"],
    }),
    hdrs = ["loop.h"] + select({
        "@platforms//os:linux": ["loop_linux.h"],
        "@platforms//os:macos": ["loop_darwin.h"],
        "@platforms//os:windows": ["loop_windows.h"],
        "//conditions:default": [],
    }),
    copts = select({
        "@platforms//os:windows": [
            "/D_WIN32_WINNT=0x0601",
            "/DWIN32_LEAN_AND_MEAN",
            "/DNOMINMAX",
        ],
        "//conditions:default": [],
    }),
    defines = select({
        ":nilinuxrt": ["SYNNAX_NILINUXRT"],
        "//conditions:default": [],
    }),
    linkopts = select({
        "@platforms//os:linux": ["-lpthread"],
        "@platforms//os:windows": ["winmm.lib"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//x/cpp/breaker",
        "//x/cpp/errors",
        "//x/cpp/json",
        "//x/cpp/log",
        "//x/cpp/loop",
        "//x/cpp/notify",
        "//x/cpp/telem",
        "//x/cpp/thread/rt",
        "@abseil-cpp//absl/log",
    ],
)

cc_test(
    name = "loop_test",
    srcs = ["loop_test.cpp"],
    deps = [
        ":loop",
        "//x/cpp/breaker",
        "//x/cpp/notify",
        "//x/cpp/test",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "timing_bench",
    timeout = "long",
    srcs = ["timing_bench.cpp"],
    # Measures wait timing with every core busy, so it only runs when named.
    tags = [
        "manual",
        "no-asan",
    ],
    deps = [
        ":loop",
        "//arc/cpp/runtime/testutil",
        "//x/cpp/breaker",
        "//x/cpp/errors",
        "//x/cpp/queue",
        "//x/cpp/telem",
        "@googletest//:gtest_main",
    ],
)
