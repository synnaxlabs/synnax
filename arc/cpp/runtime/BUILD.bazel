load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "runtime",
    hdrs = ["runtime.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//arc/cpp/runtime/errors",
        "//arc/cpp/runtime/loop",
        "//arc/cpp/runtime/node",
        "//arc/cpp/runtime/scheduler",
        "//arc/cpp/runtime/state",
        "//arc/cpp/runtime/wasm",
        "//arc/cpp/stl/channels",
        "//arc/cpp/stl/constant",
        "//arc/cpp/stl/control",
        "//arc/cpp/stl/error",
        "//arc/cpp/stl/math",
        "//arc/cpp/stl/selector",
        "//arc/cpp/stl/series",
        "//arc/cpp/stl/stable",
        "//arc/cpp/stl/stateful",
        "//arc/cpp/stl/strings",
        "//arc/cpp/stl/time",
        "//arc/cpp/stl/variable",
        "//x/cpp/control",
        "//x/cpp/thread",
    ],
)

cc_binary(
    name = "program_bench",
    srcs = ["program_bench.cpp"],
    copts = select({
        "@platforms//os:windows": ["/wd4201"],
        "//conditions:default": [],
    }),
    tags = ["requires-core"],
    deps = [
        "//arc/cpp/runtime/testutil:compile",
        "//arc/cpp/runtime/testutil:harness",
        "//client/cpp:synnax",
        "//client/cpp/testutil",
        "//x/cpp/bench",
        "//x/cpp/telem",
        "@google_benchmark//:benchmark_main",
    ],
)

cc_test(
    name = "sequence_test",
    srcs = ["sequence_test.cpp"],
    copts = select({
        "@platforms//os:windows": ["/wd4201"],
        "//conditions:default": [],
    }),
    tags = ["requires-core"],
    deps = [
        "//arc/cpp/runtime/testutil:compile",
        "//arc/cpp/runtime/testutil:harness",
        "//arc/cpp/types",
        "//client/cpp:synnax",
        "//client/cpp/testutil",
        "//x/cpp/telem",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "runtime_test",
    srcs = ["runtime_test.cpp"],
    deps = [
        ":runtime",
        "//arc/cpp/ir/testutil",
        "//arc/cpp/runtime/testutil",
        "//x/cpp/telem",
        "//x/cpp/test",
        "@googletest//:gtest_main",
    ],
)
