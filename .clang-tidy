# Lint with bazel build --config=clang-tidy <targets>. The aspect lints every header as
# its own file, so a header must compile without the file that includes it.
#
# Checks that are off, and why:
# - clang-analyzer-*: takes minutes on a large test file. The sanitizers in CI find the
#   same class of bug.
# - Arrays, casts, varargs, pointer math, and signed bitwise operands: the Driver
#   speaks C SDKs and binary wire formats.
# - throwing-static-initialization: every GoogleTest TEST registers a static.
# - unchecked-optional-access: it cannot see a GoogleTest assertion that an optional has
#   a value.
# - avoid-c-style-cast: it flags harmless casts such as uint8_t(7). pro-type-cstyle-cast
#   flags the risky ones.
# - include-cleaner and inconsistent-declaration-parameter-name: the result differs
#   between libc++ and libstdc++.
# - Brace, parameter, literal, and declaration style: clang-format and review own it.
---
Checks: |
    -*,
    bugprone-*,
    -bugprone-derived-method-shadowing-base-method,
    -bugprone-easily-swappable-parameters,
    -bugprone-signed-bitwise,
    -bugprone-throwing-static-initialization,
    -bugprone-unchecked-optional-access,
    cppcoreguidelines-avoid-non-const-global-variables,
    cppcoreguidelines-init-variables,
    cppcoreguidelines-missing-std-forward,
    cppcoreguidelines-prefer-member-initializer,
    cppcoreguidelines-pro-type-cstyle-cast,
    cppcoreguidelines-pro-type-member-init,
    cppcoreguidelines-rvalue-reference-param-not-moved,
    cppcoreguidelines-slicing,
    cppcoreguidelines-virtual-class-destructor,
    google-explicit-constructor,
    misc-*,
    -misc-const-correctness,
    -misc-include-cleaner,
    -misc-multiple-inheritance,
    -misc-no-recursion,
    -misc-non-private-member-variables-in-classes,
    -misc-unused-parameters,
    -misc-use-anonymous-namespace,
    -misc-use-internal-linkage,
    modernize-*,
    -modernize-avoid-c-arrays,
    -modernize-avoid-c-style-cast,
    -modernize-avoid-variadic-functions,
    -modernize-return-braced-init-list,
    -modernize-use-designated-initializers,
    -modernize-use-std-print,
    -modernize-use-trailing-return-type,
    performance-*,
    -performance-enum-size,
    -performance-no-int-to-ptr,
    portability-*,
    -portability-avoid-pragma-once,
    -portability-template-virtual-member-function,
    readability-*,
    -readability-braces-around-statements,
    -readability-function-cognitive-complexity,
    -readability-identifier-length,
    -readability-implicit-bool-conversion,
    -readability-inconsistent-declaration-parameter-name,
    -readability-inconsistent-ifelse-braces,
    -readability-isolate-declaration,
    -readability-magic-numbers,
    -readability-math-missing-parentheses,
    -readability-named-parameter,
    -readability-redundant-lambda-parameter-list,
    -readability-trailing-comma,
    -readability-uppercase-literal-suffix,
    -readability-use-concise-preprocessor-directives
WarningsAsErrors: "*"
# Each header is linted as its own file, so report only the file being linted.
HeaderFilterRegex: "^$"
# The build checks compiler warnings on each platform's own compiler. A header linted
# alone also raises false ones, such as #pragma once in a main file.
ExtraArgs: ["-w"]
FormatStyle: file
CheckOptions:
    # GoogleTest macros declare globals and override TestBody.
    cppcoreguidelines-avoid-non-const-global-variables.IgnoreMacros: true
    misc-override-with-different-visibility.IgnoredFunctions: ::testing::Test::TestBody
    cppcoreguidelines-init-variables.MathHeader: <cmath>
    # A throw from a destructor or a move ends the process, which is the right result.
    bugprone-exception-escape.CheckDestructors: false
    bugprone-exception-escape.CheckMoveMemberFunctions: false
    # std::lock_guard is fine for one mutex.
    modernize-use-scoped-lock.WarnOnSingleLocks: false
    # curl's public headers include each other.
    misc-header-include-cycle.IgnoredFilesList: /curl/curl\.h$
