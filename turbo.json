{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [
    "configs/vite/src/index.ts",
    "configs/ts/*.json",
    "configs/eslint/**/*.ts",
    "configs/eslint/package.json",
    "configs/stylelint/*.ts",
    "configs/stylelint/*.json",
    "pnpm-workspace.yaml"
  ],
  "globalEnv": [
    "SYNNAX_TS_ENV",
    "TAURI_SIGNING_PRIVATE_KEY",
    "TAURI_SIGNING_PRIVATE_KEY_PASSWORD",
    "VITE_DESKTOP"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "vite.config.ts", "tsconfig*.json", "package.json"],
      "outputs": ["dist/**", ".vercel/**"]
    },
    "build-vite": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "vite.config.ts", "tsconfig*.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "inputs": [
        "src/**",
        "eslint.config.ts",
        "stylelint.config.*",
        "tsconfig*.json",
        "package.json"
      ]
    },
    "check-types": { "dependsOn": ["^build"] },
    "dev-vite": {
      "cache": false,
      "passThroughEnv": ["SYNNAX_PORT", "SYNNAX_CONSOLE_PORT"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "passThroughEnv": ["SYNNAX_PORT"]
    },
    "dev-desktop": {
      "cache": false,
      "dependsOn": ["^build"],
      "passThroughEnv": ["SYNNAX_PORT"]
    },
    "build-desktop": { "cache": false, "dependsOn": ["^build"] },
    "watch": { "cache": false },
    "fix": { "cache": false },
    "test": {
      "cache": false,
      "dependsOn": ["^build"],
      "passThroughEnv": ["SYNNAX_HOST", "SYNNAX_PORT"]
    },
    "cov": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "passThroughEnv": ["SYNNAX_HOST", "SYNNAX_PORT"]
    },
    "devtools": { "cache": false }
  }
}
