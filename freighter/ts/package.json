{
  "name": "@synnaxlabs/freighter",
  "version": "0.58.0",
  "type": "module",
  "description": "a modular transport abstraction",
  "repository": "https://github.com/synnaxlabs/synnax/tree/main/freighter/ts",
  "keywords": [
    "synnax",
    "grpc",
    "transport",
    "data acquisition",
    "big data",
    "telemetry",
    "control systems"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check-types": "tsc --noEmit",
    "watch": "tsc --noEmit && vite build --watch",
    "test": "vitest",
    "cov": "vitest --coverage",
    "lint": "eslint",
    "fix": "eslint --fix",
    "madge": "madge --circular src"
  },
  "dependencies": {
    "@synnaxlabs/alamos": "catalog:",
    "@synnaxlabs/x": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@synnaxlabs/eslint-config": "catalog:",
    "@synnaxlabs/madge": "catalog:",
    "@synnaxlabs/tsconfig": "catalog:",
    "@synnaxlabs/vite-plugin": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "src",
    "!**/*.spec.*",
    "!**/*.bench.*",
    "!dist/eslint.config.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/freighter.js"
    }
  }
}
