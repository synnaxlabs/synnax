{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": { "cycles": "error" },
  "workspaces": {
    ".": {
      "ignoreBinaries": ["algolia", "check-site"],
      "ignoreDependencies": ["stylelint-config-standard"]
    },
    "alamos/ts": {
      "entry": ["src/index.ts", "src/dev/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "arc/ts": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "client/ts": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "drift": {
      "entry": ["src/index.ts", "src/react/index.ts", "src/tauri/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "freighter/ts": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "lyra": {
      "entry": ["src/*/index.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@fontsource/geist-mono", "@fontsource-variable/inter"]
    },
    "pluto": {
      "entry": ["src/index.ts", "src/ether.ts", "src/testutil/index.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["vscode"]
    },
    "x/media": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "x/ts": {
      "entry": ["src/index.ts", "src/bench/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "console": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "oracle/lsp/extensions/vscode": {
      "project": ["src/**/*.ts"]
    },
    "studio": {
      "entry": ["videos.ts", "scripts/*.ts", "films/*.ts", "src/remotion/entry.ts"],
      "project": ["{src,scripts,films}/**/*.{ts,tsx}"]
    },
    "site/docs": {
      "entry": ["src/**/*.astro", "src/**/*.tsx", "src/**/*.ts"],
      "project": ["src/**/*.{ts,tsx,astro,mdx}"]
    },
    "site/www": {
      "entry": ["src/pages/**/*.astro"],
      "project": ["src/**/*.{ts,tsx,astro}"]
    },
    "configs/eslint": {
      "project": ["*.ts"]
    },
    "configs/ts": {},
    "configs/vite": {
      "project": ["src/**/*.ts"]
    },
    "configs/stylelint": {
      "project": ["*.ts"],
      "ignoreDependencies": ["stylelint-config-standard"]
    }
  },
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
