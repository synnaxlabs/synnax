{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": { "cycles": "error" },
  "workspaces": {
    ".": {
      "entry": ["package.json"],
      "project": ["package.json"]
    },
    "alamos/ts": {
      "entry": ["src/index.ts", "src/dev/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "arc/ts": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "client/ts": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "drift": {
      "entry": ["src/index.ts", "src/react/index.ts", "src/tauri/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "freighter/ts": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "lyra": {
      "entry": ["src/*/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "pluto": {
      "entry": ["src/index.ts", "src/ether.ts", "src/testutil/index.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["vscode"]
    },
    "x/media": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "x/ts": {
      "entry": ["src/index.ts", "src/bench/index.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@vitest/coverage-v8"]
    },
    "console": {
      "entry": ["src/flags.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreIssues": {
        "src/app/nav/drawer/Bottom.tsx": ["exports"],
        "src/feature/*/{explorer,overview}/external.tsx": ["exports"],
        "src/platform/*/filter/{Chips,MenuItem}.tsx": ["exports"],
        "src/platform/task/{fields,views}/*.tsx": ["exports"]
      }
    },
    "site/docs": {
      "entry": ["src/**/*.astro", "src/**/*.tsx", "src/**/*.ts"],
      "project": ["src/**/*.{ts,tsx,astro,mdx}"]
    },
    "site/portal": {
      "entry": ["src/**/*.astro", "src/**/*.tsx", "src/**/*.ts", "scripts/*.ts"],
      "project": ["src/**/*.{ts,tsx,astro}", "scripts/*.ts"]
    },
    "site/www": {
      "entry": ["src/pages/**/*.astro"],
      "project": ["src/**/*.{ts,tsx,astro}"]
    },
    "configs/eslint": {
      "entry": ["index.ts"],
      "project": ["*.ts"],
      "ignoreDependencies": ["eslint-*", "@eslint/*"]
    },
    "configs/ts": {
      "entry": ["base.json"],
      "project": ["*.json"]
    },
    "configs/vite": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["vite-*"]
    },
    "configs/stylelint": {
      "entry": ["index.cjs"],
      "project": ["*.cjs"],
      "ignoreDependencies": ["stylelint-*"]
    }
  },
  "ignore": [
    "**/examples/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/.turbo/**",
    "**/coverage/**"
  ],
  "ignoreDependencies": ["@types/*"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
