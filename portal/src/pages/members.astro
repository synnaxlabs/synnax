import Portal from "@/layouts/Portal.astro";
import { loadScoped } from "@/page";
import { Members } from "@/ui/members/Members";

const loaded = await loadScoped(Astro, "team");
if (loaded instanceof Response) return loaded;
const { session, organizations, scope } = loaded;
---

<Portal
    title="Members"
    session={session}
    organizations={organizations}
    scope={scope}
    tab="members"
>
    <Members client:load organization={scope} />
</Portal>
