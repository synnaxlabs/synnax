# The version stamped into the Driver; release builds override it.
build --define=SYNNAX_DRIVER_VERSION=0.0.0

# The Core that live tests connect to. A test inherits these from the shell, and their
# values join its cache key, so changing one reruns the test.
build --test_env=SYNNAX_TEST_HOST
build --test_env=SYNNAX_TEST_PORT

# Enable platform-specific configs
common --enable_platform_specific_config

# vendor/registry holds module versions the Bazel Central Registry does not have yet,
# such as security releases. Bazel takes each module version from the first registry
# that has it. A Windows workspace path starts with a drive letter, so its file URL
# needs a third slash.
common:linux --registry=file://%workspace%/vendor/registry
common:linux --registry=https://bcr.bazel.build
common:macos --registry=file://%workspace%/vendor/registry
common:macos --registry=https://bcr.bazel.build
common:windows --registry=file:///%workspace%/vendor/registry
common:windows --registry=https://bcr.bazel.build

# Each external repo is a symlink into the shared repo contents cache, and Bazel deletes
# a cache entry that goes 14 days without a fetch. A repo that every build reuses is
# never re-fetched, so the collector can delete the target of a live symlink and leave
# the repo half-present. Build machines hold an output base for weeks, which is long
# enough to hit this. Collect duplicate entries only.
common --repo_contents_cache_gc_max_age=0

# A remote cache outage runs actions locally instead of failing the build with exit
# code 34. A cache needs both flags, and neither acts without --remote_cache.
build --remote_local_fallback
build --incompatible_remote_local_fallback_for_remote_cache

# Use OpenSSl instead of BoringSSL for grpc
build --@grpc//third_party:grpc_use_openssl=true

# Static linking keeps hidden symbol visibility from breaking shared library links.
build --dynamic_mode=off

# ===== Platform-specific compiler settings =====
#
# Symbols are hidden so they do not collide with libraries loaded at runtime. LabJack
# bundles an old, incompatible gRPC.

build:macos --cxxopt=-std=c++23
build:macos --host_cxxopt=-std=c++23
build:macos --copt=-Werror
build:macos --copt=-fvisibility=hidden
build:macos --cxxopt=-fvisibility-inlines-hidden
# gRPC's public headers call the deprecated pointer form of absl::MutexLock.
build:macos --copt=-Wno-error=deprecated-declarations

build:linux --cxxopt=-std=c++23
build:linux --host_cxxopt=-std=c++23
build:linux --copt=-Werror
build:linux --copt=-fvisibility=hidden
build:linux --cxxopt=-fvisibility-inlines-hidden
build:linux --copt=-Wno-error=deprecated-declarations
# GoogleTest triggers sign-compare inside gtest.h when a test compares a signed to an
# unsigned integer. GCC reports it against the header, so it cannot be suppressed at the
# call site.
build:linux --copt=-Wno-sign-compare

# Windows (MSVC)
# The Windows build bots run jobs as SYSTEM but install Rust for Administrator. The
# wasmtime genrule finds cargo there only through the host PATH.
build:windows --action_env=PATH
# Note: MSVC uses /std:c++latest for C++23 features (not /std:c++23)
build:windows --enable_runfiles
build:windows --cxxopt=/std:c++latest
build:windows --host_cxxopt=/std:c++latest
# OpenSSL's crypto.lib references user32.lib functions (GetProcessWindowStation,
# GetUserObjectInformationW, MessageBoxW) that must be linked explicitly on Windows.
build:windows --linkopt=user32.lib
build:windows --copt=/Zc:preprocessor      # Enable C++20 conformant preprocessor (for __VA_OPT__)
build:windows --copt=/W3  # warning level 3; -Wall on MSVC is /W4 plus extras
# Warnings are errors for C and C++ only. MASM would apply /WX to the option warnings it
# emits for every cl flag it does not recognise, failing on assembly with no diagnostic.
build:windows --cxxopt=/WX
build:windows --conlyopt=/WX
# Level 4 warnings raised to level 3 so /W3 reports them.
build:windows --copt=/w34388  # signed/unsigned mismatch in a comparison
build:windows --copt=/w34389  # signed/unsigned mismatch in == and !=
# Generated protobuf code is workspace code, so /external:W0 does not cover it.
build:windows --copt=/wd4267  # conversion from size_t, possible loss of data
build:windows --copt=/wd4244  # conversion between types, possible loss of data
build:windows --copt=/wd4996  # deprecated declaration
build:windows --copt=/wd4305  # truncation from double to float
build:windows --copt=/wd4146  # unary minus operator applied to unsigned type (telem templates)
build:windows --copt=/wd4589  # constructor ignores initializer for virtual base class (NI channel hierarchy)
build:windows --copt=/wd4005  # macro redefinition (SOEM wpcap headers vs Windows SDK)
# MASM reads /WX- as /W followed by X- and rejects it as a non-numeric level (A1013), so
# assembly gets neither of these flags, nor the /WX above. It still receives the /wd
# flags, but only warns about the ones it does not know.
build:windows --per_file_copt=external/.*,-.*\\.[sS]$,-.*\\.asm$@/WX-,/w
build:windows --per_file_copt=vendor/.*,-.*\\.[sS]$,-.*\\.asm$@/WX-,/w
# External headers warn at level 0, as -isystem does on the other platforms.
build:windows --features=external_include_paths
build:windows --copt=/external:W0

# Bazel hands the full cl.exe flag set to ml64 for OpenSSL's generated assembly, and
# MASM mangles the ones it does not know until it writes no object at all. /bigobj,
# /Zm500 and /showIncludes come from the toolchain itself, so no copt scoping fixes it.
# Build the C implementations on Windows instead.
build:windows --@openssl//:use-no-asm-fallback=true
# The no-asm sources omit winstore_store.c, yet the Windows configuration.h keeps the
# provider on. Without this, defltprov.c references a store nothing defines.
build:windows --@openssl//:no-winstore=true

# The static CRT removes the dependency on the VC++ Redistributable DLLs. An old copy of
# those crashes the Driver with 0xc0000005.
build:windows --copt=/MT

# ===== Warnings =====
#
# Workspace code builds with all warnings as errors, and dependencies build with none.
# Bazel prints compiler output only for workspace targets.
build --output_filter=^//
build:macos --copt=-Wall
build:macos --per_file_copt=external/.*@-w
build:macos --per_file_copt=vendor/.*@-w
build:linux --copt=-Wall
build:linux --per_file_copt=external/.*@-w
build:linux --per_file_copt=vendor/.*@-w

# ===== Optimization =====
#
# Release builds use --config=opt with --config=opt-unix or --config=opt-windows.
build:opt --compilation_mode=opt
build:opt --strip=always

build:opt-unix --copt=-O3
build:opt-unix --copt=-flto
build:opt-unix --linkopt=-flto

build:opt-windows --copt=/O2
build:opt-windows --copt=/GL
build:opt-windows --linkopt=/LTCG

# ===== Sanitizers =====

build:asan --copt=-fsanitize=address
build:asan --copt=-fno-omit-frame-pointer
build:asan --copt=-O1
build:asan --copt=-g
build:asan --copt=-fno-optimize-sibling-calls
build:asan --copt=-fdebug-prefix-map=/proc/self/cwd=.
build:asan --linkopt=-fsanitize=address
build:asan --test_env=ASAN_OPTIONS=abort_on_error=1:halt_on_error=1:detect_stack_use_after_return=1
build:asan --test_timeout=120,600,1800,3600
# ASan defines _FORTIFY_SOURCE to 0, which macOS headers define again.
build:asan --copt=-Wno-macro-redefined
# ASan gives each temporary in open62541's generated namespace zero its own padded stack
# slot. One node function then needs more than the 512 KB stack of a macOS thread.
build:asan --per_file_copt=.*/open62541/namespace0_generated\.c@-fno-sanitize=address

# LeakSanitizer runs only on Linux.
build:asan-leak --config=asan
build:asan-leak --copt=-fsanitize=leak
build:asan-leak --linkopt=-fsanitize=leak
build:asan-leak --test_env=ASAN_OPTIONS=detect_leaks=1:abort_on_error=1:halt_on_error=1:detect_stack_use_after_return=1
build:asan-leak --test_env=LSAN_OPTIONS=exitcode=0

# ThreadSanitizer cannot be combined with ASan.
build:tsan --copt=-fsanitize=thread
build:tsan --copt=-fno-omit-frame-pointer
build:tsan --copt=-O1
build:tsan --copt=-g
build:tsan --copt=-fdebug-prefix-map=/proc/self/cwd=.
build:tsan --linkopt=-fsanitize=thread
build:tsan --test_env=TSAN_OPTIONS=halt_on_error=1:second_deadlock_stack=1
build:tsan --test_timeout=120,600,1800,3600
test:tsan-no-aslr --config=tsan
test:tsan-no-aslr --run_under="setarch -R"

# ===== Coverage =====
#
# Under coverage, GCC writes a .gcno file for every compile, but Bazel declares it only
# for instrumented targets. A local compile of a target outside the filter then fails
# when an earlier run left a read-only .gcno at that path. The sandbox drops the file.
coverage:linux --strategy=CppCompile=sandboxed

# ===== clang-tidy =====
#
# bazel build --config=clang-tidy <targets> lints every C++ source and header in the
# targets without compiling them. Each file is its own cached action, and any finding
# fails it. Bazel fetches the clang-tidy that MODULE.bazel pins, and each action takes
# the binary and its headers as inputs, so a new version lints every file again.
build:clang-tidy --aspects=@bazel_clang_tidy//clang_tidy:clang_tidy.bzl%clang_tidy_aspect
build:clang-tidy --output_groups=report
build:clang-tidy --@bazel_clang_tidy//:clang_tidy_config=//:clang_tidy_config
build:clang-tidy --@bazel_clang_tidy//:clang_tidy_executable=//:clang_tidy
build:clang-tidy --@bazel_clang_tidy//:clang_tidy_additional_deps=//:clang_tidy_binary
build:clang-tidy --@bazel_clang_tidy//:clang_tidy_resource_dir=//:clang_resource_dir
build:clang-tidy-fix --config=clang-tidy
build:clang-tidy-fix --@bazel_clang_tidy//:clang_tidy_config=//:clang_tidy_fix_config
