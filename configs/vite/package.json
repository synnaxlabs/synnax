{
  "name": "@synnaxlabs/vite-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest",
    "cov": "vitest --coverage",
    "lint": "eslint",
    "fix": "eslint --fix"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "dependencies": {
    "@babel/core": "catalog:",
    "@babel/plugin-transform-react-jsx": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@synnaxlabs/eslint-config": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "rolldown": "catalog:"
  },
  "devDependencies": {
    "@synnaxlabs/tsconfig": "catalog:",
    "@types/babel__core": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "postcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
