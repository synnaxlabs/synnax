{
  "extends": "@synnaxlabs/tsconfig/base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "types": ["html-escaper", "offscreencanvas", "react", "react-dom"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
    "static/env.d.ts",
    "astro.check.config.ts",
    "astro.config.ts",
    "astro-components.d.ts",
    "eslint.config.ts",
    "stylelint.config.ts",
    "vitest.config.ts"
  ]
}
