const { text } = Astro.props;
const parts = String(text ?? "")
    .split(/(`[^`]+`)/g)
    .filter((s) => s.length > 0);
---

{
    parts.map((part) =>
        part.startsWith("`") && part.endsWith("`") ? (
            <code>{part.slice(1, -1)}</code>
        ) : (
            part
        ),
    )
}
