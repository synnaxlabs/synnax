import { Button, Flex, Icon } from "@synnaxlabs/pluto";
import { assetURL } from "@/util/releases";

const version = await Astro.locals.releases.latest("console");
const PLATFORMS = [
    { name: "macOS", asset: `Synnax_${version}_aarch64.dmg`, agent: /Mac OS X/ },
    { name: "Windows", asset: `Synnax_${version}_x64-setup.exe`, agent: /Windows/ },
];
// A prerendered page has no request, and an unknown agent gets every platform.
const agent = Astro.isPrerendered
    ? ""
    : (Astro.request.headers.get("user-agent") ?? "");
const detected = PLATFORMS.filter((platform) => platform.agent.test(agent));
const shown = detected.length > 0 ? detected : PLATFORMS;
---

<Flex.Box direction="x" gap="small" wrap>
    {
        shown.map(({ name, asset }) => (
            <Button.Button href={assetURL("console", version, asset)} variant="filled">
                <Icon.Download />
                Download v{version} for {name}
            </Button.Button>
        ))
    }
</Flex.Box>
