import { Note } from "@synnaxlabs/pluto";

import { Video } from "@/components/media/Media";

interface Props {
    type: string;
    video: string;
}

const { type, video } = Astro.props;
---

<p>
    Create a {type} with the <code>Create a {type}</code> command in the{" "}
    <a href="/reference/console/ui-overview#search-and-command-palette">
        Command Palette
    </a>, or by adding a new tab and selecting the {type} visualization.
</p>

<Note.Note variant="warning">
    <p>
        Make sure that you are working in an{" "}
        <a href="/reference/console/projects"><b>active project</b></a>. A {type}{" "}
        created outside one is <b>not saved</b>.
    </p>
</Note.Note>

<Video client:only="react" id={video} />
