import Inline from "@/components/code/Inline.astro";
import { fetchVersion } from "@/util/fetchVersion";
const { os } = Astro.props;

const version = await fetchVersion();
const baseURL = `github.com/synnaxlabs/synnax/releases/download/synnax-v${version.trim()}`;
let url = `${baseURL}/synnax-driver-v${version.trim()}-${os.toLowerCase()}`;
if (os === "ni-linux-rt") url = `${baseURL}/install-driver-nilinuxrt.sh`;
if (os === "windows") url = `${baseURL}/synnax-driver-v${version.trim()}-windows.exe`;
let cmd = `curl -LO ${url}`;
if (os === "ni-linux-rt")
    cmd += ` && chmod +x install-driver-nilinuxrt.sh && ./install-driver-nilinuxrt.sh`;
if (os === "windows")
    cmd = `Invoke-WebRequest -Uri "https://${url}" -OutFile "synnax-driver.exe"`;
---

<Inline
    lang={os === "windows" ? "powershell" : "bash"}
    theme="css-variables"
    code={cmd}
/>
