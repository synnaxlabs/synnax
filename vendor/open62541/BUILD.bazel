load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load(":codegen.bzl", "generate")

# Builds open62541 with the options its CMake build gets from -DUA_NAMESPACE_ZERO=FULL
# and -DUA_ENABLE_ENCRYPTION=MBEDTLS. Each glob exclude is a source that CMake leaves
# out for a disabled option or another platform. On an upgrade, compare OPTIONS and the
# sources with the CMake build of the new version.

VERSION = (1, 5, 9)

OPTIONS = [
    "UA_ENABLE_DA",
    "UA_ENABLE_DIAGNOSTICS",
    "UA_ENABLE_DISCOVERY",
    "UA_ENABLE_DISCOVERY_SEMAPHORE",
    "UA_ENABLE_ENCRYPTION_MBEDTLS",
    "UA_ENABLE_HISTORIZING",
    "UA_ENABLE_JSON_ENCODING",
    "UA_ENABLE_METHODCALLS",
    "UA_ENABLE_NODEMANAGEMENT",
    "UA_ENABLE_NODESET_COMPILER_DESCRIPTIONS",
    "UA_ENABLE_PUBSUB",
    "UA_ENABLE_PUBSUB_INFORMATIONMODEL",
    "UA_ENABLE_STATUSCODE_DESCRIPTIONS",
    "UA_ENABLE_SUBSCRIPTIONS",
    "UA_ENABLE_SUBSCRIPTIONS_EVENTS",
    "UA_ENABLE_TYPEDESCRIPTION",
    "UA_ENABLE_XML_ENCODING",
    "UA_GENERATED_NAMESPACE_ZERO",
    "UA_GENERATED_NAMESPACE_ZERO_FULL",
    "OPEN62541_VER_MAJOR=%d" % VERSION[0],
    "OPEN62541_VER_MINOR=%d" % VERSION[1],
    "OPEN62541_VER_PATCH=%d" % VERSION[2],
    "OPEN62541_VER_LABEL=",
    "OPEN62541_VER_COMMIT=v%d.%d.%d" % VERSION,
    "OPEN62541_VERSION=v%d.%d.%d" % VERSION,
    "UA_LOGLEVEL=100",
    "UA_MULTITHREADING=100",
]

SCHEMA = "open62541/deps/ua-nodeset/Schema/"

GENERATED = "src_generated/open62541/"

py_library(
    name = "nodeset_compiler_lib",
    srcs = glob(["open62541/tools/nodeset_compiler/*.py"]),
    imports = [
        "open62541/tools",
        "open62541/tools/nodeset_compiler",
    ],
)

py_binary(
    name = "configure",
    srcs = ["configure.py"],
)

py_binary(
    name = "patch",
    srcs = ["patch.py"],
)

py_binary(
    name = "generate_datatypes",
    srcs = ["open62541/tools/generate_datatypes.py"],
    deps = [":nodeset_compiler_lib"],
)

py_binary(
    name = "generate_nodeid_header",
    srcs = ["open62541/tools/generate_nodeid_header.py"],
)

py_binary(
    name = "generate_statuscode_descriptions",
    srcs = ["open62541/tools/generate_statuscode_descriptions.py"],
)

# The compiler uses relative imports, so it runs as a module of its package.
py_binary(
    name = "nodeset_compiler",
    main_module = "nodeset_compiler.nodeset_compiler",
    deps = [":nodeset_compiler_lib"],
)

generate(
    name = "config",
    srcs = ["open62541/include/open62541/config.h.in"],
    outs = [GENERATED + "config.h"],
    arguments = [
        "$(execpath open62541/include/open62541/config.h.in)",
        "{out}",
    ] + OPTIONS + select({
        "@platforms//os:windows": ["UA_ARCHITECTURE_WIN32"],
        "//conditions:default": ["UA_ARCHITECTURE_POSIX"],
    }),
    stem = "config.h",
    tool = ":configure",
)

generate(
    name = "nodeids",
    srcs = [SCHEMA + "NodeIds.csv"],
    outs = [GENERATED + "nodeids.h"],
    arguments = [
        "$(execpath %sNodeIds.csv)" % SCHEMA,
        "{out}",
        "NS0",
    ],
    stem = "nodeids",
    tool = ":generate_nodeid_header",
)

generate(
    name = "statuscodes",
    srcs = [SCHEMA + "StatusCode.csv"],
    outs = [
        GENERATED + "statuscodes.c",
        GENERATED + "statuscodes.h",
    ],
    arguments = [
        "$(execpath %sStatusCode.csv)" % SCHEMA,
        "{out}",
    ],
    stem = "statuscodes",
    tool = ":generate_statuscode_descriptions",
)

generate(
    name = "types",
    srcs = [
        SCHEMA + "NodeIds.csv",
        SCHEMA + "Opc.Ua.Types.bsd",
    ],
    outs = [
        GENERATED + "types_generated.c",
        GENERATED + "types_generated.h",
    ],
    arguments = [
        "--type-bsd=$(execpath %sOpc.Ua.Types.bsd)" % SCHEMA,
        "--type-csv=$(execpath %sNodeIds.csv)" % SCHEMA,
        "{out}",
    ],
    stem = "types",
    tool = ":generate_datatypes",
)

generate(
    name = "transport",
    srcs = [
        "open62541/tools/schema/Custom.Opc.Ua.Transport.bsd",
        "open62541/tools/schema/datatypes_transport.txt",
        SCHEMA + "NodeIds.csv",
        SCHEMA + "Opc.Ua.Types.bsd",
    ],
    outs = [
        GENERATED + "transport_generated.c",
        GENERATED + "transport_generated.h",
    ],
    arguments = [
        "--selected-types=$(execpath open62541/tools/schema/datatypes_transport.txt)",
        "--type-bsd=$(execpath open62541/tools/schema/Custom.Opc.Ua.Transport.bsd)",
        "--import=TYPES#$(execpath %sOpc.Ua.Types.bsd)" % SCHEMA,
        "--type-csv=$(execpath %sNodeIds.csv)" % SCHEMA,
        "--no-builtin",
        "--internal",
        "{out}",
    ],
    stem = "transport",
    tool = ":generate_datatypes",
)

generate(
    name = "namespace0",
    srcs = [
        "open62541/tools/nodeset_compiler/NodeID_NS0_Base.txt",
        SCHEMA + "Opc.Ua.NodeSet2.xml",
    ],
    outs = [
        GENERATED + "namespace0_generated.c",
        GENERATED + "namespace0_generated.h",
    ],
    arguments = [
        "--internal-headers",
        "--ignore=$(execpath open62541/tools/nodeset_compiler/NodeID_NS0_Base.txt)",
        "--xml=$(execpath %sOpc.Ua.NodeSet2.xml)" % SCHEMA,
        "{out}",
    ],
    stem = "namespace0_generated",
    tool = ":nodeset_compiler",
)

generate(
    name = "client_connect",
    srcs = ["open62541/src/client/ua_client_connect.c"],
    outs = ["src_patched/ua_client_connect.c"],
    arguments = [
        "$(execpath open62541/src/client/ua_client_connect.c)",
        "{out}",
    ],
    stem = "ua_client_connect.c",
    tool = ":patch",
)

# src/client resolves the includes of the patched copy of ua_client_connect.c.
PRIVATE_INCLUDES = [
    "deps",
    "plugins",
    "src",
    "src/client",
    "src/pubsub",
]

cc_library(
    name = "open62541",
    srcs = glob(
        [
            "open62541/arch/common/*.c",
            "open62541/arch/common/*.h",
            "open62541/arch/posix/*.c",
            "open62541/arch/posix/*.h",
            "open62541/deps/*.c",
            "open62541/deps/*.h",
            "open62541/plugins/*.c",
            "open62541/plugins/crypto/*.c",
            "open62541/plugins/crypto/*.h",
            "open62541/plugins/crypto/mbedtls/*.c",
            "open62541/plugins/crypto/mbedtls/*.h",
            "open62541/plugins/historydata/*.c",
            "open62541/src/**/*.c",
            "open62541/src/**/*.h",
        ],
        exclude = [
            # UA_ENABLE_MQTT
            "open62541/arch/common/eventloop_mqtt.c",
            # UA_DEBUG_DUMP_PKGS
            "open62541/plugins/ua_debug_dump_pkgs.c",
            # Unix only
            "open62541/plugins/ua_log_syslog.c",
            # UA_ENABLE_NODESETLOADER
            "open62541/plugins/ua_nodesetloader.c",
            # UA_ENABLE_DISCOVERY_MULTICAST
            "open62541/src/server/ua_discovery_mdns.c",
            "open62541/src/server/ua_discovery_mdns_avahi.c",
            # Patched by patch.py
            "open62541/src/client/ua_client_connect.c",
        ],
    ) + [
        GENERATED + "namespace0_generated.c",
        GENERATED + "namespace0_generated.h",
        GENERATED + "statuscodes.c",
        GENERATED + "transport_generated.c",
        GENERATED + "transport_generated.h",
        GENERATED + "types_generated.c",
        "src_patched/ua_client_connect.c",
    ] + select({
        "@platforms//os:windows": [],
        "//conditions:default": ["open62541/plugins/ua_log_syslog.c"],
    }),
    hdrs = glob([
        "open62541/include/open62541/**/*.h",
        "open62541/plugins/include/open62541/**/*.h",
    ]) + [
        GENERATED + "config.h",
        GENERATED + "nodeids.h",
        GENERATED + "statuscodes.h",
        GENERATED + "types_generated.h",
    ],
    copts = ["-I%s/open62541/%s" % (
                package_name(),
                d,
            ) for d in PRIVATE_INCLUDES] +
            select({
                "@platforms//os:windows": ["/w44996"],
                "//conditions:default": [
                    "-fexceptions",
                    "-fno-strict-aliasing",
                ],
            }),
    includes = [
        "open62541/include",
        "open62541/plugins/include",
        "src_generated",
    ],
    linkopts = select({
        "@platforms//os:linux": [
            "-lm",
            "-lpthread",
            "-lrt",
        ],
        "@platforms//os:windows": [
            "bcrypt.lib",
            "iphlpapi.lib",
            "ws2_32.lib",
        ],
        "//conditions:default": [],
    }),
    # The default configuration adds the Basic128Rsa15 and Basic256 security policies
    # only with UA_INCLUDE_INSECURE_POLICIES, which CMake has no option for.
    local_defines = ["UA_INCLUDE_INSECURE_POLICIES"] + select({
        "@platforms//os:macos": ["_DARWIN_C_SOURCE=1"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = ["@mbedtls"],
)

cc_test(
    name = "patch_test",
    srcs = ["patch_test.cpp"],
    deps = [
        ":open62541",
        "@googletest//:gtest_main",
    ],
)
