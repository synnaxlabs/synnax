        "//conditions:default": """
            # Build wasmtime
            cd vendor/wasmtime/wasmtime
            cmake -S crates/c-api -B target/c-api --install-prefix="$$(pwd)/artifacts" -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF
