[submodule "vendor/open62541/open62541"]
	path = vendor/open62541/open62541
	url = https://github.com/open62541/open62541
[submodule "vendor/mbedtls/mbedtls"]
	path = vendor/mbedtls/mbedtls
	url = https://github.com/mbed-tls/mbedtls
[submodule "vendor/wasmtime/wasmtime"]
	path = vendor/wasmtime/wasmtime
	url = https://github.com/bytecodealliance/wasmtime.git
	branch = v49.0.1
[submodule "vendor/libmodbus/libmodbus"]
	path = vendor/libmodbus/libmodbus
	url = https://github.com/stephane/libmodbus.git
# SOEM tracks master: the newest release, v2.0.0, predates the FoE MbxOut fix and a
# dozen later fixes for a NULL dereference, a memory leak and an uninitialised read.
[submodule "vendor/soem/SOEM"]
	path = vendor/soem/SOEM
	url = https://github.com/OpenEtherCATsociety/SOEM.git
	branch = master
