{
  "name": "oracle-language",
  "displayName": "Oracle Schema Language",
  "description": "Language support for Oracle schema files (.oracle)",
  "version": "0.1.0",
  "publisher": "synnaxlabs",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:**/*.oracle"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "oracle",
        "aliases": [
          "Oracle",
          "oracle"
        ],
        "extensions": [
          ".oracle"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "oracle",
        "scopeName": "source.oracle",
        "path": "./syntaxes/oracle.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Oracle Language Server",
      "properties": {
        "oracle.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the Oracle CLI executable. If empty, will search in PATH."
        },
        "oracle.lsp.verbose": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose logging for the language server."
        }
      }
    },
    "configurationDefaults": {
      "[oracle]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "synnaxlabs.oracle-language"
      }
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "compile": "esbuild src/extension.ts --bundle --minify --platform=node --target=node20 --external:vscode --outfile=out/extension.js",
    "watch": "pnpm compile --watch",
    "package": "pnpm check-types && pnpm compile && vsce package --allow-missing-repository --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/vscode": "^1.91.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "typescript": "catalog:"
  }
}
