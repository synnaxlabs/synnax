func readConfigReferences() []gorp.Reference[uuid.UUID, ReadConfig] {
	return []gorp.Reference[uuid.UUID, ReadConfig]{
		gorp.NewKeyReference(gorp.KeyReferenceConfig[uuid.UUID, ReadConfig, channel.Key]{
			Name:     "states.source.key",
			Table:    "channel",
			OnDelete: gorp.Weak,
			Kind:     gorp.Use,
			Tag:      1, // direction read
			Targets: func(e *ReadConfig) []channel.Key {
				var targets []channel.Key
for _, v1 := range e.States {
if v1.Source != nil {
switch v2 := v1.Source.Variant.(type) {
case ChannelSource:
if v2.Key != nil {
if targets == nil {
targets = make([]channel.Key, 0, len(e.States))
}
targets = append(targets, *v2.Key)
}
}
}
}
return targets
			},
			Detach: func(e *ReadConfig, t channel.Key) {
				for i3 := range e.States {
if e.States[i3].Source != nil {
switch v4 := e.States[i3].Source.Variant.(type) {
case ChannelSource:
if v4.Key != nil && *v4.Key == t {
v4.Key = nil
}
e.States[i3].Source.Variant = v4
}
}
}
},
			Retarget: func(e *ReadConfig, to map[channel.Key]channel.Key) {
				for i5 := range e.States {
if e.States[i5].Source != nil {
switch v6 := e.States[i5].Source.Variant.(type) {
case ChannelSource:
if v6.Key != nil {
if t, ok := to[*v6.Key]; ok {
*v6.Key = t
}
}
e.States[i5].Source.Variant = v6
}
}
}
},
		}),
		gorp.NewKeyReference(gorp.KeyReferenceConfig[uuid.UUID, ReadConfig, channel.Key]{
			Name:     "states.source.command",
			Table:    "channel",
			OnDelete: gorp.Weak,
			Kind:     gorp.Use,
			Tag:      2, // direction write
			Targets: func(e *ReadConfig) []channel.Key {
				var targets []channel.Key
for _, v1 := range e.States {
if v1.Source != nil {
switch v2 := v1.Source.Variant.(type) {
case ChannelSource:
if v2.Command != nil {
if targets == nil {
targets = make([]channel.Key, 0, len(e.States))
}
targets = append(targets, *v2.Command)
}
}
}
}
return targets
			},
			Detach: func(e *ReadConfig, t channel.Key) {
				for i3 := range e.States {
if e.States[i3].Source != nil {
switch v4 := e.States[i3].Source.Variant.(type) {
case ChannelSource:
if v4.Command != nil && *v4.Command == t {
v4.Command = nil
}
e.States[i3].Source.Variant = v4
}
}
}
},
			Retarget: func(e *ReadConfig, to map[channel.Key]channel.Key) {
				for i5 := range e.States {
if e.States[i5].Source != nil {
switch v6 := e.States[i5].Source.Variant.(type) {
case ChannelSource:
if v6.Command != nil {
if t, ok := to[*v6.Command]; ok {
*v6.Command = t
}
}
e.States[i5].Source.Variant = v6
}
}
}
},
		}),
		gorp.NewKeyReference(gorp.KeyReferenceConfig[uuid.UUID, ReadConfig, channel.Key]{
			Name:     "commands.channel",
			Table:    "channel",
			OnDelete: gorp.Weak,
			Kind:     gorp.Use,
			Tag:      2, // direction write
			Targets: func(e *ReadConfig) []channel.Key {
				var targets []channel.Key
for _, v1 := range e.Commands {
if targets == nil {
targets = make([]channel.Key, 0, len(e.Commands))
}
targets = append(targets, v1.Channel)
}
return targets
			},
			Detach: func(e *ReadConfig, t channel.Key) {
				e.Commands = slices.DeleteFunc(e.Commands, func(v2 CommandBinding) bool {
if v2.Channel == t {
return true
}
return false
})
},
			Retarget: func(e *ReadConfig, to map[channel.Key]channel.Key) {
				for i3 := range e.Commands {
if t, ok := to[e.Commands[i3].Channel]; ok {
e.Commands[i3].Channel = t
}
}
},
		}),
	}
}
