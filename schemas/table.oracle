import "schemas/channel"
import "schemas/color"
import "schemas/notation"
import "schemas/spatial"
import "schemas/text"

@ts output "client/ts/src/table"
@go output "core/pkg/service/table"
@pb

Key = uuid {
    @doc value "is a unique identifier for a table, represented as a UUID."
}

TextCellConfig struct {
    value            string?             {
        @doc value "is the text content of the cell."
    }
    level            text.Level??        {
        @doc value "is the typography level of the cell text."
    }
    weight           float64??           {
        @doc value "is the font weight of the cell text."
    }
    align            spatial.Alignment?? {
        @doc value "is the alignment of the cell text along the row axis."
    }
    background_color color.Color??       {
        @doc value "is the background color of the cell."
    }

    @doc value "is the configuration for static text cells."
}

Redline struct {
    bounds   spatial.Bounds {
        @doc value "is the numeric range mapped onto the gradient."
    }
    gradient color.Stop[]   {
        @doc value "is the color gradient applied across the bounds."
    }

    @doc value "maps a numeric range to a color gradient for limit visualization."
}

ValueCellConfig struct {
    channel           channel.Key??       {
        @doc value "is the channel whose value the cell displays."
    }
    rolling_average   int32??             {
        @doc value "is the sample window for rolling-average smoothing."
    }
    precision         float64??           {
        @doc value "is the number of decimal places shown."
    }
    notation          notation.Notation?? {
        @doc value "is the numeric notation used to format the value."
    }
    redline           Redline??           {
        @doc value "is the bounds-to-gradient mapping applied to the background."
    }
    level             text.Level??        {
        @doc value "is the typography level of the displayed value."
    }
    color             color.Color??       {
        @doc value "is the color of the displayed text."
    }
    units             string?             {
        @doc value "is the unit suffix displayed after the value."
    }
    staleness_timeout float64??           {
        @doc value "is the duration in seconds after which the value is considered stale."
    }
    staleness_color   color.Color??       {
        @doc value "is the color applied when the value is stale."
    }

    @doc value "is the configuration for live telemetry value cells."
}

CellConfig union on variant {
    text  TextCellConfig
    value ValueCellConfig

    @doc value """
        is the per-cell configuration stored in the table cells map. The
        variant selects which Pluto cell component renders the cell.
    """
}

Cell struct {
    key    string     {
        @doc value "is the unique identifier for this cell within the table."
    }
    config CellConfig {
        @doc value "is the cell's variant-discriminated configuration."
    }

    @doc value """
        is a keyed cell configuration used by actions that address cells
        explicitly. Inside the table state itself, cell configurations are
        stored in the cells map keyed by cell key.
    """
}

Row struct {
    size  float64  {
        @doc value "is the height of the row in pixels."
    }
    cells string[] {
        @doc value """
            is the ordered list of cell keys in this row from left to right.
            Each key points at an entry in the table's cells map.
        """
    }

    @doc value "is a single row in a table, with height and ordered cell keys."
}

Column struct {
    size float64 {
        @doc value "is the width of the column in pixels."
    }

    @doc value "is a single column in a table, with width."
}

Table struct {
    key     Key                     {
        @doc value "is the unique identifier for this table."
        @key
    }
    name    string                  {
        @doc value "is a human-readable name for the table."
    }
    rows    Row[]                   {
        @doc value "are the table rows in display order, top to bottom."
    }
    columns Column[]                {
        @doc value "are the table columns in display order, left to right."
    }
    cells   map<string, CellConfig> {
        @doc value        """
            contains all cells in the table, keyed by cell key. Cell positions
            are derived from rows[*].cells[*] references; cells not referenced
            by any row are orphaned and will be pruned on the next structural
            edit.
        """
        @ts preserve_keys
    }

    action Rename {
        name string

        @doc value "renames the table."
    }

    action AddRow {
        index         uint32
        size          float64
        cells         Cell[]
        cell_template Cell??

        @doc value """
            inserts a row at the given index. Three flows:

            1. User gesture with cell_template against a non-empty table:
               replicate the template once per existing column.
            2. User gesture with cell_template against a fully-empty table:
               seed a 1x1 grid (one template replica plus one default-sized
               column).
            3. Undo replay of RemoveRow (cell_template is null, cells is
               non-empty): use cells as-is. If the original RemoveRow had
               stripped the table down to no columns, the explicit cells
               trigger the same column-bootstrap as flow 2.

            Derived replica keys come from the template's key with the last
            four hex digits replaced by the column index. Out-of-range
            indices clamp to the end.
        """
    }

    action RemoveRow {
        index uint32

        @doc value """
            removes the row at the given index. All cells referenced by the
            removed row are also dropped from the cells map. No-op if the
            index is out of range.
        """
    }

    action AddCol {
        index         uint32
        size          float64
        cells         Cell[]
        cell_template Cell??

        @doc value """
            inserts a column at the given index. Three flows:

            1. User gesture with cell_template against a non-empty table:
               replicate the template once per existing row.
            2. User gesture with cell_template against a fully-empty table:
               seed a 1x1 grid (one template replica plus one default-sized
               row).
            3. Undo replay of RemoveCol (cell_template is null, cells is
               non-empty): use cells as-is. If the original RemoveCol had
               stripped the table down to no rows, the explicit cells
               trigger the same row-bootstrap as flow 2.

            Derived replica keys come from the template's key with the last
            four hex digits replaced by the row index. Cells whose row
            index exceeds the row count are added to the cells map but not
            referenced by any row. Out-of-range indices clamp to the end of
            every row's cells list.
        """
    }

    action RemoveCol {
        index uint32

        @doc value """
            removes the column at the given index. All cells in that column
            (across every row) are dropped from the cells map. No-op if the
            index is out of range.
        """
    }

    action ResizeRow {
        index uint32
        size  float64

        @doc value "resizes the row at the given index. No-op if the index is out of range."
    }

    action ResizeCol {
        index uint32
        size  float64

        @doc value "resizes the column at the given index. No-op if the index is out of range."
    }

    action SetCell {
        cell Cell

        @doc value """
            replaces the cell at cell.key with the provided value. No-op if
            no cell with that key exists in the table.
        """
    }

    action EraseCells {
        cells    string[]
        template CellConfig

        @doc value """
            erases the cells whose keys are in cells. Any row whose every
            cell is in the selection is removed entirely; same for columns.
            Cells that survive that row/column removal have their config
            replaced with the template, keeping their original keys. Cells
            in the selection whose keys are not in the table's cells map are
            silently skipped.
        """
    }

    @doc value     """
        is a tabular data display component for viewing structured telemetry
        data. Tables support multiple columns, channel data sources, and
        customizable formatting options.
    """
    @ontology type "table"
    @retrieve
    @go marshal
    @go migrate
}

New struct extends Table {
    key     = create
    rows    = []
    columns = []
    cells   = {}

    @doc value    "contains parameters for creating a new table."
    @ts use_input
    @go omit
    @pb omit
}
