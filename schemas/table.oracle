@ts output "client/ts/src/table"
@go output "core/pkg/service/table"
@pb

Key = uuid {
    @doc value "is a unique identifier for a table, represented as a UUID."
}

Cell struct {
    key     string {
        @doc value "is the unique identifier for this cell within the table."
    }
    variant string {
        @doc value """
            is the cell variant identifier (e.g. "text", "value"). The variant
            determines the shape of props and which Pluto cell component renders
            the cell.
        """
    }
    props   record {
        @doc value        """
            is the variant-specific cell configuration. The shape is determined
            by the variant; the wire format intentionally stores it as an
            opaque record so new variants can be added without a schema
            migration.
        """
        @ts preserve_case
    }

    @doc value "is a single cell in a table, identified by key and variant."
}

Row struct {
    size  float64  {
        @doc value "is the height of the row in pixels."
    }
    cells string[] {
        @doc value """
            is the ordered list of cell keys in this row from left to right.
            Each key points at an entry in the table's cells map.
        """
    }

    @doc value "is a single row in a table, with height and ordered cell keys."
}

Column struct {
    size float64 {
        @doc value "is the width of the column in pixels."
    }

    @doc value "is a single column in a table, with width."
}

Table struct {
    key     Key               {
        @doc value "is the unique identifier for this table."
        @key
    }
    name    string            {
        @doc value "is a human-readable name for the table."
    }
    rows    Row[]             {
        @doc value "are the table rows in display order, top to bottom."
    }
    columns Column[]          {
        @doc value "are the table columns in display order, left to right."
    }
    cells   map<string, Cell> {
        @doc value        """
            contains all cells in the table, keyed by cell key. Cell positions
            are derived from rows[*].cells[*] references; cells not referenced
            by any row are orphaned and will be pruned on the next structural
            edit.
        """
        @ts preserve_case
    }

    action Rename {
        name string

        @doc value "renames the table."
    }

    action AddRow {
        index uint32
        size  float64
        cells Cell[]

        @doc value """
            inserts a row at the given index with the provided cell values.
            cells carries one Cell per column in left-to-right order; each
            cell is added to the table's cells map and its key is appended to
            the new row's cells list. Out-of-range indices clamp to the end.
        """
    }

    action RemoveRow {
        index uint32

        @doc value """
            removes the row at the given index. All cells referenced by the
            removed row are also dropped from the cells map. No-op if the
            index is out of range.
        """
    }

    action AddCol {
        index uint32
        size  float64
        cells Cell[]

        @doc value """
            inserts a column at the given index with the provided cell values.
            cells carries one Cell per row in top-to-bottom order; each cell
            is added to the table's cells map and its key is inserted into
            the corresponding row's cells list at the column index.
            Out-of-range indices clamp to the end.
        """
    }

    action RemoveCol {
        index uint32

        @doc value """
            removes the column at the given index. All cells in that column
            (across every row) are dropped from the cells map. No-op if the
            index is out of range.
        """
    }

    action ResizeRow {
        index uint32
        size  float64

        @doc value "resizes the row at the given index. No-op if the index is out of range."
    }

    action ResizeCol {
        index uint32
        size  float64

        @doc value "resizes the column at the given index. No-op if the index is out of range."
    }

    action SetCell {
        cell Cell

        @doc value """
            replaces the cell at cell.key with the provided value. No-op if
            no cell with that key exists in the table.
        """
    }

    @doc value     """
        is a tabular data display component for viewing structured telemetry
        data. Tables support multiple columns, channel data sources, and
        customizable formatting options.
    """
    @ontology type "table"
    @retrieve
    @go marshal
    @go migrate
}

New struct extends Table {
    key Key? {
        @doc value """
            is an optional key for the table. If not provided, one will be
            automatically assigned.
        """
    }

    @doc value    "contains parameters for creating a new table."
    @ts use_input
    @go omit
    @pb omit
}
