@go output "core/pkg/service/access"
@py output "client/py/synnax/access/action"
@ts output "client/ts/src/access/action"

Action enum {
    create   = "create" {
        @doc value "creates a resource."
    }
    delete   = "delete" {
        @doc value "deletes a resource."
    }
    retrieve = "retrieve" {
        @doc value "reads a resource."
    }
    update   = "update" {
        @doc value "changes a resource."
    }

    @doc value """
        is a fundamental operation controlled by the permission system. Actions define
        what operations a subject can perform on resources.
    """
}
