import "schemas/synnax/task"

@go output "core/pkg/service/pagerduty"
@py output "client/py/synnax/pagerduty"
@ts output "client/ts/src/pagerduty"

Alert struct {
    key                     string = "" {
        @doc value "uniquely identifies the alert within the task."
        @key
    }
    status                  string = "" {
        @doc value "is the key of the Synnax status the alert watches."
    }
    treat_error_as_critical bool = false {
        @doc value "maps the error variant to PagerDuty critical instead of error."
    }
    component               string = "" {
        @doc value "is the PagerDuty component attached to triggered events."
    }
    group                   string = "" {
        @doc value "is the PagerDuty group attached to triggered events."
    }
    class                   string = "" {
        @doc value "is the PagerDuty class attached to triggered events."
    }
    disabled                bool = false {
        @doc value "is true when the alert is excluded from the task."
    }

    @doc value "maps a Synnax status to a PagerDuty event routing rule."
}

TaskConfig struct extends task.BaseStartConfig {
    routing_key string = "" {
        @doc value "is the PagerDuty Events API v2 routing key."
    }
    alerts      Alert[] {
        @doc value "are the alerts the task evaluates."
    }

    @doc value """
        configures a PagerDuty alert task, which forwards Synnax status changes to
        PagerDuty as events.
    """
}
