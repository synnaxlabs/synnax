import "schemas/synnax/resource"

@go output "core/pkg/service/impact"
@py output "client/py/synnax/impact"
@ts output "client/ts/src/impact"

Change union on type {
    delete {
        records resource.ID[] {
            @doc value "are the records to delete."
        }

        @doc value "deletes records."
    }

    @doc value "is a change that a plan covers."
    @go output "core/pkg/api/impact"
}

Effect enum {
    restrict = "restrict"
    cascade  = "cascade"
    detach   = "detach"

    @doc value """
        is what a delete does to a record that holds a record it deletes. A restrict
        record stops the delete unless the caller picks to delete it too, a cascade
        record is deleted with the record it holds, and a detach record loses it.
    """
}

Choice enum {
    cancel = "cancel"
    delete = "delete"

    @doc value """
        is a pick for an entry. Cancel stops the whole change, and delete deletes the
        record too.
    """
}

Entry struct {
    record  resource.ID {
        @doc value """
            is the record that the change touches. A pick names it in text form.
        """
    }
    effect  Effect      {
        @doc value "is what the change does to the record."
    }
    choices Choice[]    {
        @doc value "are the picks the caller may make, empty when it has none."
    }
    default Choice?     {
        @doc value "is the pick that applies when the caller makes none."
    }

    @doc value "is one record that a change touches."
}

Hidden struct {
    restrict uint32 {
        @doc value "is the number of hidden entries that stop the change."
    }
    cascade  uint32 {
        @doc value "is the number of hidden entries that the change deletes."
    }
    detach   uint32 {
        @doc value "is the number of hidden entries that lose a record."
    }

    @doc value """
        counts the entries whose records the caller cannot see, by effect. Counts name
        no record.
    """
}

Plan struct {
    entries Entry[]       {
        @doc value "are the records that the change touches, sorted by record."
    }
    kept    uint32        {
        @doc value """
            is the number of records that hold a deleted record and keep it with no
            change. They need no pick, so they are not entries.
        """
    }
    hidden  Hidden        {
        @doc value """
            counts the entries whose records the caller cannot see. One pick covers the
            ones that stop the change.
        """
    }
    token   string        {
        @doc value """
            is the hex form of a hash of the change, each visible entry, and the hidden
            counts, with the caller's picks. Apply refuses a token that no longer
            matches.
        """
    }
    records resource.ID[] {
        @doc value "are the records that the caller deletes."
    }

    @doc value "is every record that a change touches, with the picks for each."
}

PlanRequest struct {
    change Change              {
        @doc value "is the change to plan."
    }
    picks  map<string, Choice> {
        @doc value        """
            maps the text form of the record of a visible entry to the pick for it.
        """
        @ts preserve_keys
    }
    hidden Choice?             {
        @doc value "is the pick for every hidden entry that stops the change."
    }

    @doc value "asks what a change would do with the caller's picks."
    @go output "core/pkg/api/impact"
}

ApplyRequest struct {
    change Change              {
        @doc value "is the change to apply."
    }
    token  string = "" {
        @doc value """
            is the token of the plan that the caller saw. Empty skips the check.
        """
    }
    picks  map<string, Choice> {
        @doc value        """
            maps the text form of the record of a visible entry to the pick for it.
        """
        @ts preserve_keys
    }
    hidden Choice?             {
        @doc value "is the pick for every hidden entry that stops the change."
    }

    @doc value "carries out a change with the caller's picks."
    @go output "core/pkg/api/impact"
}
