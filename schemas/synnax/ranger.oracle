import "schemas/synnax/label"
import "schemas/x/color"
import "schemas/x/filter"
import "schemas/x/patch"
import "schemas/x/telem"

@cpp output "client/cpp/ranger"
@go output  "core/pkg/service/ranger"
@pb
@py output  "client/py/synnax/ranger"
@ts output  "client/ts/src/ranger"

Key = uuid {
    @doc value "is a unique identifier for a range, represented as a UUID."
}

Range struct {
    key        Key             {
        @doc value "is the unique identifier for this range."
        @key
    }
    name       string          {
        @doc value           "is a human-readable name for the range."
        @filter
        @index sorted
        @patch
        @search
        @validate min_length 1
    }
    time_range telem.TimeRange {
        @doc value    """
            is the temporal extent of the range, defining its start and end timestamps.
        """
        @index sorted start
        @patch
        @ts type      telem.TimeRangeBounded
    }
    color      color.Color?    {
        @doc value """
            is an optional display color for visual identification of the range in user
            interfaces.
        """
        @patch
    }
    labels     label.Key[] = [] {
        @doc value     "are the keys of the labels attached to the range."
        @ref kind      use
        @ref on_delete detach
    }
    parent     Key?            {
        @doc value     """
            is the key of the range this range is nested in. Empty for a top-level
            range.
        """
        @patch
        @ref acyclic
        @ref kind      place
        @ref on_delete cascade
    }

    action Create {
        range Range

        @doc value """
            replaces the range with the given created state. Emitted by the Core when a
            range is created; clients never dispatch it.
        """
    }

    action Set = patch.Set

    action Remove = patch.Remove

    action Insert = patch.Insert

    action Move = patch.Move

    @cpp includes    "client/cpp/ranger/kv/kv.h"
    @cpp methods     "ranger::kv::Client kv"
    @cpp name        "Range"
    @doc value       """
        is a user-defined region of time in the Synnax cluster. Ranges act as a method
        for labeling and categorizing telemetry data within specific time periods.
    """
    @go marshal
    @go migrate
    @pb
    @py name         "Payload"
    @resource type   "range"
    @retrieve custom
    @ts name         "Payload"
}

Where filter Range {
    key
    name
    overlaps telem.TimeRange {
        @doc value "matches ranges whose time range overlaps the given range."
    }
    labels   label.Key[]     {
        @doc value "matches ranges that have any of the given labels."
    }
    parents  Key[]           {
        @doc value "matches the ranges nested in any of the given ranges."
    }

    @doc value         "is a filter that selects ranges."
    @go marshal
    @go request_output "core/pkg/api/ranger"
}

Ref union on variant {
    key {
        key Key {
            @doc value "is the key of a range saved in the Core."
        }

        @doc value "is a range saved in the Core."
    }
    window {
        window telem.Window {
            @doc value "is the window the reference resolves to."
        }

        @doc value "is a window carried inline: rolling or fixed."
    }

    @cpp omit
    @doc value  """
        is the range a visualization shows: a range saved in the Core, or an inline
        window.
    """
    @go marshal
    @pb omit
}

New struct extends Range {
    key?

    @cpp omit
    @doc value "contains parameters for creating a new range."
    @go omit
    @pb omit
    @py omit
    @ts {
        name "New"
        use_input
    }
}
