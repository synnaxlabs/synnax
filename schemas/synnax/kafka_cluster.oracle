import "schemas/synnax/channel"
import "schemas/synnax/icd"
import "schemas/synnax/rack"
import "schemas/synnax/secret"
import "schemas/synnax/status"
import "schemas/synnax/tls"
import "schemas/x/filter"
import "schemas/x/net"

@go output "core/pkg/service/kafka/cluster"
@py output "client/py/synnax/kafka/cluster"
@ts output "client/ts/src/kafka/cluster"

Key = uuid {
    @doc value "uniquely identifies a Kafka cluster."
}

Transport union on type {
    plaintext {
        @doc value "connects over plain TCP."
    }
    tls extends tls.TLS {
        @doc value "connects over TLS."
    }

    @doc value  """
        is the transport that the Core connects to the brokers of a cluster over.
    """
    @go marshal
}

Credentials struct {
    username string     {
        @doc value         "is the user name to authenticate with."
        @validate required
    }
    password secret.Key {
        @doc value         "is the secret that holds the password."
        @validate required
    }

    @doc value  "carries the user name and password of a SASL mechanism."
    @go marshal
}

Auth union on mechanism {
    none {
        @doc value "authenticates with no credentials."
    }
    plain extends Credentials {
        @doc value "authenticates with the SASL PLAIN mechanism."
    }
    scram_sha_256 extends Credentials {
        @doc value "authenticates with the SASL SCRAM-SHA-256 mechanism."
    }
    scram_sha_512 extends Credentials {
        @doc value "authenticates with the SASL SCRAM-SHA-512 mechanism."
    }

    @doc value  "selects the SASL mechanism and the credentials it carries."
    @go marshal
}

Read struct {
    topic      string         {
        @doc value         "is the topic to consume."
        @go validate       pattern "^([a-zA-Z0-9_-][a-zA-Z0-9._-]{0,248}|[.][a-zA-Z0-9_-][a-zA-Z0-9._-]{0,247}|[.][.][a-zA-Z0-9._-]{1,247})$" "Topic must be 1 to 249 letters, digits, '.', '_', or '-', and not '.' or '..'"
        @validate required
    }
    record_key string?        {
        @doc value           """
            is the Kafka key of the records read here, never empty. Absent reads only
            the records with no key or an empty key.
        """
        @validate min_length 1
    }
    message    icd.MessageKey {
        @doc value         "is the ICD message that the values of the records hold."
        @validate required
    }
    pointer    string = "" {
        @doc value   "is the JSON Pointer to the value in the message."
        @go validate pattern "^(/([^~/]|~[01])*)*$" "Pointer must be empty or a JSON Pointer that starts with / and escapes ~ as ~0 and / as ~1"
    }
    index      channel.Key    {
        @doc value         "is the index channel of the channel."
        @ref kind          use
        @ref on_delete     restrict
        @validate required
    }
    channel    channel.Key    {
        @doc value         "is the channel that holds the samples of the value."
        @ref kind          use
        @ref on_delete     restrict
        @validate required
    }

    @doc value  "binds a value in the records of a topic to a channel."
    @go marshal
}

StatusDetails struct {
    rack      rack.Key {
        @doc value "is the key of the rack the cluster belongs to."
    }
    cluster   Key      {
        @doc value "is the key of the cluster."
    }
    connected bool = false {
        @doc value "is true when the Core is connected to the cluster."
    }

    @doc value "identifies the cluster and rack that a status pertains to."
}

Status = status.Status<StatusDetails> {
    @doc value "is the connection status of a cluster."
}

Cluster struct {
    key       Key = create {
        @doc value "uniquely identifies the cluster."
        @key
    }
    rack      rack.Key      {
        @doc value     "is the key of the rack that connects to the cluster."
        @ref kind      place
        @ref on_delete restrict
    }
    name      string        {
        @doc value         "is a human-readable name for the cluster."
        @filter
        @search
        @validate required
    }
    brokers   net.Address[] {
        @doc value         """
            are the bootstrap brokers of the cluster. A cluster has at least one, and a
            broker with no port takes 9092.
        """
        @validate required
    }
    transport Transport = plaintext {
        @doc value "is the transport that the Core connects to the brokers over."
    }
    auth      Auth = none {
        @doc value "is the authentication that the brokers require."
    }
    reads     Read[] = [] {
        @doc value "bind the values that read tasks consume to channels."
    }
    status    Status?       {
        @doc value  "is the current connection status of the cluster."
        @go marshal omit
        @include
    }

    @create
    @doc value     "is a Kafka cluster that a rack connects to."
    @go marshal
    @go migrate
    @resource type "kafka_cluster"
    @retrieve
}

Where filter Cluster {
    key
    name
    rack

    @doc value         "is a filter that selects Kafka clusters."
    @go request_output "core/pkg/api/kafka/cluster"
}

Identity struct {
    rack      rack.Key      {
        @doc value         "is the key of the rack that connects to the cluster."
        @validate required
    }
    name      string        {
        @doc value         "is a human-readable name for the cluster."
        @validate required
    }
    brokers   net.Address[] {
        @doc value         """
            are the bootstrap brokers of the cluster. A cluster has at least one, and a
            broker with no port takes 9092.
        """
        @validate required
    }
    transport Transport = plaintext {
        @doc value "is the transport that the Core connects to the brokers over."
    }
    auth      Auth = none {
        @doc value "is the authentication that the brokers require."
    }

    @doc value "holds the cluster fields that the connect form owns."
}

Configuration struct {
    reads Read[] = [] {
        @doc value "bind the values that read tasks consume to channels."
    }

    @doc value "holds the cluster fields that the task forms own."
}

Update union on group {
    identity      Identity {
        @doc value "writes the fields of the cluster that the connect form owns."
    }
    configuration Configuration {
        @doc value """
            replaces the reads of the cluster. A client sends the whole group, because a
            field it leaves out is cleared.
        """
    }

    @doc value "is a write to one field group of a cluster."
}
