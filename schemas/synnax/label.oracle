import "schemas/x/color"
import "schemas/x/filter"
import "schemas/x/patch"

@cpp output "client/cpp/label"
@go output  "core/pkg/service/label"
@pb
@py output  "client/py/synnax/label"
@ts output  "client/ts/src/label"

Key = uuid {
    @doc value "is a unique identifier for a label, represented as a UUID."
}

Label struct {
    key   Key = create {
        @doc value "is the unique identifier for this label."
        @key
    }
    name  string      {
        @doc value           "is a human-readable name for the label."
        @index sorted
        @patch
        @search
        @validate min_length 1
    }
    color color.Color {
        @doc value "is the display color for visual identification of the label."
        @patch
    }

    action Create {
        label Label

        @doc value """
            replaces the label with the given created state. Emitted by the Core when a
            label is created; clients never dispatch it.
        """
    }

    action Set = patch.Set

    action Remove = patch.Remove

    action Insert = patch.Insert

    action Move = patch.Move

    @create
    @doc value       """
        is a tagging and categorization entity with a name and associated color. Labels
        can be attached to resources like ranges for organization and filtering.
    """
    @go marshal
    @go migrate
    @resource type   "label"
    @retrieve custom
}

Where filter Label {
    key
    name

    @cpp omit
    @doc value         "is a filter that selects labels."
    @go request_output "core/pkg/api/label"
    @pb omit
}
