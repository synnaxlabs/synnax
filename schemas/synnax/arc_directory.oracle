import "schemas/x/filter"

@go output "core/pkg/service/arc/directory"
@ts output "client/ts/src/arc/directory"

Key = uuid {
    @doc value "is a unique identifier for a directory of Arcs."
}

Directory struct {
    key    Key    {
        @doc value "is the unique identifier for this directory."
        @key
    }
    name   string {
        @doc value         """
            is the name of the directory, one segment of an import path.
        """
        @search
        @validate required
    }
    parent Key?   {
        @doc value     "is the directory that holds this directory. The root has none."
        @ref acyclic
        @ref on_delete restrict
    }

    @doc value     "holds Arcs and other directories below the Arcs root."
    @go marshal
    @go migrate
    @resource type "arc_directory"
    @retrieve
}

Where filter Directory {
    key
    name
    parents Key[] {
        @doc value "matches the directories that any of the given directories hold."
    }
    nested  bool  {
        @doc value """
            matches the directories that another directory holds, or the root when
            false.
        """
    }

    @doc value         "is a filter that selects Arc directories."
    @go request_output "core/pkg/api/arc/directory"
}
