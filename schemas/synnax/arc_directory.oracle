@go output "core/pkg/service/arc/directory"
@ts output "client/ts/src/arc/directory"

Key = uuid {
    @doc value "is a unique identifier for a directory of Arcs."
}

Directory struct {
    key  Key    {
        @doc value "is the unique identifier for this directory."
        @key
    }
    name string {
        @doc value         """
            is the name of the directory, one segment of an import path.
        """
        @validate required
    }

    @doc value     "holds Arcs and other directories below the Arcs root."
    @go marshal
    @go migrate
    @ontology type "arc_directory"
}
