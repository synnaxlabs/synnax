import "schemas/x/filter"
import "schemas/x/telem"

@go output "core/pkg/service/secret"
@py output "client/py/synnax/secret"
@ts output "client/ts/src/secret"

Key = uuid {
    @doc value "is a unique identifier for a secret."
}

Source enum {
    stored = "stored"
    file   = "file"

    @doc value "is where the value of a secret lives."
}

Base struct {
    key     Key = create {
        @doc value "is the unique identifier for this secret."
        @key
    }
    name    string          {
        @doc value         "is a human-readable name for the secret."
        @search
        @validate required
    }
    updated telem.TimeStamp {
        @doc value "is when the value or path of the secret last changed."
    }

    @doc value  "carries the fields shared by every secret."
    @go marshal
}

Secret union on source Source extends Base {
    stored {
        value bytes {
            @doc value "is the value, encrypted with AES-256-GCM under the data key."
            @go wire   omit
            @py omit
            @ts omit
        }

        @doc value "is a secret whose value the Core stores."
    }
    file {
        path string {
            @doc value "is the path of the file on the computer that uses the secret."
        }

        @doc value "is a secret whose value is a file on the computer that uses it."
    }

    @doc value     """
        is a hidden value that a device or task uses to connect, such as a password, a
        token, an API key, or a private key. Only the program that connects reads it.
    """
    @go marshal
    @go migrate
    @ontology type "secret"
    @retrieve
}

Where filter Secret {
    key

    @doc value         "is a filter that selects secrets."
    @go request_output "core/pkg/api/secret"
}
