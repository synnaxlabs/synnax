import "schemas/synnax/ontology"

@go output "core/pkg/service/auth/oidc"
@ts output "client/ts/src/auth/oidc"

Key = uuid {
    @doc value "is a unique identifier for a provider link."
}

Link struct {
    key      Key = create {
        @doc value "is the unique identifier for this link."
        @key
    }
    subject  ontology.ID {
        @doc value    "is the user the provider account logs in as."
        @filter
        @index lookup
    }
    provider string      {
        @doc value         "is the name of the provider in the Core's settings."
        @filter
        @index lookup
        @validate required
    }
    account  string      {
        @doc value         """
            is the provider's permanent ID for the account, its `sub` claim.
        """
        @filter
        @index lookup
        @validate required
    }

    @doc value  """
        links an OpenID Connect provider account to a user. A user holds one link per
        provider.
    """
    @go marshal
    @go migrate
    @retrieve
}
