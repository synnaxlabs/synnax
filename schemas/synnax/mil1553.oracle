import "schemas/synnax/bus"
import "schemas/synnax/task"

@cpp output "client/cpp/mil1553"
@go output  "core/pkg/service/mil1553"
@py output  "client/py/synnax/mil1553"
@ts output  "client/ts/src/mil1553"

Backend enum {
    simulated = "simulated"
    ddc       = "ddc"
    ballard   = "ballard"

    @doc value "is the driver library the Driver talks to a MIL-STD-1553 card through."
}

Role enum {
    bus_controller  = "bus_controller"
    remote_terminal = "remote_terminal"
    monitor         = "monitor"

    @doc value "is how a MIL-STD-1553 channel takes part in the bus."
}

Properties struct {
    backend   Backend {
        @doc value "is the driver library the card is reached through."
    }
    card      uint16 = 0 {
        @doc value "is the index of the card within its backend."
    }
    channel   uint16 = 0 {
        @doc value "is the index of the channel on the card."
    }
    role      Role = monitor {
        @doc value """
            is how the channel takes part in the bus. A bus controller sends each
            message on its period, a remote terminal answers commands for the terminals
            it simulates, and a monitor only listens.
        """
    }
    terminals uint8[] = [] {
        @doc value """
            are the remote terminal addresses a remote terminal channel answers.
        """
    }

    @doc value  "are the properties of a MIL-STD-1553 device: one channel on one card."
    @go marshal
}

ReadConfig struct extends bus.ReadConfig {
    @doc value  """
        configures a MIL-STD-1553 read task. On a bus controller it commands each
        message on its period; on a monitor or remote terminal it listens.
    """
    @go marshal
    @go migrate
}

WriteConfig struct extends bus.WriteConfig {
    @doc value  """
        configures a MIL-STD-1553 write task. On a bus controller it sends receive
        commands; on a remote terminal it answers transmit commands with the latest
        command channel values.
    """
    @go marshal
    @go migrate
}

ScanConfig struct extends task.ScanConfig {
    @doc value  "configures the scan task that lists the channels of each backend."
    @go marshal
    @go migrate
}
