import "schemas/synnax/access"
import "schemas/synnax/resource"
import "schemas/synnax/role"
import "schemas/x/filter"
import "schemas/x/patch"

@go output "core/pkg/service/access/rbac/policy"
@py output "client/py/synnax/access/policy"
@ts output "client/ts/src/access/policy"

Key = uuid {
    @doc value "is a unique identifier for a policy, represented as a UUID."
}

Policy struct {
    key      Key = create {
        @doc value "is the unique identifier for this policy."
        @key
    }
    name     string          {
        @doc value         "is a human-readable name for the policy."
        @filter
        @index sorted
        @search
        @validate required
    }
    objects  resource.ID[]   {
        @doc value "is the list of resources this policy applies to."
    }
    actions  access.Action[] {
        @doc value "is the list of actions this policy permits."
    }
    internal bool = false {
        @doc value "is true if this is a built-in system policy that cannot be deleted."
        @filter
    }
    role     role.Key        {
        @doc value     "is the role that grants this policy to its subjects."
        @ref kind      place
        @ref on_delete cascade
    }

    action Create {
        policy Policy

        @doc value """
            replaces the policy with the given created state. Emitted by the Core when a
            policy is created; clients never dispatch it.
        """
    }

    action Set = patch.Set

    action Remove = patch.Remove

    action Insert = patch.Insert

    action Move = patch.Move

    @create
    @doc value       """
        is an access control policy that defines which actions are permitted on which
        resources. Each policy belongs to one role, and a subject holds the policies of
        each role in its roles.
    """
    @go marshal
    @go migrate
    @resource type   "policy"
    @retrieve custom
}

Where filter Policy {
    key
    internal
    subjects resource.ID[] {
        @doc value """
            matches the policies of the roles that any of the given subjects hold.
        """
    }
    roles    role.Key[]    {
        @doc value "matches the policies of any of the given roles."
    }

    @doc value         "is a filter that selects policies."
    @go request_output "core/pkg/api/access/policy"
}
