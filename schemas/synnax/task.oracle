import "schemas/synnax/device"
import "schemas/synnax/rack"
import "schemas/synnax/status"
import "schemas/x/telem"

@ts output  "client/ts/src/task"
@py output  "client/py/synnax/task"
@go output  "core/pkg/service/task"
@cpp output "client/cpp/task"
@pb

Key = uuid {
    @go version 2
    @doc value  "is a unique identifier for a task."
}

StatusDetails struct<Data? = record> {
    task        Key      {
        @doc value "is the key of the task this status pertains to."
    }
    running     bool     {
        @doc value "is true if the task is currently executing."
    }
    cmd         string = "" {
        @doc value "is the last command executed on this task."
    }
    config_hash string = "" {
        @doc value """
            is the hash of the config the running task instance was built from.
            Empty when no instance exists.
        """
    }
    rack        rack.Key = 0 {
        @doc value "is the key of the rack running the task instance."
    }
    data        Data?    {
        @doc value "contains task-specific status data."
    }

    @go version        2
    @doc value         "contains task-specific status details including execution state."
    @ts concrete_types
}

Status<Data? = record> = status.Status<StatusDetails<Data>> {
    @go version 2
    @doc value  """
        is task-specific status information including execution state and task-specific data.
    """
}

Task struct<
    Type extends string = string,
    Config extends record = record,
    StatusData? = record
> {
    key         Key = create {
        @doc value "is the unique identifier for this task."
        @key
    }
    rack        rack.Key = 0 {
        @doc value """
            is the key of the rack this task deploys to. Zero for a draft that
            has not been assigned a rack; required to start.
        """
        @filter
    }
    name        string              {
        @doc value "is a human-readable name for the task."
        @filter
    }
    type        Type                {
        @doc value """
            is the task type (e.g., 'modbus_read', 'labjack_write', 'opc_scan').
            Determines which hardware integration handles the task.
        """
        @filter
    }
    config      Config              {
        @doc value """
            is task-specific configuration stored as JSON. Structure varies by
            task type.
        """
    }
    config_hash string = "" {
        @doc value """
            is the Core-assigned hash of config, rewritten on every write and ignored on
            writes from clients. Compare against a status's config_hash to detect drift.
        """
    }
    internal    bool = false {
        @doc value "is true if this is an internal system task."
        @filter
    }
    snapshot    bool = false {
        @doc value "indicates whether to persist this task's configuration."
        @filter
    }
    status      Status<StatusData>? {
        @doc value  "is the current execution status of the task."
        @go marshal omit
    }

    @go version    2
    @doc value     """
        is an executable unit of work in the Driver system. Tasks represent
        specific hardware operations such as reading sensor data, writing
        control signals, or scanning for devices.
    """
    @ts {
        name "Payload"
        concrete_types
        coalesce_type_params
    }
    @ontology type "task"
    @retrieve
    @search
    @go marshal
    @go migrate
    @py name       "Payload"
    @create
}

Command struct {
    task        Key    {
        @doc value "is the key of the target task."
    }
    type        string {
        @doc value "is the command type (e.g., 'start', 'stop', 'configure')."
    }
    key         string {
        @doc value "is a unique identifier for this command instance."
    }
    config_hash string = "" {
        @doc value """
            is the config hash the sender wants running. Empty when the sender does not
            know it. The Driver reuses its live instance when the hash matches and
            redeploys when it differs.
        """
    }
    args        record = {} {
        @doc value        "contains optional arguments for the command."
        @ts preserve_case
    }

    @doc value "is a command to execute on a task in the Driver system."
}

BaseStartConfig struct {
    auto_start bool = false {
        @doc value "is true when the task should start as soon as it is configured."
    }

    @doc value  "carries the configuration fields shared by every task."
    @go output  "core/pkg/service/task/common"
    @cpp output "client/cpp/task/common"
    @pb omit
}

BasePersistConfig struct extends BaseStartConfig {
    data_saving_disabled bool = false {
        @doc value "is true when task telemetry is not persisted to disk."
    }

    @doc value  "carries the configuration fields shared by tasks that write telemetry."
    @go output  "core/pkg/service/task/common"
    @cpp output "client/cpp/task/common"
    @pb omit
}

BaseReadConfig struct extends BasePersistConfig {
    sample_rate telem.Rate = 10 {
        @doc value "is the per-channel hardware sample rate, in hertz."
        @ts type   "number"
    }
    stream_rate telem.Rate = 5 {
        @doc value "is the rate at which samples are streamed to Synnax, in hertz."
        @ts type   "number"
    }

    @doc value  "carries the configuration fields shared by hardware acquisition tasks."
    @go output  "core/pkg/service/task/common"
    @cpp output "client/cpp/task/common"
    @pb omit
}

BaseWriteConfig struct extends BasePersistConfig {
    device device.Key = "" {
        @doc value "is the key of the device the task writes to."
    }

    @doc value  "carries the configuration fields shared by hardware control tasks."
    @go output  "core/pkg/service/task/common"
    @cpp output "client/cpp/task/common"
    @pb omit
}
