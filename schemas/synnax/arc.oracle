import "schemas/arc/graph"
import "schemas/arc/ir"
import "schemas/arc/program"
import "schemas/arc/text"
import "schemas/synnax/status"
import "schemas/x/crdt"
import "schemas/x/filter"
import "schemas/x/patch"
import "schemas/x/spatial"

@cpp output "client/cpp/arc"
@go output  "core/pkg/service/arc"
@pb
@py output  "client/py/synnax/arc"
@ts output  "client/ts/src/arc"

Key = uuid {
    @doc value "is a unique identifier for an Arc module."
}

Mode enum {
    text  = "text" {
        @doc value "stores the module as Arc source text."
    }
    graph = "graph" {
        @doc value "stores the module as a visual dataflow graph."
    }

    @doc value """
        specifies whether an Arc module uses text-based or graph-based representation.
    """
}

Source union on mode Mode {
    text {
        text text.Text = {} {
            @doc value "is the text-based Arc source code."
        }

        @doc value "is Arc source code written as text."
    }
    graph {
        graph graph.Graph = {} {
            @doc value "is the visual dataflow graph representation of the module."
        }

        @doc value "is Arc source code drawn as a visual dataflow graph."
    }

    @doc value  "is the source code of an Arc. The mode selects text or a graph."
    @go marshal
}

Base struct {
    key       Key = create {
        @doc value "is the unique identifier for this module."
        @key
    }
    name      string {
        @doc value         "is a human-readable name for the module."
        @filter
        @index sorted
        @search
        @validate required
    }
    source    Source = text {
        @doc value "is the Arc's source code, written as text or drawn as a graph."
    }
    directory uuid?  {
        @doc value "is the key of the directory that holds the Arc."
    }

    @doc value  "carries the fields that every Arc shares."
    @go marshal
}

Arc union on type Type extends Base {
    automation {
        program program.Program? {
            @doc value  """
                is the compiled module output including IR and WebAssembly bytecode.
            """
            @go marshal omit
            @include
        }
        changes Change[]?        {
            @doc value  "is what changed in the automation since its task was deployed."
            @go marshal omit
            @include
        }

        @doc value "is an Arc that runs on a rack as a task."
    }
    module {
        status Status? {
            @doc value  "is the result of the module's last compile on the Core."
            @go marshal omit
            @include
        }

        @doc value "is an Arc that holds code for other Arcs to import."
    }

    action Create {
        arc Arc

        @doc value """
            replaces the document with the given created state. Emitted by the Core on
            create so remote caches ingest new documents; clients never dispatch it.
        """
    }

    action SetNode {
        node graph.Node

        @doc value """
            inserts the node if no node with the same key exists, otherwise replaces the
            existing node in place. Operates only on the node's position; the node's
            function type and inputs are set separately via SetNodeInputs.
        """
    }

    action SetNodePosition {
        key      string
        position spatial.XY

        @doc value "moves a graph node to a new canvas position."
    }

    action SetNodeInputs {
        key    string
        inputs record {
            @ts preserve_case
        }

        @doc value """
            merges the given inputs into the entry for the given key in the graph inputs
            map. Top-level fields present in the payload overwrite existing fields;
            fields absent from the payload are preserved. The node's function type is
            held under "type".
        """
    }

    action RemoveNode {
        key string

        @doc value """
            removes the node with the given key along with its inputs entry and any
            edges connected to it.
        """
    }

    action AddEdge {
        edge graph.Edge

        @doc value """
            appends the edge to the graph. No-op when an edge with the same source and
            target handles already exists, so concurrent additions of the same
            connection converge regardless of differing keys.
        """
    }

    action RemoveEdge {
        key string

        @doc value """
            removes the edge with the given key, if present.
        """
    }

    action ReconnectEdge {
        key    string
        source ir.Handle
        target ir.Handle

        @doc value """
            rewrites the endpoints of the edge with the given key, preserving its key
            and kind. No-op when no edge with the key exists.
        """
    }

    action InsertChar extends crdt.Insert {
        @doc value """
            carries a single collaborative-edit character insertion against the module's
            text. The payload is a sequence CRDT operation; the server relays it to the
            other editors of the module without interpreting it.
        """
    }

    action DeleteChar extends crdt.Delete {
        @doc value """
            carries a single collaborative-edit character deletion against the module's
            text. The payload is a sequence CRDT operation; the server relays it to the
            other editors of the module without interpreting it.
        """
    }

    action ForgetChars {
        ids crdt.ID[]

        @doc value """
            removes the given already-deleted characters from the module's text
            document, dropping both their insert and delete operations from the
            replicated op-log. The server emits it after a quiet editing period to
            reclaim the space held by tombstoned characters. Because the characters are
            already deleted, and thus invisible, applying it never changes the
            materialized text.
        """
    }

    action SetDirectory {
        directory uuid

        @doc value """
            moves the Arc into the directory with the given key. The root Arcs directory
            holds the Arcs at the top level.
        """
    }

    action Set = patch.Set {
        @doc value """
            replaces the Arc's name, or the value at a path in the graph's node inputs.
        """
    }

    action Remove = patch.Remove {
        @doc value """
            removes an entry from a list or a field from an object in the graph's node
            inputs.
        """
    }

    action Insert = patch.Insert {
        @doc value "adds an entry to a list in the graph's node inputs."
    }

    action Move = patch.Move {
        @doc value "moves an entry in a list in the graph's node inputs."
    }

    @create
    @doc value     """
        is an Arc module combining visual graph representation and text-based source
        code for reactive control systems. Compiles to WebAssembly for sandboxed
        execution.
    """
    @go imex
    @go marshal
    @go migrate
    @py name       "Payload"
    @resource type "arc"
    @retrieve
}

Status = status.Status<nil>

ChangeKind enum {
    changed = "changed"
    added   = "added"
    removed = "removed"

    @doc value """
        is how a piece of an automation's content differs from what its task last ran.
    """
}

Change struct {
    type Type       {
        @doc value "is whether the automation's own text or a module changed."
    }
    path string = "" {
        @doc value "is the import path of the module. Empty for the automation."
    }
    kind ChangeKind {
        @doc value "is how the content differs from what the task last ran."
    }

    @doc value """
        is one difference between an automation's content and what its task last ran.
    """
}

Type enum {
    automation = "automation"
    module     = "module"

    @doc value """
        specifies whether an Arc runs on a rack as an automation or holds code for other
        Arcs to import as a module.
    """
}

Where filter Arc {
    key
    name
    directories uuid[] {
        @doc value "matches the Arcs in any of the given directories."
    }

    @doc value         "is a filter that selects Arcs."
    @go request_output "core/pkg/api/arc"
}
