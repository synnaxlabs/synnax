import "schemas/synnax/ranger"
import "schemas/x/patch"

@go output "core/pkg/service/ranger/kv"
@pb
@ts output "client/ts/src/ranger/kv"

Pair struct {
    range ranger.Key {
        @doc value     """
            is the unique identifier of the range owning this key-value pair.
        """
        @ref kind      place
        @ref on_delete cascade
    }
    key   string     {
        @doc value "is the metadata key name."
    }
    value string     {
        @doc value "is the metadata value stored as a string for flexibility."
    }

    action Create {
        pair Pair

        @doc value """
            replaces the pair with the given created state. Emitted by the Core when a
            pair is created or overwritten whole; clients never dispatch it.
        """
    }

    action Set = patch.Set

    action Remove = patch.Remove

    action Insert = patch.Insert

    action Move = patch.Move

    @doc value        """
        is a key-value metadata pair associated with a specific range, enabling
        arbitrary metadata storage on time ranges.
    """
    @go marshal
    @go migrate
    @retrieve indexes
    @retrieve key     "string"
}
