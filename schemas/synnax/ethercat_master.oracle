import "schemas/synnax/rack"
import "schemas/synnax/status"
import "schemas/x/filter"

@cpp output "client/cpp/ethercat/master"
@go output  "core/pkg/service/ethercat/master"
@py output  "client/py/synnax/ethercat/master"
@ts output  "client/ts/src/ethercat/master"

Key = uuid {
    @doc value "uniquely identifies an EtherCAT master."
}

StatusDetails struct {
    rack   rack.Key {
        @doc value "is the key of the rack the master belongs to."
    }
    master Key      {
        @doc value "is the key of the master."
    }

    @doc value "identifies the master and rack that a status pertains to."
}

Status = status.Status<StatusDetails> {
    @doc value "is the operational status of a master."
}

Master struct {
    key       Key = create {
        @doc value "uniquely identifies the master."
        @key
    }
    rack      rack.Key {
        @doc value     "is the key of the rack the master runs on."
        @ref kind      place
        @ref on_delete restrict
    }
    name      string   {
        @doc value         "is a human-readable name for the master."
        @filter
        @search
        @validate required
    }
    interface string   {
        @doc value         """
            is the network interface the master drives, such as eth0 or igh:0.
        """
        @filter
        @go validate       pattern "^(igh:[0-9]+|\\\\Device\\\\NPF_[{][0-9A-Fa-f-]{36}[}]|[A-Za-z0-9][A-Za-z0-9_.-]{0,14})$" "Interface must be a network interface name, such as eth0, or igh: and a master index"
        @index lookup
        @validate required
    }
    slaves    uuid[] = [] {
        @doc value """
            are the keys of the slaves on the bus, in bus order. A slave's position is
            its index.
        """
    }
    status    Status?  {
        @doc value  "is the current operational status of the master."
        @go marshal omit
        @include
    }

    @create
    @doc value     "is an EtherCAT master: one network interface and the bus behind it."
    @go marshal
    @go migrate
    @resource type "ethercat_master"
    @retrieve
}

Where filter Master {
    key
    name
    interface
    rack

    @doc value         "is a filter that selects EtherCAT masters."
    @go request_output "core/pkg/api/ethercat/master"
}
