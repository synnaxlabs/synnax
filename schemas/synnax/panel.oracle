import "schemas/synnax/ontology"
import "schemas/x/spatial"

@ts output "client/ts/src/panel"
@go output "core/pkg/service/panel"

TabKey = uuid {
    @go version 0
}

TabBase struct {
    key TabKey = create {
        @doc value """
            is the stable unique identifier of this tab within the panel. It is
            independent of the tab's content, so a tab's content may be swapped
            without changing the tab's identity or position.
        """
    }

    @go version 0
    @doc value  "carries the identity shared by every tab variant."
}

View struct {
    type string {
        @doc value """
            is the Console-owned view type identifier (e.g., 'docs',
            'selector') used to select a renderer.
        """
    }
    args record = {} {
        @doc value        """
            is an opaque, Console-owned configuration payload for the
            view. Core never interprets it; it round-trips as-is.
        """
        @ts preserve_case
    }

    @go version 0
    @doc value  """
        is an inline, self-describing view: a Console-owned type plus an
        opaque configuration payload, with no backing core document. Used
        for app-views and tools (docs, explorers, task forms, and the
        selector pickers).
    """
}

Tab union on variant extends TabBase {
    resource {
        resource ontology.ID {
            @doc value """
                is the visualization resource displayed by this tab, set via
                SetTabResource.
            """
        }

        @doc value "is a tab displaying a backing core document."
    }
    view View {
        @doc value """
            is a tab displaying an inline, self-describing view. Unlike a
            resource, a view has no backing core document: it carries its own
            type and opaque args. Used for app-views and tools (docs,
            explorers, task forms, and the selector pickers).
        """
    }

    @go version 0
    @doc value  """
        is a single tab in a leaf. Tab content is a discriminated union:
        a resource (a backing core document, e.g. a line plot) or a view
        (an inline, self-describing app-view, e.g. docs). A freshly created
        tab is a view whose type is a selector picker; SetTabResource or
        SetTabView swaps content in place. Display attributes (name, icon,
        closability) are resolved at render time from the content. A
        resource may back at most one tab per panel; views may repeat.
    """
    @create
}

Node union on variant {
    leaf {
        tabs Tab[] {
            @doc value "is the ordered list of tabs in this leaf."
        }

        @doc value "is a leaf node in the panel tree displaying a tab strip."
    }
    split {
        direction spatial.Direction {
            @doc value "is the axis along which this node is split."
        }
        size      spatial.Decimal   {
            @doc value """
                is the fraction in [0, 1] of the parent area allocated to first.
                The remainder is allocated to last.
            """
        }
        first     Node              {
            @doc value "is the first child (left for x, top for y)."
        }
        last      Node              {
            @doc value "is the second child (right for x, bottom for y)."
        }

        @doc value "is an interior split node dividing its area between two children."
    }

    @go version 0
    @doc value  """
        is a node in the panel tree: either a leaf displaying a tab strip
        or an interior split. Nodes are identified by path-derived numeric
        keys during traversal (1 = root, 2k = first child, 2k+1 = last child).
    """
}

Key = uuid {
    @go version 0
    @doc value  "is a unique identifier for a panel, represented as a UUID."
}

Panel struct {
    key    Key = create {
        @doc value "is the unique identifier for this panel."
        @key
    }
    name   string       {
        @doc value         "is a human-readable name for the panel."
        @validate required
    }
    root   Node = { variant = "leaf", tabs = [] } {
        @doc value "is the root of the panel tree."
    }
    parent ontology.ID? {
        @doc value  """
            is the parent resource for the panel in the ontology, required
            on create. Parenthood lives in the ontology graph, so the field
            is not persisted on the panel record and is absent on retrieve.
        """
        @go marshal omit
    }

    action Create {
        panel Panel

        @doc value """
            replaces the document with the given created state. Emitted by the Core on
            create so remote caches ingest new documents; clients never dispatch it.
        """
    }

    action Rename {
        name string

        @doc value "renames the panel."
    }

    action InsertTabs {
        tabs        Tab[]
        target_leaf int32?
        target_tab  TabKey?
        index       int32?
        location    spatial.Location?
        singleton   bool?

        @doc value """
            inserts tabs into a leaf in order, starting at the given index and
            appending when index is absent or past the leaf's end. The
            destination leaf is resolved
            from target_tab (the leaf holding that tab) when set, otherwise
            from the target_leaf path-derived key, otherwise the first leaf in
            traversal order. Both are hints: a target that no longer resolves
            to a leaf falls back to the first leaf instead of failing, so a
            placement invalidated between the gesture and the dispatch still
            opens the tabs. The fallback drops location too, leaving a leaf the
            caller never pointed at unsplit. When location is an edge, the
            resolved leaf is split once at that location and every tab is
            inserted into the new empty leaf; a center location places the tabs
            directly in the resolved leaf, equivalent to absent. The split is
            deferred to the first tab that lands, so a batch whose every tab is
            skipped leaves no empty pane behind. A tab whose key is already in
            the tree has its content refreshed and keeps its position unless
            the payload carries an explicit placement, in which case it is
            relocated with the rest. Inserting a resource tab whose resource
            already backs a different tab is skipped, as is a view tab of a
            type already backing a tab when singleton is set: each may back at
            most one tab per panel, and callers select the existing tab
            instead. Skipping one tab does not stop the others.
        """
    }

    action RemoveTab {
        key uuid

        @doc value """
            removes the tab with the given key. If the containing leaf
            becomes empty and has a sibling, the reducer collapses the
            parent split.
        """
    }

    action MoveTab {
        key         uuid
        target_leaf int32
        index       int32?
        location    spatial.Location?

        @doc value """
            moves a tab to a position within the panel. When location is an
            edge, the target leaf is first split at that location and the
            tab moves into the new empty leaf; moving a leaf's only tab to
            an edge of its own leaf is a no-op. A center location places the
            tab directly in the target leaf, equivalent to absent.
            Cross-panel moves are RemoveTab on the source plus InsertTabs on
            the destination (two dispatches; not atomic).
        """
    }

    action SplitTab {
        key       uuid
        direction spatial.Direction

        @doc value """
            splits the tab with the given key off its leaf into a new sibling
            pane, moving the tab into it. direction x places the new pane to
            the right, y to the bottom. The tab must share its leaf with at
            least one other tab; splitting the only tab in a leaf is a no-op.
        """
    }

    action ResizeSplit {
        split int32
        size  spatial.Decimal

        @doc value "adjusts the size ratio of a split node. size in [0, 1]."
    }

    action SetTabResource {
        key      uuid
        resource ontology.ID

        @doc value """
            sets the visualization resource displayed by the tab with the
            given key, swapping it in place without changing the tab's
            identity or position. Clears any view set on the tab. A no-op
            when the resource already backs another tab in the panel. Used
            to fill a freshly inserted selector tab once the user picks a
            visualization.
        """
    }

    action SetTabView {
        key  uuid
        view View

        @doc value """
            sets the inline view displayed by the tab with the given key,
            swapping it in place without changing the tab's identity or
            position. Clears any resource set on the tab.
        """
    }

    @go version    0
    @doc value     "is a project-owned tab holding a tree of visualization tabs."
    @ontology type "panel"
    @retrieve
    @create
    @search
    @go marshal
    @go migrate
}
