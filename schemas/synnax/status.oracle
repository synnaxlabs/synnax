import "schemas/synnax/label"
import "schemas/synnax/resource"
import "schemas/x/filter"
import "schemas/x/telem"

@cpp output "client/cpp/status"
@go output  "core/pkg/service/status"
@pb
@py output  "client/py/synnax/status"
@ts output  "client/ts/src/status"

Variant enum {
    success  = "success" {
        @doc value "reports that an operation succeeded."
    }
    info     = "info" {
        @doc value "reports general information."
    }
    warning  = "warning" {
        @doc value "reports a condition that needs attention."
    }
    error    = "error" {
        @doc value "reports a failure."
    }
    loading  = "loading" {
        @doc value "reports an operation in progress."
    }
    disabled = "disabled" {
        @doc value "reports that the subject is not active."
    }

    @doc value   "is the severity or type of a status message."
    @ts literals
}

Key = string {
    @doc value "is a unique identifier for a status."
}

Status struct<Details?, V extends Variant = Variant> {
    key         Key = create {
        @doc value """
            is a unique identifier for this status. The Core assigns a UUID when a
            status has no key and its owner holds no status.
        """
        @key
    }
    name        string = "" {
        @doc value    """
            is the name of what the status is about, such as a task, device, or rack.
            Empty when the status is not about a named thing.
        """
        @index sorted
        @search
    }
    variant     V               {
        @doc value """
            indicates the severity of the status. One of success, info, warning, error,
            loading, or disabled.
        """
    }
    message     string          {
        @doc value """
            says what happened in one short line, such as "Failed to start task" or
            "Started task". A status that reports a state names the state instead, such
            as "Driver not running".
        """
    }
    description string = "" {
        @doc value """
            says why it happened and what to do now, in full sentences. Raw error text
            goes here, never in the message. Empty when the message says enough.
        """
    }
    time        telem.TimeStamp = now {
        @doc value "is the timestamp when the status was created."
    }
    details     Details         {
        @doc value  """
            contains optional component-specific custom details for the status.
        """
        @go marshal json_only
    }
    labels      label.Key[] = [] {
        @doc value     "are the keys of the labels attached to the status."
        @ref kind      use
        @ref on_delete detach
    }
    owner       resource.ID?    {
        @doc value     """
            is the resource the status reports on, such as a task, device, or rack. An
            owner holds at most one status. Empty for a status that no resource owns.
        """
        @ref kind      place
        @ref on_delete cascade
        @ref types     rack task device channel arc ni_device ni_chassis certificate
        @ref unique
    }

    action Set {
        status Status<any>

        @doc value """
            replaces the status with the given state. Emitted by the Core on every write
            to the status; clients never dispatch it.
        """
    }

    @create
    @doc value         """
        is a standardized message used to communicate state across the Synnax platform.
        Statuses support different severity variants and can carry component-specific
        details. A status is uniquely identified by a key, may name the resource that
        owns it, and may carry a human-readable name and labels.
    """
    @go marshal
    @go to_any
    @resource type     "status"
    @retrieve indexes
    @ts concrete_types
}

Where filter Status {
    key
    variant
    labels  label.Key[]   {
        @doc value "matches statuses that have any of the given labels."
    }
    owners  resource.ID[] {
        @doc value "matches the statuses that the given resources own."
    }

    @doc value         "is a filter that selects statuses."
    @go marshal
    @go request_output "core/pkg/api/status"
}
