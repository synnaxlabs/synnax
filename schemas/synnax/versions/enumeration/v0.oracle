import "schemas/synnax/versions/color/v0"
import "schemas/synnax/versions/resource/v0"

Key = uuid {
    @doc value "is the key of an enumeration."
}

Entry struct {
    key      string     {
        @doc value "is the key of the entry, unique in its enumeration."
    }
    value    float64    {
        @doc value """
            is the value that selects the entry, unique in its enumeration. Selects and
            buttons write it.
        """
    }
    name     string     {
        @doc value "is the name of the entry."
    }
    abnormal bool = false {
        @doc value "is true when the entry is a state that needs attention."
    }
    color    color.Ref? {
        @doc value "is the color of the entry. When absent, the symbol picks the color."
    }

    @doc value  "is one state of an enumeration: a value with a name and a color."
    @go marshal
}

Enumeration struct {
    key     Key = create {
        @doc value "is the key of the enumeration."
        @key
    }
    name    string         {
        @doc value "is the name of the enumeration."
    }
    entries Entry[] = [] {
        @doc value "are the states of the enumeration."
    }
    uses    resource.ID[]? {
        @doc value  """
            are the resources that use the enumeration and that the caller can read,
            filled only when a retrieve request asks for them.
        """
        @go marshal omit
    }

    @doc value  """
        is a set of states that maps exact values to names and colors. A record that
        shows states holds its key, so an edit to the enumeration changes each user.
    """
    @go marshal
    @go migrate
}
