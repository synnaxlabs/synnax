SecureCredentials struct {
    username string {
        @doc value "is the unique login name the credentials belong to."
    }
    password bytes  {
        @doc value "is the bcrypt hash of the user's password."
    }

    @doc value  """
        is the legacy storage shape of a credential row: a MessagePack map keyed by Go
        field names.
    """
    @go hand
    @go migrate
}
