import "schemas/synnax/versions/ontology/v0"
import "schemas/x/versions/telem/v0"

SessionKey = v2.SessionKey

Session struct extends v2.Session {
    credential
    credential_version telem.TimeStamp {
        @doc value "is when the credential's secret was set, as the login saw it."
        @go wire   omit
    }
}
