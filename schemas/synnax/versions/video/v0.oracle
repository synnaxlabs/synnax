import "schemas/synnax/versions/channel/v0"
import "schemas/synnax/versions/ranger/v1"

Key = uuid {
    @doc value "is a unique identifier for a video view, represented as a UUID."
}

Video struct {
    key     Key = create {
        @doc value "is the unique identifier for this video view."
        @key
    }
    name    string      {
        @doc value "is a human-readable name for the video view."
    }
    channel channel.Key = 0 {
        @doc value "is the video channel the view shows."
    }
    range   ranger.Ref? {
        @doc value "is the range the view plays back. Absent shows live video."
    }

    @doc value  "is a view that shows the frames of one video channel."
    @go marshal
    @go migrate
}
