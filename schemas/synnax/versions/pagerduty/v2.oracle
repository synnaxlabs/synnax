import "schemas/synnax/versions/secret/v0"
import "schemas/synnax/versions/task/v2"

Alert = v1.Alert

TaskConfig struct extends v1.TaskConfig {
    routing_key       secret.Key? {
        @doc value "is the secret that holds the PagerDuty Events API v2 routing key."
    }
    plain_routing_key string?     {
        @doc value  """
            is the routing key in plain text, which only configs from before secrets
            carry. A write moves it into a new secret and clears it.
        """
        @go marshal omit
    }
}
