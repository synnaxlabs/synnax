Key = v0.Key

User struct {
    key        Key    {
        @doc value "is the unique identifier for this user."
        @key
    }
    username   string {
        @doc value  """
            is the login name of the user's password credential. It is not stored on the
            user and is filled when the user is read.
        """
        @go marshal omit
    }
    first_name string {
        @doc value "is the user's first name."
    }
    last_name  string {
        @doc value "is the user's last name."
    }
    root_user  bool = false {
        @doc value """
            is true if this is a root/admin user with full system access. Root users
            cannot be deleted.
        """
    }

    @doc value  """
        is an account entity representing a person accessing the Synnax system. Users
        can have roles assigned for permission management.
    """
    @go marshal
    @go migrate
}
