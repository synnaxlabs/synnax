Key = uuid {
    @doc value "is a unique identifier for a user, represented as a UUID."
}

User struct {
    key        Key    {
        @doc value "is the unique identifier for this user."
        @key
    }
    username   string {
        @doc value "is the unique login name for the user."
    }
    first_name string {
        @doc value "is the user's first name."
    }
    last_name  string {
        @doc value "is the user's last name."
    }
    root_user  bool = false {
        @doc value """is true if this is a root/admin user with full system access. Root
users cannot be deleted."""
    }

    @doc value  """is an account entity representing a person accessing the Synnax system.
Users can have roles assigned for permission management."""
    @go migrate
    @go marshal
}
