Key = uuid {
    @doc value "is the key of the task a record describes."
}

Hashes struct {
    text    string = "" {
        @doc value "is the text hash of the automation."
    }
    modules map<string, string> {
        @doc value "maps the import path of each module to that module's text hash."
    }

    @doc value  "names the content of an automation and of the modules it imports."
    @go marshal
    @go migrate
}

Record struct {
    task     Key    {
        @doc value "is the key of the automation's task."
        @key
    }
    stored   Hashes = {} {
        @doc value "is the content the automation's task config now holds."
    }
    deployed Hashes = {} {
        @doc value "is the content the Driver last ran, as far as the Core has seen."
    }

    @doc value  "records what changed in an automation since its task was deployed."
    @go marshal
    @go migrate
}
