import "schemas/synnax/versions/channel/v2"

Key = v0.Key

Hashes = v0.Hashes

Record struct extends v0.Record {
    reads  channel.Key[] = [] {
        @doc value "are the channels that the program the Driver last ran reads."
    }
    writes channel.Key[] = [] {
        @doc value "are the channels that the program the Driver last ran writes."
    }
}
