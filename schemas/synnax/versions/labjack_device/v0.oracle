import "schemas/synnax/versions/channel/v1"
import "schemas/synnax/versions/rack/v3"
import "schemas/synnax/versions/status/v2"

Key = uuid {
    @doc value "uniquely identifies a LabJack device."
}

Model enum {
    t4 = "t4" {
        @doc value "is a T4."
    }
    t7 = "t7" {
        @doc value "is a T7."
    }
    t8 = "t8" {
        @doc value "is a T8."
    }

    @doc value "is the model of a LabJack device."
}

Connection enum {
    usb      = "LJM_ctUSB" {
        @doc value "is a USB connection."
    }
    ethernet = "LJM_ctETHERNET" {
        @doc value "is an Ethernet connection."
    }
    wifi     = "LJM_ctWIFI" {
        @doc value "is a Wi-Fi connection."
    }

    @doc value """
        is the connection of a LabJack device, named by its LJM connection type.
    """
}

StatusDetails struct {
    rack   rack.Key {
        @doc value "is the key of the rack the device belongs to."
    }
    device Key      {
        @doc value "is the key of the device."
    }

    @doc value "identifies the device and rack that a status pertains to."
}

Status = status.Status<StatusDetails> {
    @doc value "is the operational status of a device."
}

Ports union on model Model {
    t4 {
        @doc value "are the ports of a T4."
    }
    t7 {
        mux80_attached bool = false {
            @doc value """
                is true when a Mux80 is attached, which adds the analog input ports
                AIN48 to AIN127.
            """
        }

        @doc value "are the ports of a T7."
    }
    t8 {
        @doc value "are the ports of a T8."
    }

    @doc value  """
        holds the configuration that depends on the model: the channel maps and the
        accessories that add ports.
    """
    @go marshal
}

Device struct {
    key               Key = create {
        @doc value "uniquely identifies the device."
        @key
    }
    rack              rack.Key    {
        @doc value "is the key of the rack the device is connected to."
    }
    name              string      {
        @doc value "is a human-readable name for the device."
    }
    serial            uint32      {
        @doc value "is the serial number of the device."
    }
    connection        Connection  {
        @doc value "is the connection the scanner last found the device on."
    }
    identifier        string = "" {
        @doc value   """
            is the prefix of the device's channel names. The device is unconfigured
            while it is empty.
        """
        @go validate pattern "^$|^[A-Za-z][A-Za-z0-9_]{1,11}$" "Identifier must be 2 to 12 characters, start with a letter, and contain only letters, digits, and underscores"
    }
    read_index        channel.Key = 0 {
        @doc value "is the index channel of the channels that the device reads into."
    }
    write_state_index channel.Key = 0 {
        @doc value "is the index channel of the state channels of the device's outputs."
    }
    status            Status?     {
        @doc value  "is the current operational status of the device."
        @go marshal omit
    }
    model             Model       {
        @doc value         """
            is the model of the device. It selects the ports the device has.
        """
        @validate required
    }
    ports             Ports       {
        @doc value "holds the channel maps and the accessories of the device's model."
    }

    @doc value  "is a LabJack T-series device."
    @go marshal
    @go migrate
}
