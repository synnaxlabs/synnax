import "schemas/synnax/versions/channel/v0"
import "schemas/x/versions/border/v0"
import "schemas/x/versions/color/v0"
import "schemas/x/versions/spatial/v0"
import "schemas/x/versions/text/v0"

Key = v0.Key

Node = v8.Node

Handle = v7.Handle

Edge = v7.Edge

Segment struct {
    direction spatial.Direction {
        @doc value "is the axis along which the segment travels."
    }
    length    float64           {
        @doc value "is the signed length of the segment in pixels."
    }

    @doc value  "is a single orthogonal run in an edge's connector path."
    @go marshal
}

SegmentedEdgeConfig struct {
    color    color.Color? {
        @doc value "is the stroke color of the edge."
    }
    segments Segment[]    {
        @doc value """
            is the ordered list of orthogonal runs that trace the connector path from
            the source handle to the target handle.
        """
    }

    @doc value  "is the configuration shared by every segmented edge variant."
    @go marshal
}

EdgeConfig union on variant {
    pipe      SegmentedEdgeConfig
    electric  SegmentedEdgeConfig
    secondary SegmentedEdgeConfig
    jacketed  SegmentedEdgeConfig
    hydraulic SegmentedEdgeConfig
    pneumatic SegmentedEdgeConfig
    data      SegmentedEdgeConfig

    @doc value  """
        is the per-edge configuration stored in the schematic configs map. The variant
        selects the visual style of the connection.
    """
    @go marshal
}

FlexAlignment enum {
    start   = "start"
    center  = "center"
    end     = "end"
    stretch = "stretch"

    @doc value "is a cross-axis flex alignment for laid-out content."
}

ComponentSize enum {
    tiny   = "tiny"
    small  = "small"
    medium = "medium"
    large  = "large"
    huge   = "huge"

    @doc value "is a discrete size preset for interactive components."
}

ButtonMode enum {
    fire      = "fire"
    momentary = "momentary"
    pulse     = "pulse"

    @doc value """
        is the actuation behavior of a button: fire writes once on click, momentary
        writes on press and clears on release, and pulse writes a one-cycle pulse.
    """
}

LabelConfig struct {
    label           string = "" {
        @doc value "is the text content of the label."
    }
    level           text.Level = text.LevelH5 {
        @doc value "is the typography level of the label text."
    }
    orientation     spatial.Location = spatial.LocationTop {
        @doc value "is the placement of the label relative to the symbol."
    }
    direction       spatial.Direction = spatial.DirectionX {
        @doc value "is the axis along which the label text flows."
    }
    max_inline_size float64 = 150 {
        @doc value    """
            is the maximum inline size of the label in pixels before wrapping.
        """
        @validate min 1
    }
    align           FlexAlignment = FlexAlignmentCenter {
        @doc value "is the alignment of the label text within its box."
    }

    @doc value  "is the text label configuration shared by schematic symbols."
    @go marshal
}

LabeledConfig struct {
    label       LabelConfig = {} {
        @doc value "is the symbol's label configuration."
    }
    orientation spatial.OuterLocation = spatial.OuterLocationLeft {
        @doc value "is the orientation of the symbol's primitive within the diagram."
    }
    scale       float64 = 1 {
        @doc value "is the rendered scale multiplier of the symbol."
    }

    @doc value  "is the base configuration for any symbol that carries a label."
    @go marshal
}

ControlStateConfig struct {
    authority        uint8?           {
        @doc value """
            is the control authority requested when the symbol acquires its command
            channel. Defaults to absolute authority when unset.
        """
    }
    hidden           bool = false {
        @doc value "hides the control state widget."
    }
    chip_hidden      bool = false {
        @doc value "hides the authority chip."
    }
    indicator_hidden bool = false {
        @doc value "hides the state indicator."
    }
    orientation      spatial.Location = spatial.LocationBottom {
        @doc value """
            is the placement of the control state widget relative to the symbol.
        """
    }

    @doc value  """
        is the control authority and state display configuration for actuated symbols.
    """
    @go marshal
}

ToggleConfig struct extends LabeledConfig {
    state_channel     channel.Key?        {
        @doc value "is the channel whose value drives the symbol's active state."
    }
    command_channel   channel.Key?        {
        @doc value "is the channel actuation commands are written to."
    }
    control           ControlStateConfig? {
        @doc value "is the control state display configuration."
    }
    on_click_delay    float64 = 0 {
        @doc value "is the debounce delay applied to clicks, in milliseconds."
    }
    staleness_timeout float64 = 5 {
        @doc value """
            is the duration in seconds after which the state is considered stale.
        """
    }
    staleness_color   color.Color?        {
        @doc value "is the color applied when the state is stale."
    }

    @doc value  """
        is the base configuration for symbols actuated through a boolean telemetry pair.
    """
    @go marshal
}

StaticSymbolConfig struct extends LabeledConfig {
    color color.Color? {
        @doc value "is the stroke color of the symbol."
    }

    @doc value  "is the configuration for non-interactive labeled symbols."
    @go marshal
}

ToggleSymbolConfig struct extends ToggleConfig {
    color color.Color? {
        @doc value "is the stroke color of the symbol."
    }

    @doc value  "is the configuration for telemetry-actuated toggle symbols."
    @go marshal
}

DummyToggleSymbolConfig struct extends LabeledConfig {
    enabled   bool = false {
        @doc value "indicates whether the symbol renders in its active state."
    }
    clickable bool = false {
        @doc value "indicates whether clicking the symbol toggles its state."
    }
    color     color.Color? {
        @doc value "is the stroke color of the symbol."
    }

    @doc value  """
        is the configuration for symbols that toggle their appearance from local state
        without binding to telemetry.
    """
    @go marshal
}

ScaleIndicatorConfig struct {
    channel           channel.Key?          {
        @doc value "is the channel whose value drives the indicator."
    }
    rolling_average   int32?                {
        @doc value "is the sample window for rolling-average smoothing."
    }
    bounds            spatial.Bounds = { lower = 0, upper = 100 } {
        @doc value "is the numeric range the indicator maps onto its extent."
    }
    color             color.Color?          {
        @doc value "is the color of the filled portion."
    }
    axis_color        color.Color?          {
        @doc value "is the color of the scale axis and its ticks."
    }
    text_color        color.Color?          {
        @doc value "is the color of the tick labels."
    }
    units             string = "" {
        @doc value "is the unit suffix displayed after each tick label."
    }
    notation          notation.Notation = "standard" {
        @doc value "is the numeric notation used to format tick labels."
    }
    precision         float64 = 2 {
        @doc value    "is the number of decimal places shown on tick labels."
        @validate min 0
    }
    fill_hidden       bool = false {
        @doc value "hides the filled portion."
    }
    caret_hidden      bool = false {
        @doc value "hides the caret marking the current value."
    }
    scale_hidden      bool = false {
        @doc value "hides the axis and its tick labels."
    }
    side              spatial.OuterLocation = spatial.OuterLocationRight {
        @doc value "is the edge the axis is drawn along."
    }
    caret_side        spatial.OuterLocation = spatial.OuterLocationRight {
        @doc value "is the edge the value readout sits on."
    }
    level             text.Level = text.LevelSmall {
        @doc value "is the typography level of the tick labels."
    }
    staleness_timeout float64 = 5 {
        @doc value """
            is the duration in seconds after which the value is considered stale.
        """
    }
    staleness_color   color.Color?          {
        @doc value "is the color applied when the value is stale."
    }

    @doc value  """
        is a live fill indicator driven by a channel, rendered by symbols that show a
        level against a numeric range.
    """
    @go marshal
}

StateMapping struct {
    key   string       {
        @doc value "is the unique identifier for the mapping entry."
    }
    name  string       {
        @doc value "is the display name for this state."
    }
    value float64      {
        @doc value "is the channel value this state corresponds to."
    }
    color color.Color? {
        @doc value "is the display color associated with this state."
    }

    @doc value  "maps a numeric channel value to a named, colored state."
    @go marshal
}

Redline struct {
    bounds   spatial.Bounds {
        @doc value "is the numeric range mapped onto the gradient."
    }
    gradient color.Stop[]   {
        @doc value "is the color gradient applied across the bounds."
    }

    @doc value  "maps a numeric range to a color gradient for limit visualization."
    @go marshal
}

PageType enum {
    schematic = "schematic"
    lineplot  = "lineplot"
    log       = "log"
    table     = "table"

    @doc value "names the kinds of page an off-page reference can link to."
}

Page struct {
    type PageType {
        @doc value "is the kind of page referenced."
    }
    key  string   {
        @doc value "is the key of the referenced page."
    }

    @doc value  "identifies a page an off-page reference links to."
    @go marshal
}

NodeConfig union on variant {
    cap                                StaticSymbolConfig
    filter                             StaticSymbolConfig
    flow_straightener                  StaticSymbolConfig
    heater_element                     StaticSymbolConfig
    iso_cap                            StaticSymbolConfig
    iso_filter                         StaticSymbolConfig
    nozzle                             StaticSymbolConfig
    orifice                            StaticSymbolConfig
    orifice_plate                      StaticSymbolConfig
    strainer                           StaticSymbolConfig
    strainer_cone                      StaticSymbolConfig
    thruster                           ToggleSymbolConfig
    vent                               StaticSymbolConfig
    flowmeter_general                  StaticSymbolConfig
    flowmeter_electromagnetic          StaticSymbolConfig
    flowmeter_variable_area            StaticSymbolConfig
    flowmeter_coriolis                 StaticSymbolConfig
    flowmeter_nozzle                   StaticSymbolConfig
    flowmeter_venturi                  StaticSymbolConfig
    flowmeter_ring_piston              StaticSymbolConfig
    flowmeter_positive_displacement    StaticSymbolConfig
    flowmeter_turbine                  StaticSymbolConfig
    flowmeter_pulse                    StaticSymbolConfig
    flowmeter_float_sensor             StaticSymbolConfig
    flowmeter_orifice                  StaticSymbolConfig
    box {
        label            LabelConfig = {} {
            @doc value "is the box's label configuration."
        }
        orientation      spatial.OuterLocation = spatial.OuterLocationLeft {
            @doc value "is the orientation of the box within the diagram."
        }
        color            color.Color?          {
            @doc value "is the border color of the box."
        }
        background_color color.Color?          {
            @doc value "is the fill color of the box."
        }
        dimensions       spatial.Dimensions = { width = 125, height = 200 } {
            @doc value "is the rendered size of the box in pixels."
        }
        border_radius    float64 = 3 {
            @doc value "is the uniform corner radius of the box in pixels."
        }
        stroke_width     float64 = 2 {
            @doc value "is the border stroke width in pixels."
        }

        @doc value "is the configuration for box annotation symbols."
    }
    button extends LabeledConfig {
        size            ComponentSize = ComponentSizeMedium {
            @doc value "is the rendered size preset of the button."
        }
        level           text.Level?         {
            @doc value "is the typography level of the button text."
        }
        on_click_delay  float64 = 0 {
            @doc value "is the debounce delay applied to clicks, in milliseconds."
        }
        command_channel channel.Key?        {
            @doc value "is the channel button presses are written to."
        }
        mode            ButtonMode = ButtonModeFire {
            @doc value "is the actuation behavior of the button."
        }
        color           color.Color?        {
            @doc value "is the background color of the button."
        }
        control         ControlStateConfig? {
            @doc value "is the control state display configuration."
        }

        @doc value "is the configuration for button symbols."
    }
    circle extends LabeledConfig {
        radius           float64 = 20 {
            @doc value "is the radius of the circle in pixels."
        }
        color            color.Color? {
            @doc value "is the border color of the circle."
        }
        background_color color.Color? {
            @doc value "is the fill color of the circle."
        }
        stroke_width     float64 = 2 {
            @doc value "is the border stroke width in pixels."
        }

        @doc value "is the configuration for circle annotation symbols."
    }
    gauge extends LabeledConfig {
        position          spatial.XY?        {
            @doc value "is the offset of the gauge contents within the symbol."
        }
        color             color.Color?       {
            @doc value "is the accent color of the gauge arc."
        }
        bounds            spatial.Bounds = { lower = 0, upper = 100 } {
            @doc value "is the numeric range displayed by the gauge."
        }
        bar_width         float64 = 10 {
            @doc value    "is the thickness of the gauge arc in pixels."
            @validate min 1
        }
        channel           channel.Key?       {
            @doc value "is the channel whose value the gauge displays."
        }
        rolling_average   int32?             {
            @doc value "is the sample window for rolling-average smoothing."
        }
        precision         float64 = 2 {
            @doc value    "is the number of decimal places shown."
            @validate min 0
        }
        notation          notation.Notation = "standard" {
            @doc value "is the numeric notation used to format the value."
        }
        location          spatial.LocationXY = {
            x = spatial.XCenterLocationLeft,
            y = spatial.YCenterLocationCenter
        } {
            @doc value "is the anchor of the value within the gauge."
        }
        units             string = "RPM" {
            @doc value "is the unit suffix displayed after the value."
        }
        level             text.Level = text.LevelH5 {
            @doc value "is the typography level of the displayed value."
        }
        staleness_timeout float64 = 5 {
            @doc value """
                is the duration in seconds after which the value is considered stale.
            """
        }
        staleness_color   color.Color?       {
            @doc value "is the color applied when the value is stale."
        }

        @doc value "is the configuration for gauge symbols."
    }
    input extends LabeledConfig {
        size            ComponentSize = ComponentSizeMedium {
            @doc value "is the rendered size preset of the input."
        }
        command_channel channel.Key?        {
            @doc value "is the channel submitted values are written to."
        }
        dimensions      spatial.Dimensions? {
            @doc value "is the rendered size of the input in pixels."
        }
        color           color.Color?        {
            @doc value "is the accent color of the input."
        }
        disabled        bool = false {
            @doc value "indicates whether the input rejects interaction."
        }
        control         ControlStateConfig? {
            @doc value "is the control state display configuration."
        }

        @doc value "is the configuration for free-form input symbols."
    }
    light extends LabeledConfig {
        channel           channel.Key?    {
            @doc value "is the channel whose value drives the light's on state."
        }
        threshold         spatial.Bounds? {
            @doc value "is the value range within which the light is considered on."
        }
        color             color.Color?    {
            @doc value "is the illuminated color of the light."
        }
        staleness_timeout float64 = 5 {
            @doc value """
                is the duration in seconds after which the value is considered stale.
            """
        }
        staleness_color   color.Color?    {
            @doc value "is the color applied when the value is stale."
        }

        @doc value "is the configuration for indicator light symbols."
    }
    line {
        color        color.Color? {
            @doc value "is the stroke color of the line."
        }
        start        spatial.XY = { x = 0, y = 0 } {
            @doc value "is the first endpoint, offset from the node position."
        }
        end          spatial.XY = { x = 100, y = 0 } {
            @doc value "is the second endpoint, offset from the node position."
        }
        stroke_width float64 = 2 {
            @doc value    "is the stroke width of the line in pixels."
            @validate min 1
        }

        @doc value "is the configuration for straight line symbols."
    }
    off_page_reference {
        orientation            spatial.OuterLocation = spatial.OuterLocationRight {
            @doc value "is the direction the reference arrow points."
        }
        label                  LabelConfig = {} {
            @doc value "is the label displayed inside the reference."
        }
        color                  color.Color?          {
            @doc value "is the fill color of the reference."
        }
        page                   Page?                 {
            @doc value "is the page this reference links to."
        }
        dbl_click_nav_disabled bool = false {
            @doc value "stops double-clicking from navigating to the linked page."
        }

        @doc value "is the configuration for off-page reference symbols."
    }
    polygon extends LabeledConfig {
        num_sides        float64 = 6 {
            @doc value "is the number of sides of the polygon."
        }
        side_length      float64 = 20 {
            @doc value "is the length of each side in pixels."
        }
        rotation         float64 = 0 {
            @doc value "is the rotation of the polygon in degrees."
        }
        corner_rounding  float64 = 0 {
            @doc value "is the corner rounding radius in pixels."
        }
        color            color.Color? {
            @doc value "is the border color of the polygon."
        }
        background_color color.Color? {
            @doc value "is the fill color of the polygon."
        }
        stroke_width     float64 = 2 {
            @doc value "is the border stroke width in pixels."
        }

        @doc value "is the configuration for polygon annotation symbols."
    }
    select extends LabeledConfig {
        size            ComponentSize = ComponentSizeMedium {
            @doc value "is the rendered size preset of the select."
        }
        command_channel channel.Key?        {
            @doc value "is the channel the selected value is written to."
        }
        color           color.Color?        {
            @doc value "is the accent color of the select."
        }
        inline_size     float64 = 100 {
            @doc value    "is the inline size of the select in pixels."
            @validate min 1
        }
        options         StateMapping[] = [] {
            @doc value "is the set of selectable states."
        }
        disabled        bool = false {
            @doc value "indicates whether the select rejects interaction."
        }
        control         ControlStateConfig? {
            @doc value "is the control state display configuration."
        }

        @doc value "is the configuration for select symbols."
    }
    scale {
        label       LabelConfig = {} {
            @doc value "is the symbol's label configuration."
        }
        orientation spatial.OuterLocation = spatial.OuterLocationTop {
            @doc value """
                is the axis the bar fills along: top for vertical, right for horizontal.
                Any other value reads as vertical.
            """
        }
        scale       float64 = 1 {
            @doc value "is the rendered scale multiplier of the symbol."
        }
        position    spatial.XY?           {
            @doc value "is the offset of the scale contents within the symbol."
        }
        dimensions  spatial.Dimensions = { width = 34, height = 160 } {
            @doc value """
                is the size of the bar alone in pixels. The tick gutter beside it adds
                to the rendered size.
            """
        }
        color       color.Color?          {
            @doc value """
                is the color of the fill, which is what the symbol reads as. The toolbar
                recolors a selection through this field.
            """
        }
        indicator   ScaleIndicatorConfig = {} {
            @doc value "is the live indicator the scale renders."
        }

        @doc value "is the configuration for standalone scale symbols."
    }
    setpoint extends LabeledConfig {
        size            ComponentSize = ComponentSizeMedium {
            @doc value "is the rendered size preset of the setpoint."
        }
        command_channel channel.Key?        {
            @doc value "is the channel submitted setpoints are written to."
        }
        dimensions      spatial.Dimensions? {
            @doc value "is the rendered size of the setpoint in pixels."
        }
        color           color.Color?        {
            @doc value "is the accent color of the setpoint."
        }
        units           string = "mV" {
            @doc value "is the unit suffix displayed after the value."
        }
        disabled        bool = false {
            @doc value "indicates whether the setpoint rejects interaction."
        }
        control         ControlStateConfig? {
            @doc value "is the control state display configuration."
        }

        @doc value "is the configuration for numeric setpoint symbols."
    }
    state_indicator extends LabeledConfig {
        channel           channel.Key?   {
            @doc value "is the channel whose value selects the displayed state."
        }
        color             color.Color?   {
            @doc value "is the fallback color when no state matches."
        }
        inline_size       float64 = 100 {
            @doc value    "is the inline size of the indicator in pixels."
            @validate min 1
        }
        options           StateMapping[] = [] {
            @doc value "is the set of displayable states."
        }
        staleness_timeout float64 = 5 {
            @doc value """
                is the duration in seconds after which the value is considered stale.
            """
        }
        staleness_color   color.Color?   {
            @doc value "is the color applied when the value is stale."
        }

        @doc value "is the configuration for multi-state indicator symbols."
    }
    string_display extends LabeledConfig {
        color             color.Color? {
            @doc value "is the background color of the display."
        }
        text_color        color.Color? {
            @doc value "is the color of the displayed text."
        }
        tooltip           string[] = [] {
            @doc value "is the list of tooltip lines shown on hover."
        }
        inline_size       float64 = 100 {
            @doc value    "is the inline size of the display in pixels."
            @validate min 1
        }
        channel           channel.Key? {
            @doc value "is the channel whose string value the symbol displays."
        }
        level             text.Level = text.LevelH4 {
            @doc value "is the typography level of the displayed text."
        }
        staleness_timeout float64 = 5 {
            @doc value """
                is the duration in seconds after which the value is considered stale.
            """
        }
        staleness_color   color.Color? {
            @doc value "is the color applied when the value is stale."
        }

        @doc value "is the configuration for live string display symbols."
    }
    switch                             ToggleSymbolConfig
    text_box extends LabeledConfig {
        color             color.Color?  {
            @doc value "is the text color."
        }
        width             float64 = 75 {
            @doc value    "is the rendered width of the text box in pixels."
            @validate min 1
        }
        align             FlexAlignment = FlexAlignmentCenter {
            @doc value "is the alignment of the text within the box."
        }
        auto_fit_disabled bool = false {
            @doc value "stops the box from resizing to fit its content."
        }
        level             text.Level = text.LevelP {
            @doc value "is the typography level of the text."
        }
        value             string = "Text box" {
            @doc value "is the text content of the box."
        }

        @doc value "is the configuration for text box annotation symbols."
    }
    value extends LabeledConfig {
        position          spatial.XY?        {
            @doc value "is the offset of the value contents within the symbol."
        }
        color             color.Color?       {
            @doc value "is the background color of the value."
        }
        text_color        color.Color?       {
            @doc value "is the color of the displayed text."
        }
        tooltip           string[] = [] {
            @doc value "is the list of tooltip lines shown on hover."
        }
        redline           Redline = { bounds = { lower = 0, upper = 1 }, gradient = [] } {
            @doc value "is the bounds-to-gradient mapping applied to the background."
        }
        units             string = "psi" {
            @doc value "is the unit suffix displayed after the value."
        }
        inline_size       float64 = 70 {
            @doc value    "is the inline size of the value in pixels."
            @validate min 1
        }
        channel           channel.Key?       {
            @doc value "is the channel whose value the symbol displays."
        }
        rolling_average   int32?             {
            @doc value "is the sample window for rolling-average smoothing."
        }
        level             text.Level = text.LevelH4 {
            @doc value "is the typography level of the displayed value."
        }
        precision         float64 = 2 {
            @doc value    "is the number of decimal places shown."
            @validate min 0
        }
        staleness_timeout float64 = 5 {
            @doc value """
                is the duration in seconds after which the value is considered stale.
            """
        }
        staleness_color   color.Color?       {
            @doc value "is the color applied when the value is stale."
        }
        notation          notation.Notation = "standard" {
            @doc value "is the numeric notation used to format the value."
        }
        location          spatial.LocationXY = {
            x = spatial.XCenterLocationLeft,
            y = spatial.YCenterLocationCenter
        } {
            @doc value "is the anchor of the value within the symbol."
        }

        @doc value "is the configuration for live telemetry value symbols."
    }
    agitator                           ToggleSymbolConfig
    cross_beam_agitator                ToggleSymbolConfig
    flat_blade_agitator                ToggleSymbolConfig
    heat_exchanger_general             StaticSymbolConfig
    heat_exchanger_m                   StaticSymbolConfig
    heat_exchanger_straight_tube       StaticSymbolConfig
    helical_agitator                   ToggleSymbolConfig
    paddle_agitator                    ToggleSymbolConfig
    propeller_agitator                 ToggleSymbolConfig
    rotary_mixer                       ToggleSymbolConfig
    static_mixer                       StaticSymbolConfig
    cavity_pump                        ToggleSymbolConfig
    centrifugal_compressor             ToggleSymbolConfig
    compressor                         ToggleSymbolConfig
    diaphragm_pump                     ToggleSymbolConfig
    ejection_pump                      ToggleSymbolConfig
    ejector_compressor                 ToggleSymbolConfig
    liquid_ring_compressor             ToggleSymbolConfig
    piston_pump                        ToggleSymbolConfig
    pump                               ToggleSymbolConfig
    roller_vane_compressor             ToggleSymbolConfig
    screw_pump                         ToggleSymbolConfig
    turbo_compressor                   ToggleSymbolConfig
    vacuum_pump                        ToggleSymbolConfig
    burst_disc                         StaticSymbolConfig
    flame_arrestor                     StaticSymbolConfig
    flame_arrestor_detonation          StaticSymbolConfig
    flame_arrestor_explosion           StaticSymbolConfig
    flame_arrestor_fire_res            StaticSymbolConfig
    flame_arrestor_fire_res_detonation StaticSymbolConfig
    iso_burst_disc                     StaticSymbolConfig
    angled_valve                       ToggleSymbolConfig
    angled_relief_valve                DummyToggleSymbolConfig
    angled_spring_loaded_relief_valve  DummyToggleSymbolConfig
    ball_valve                         ToggleSymbolConfig
    breather_valve                     DummyToggleSymbolConfig
    butterfly_valve_one                ToggleSymbolConfig
    butterfly_valve_two                ToggleSymbolConfig
    check_valve                        StaticSymbolConfig
    check_valve_with_arrow             StaticSymbolConfig
    electric_regulator                 StaticSymbolConfig
    electric_regulator_motorized       StaticSymbolConfig
    four_way_valve                     ToggleSymbolConfig
    gate_valve                         ToggleSymbolConfig
    iso_check_valve                    StaticSymbolConfig
    manual_valve                       DummyToggleSymbolConfig
    needle_valve                       DummyToggleSymbolConfig
    regulator                          StaticSymbolConfig
    regulator_manual                   StaticSymbolConfig
    relief_valve                       DummyToggleSymbolConfig
    solenoid_valve extends ToggleSymbolConfig {
        normally_open bool = false {
            @doc value "indicates whether the valve is open when unpowered."
        }

        @doc value "is the configuration for solenoid valve symbols."
    }
    spring_loaded_relief_valve         DummyToggleSymbolConfig
    three_way_valve                    ToggleSymbolConfig
    three_way_ball_valve               ToggleSymbolConfig
    valve                              ToggleSymbolConfig
    cross_junction                     StaticSymbolConfig
    cylinder extends LabeledConfig {
        dimensions       spatial.Dimensions = { width = 66, height = 181 } {
            @doc value "is the rendered size of the cylinder in pixels."
        }
        border_radius    border.Radius?     {
            @doc value "is the corner radius of the cylinder."
        }
        color            color.Color?       {
            @doc value "is the border color of the cylinder."
        }
        background_color color.Color?       {
            @doc value "is the fill color of the cylinder."
        }

        @doc value "is the configuration for cylinder vessel symbols."
    }
    tank extends LabeledConfig {
        position         spatial.XY?          {
            @doc value "is the offset of the tank contents within the symbol."
        }
        color            color.Color?         {
            @doc value "is the border color of the tank."
        }
        background_color color.Color?         {
            @doc value "is the fill color of the tank."
        }
        dimensions       spatial.Dimensions = { width = 125, height = 200 } {
            @doc value "is the rendered size of the tank in pixels."
        }
        border_radius    border.Radius = {
            top_left = { x = 50, y = 10 },
            top_right = { x = 50, y = 10 },
            bottom_left = { x = 50, y = 10 },
            bottom_right = { x = 50, y = 10 }
        } {
            @doc value "is the corner radius of the tank."
        }
        fill             ScaleIndicatorConfig = {
            caret_hidden = true,
            scale_hidden = true,
            side = spatial.OuterLocationLeft
        } {
            @doc value """
                is the live fill level drawn inside the tank. A tank without one renders
                its wall alone.
            """
        }

        @doc value "is the configuration for tank vessel symbols."
    }
    t_junction                         StaticSymbolConfig
    custom_actuator extends ToggleConfig {
        spec_key        string       {
            @doc value "is the key of the custom symbol spec this instance renders."
        }
        color           color.Color? {
            @doc value "is the stroke color of the symbol."
        }
        state_overrides record[] = [] {
            @doc value """
                contains per-instance overrides of the spec's visual states. Each entry
                mirrors the symbol service's State shape; the wire format stores it
                opaquely, consistent with how the symbol service stores specs.
            """
        }

        @doc value "is the configuration for user-defined actuator symbols."
    }
    custom_static extends LabeledConfig {
        spec_key        string       {
            @doc value "is the key of the custom symbol spec this instance renders."
        }
        color           color.Color? {
            @doc value "is the stroke color of the symbol."
        }
        state_overrides record[] = [] {
            @doc value """
                contains per-instance overrides of the spec's visual states. Each entry
                mirrors the symbol service's State shape; the wire format stores it
                opaquely, consistent with how the symbol service stores specs.
            """
        }

        @doc value "is the configuration for user-defined static symbols."
    }
    group_box {
        members string[] = [] {
            @doc value "lists the keys of the symbols the group contains."
        }
        locked  bool = false {
            @doc value "pins the group and its members in place."
        }

        @doc value """
            is the configuration for a group box, the symbol that bounds a set of
            grouped symbols. Groups nest: a member may itself be a group.
        """
    }

    @doc value  """
        is the per-node configuration stored in the schematic configs map. The variant
        selects the symbol rendered for the node and the fields that accompany it.
    """
    @go marshal
}

ElementConfig union on variant extends NodeConfig, EdgeConfig {
    @doc value  """
        is the per-element configuration stored in the schematic configs map: a node
        config or an edge config, discriminated by variant.
    """
    @go marshal
}

Schematic struct {
    key      Key = create {
        @doc value "is the unique identifier for this schematic."
        @key
    }
    name     string                     {
        @doc value "is a human-readable name for the schematic."
    }
    snapshot bool = false {
        @doc value "is true if this schematic is an immutable snapshot copy."
    }
    nodes    Node[] = [] {
        @doc value "contains all diagram nodes in the schematic."
    }
    edges    Edge[] = [] {
        @doc value "contains all connections between nodes."
    }
    configs  map<string, ElementConfig> = {} {
        @doc value """
            contains per-element configuration keyed by node or edge key. The variant of
            each value selects the symbol or edge style it configures.
        """
    }

    @doc value  """
        is a visual diagram editor component for drawing system schematics, control
        flows, and process diagrams. Schematics support interactive symbols, connection
        handles, and dynamic state visualization.
    """
    @go imex
    @go marshal
    @go migrate
}
