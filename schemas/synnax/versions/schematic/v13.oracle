import "schemas/synnax/versions/channel/v0"
import "schemas/synnax/versions/color/v0"
import "schemas/synnax/versions/group/v1"
import "schemas/synnax/versions/project/v3"
import "schemas/synnax/versions/ranger/v1"
import "schemas/synnax/versions/symbol/v4"
import "schemas/x/versions/border/v0"
import "schemas/x/versions/color/v2"
import "schemas/x/versions/notation/v0"
import "schemas/x/versions/spatial/v0"
import "schemas/x/versions/telem/v0"
import "schemas/x/versions/text/v0"

Key = v0.Key

Node struct extends v8.Node {
    config NodeConfig {
        @doc value "is the symbol the node draws and its settings."
    }
    parent string?    {
        @doc value """
            is the key of the group box node that contains the node. Absent when the
            node is at the top level.
        """
    }
}

Handle = v7.Handle

Edge struct extends v7.Edge {
    config EdgeConfig {
        @doc value "is the style of the connection and the path it traces."
    }
}

Segment = v9.Segment

SegmentedEdgeConfig struct extends v9.SegmentedEdgeConfig {
    stroke_width uint8 = 2 {
        @doc value "is the stroke width of the edge in pixels."
    }
    stroke_color color.Ref? {
        @doc value "is the stroke color of the edge, a named color or a fixed color."
    }
}

EdgeConfig union on variant extends v9.EdgeConfig {}

FlexAlignment = v9.FlexAlignment

ComponentSize = v9.ComponentSize

ButtonMode = v9.ButtonMode

LabelConfig struct extends v9.LabelConfig {
    max_inline_size uint16 = 150 {
        @doc value    """
            is the maximum inline size of the label in pixels before wrapping.
        """
        @validate min 1
    }
}

LabeledConfig struct extends v9.LabeledConfig {}

ScaledConfig = v9.ScaledConfig

StalenessConfig struct extends v9.StalenessConfig {
    staleness_timeout telem.TimeSpan = 5000000000 {
        @doc value    "is the span after which the value is considered stale."
        @validate max 9007199254740991
        @validate min 1000000000
    }
}

NumericTelemConfig struct extends v12.NumericTelemConfig {
    channel         channel.Key = 0 {
        @doc value """
            is the channel whose value the symbol displays, or 0 when it displays none.
        """
    }
    rolling_average uint16 = 1 {
        @doc value    "is the number of samples in the rolling average."
        @validate min 1
    }
}

ControlStateConfig = v9.ControlStateConfig

ToggleConfig struct extends v9.ToggleConfig {
    state_channel   channel.Key = 0 {
        @doc value """
            is the channel whose value drives the symbol's active state, or 0 when none
            does.
        """
    }
    command_channel channel.Key = 0 {
        @doc value """
            is the channel actuation commands are written to, or 0 when the symbol
            writes to none.
        """
    }
    control         ControlStateConfig = {} {
        @doc value "is the control state display configuration."
    }
    on_click_delay  telem.TimeSpan = 0 {
        @doc value    "is the debounce delay applied to clicks."
        @validate max 2147483647000000
        @validate min 0
    }
}

StaticSymbolConfig struct extends v9.StaticSymbolConfig {}

ToggleSymbolConfig struct extends v9.ToggleSymbolConfig {}

DummyToggleSymbolConfig struct extends v9.DummyToggleSymbolConfig {}

ScaleIndicatorConfig struct extends v12.ScaleIndicatorConfig {
    level_color color.Ref? {
        @doc value """
            is the color of the filled portion, the caret, and the value readout border,
            a named color or a fixed color.
        """
    }
    axis_color  color.Ref? {
        @doc value """
            is the color of the axis and its ticks, a named color or a fixed color.
        """
    }
    text_color  color.Ref? {
        @doc value "is the color of the tick labels, a named color or a fixed color."
    }
}

StateMapping struct extends v9.StateMapping {}

PageType = v9.PageType

Page = v9.Page

NodeConfig union on variant extends v10.NodeConfig {
    group_box {
        -members
    }
    box {
        border_radius uint16?    {
            @doc value """
                is the uniform corner radius of the box in pixels. Absent draws 3.
            """
        }
        stroke_width  uint8?     {
            @doc value    "is the border stroke width in pixels. Absent draws 2."
            @validate max 20
        }
        stroke_color  color.Ref? {
            @doc value "is the border color of the box, a named color or a fixed color."
        }
        fill_color    color.Ref? {
            @doc value "is the fill color of the box, a named color or a fixed color."
        }
    }
    button {
        -level
        command_channel channel.Key = 0 {
            @doc value """
                is the channel button presses are written to, or 0 when the symbol
                writes to none.
            """
        }
        control         ControlStateConfig = {} {
            @doc value "is the control state display configuration."
        }
        on_click_delay  telem.TimeSpan = 0 {
            @doc value    "is the debounce delay applied to clicks."
            @validate max 2147483647000000
            @validate min 0
        }
        fill_color      color.Ref?         {
            @doc value """
                is the fill color of the button, which its border follows, a named color
                or a fixed color.
            """
        }
    }
    circle {
        radius       uint16 = 20 {
            @doc value    "is the radius of the circle in pixels."
            @validate min 1
        }
        stroke_width uint8?     {
            @doc value    "is the border stroke width in pixels. Absent draws 2."
            @validate max 20
        }
        stroke_color color.Ref? {
            @doc value """
                is the border color of the circle, a named color or a fixed color.
            """
        }
        fill_color   color.Ref? {
            @doc value """
                is the fill color of the circle, a named color or a fixed color.
            """
        }
    }
    gauge {
        position     spatial.XY = { x = 0, y = 0 } {
            @doc value "is the offset of the gauge contents within the symbol."
        }
        bar_width    uint16 = 10 {
            @doc value    "is the thickness of the gauge arc in pixels."
            @validate min 1
        }
        stroke_color color.Ref? {
            @doc value "is the color of the gauge arc, a named color or a fixed color."
        }
    }
    line {
        stroke_width uint8 = 2 {
            @doc value    "is the stroke width of the line in pixels."
            @validate max 20
            @validate min 1
        }
        stroke_color color.Ref? {
            @doc value """
                is the stroke color of the line, a named color or a fixed color.
            """
        }
    }
    light {
        channel channel.Key = 0 {
            @doc value """
                is the channel whose value drives the light's on state, or 0 when none
                does.
            """
        }
    }
    off_page_reference {
        -dbl_click_nav_disabled
        page                             Page = { type = PageTypeSchematic, key = "" } {
            @doc value """
                is the page this reference links to. An empty key links to no page.
            """
        }
        double_click_navigation_disabled bool = false {
            @doc value "stops double-clicking from navigating to the linked page."
        }
        fill_color                       color.Ref? {
            @doc value """
                is the fill color of a linked reference, a named color or a fixed color.
                An unlinked reference draws its outline in this color.
            """
        }
    }
    polygon {
        -corner_rounding
        num_sides     uint8 = 6 {
            @doc value    "is the number of sides of the polygon."
            @validate min 3
        }
        side_length   uint16 = 20 {
            @doc value    "is the length of each side in pixels."
            @validate min 1
        }
        rotation
        border_radius uint16 = 0 {
            @doc value "is the corner radius of the polygon in pixels."
        }
        stroke_width  uint8?     {
            @doc value    "is the border stroke width in pixels. Absent draws 2."
            @validate max 20
        }
        stroke_color  color.Ref? {
            @doc value """
                is the border color of the polygon, a named color or a fixed color.
            """
        }
        fill_color    color.Ref? {
            @doc value """
                is the fill color of the polygon, a named color or a fixed color.
            """
        }
    }
    input {
        command_channel channel.Key = 0 {
            @doc value """
                is the channel submitted values are written to, or 0 when the symbol
                writes to none.
            """
        }
        state_channel   channel.Key = 0 {
            @doc value """
                is the channel that reports the value the device holds, or 0 when none
                does.
            """
        }
        dimensions      spatial.Dimensions = { width = 0, height = 0 } {
            @doc value """
                is the rendered size of the input in pixels. Zero sizes it to its
                content.
            """
        }
        control         ControlStateConfig = {} {
            @doc value "is the control state display configuration."
        }
        inline_size     uint16 = 150 {
            @doc value    """
                is the width of the field in pixels, not counting the Set button.
            """
            @validate min 1
        }
        on_click_delay  telem.TimeSpan = 0 {
            @doc value    "is the debounce delay applied to clicks."
            @validate max 2147483647000000
            @validate min 0
        }
        fill_color      color.Ref?         {
            @doc value """
                is the fill color of the Set button, which the input border follows, a
                named color or a fixed color.
            """
        }
    }
    scale {
        position spatial.XY = { x = 0, y = 0 } {
            @doc value "is the offset of the scale contents within the symbol."
        }
    }
    select {
        command_channel channel.Key = 0 {
            @doc value """
                is the channel the selected value is written to, or 0 when the symbol
                writes to none.
            """
        }
        state_channel   channel.Key = 0 {
            @doc value """
                is the channel that reports the state the device holds, or 0 when none
                does.
            """
        }
        control         ControlStateConfig = {} {
            @doc value "is the control state display configuration."
        }
        inline_size     uint16 = 100 {
            @doc value    """
                is the width of the field in pixels, not counting the Set button.
            """
            @validate min 1
        }
        on_click_delay  telem.TimeSpan = 0 {
            @doc value    "is the debounce delay applied to clicks."
            @validate max 2147483647000000
            @validate min 0
        }
        fill_color      color.Ref?         {
            @doc value """
                is the fill color of the Set button, which the select border follows, a
                named color or a fixed color.
            """
        }
    }
    setpoint {
        command_channel channel.Key = 0 {
            @doc value """
                is the channel submitted setpoints are written to, or 0 when the symbol
                writes to none.
            """
        }
        state_channel   channel.Key = 0 {
            @doc value """
                is the channel that reports the value the device holds, or 0 when none
                does.
            """
        }
        dimensions      spatial.Dimensions = { width = 0, height = 0 } {
            @doc value """
                is the rendered size of the setpoint in pixels. Zero sizes it to its
                content.
            """
        }
        control         ControlStateConfig = {} {
            @doc value "is the control state display configuration."
        }
        inline_size     uint16 = 100 {
            @doc value    """
                is the width of the field in pixels, not counting the Set button.
            """
            @validate min 1
        }
        on_click_delay  telem.TimeSpan = 0 {
            @doc value    "is the debounce delay applied to clicks."
            @validate max 2147483647000000
            @validate min 0
        }
        fill_color      color.Ref?         {
            @doc value """
                is the fill color of the Set button, which the setpoint border follows,
                a named color or a fixed color.
            """
        }
    }
    state_indicator {
        channel      channel.Key = 0 {
            @doc value """
                is the channel whose value selects the displayed state, or 0 when none
                does.
            """
        }
        inline_size  uint16 = 100 {
            @doc value    "is the inline size of the indicator in pixels."
            @validate min 1
        }
        stroke_color color.Ref?  {
            @doc value """
                is the border color of the indicator, a named color or a fixed color.
            """
        }
    }
    string_display {
        channel      channel.Key = 0 {
            @doc value """
                is the channel whose string value the symbol displays, or 0 when it
                displays none.
            """
        }
        inline_size  uint16 = 100 {
            @doc value    "is the inline size of the display in pixels."
            @validate min 1
        }
        stroke_color color.Ref?  {
            @doc value """
                is the border color of the display, a named color or a fixed color.
            """
        }
        text_color   color.Ref?  {
            @doc value """
                is the color of the displayed text, a named color or a fixed color.
            """
        }
    }
    text_box {
        -width
        text_color
        inline_size uint16 = 75 {
            @doc value    "is the rendered inline size of the text box in pixels."
            @validate min 1
        }
        value       string = "" {
            @doc value "is the text content of the box."
        }
        text_color  color.Ref? {
            @doc value "is the text color, a named color or a fixed color."
        }
    }
    value {
        position     spatial.XY = { x = 0, y = 0 } {
            @doc value "is the offset of the value contents within the symbol."
        }
        inline_size  uint16 = 70 {
            @doc value    "is the inline size of the value in pixels."
            @validate min 1
        }
        stroke_color color.Ref? {
            @doc value """
                is the color of the value's border and units divider, a named color or a
                fixed color.
            """
        }
        text_color   color.Ref? {
            @doc value """
                is the color of the displayed value, a named color or a fixed color.
            """
        }
        fill_color   color.Ref? {
            @doc value """
                is the fill behind the value where no redline band paints, a named color
                or a fixed color. When absent the value paints no fill.
            """
        }
    }
    tank {
        position      spatial.XY = { x = 0, y = 0 } {
            @doc value "is the offset of the tank contents within the symbol."
        }
        border_radius border.Radius? {
            @doc value """
                is the corner radius of the tank. Absent draws 50 by 10 percent.
            """
        }
        stroke_color  color.Ref?     {
            @doc value """
                is the color of the tank's wall, a named color or a fixed color.
            """
        }
        fill_color    color.Ref?     {
            @doc value """
                is the fill color of the tank body, a named color or a fixed color.
            """
        }
    }
    cylinder {
        stroke_color color.Ref? {
            @doc value """
                is the border color of the cylinder, a named color or a fixed color.
            """
        }
        fill_color   color.Ref? {
            @doc value """
                is the fill color of the cylinder, a named color or a fixed color.
            """
        }
    }
}

Schematic struct extends v12.Schematic {
    -configs
}
