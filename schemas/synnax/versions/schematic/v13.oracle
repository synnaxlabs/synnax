import "schemas/synnax/versions/channel/v0"
import "schemas/synnax/versions/group/v1"
import "schemas/synnax/versions/project/v3"
import "schemas/synnax/versions/ranger/v1"
import "schemas/synnax/versions/symbol/v4"
import "schemas/x/versions/border/v0"
import "schemas/x/versions/color/v2"
import "schemas/x/versions/notation/v0"
import "schemas/x/versions/spatial/v0"
import "schemas/x/versions/telem/v0"
import "schemas/x/versions/text/v0"

Key = v0.Key

Node struct extends v8.Node {
    config NodeConfig {
        @doc value "is the symbol the node draws and its settings."
    }
    parent string?    {
        @doc value """
            is the key of the group box node that contains the node. Absent when the
            node is at the top level.
        """
    }
}

Handle = v7.Handle

Edge struct extends v7.Edge {
    config EdgeConfig {
        @doc value "is the style of the connection and the path it traces."
    }
}

Segment = v9.Segment

SegmentedEdgeConfig struct extends v9.SegmentedEdgeConfig {
    stroke_width uint8 = 2 {
        @doc value "is the stroke width of the edge in pixels."
    }
}

EdgeConfig union on variant extends v9.EdgeConfig {}

FlexAlignment = v9.FlexAlignment

ComponentSize = v9.ComponentSize

ButtonMode = v9.ButtonMode

LabelConfig struct extends v9.LabelConfig {
    max_inline_size uint16 = 150 {
        @doc value    """
            is the maximum inline size of the label in pixels before wrapping.
        """
        @validate min 1
    }
}

LabeledConfig struct extends v9.LabeledConfig {}

ScaledConfig = v9.ScaledConfig

StalenessConfig struct extends v9.StalenessConfig {
    staleness_timeout telem.TimeSpan = 5000000000 {
        @doc value    "is the span after which the value is considered stale."
        @validate max 9007199254740991
        @validate min 1000000000
    }
}

NumericTelemConfig struct extends v12.NumericTelemConfig {
    rolling_average uint16? {
        @doc value    "is the number of samples in the rolling average."
        @validate min 1
    }
}

ControlStateConfig = v9.ControlStateConfig

ToggleConfig struct extends v9.ToggleConfig {
    on_click_delay telem.TimeSpan = 0 {
        @doc value    "is the debounce delay applied to clicks."
        @validate max 2147483647000000
        @validate min 0
    }
}

StaticSymbolConfig struct extends v9.StaticSymbolConfig {}

ToggleSymbolConfig struct extends v9.ToggleSymbolConfig {}

DummyToggleSymbolConfig struct extends v9.DummyToggleSymbolConfig {}

ScaleIndicatorConfig struct extends v12.ScaleIndicatorConfig {}

StateMapping struct extends v9.StateMapping {}

PageType = v9.PageType

Page = v9.Page

NodeConfig union on variant extends v10.NodeConfig {
    group_box {
        -members
    }
    box {
        border_radius uint16 = 3 {
            @doc value "is the uniform corner radius of the box in pixels."
        }
        stroke_width  uint8 = 2 {
            @doc value    "is the border stroke width in pixels."
            @validate max 20
        }
    }
    button {
        -level
        on_click_delay telem.TimeSpan = 0 {
            @doc value    "is the debounce delay applied to clicks."
            @validate max 2147483647000000
            @validate min 0
        }
    }
    circle {
        radius       uint16 = 20 {
            @doc value "is the radius of the circle in pixels."
        }
        stroke_width uint8 = 2 {
            @doc value    "is the border stroke width in pixels."
            @validate max 20
        }
    }
    gauge {
        bar_width uint16 = 10 {
            @doc value "is the thickness of the gauge arc in pixels."
        }
    }
    line {
        stroke_width uint8 = 2 {
            @doc value    "is the stroke width of the line in pixels."
            @validate max 20
            @validate min 1
        }
    }
    off_page_reference {
        -dbl_click_nav_disabled
        page
        double_click_navigation_disabled bool = false {
            @doc value "stops double-clicking from navigating to the linked page."
        }
    }
    polygon {
        -corner_rounding
        num_sides     uint8 = 6 {
            @doc value    "is the number of sides of the polygon."
            @validate min 3
        }
        side_length   uint16 = 20 {
            @doc value "is the length of each side in pixels."
        }
        rotation
        border_radius uint16 = 0 {
            @doc value "is the corner radius of the polygon in pixels."
        }
        stroke_width  uint8 = 2 {
            @doc value    "is the border stroke width in pixels."
            @validate max 20
        }
    }
    input {
        inline_size    uint16 = 150 {
            @doc value """
                is the width of the field in pixels, not counting the Set button.
            """
        }
        on_click_delay telem.TimeSpan = 0 {
            @doc value    "is the debounce delay applied to clicks."
            @validate max 2147483647000000
            @validate min 0
        }
    }
    select {
        inline_size    uint16 = 100 {
            @doc value """
                is the width of the field in pixels, not counting the Set button.
            """
        }
        on_click_delay telem.TimeSpan = 0 {
            @doc value    "is the debounce delay applied to clicks."
            @validate max 2147483647000000
            @validate min 0
        }
    }
    setpoint {
        inline_size    uint16 = 100 {
            @doc value """
                is the width of the field in pixels, not counting the Set button.
            """
        }
        on_click_delay telem.TimeSpan = 0 {
            @doc value    "is the debounce delay applied to clicks."
            @validate max 2147483647000000
            @validate min 0
        }
    }
    state_indicator {
        inline_size uint16 = 100 {
            @doc value "is the inline size of the indicator in pixels."
        }
    }
    string_display {
        inline_size uint16 = 100 {
            @doc value "is the inline size of the display in pixels."
        }
    }
    text_box {
        -width
        text_color
        inline_size uint16 = 75 {
            @doc value "is the rendered inline size of the text box in pixels."
        }
    }
    value {
        inline_size uint16 = 70 {
            @doc value "is the inline size of the value in pixels."
        }
    }
}

Schematic struct extends v12.Schematic {
    -configs
}
