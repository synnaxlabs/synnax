import "schemas/synnax/versions/channel/v0"
import "schemas/synnax/versions/color/v0"
import "schemas/synnax/versions/enumeration/v0"
import "schemas/synnax/versions/group/v1"
import "schemas/synnax/versions/project/v3"
import "schemas/synnax/versions/ranger/v1"
import "schemas/synnax/versions/symbol/v5"
import "schemas/x/versions/border/v0"
import "schemas/x/versions/color/v2"
import "schemas/x/versions/notation/v0"
import "schemas/x/versions/spatial/v0"
import "schemas/x/versions/telem/v0"
import "schemas/x/versions/text/v0"

Key = v0.Key

Node struct extends v13.Node {}

Handle = v7.Handle

Edge struct extends v13.Edge {}

Segment = v9.Segment

SegmentedEdgeConfig struct extends v13.SegmentedEdgeConfig {
    stroke_color color.Ref? {
        @doc value "is the stroke color of the edge, a named color or a fixed color."
    }
}

EdgeConfig union on variant extends v13.EdgeConfig {}

FlexAlignment = v9.FlexAlignment

ComponentSize = v9.ComponentSize

ButtonMode = v9.ButtonMode

LabelConfig = v13.LabelConfig

LabeledConfig = v13.LabeledConfig

ScaledConfig = v9.ScaledConfig

StalenessConfig struct extends v13.StalenessConfig {
    -staleness_color
}

NumericTelemConfig = v13.NumericTelemConfig

ControlStateConfig = v9.ControlStateConfig

ScaleIndicatorConfig struct extends v13.ScaleIndicatorConfig {
    bounds      spatial.ClosedBounds = { lower = 0, upper = 100 } {
        @doc value "is the numeric range the indicator maps onto its extent."
    }
    level_color color.Ref?           {
        @doc value """
            is the color of the filled portion, the caret, and the value readout border,
            a named color or a fixed color.
        """
    }
    axis_color  color.Ref?           {
        @doc value """
            is the color of the axis and its ticks, a named color or a fixed color.
        """
    }
    text_color  color.Ref?           {
        @doc value "is the color of the tick labels, a named color or a fixed color."
    }
}

PageType = v9.PageType

Page = v9.Page

FormatConfig struct {
    units     string?            {
        @doc value "is the unit suffix shown after the value. Absent shows none."
    }
    precision uint8?             {
        @doc value    """
            is the number of decimal places shown, from 0 to 17. Absent shows 2.
        """
        @validate max 17
    }
    notation  notation.Notation? {
        @doc value "is the notation of the value. Absent shows standard notation."
    }

    @doc value  "is how a node shows a number."
    @go marshal
}

StateBinding struct extends FormatConfig {
    key         string                {
        @doc value "is the key of the state of the symbol that the binding sets."
    }
    source      Source?               {
        @doc value "is where the state reads its value, or nowhere."
    }
    enumeration enumeration.Key?      {
        @doc value "replaces the enumeration of the state."
    }
    match       symbol.Matcher?       {
        @doc value "replaces the match of the state."
    }
    bounds      spatial.ClosedBounds? {
        @doc value "replaces the bounds of a number state."
    }
    default     float64?              {
        @doc value "replaces the default of the state."
    }

    @doc value  "is how one node reads one state of its symbol."
    @go marshal
}

Source union on type {
    channel {
        key     channel.Key? {
            @doc value "is the channel that the state reads."
        }
        command channel.Key? {
            @doc value "is the channel that the commands of the state write to."
        }

        @doc value "reads a channel."
    }
    local {
        value float64 {
            @doc value "is the value that the state reads and its commands write."
        }

        @doc value "holds a value in the node."
    }

    @doc value  "is where a state reads its value."
    @go marshal
}

CommandBinding struct {
    key     string      {
        @doc value "is the key of the command of the symbol."
    }
    channel channel.Key {
        @doc value "is the channel that the command writes to."
    }

    @doc value  "is the channel of a command that has no state."
    @go marshal
}

NodeConfig union on variant extends v13.NodeConfig {
    symbol extends LabeledConfig, ScaledConfig, StalenessConfig {
        spec            symbol.Ref          {
            @doc value "is the symbol that the node draws."
        }
        color           color.Ref?          {
            @doc value "is the color that node paint reads."
        }
        disabled        bool = false {
            @doc value "is true when the node takes no clicks."
        }
        motion_disabled bool = false {
            @doc value "is true when the node draws no motion."
        }
        on_click_delay  telem.TimeSpan = 0 {
            @doc value    "is the debounce delay applied to clicks."
            @validate max 2147483647000000
            @validate min 0
        }
        states          StateBinding[] = [] {
            @doc value "are how the node reads the states of its symbol."
        }
        commands        CommandBinding[] = [] {
            @doc value "are the channels of the commands that have no state."
        }
        control         ControlStateConfig? {
            @doc value "is the control state display configuration."
        }

        @doc value "is the configuration for a node that draws a symbol."
    }
    box {
        stroke_color color.Ref? {
            @doc value "is the border color of the box, a named color or a fixed color."
        }
        fill_color   color.Ref? {
            @doc value "is the fill color of the box, a named color or a fixed color."
        }
    }
    button {
        fill_color color.Ref? {
            @doc value """
                is the fill color of the button, which its border follows, a named color
                or a fixed color.
            """
        }
    }
    circle {
        stroke_color color.Ref? {
            @doc value """
                is the border color of the circle, a named color or a fixed color.
            """
        }
        fill_color   color.Ref? {
            @doc value """
                is the fill color of the circle, a named color or a fixed color.
            """
        }
    }
    gauge {
        stroke_color color.Ref?           {
            @doc value "is the color of the gauge arc, a named color or a fixed color."
        }
        bounds       spatial.ClosedBounds = { lower = 0, upper = 100 } {
            @doc value "is the numeric range displayed by the gauge."
        }
    }
    line {
        stroke_color color.Ref? {
            @doc value """
                is the stroke color of the line, a named color or a fixed color.
            """
        }
    }
    off_page_reference {
        fill_color color.Ref? {
            @doc value """
                is the fill color of a linked reference, a named color or a fixed color.
                An unlinked reference draws its outline in this color.
            """
        }
    }
    polygon {
        stroke_color color.Ref? {
            @doc value """
                is the border color of the polygon, a named color or a fixed color.
            """
        }
        fill_color   color.Ref? {
            @doc value """
                is the fill color of the polygon, a named color or a fixed color.
            """
        }
    }
    input {
        fill_color color.Ref? {
            @doc value """
                is the fill color of the Set button, which the input border follows, a
                named color or a fixed color.
            """
        }
    }
    select {
        -options
        fill_color  color.Ref?       {
            @doc value """
                is the fill color of the Set button, which the select border follows, a
                named color or a fixed color.
            """
        }
        enumeration enumeration.Key? {
            @doc value "is the enumeration whose entries the select offers."
        }
    }
    setpoint {
        fill_color color.Ref? {
            @doc value """
                is the fill color of the Set button, which the setpoint border follows,
                a named color or a fixed color.
            """
        }
    }
    state_indicator {
        -options
        stroke_color color.Ref?       {
            @doc value """
                is the border color of the indicator, a named color or a fixed color.
            """
        }
        enumeration  enumeration.Key? {
            @doc value "is the enumeration whose entries the indicator shows."
        }
    }
    string_display {
        stroke_color color.Ref? {
            @doc value """
                is the border color of the display, a named color or a fixed color.
            """
        }
        text_color   color.Ref? {
            @doc value """
                is the color of the displayed text, a named color or a fixed color.
            """
        }
    }
    text_box {
        text_color color.Ref? {
            @doc value "is the text color, a named color or a fixed color."
        }
    }
    value {
        stroke_color color.Ref? {
            @doc value """
                is the color of the value's border and units divider, a named color or a
                fixed color.
            """
        }
        text_color   color.Ref? {
            @doc value """
                is the color of the displayed value, a named color or a fixed color.
            """
        }
        fill_color   color.Ref? {
            @doc value """
                is the fill behind the value where no redline band paints, a named color
                or a fixed color. When absent the value paints no fill.
            """
        }
    }
    tank {
        stroke_color color.Ref? {
            @doc value """
                is the color of the tank's wall, a named color or a fixed color.
            """
        }
        fill_color   color.Ref? {
            @doc value """
                is the fill color of the tank body, a named color or a fixed color.
            """
        }
    }
    cylinder {
        stroke_color color.Ref? {
            @doc value """
                is the border color of the cylinder, a named color or a fixed color.
            """
        }
        fill_color   color.Ref? {
            @doc value """
                is the fill color of the cylinder, a named color or a fixed color.
            """
        }
    }
