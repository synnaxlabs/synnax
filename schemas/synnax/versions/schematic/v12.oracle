import "schemas/synnax/versions/channel/v0"
import "schemas/synnax/versions/group/v1"
import "schemas/synnax/versions/project/v3"
import "schemas/synnax/versions/ranger/v1"
import "schemas/synnax/versions/symbol/v2"
import "schemas/x/versions/border/v0"
import "schemas/x/versions/color/v1"
import "schemas/x/versions/notation/v0"
import "schemas/x/versions/spatial/v0"
import "schemas/x/versions/text/v0"

Key = v0.Key

Node = v8.Node

Handle = v7.Handle

Segment = v9.Segment

EdgeVariant enum {
    pipe      = "pipe" {
        @doc value "draws a fluid pipe."
    }
    electric  = "electric" {
        @doc value "draws an electrical wire."
    }
    secondary = "secondary" {
        @doc value "draws a secondary line."
    }
    jacketed  = "jacketed" {
        @doc value "draws a jacketed pipe."
    }
    hydraulic = "hydraulic" {
        @doc value "draws a hydraulic line."
    }
    pneumatic = "pneumatic" {
        @doc value "draws a pneumatic line."
    }
    data      = "data" {
        @doc value "draws a data link."
    }

    @doc value "is the visual style of a schematic edge."
}

Edge struct extends v7.Edge {
    variant      EdgeVariant = EdgeVariantPipe {
        @doc value "is the visual style of the edge."
    }
    stroke_color color.Color? {
        @doc value "is the stroke color of the edge."
    }
    stroke_width uint8 = 2 {
        @doc value "is the stroke width of the edge in pixels."
    }
    segments     Segment[]    {
        @doc value """
            is the ordered list of orthogonal runs that trace the connector path from
            the source handle to the target handle.
        """
    }
}

FlexAlignment = v9.FlexAlignment

ComponentSize = v9.ComponentSize

ButtonMode = v9.ButtonMode

LabelConfig struct extends v9.LabelConfig {
    max_inline_size uint16 = 150 {
        @doc value "is the maximum inline size of the label in pixels before wrapping."
    }
}

LabeledConfig struct extends v9.LabeledConfig {}

ScaledConfig = v9.ScaledConfig

StalenessConfig = v9.StalenessConfig

NumericTelemConfig struct extends v9.NumericTelemConfig {
    precision uint8? {
        @doc value    """
            is the number of decimal places shown, from 0 to 17. Absent shows 2.
        """
        @validate max 17
    }
}

ControlStateConfig = v9.ControlStateConfig

ToggleConfig struct extends v9.ToggleConfig {}

StaticSymbolConfig struct extends v9.StaticSymbolConfig {}

ToggleSymbolConfig struct extends v9.ToggleSymbolConfig {}

DummyToggleSymbolConfig struct extends v9.DummyToggleSymbolConfig {}

ScaleIndicatorConfig struct extends v9.ScaleIndicatorConfig {}

StateMapping = v9.StateMapping

PageType = v9.PageType

Page = v9.Page

NodeConfig union on variant extends v10.NodeConfig {
    box {
        stroke_width uint8 = 2 {
            @doc value "is the border stroke width in pixels."
        }
    }
    button {
        level text.Level = text.LevelH4 {
            @doc value "is the typography level of the button text."
        }
    }
    circle {
        stroke_width uint8 = 2 {
            @doc value "is the border stroke width in pixels."
        }
    }
    line {
        stroke_width uint8 = 2 {
            @doc value "is the stroke width of the line in pixels."
        }
    }
    polygon {
        stroke_width uint8 = 2 {
            @doc value "is the border stroke width in pixels."
        }
    }
    input {
        size
        level text.Level = text.LevelH4 {
            @doc value "is the typography level of the input text."
        }
    }
    select {
        size
        level text.Level = text.LevelH4 {
            @doc value "is the typography level of the select text."
        }
    }
    setpoint {
        size
        level text.Level = text.LevelH4 {
            @doc value "is the typography level of the setpoint text."
        }
    }
    state_indicator {
        size
        level text.Level = text.LevelH4 {
            @doc value "is the typography level of the indicator text."
        }
    }
}

Schematic struct extends v11.Schematic {
    -snapshot
    -range
    project project.Key?            {
        @doc value "is the project that holds the schematic."
    }
    configs map<string, NodeConfig> = {} {
        @doc value """
            contains per-node configuration keyed by node key. The variant of each value
            selects the symbol it configures.
        """
    }
}
