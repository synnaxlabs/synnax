import "schemas/x/versions/spatial/v0"

Key = v0.Key

Node struct {
    key      string     {
        @doc value "is the unique node identifier within the schematic."
    }
    position spatial.XY {
        @doc value "is the top-left position of the node."
    }
    z_index  int16 = 0 {
        @doc value """
            is the stacking order of the node within the schematic. Higher values render
            above lower values. Set by the user via send-to-back / bring-to-front
            actions.
        """
    }

    @doc value  "is a diagram node representing a symbol in the schematic."
    @go marshal
}

Handle struct {
    node  string {
        @doc value "is the node identifier."
    }
    param string {
        @doc value "is the connection point identifier on the node."
    }

    @doc value  """
        is a reference to a specific connection point on a specific node. For
        schematics, param is the symbol handle key (e.g. inlet, outlet).
    """
    @go marshal
}

Edge struct {
    key    string {
        @doc value "is the unique edge identifier within the schematic."
    }
    source Handle {
        @doc value "is the source endpoint of the edge."
    }
    target Handle {
        @doc value "is the target endpoint of the edge."
    }

    @doc value  "is a connection between two nodes in the schematic."
    @go marshal
}

Schematic struct {
    key      Key = create {
        @doc value "is the unique identifier for this schematic."
        @key
    }
    name     string              {
        @doc value "is a human-readable name for the schematic."
    }
    snapshot bool = false {
        @doc value "is true if this schematic is an immutable snapshot copy."
    }
    nodes    Node[] = [] {
        @doc value "contains all diagram nodes in the schematic."
    }
    edges    Edge[] = [] {
        @doc value "contains all connections between nodes."
    }
    configs  map<string, record> = {} {
        @doc value """
            contains per-element configuration keyed by node or edge key. The shape of
            each value is determined by the element's variant; the wire format
            intentionally stores it as an opaque record.
        """
    }

    @go imex
    @go marshal
    @go migrate
}
