Key = uuid {
    @doc value "is a unique identifier for a schematic, represented as a UUID."
}

Schematic struct {
    key      Key = create {
        @doc value "is the unique identifier for this schematic."
        @key
    }
    name     string {
        @doc value "is a human-readable name for the schematic."
    }
    data     record {
        @doc value """is the schematic content including symbols, connections, and layout
configuration."""
    }
    snapshot bool = false {
        @doc value "indicates whether this schematic represents a saved snapshot state."
    }

    @doc value  """is a visual diagram editor component for drawing system schematics,
control flows, and process diagrams. Schematics support interactive
symbols, connection handles, and dynamic state visualization."""
    @go marshal
    @go migrate
}
