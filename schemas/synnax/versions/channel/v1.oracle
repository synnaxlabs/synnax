import "schemas/synnax/versions/node/v0"
import "schemas/x/versions/control/v0"
import "schemas/x/versions/telem/v0"

Key = v0.Key

LocalKey = v0.LocalKey

Name = v0.Name

OperationType = v0.OperationType

Operation = v0.Operation

Channel struct extends v0.Channel {
    retention telem.TimeSpan = 0 {
        @doc value """
            is how long the Core keeps the data of an index channel and of every channel
            on it. Zero keeps the data forever. Only an index channel can set it.
        """
    }
}
