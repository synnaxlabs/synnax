import "schemas/synnax/versions/channel/v0"
import "schemas/synnax/versions/device/v0"
import "schemas/synnax/versions/task/v2"
import "schemas/x/versions/telem/v0"

TemperatureUnits enum {
    celsius    = "C" {
        @doc value "is degrees Celsius."
    }
    fahrenheit = "F" {
        @doc value "is degrees Fahrenheit."
    }
    kelvin     = "K" {
        @doc value "is kelvins."
    }

    @doc value "are the engineering units for a temperature measurement."
}

ThermocoupleType enum {
    j = "J" {
        @doc value "pairs iron with copper-nickel."
    }
    k = "K" {
        @doc value "pairs nickel-chromium with nickel-aluminum."
    }
    n = "N" {
        @doc value "pairs nickel-chromium-silicon with nickel-silicon-magnesium."
    }
    r = "R" {
        @doc value "pairs platinum-13% rhodium with platinum."
    }
    s = "S" {
        @doc value "pairs platinum-10% rhodium with platinum."
    }
    t = "T" {
        @doc value "pairs copper with copper-nickel."
    }
    b = "B" {
        @doc value "pairs platinum-30% rhodium with platinum-6% rhodium."
    }
    e = "E" {
        @doc value "pairs nickel-chromium with copper-nickel."
    }
    c = "C" {
        @doc value "pairs tungsten-5% rhenium with tungsten-26% rhenium."
    }

    @doc value "selects the thermocouple alloy type."
}

BaseReadChannel struct {
    key      string = create {
        @doc value "uniquely identifies the channel within the task."
        @key
    }
    name     string = "" {
        @doc value "is the human-readable channel name."
    }
    disabled bool = false {
        @doc value "is true when the channel is excluded from acquisition."
    }
    channel  channel.Key = 0 {
        @doc value "is the Synnax channel that raw samples are written to."
    }
    port     string = "" {
        @doc value "is the physical port the channel reads from (e.g. 'AIN0', 'DIO4')."
    }

    @doc value  "carries the fields every LabJack read channel shares."
    @go marshal
}

ReadChannel union on type extends BaseReadChannel {
    analog {
        port     string = "AIN0"
        range    float64 = 10 {
            @doc value """
                is the largest voltage magnitude the channel reads, in Volts. The
                channel uses the smallest range of the device that covers it.
            """
        }
        neg_chan int32 = 199 {
            @doc value """
                is the negative channel for differential readings on T7 devices. 199
                selects single-ended.
            """
        }
        scale    task.Scale = none {
            @doc value "is the scale applied to raw samples after acquisition."
        }

        @doc value "reads a voltage from an analog input port."
    }
    digital {
        port string = "DIO4"

        @doc value "reads a digital input line."
    }
    thermocouple {
        port              string = "AIN0" {
            @doc value "is the AIN port the thermocouple's positive lead is wired to."
        }
        thermocouple_type ThermocoupleType = k {
            @doc value "selects the thermocouple alloy type."
        }
        neg_chan          int32 = 199 {
            @doc value """
                is the AIN port of the thermocouple's negative lead on T7 devices. 199
                selects single-ended.
            """
        }
        cjc_source        string = "TEMPERATURE_DEVICE_K" {
            @doc value """
                selects the cold-junction-compensation source: the device sensor
                ('TEMPERATURE_DEVICE_K', which on a T8 is the sensor at the
                thermocouple's own terminal), ambient air ('TEMPERATURE_AIR_K', not on a
                T8), or an AIN port (e.g. 'AIN2').
            """
        }
        cjc_slope         float64 = 1 {
            @doc value "is the CJC voltage-to-temperature slope, in Kelvin per Volt."
        }
        cjc_offset        float64 = 0 {
            @doc value "is the CJC temperature offset, in Kelvins."
        }
        units             TemperatureUnits = kelvin {
            @doc value "are the units of the temperature measurement."
        }
        scale             task.Scale = none {
            @doc value "is the scale applied to raw samples after acquisition."
        }

        @doc value "reads temperature from a thermocouple."
    }

    @doc value  """
        is a single LabJack read channel. The type field selects the input mode and the
        fields that accompany it.
    """
    @go marshal
}

BaseWriteChannel struct {
    key                string = create {
        @doc value "uniquely identifies the channel within the task."
        @key
    }
    disabled           bool = false {
        @doc value "is true when the channel is excluded from the task."
    }
    cmd_channel        channel.Key = 0 {
        @doc value "is the Synnax channel commands are read from."
    }
    state_channel      channel.Key = 0 {
        @doc value "is the Synnax channel the output state is written to."
    }
    cmd_channel_name   string = "" {
        @doc value "is the human-readable name of the command channel."
    }
    state_channel_name string = "" {
        @doc value "is the human-readable name of the state channel."
    }
    port               string = "" {
        @doc value "is the physical port the channel writes to (e.g. 'DAC0', 'DIO4')."
    }

    @doc value  "carries the fields every LabJack write channel shares."
    @go marshal
}

WriteChannel union on type extends BaseWriteChannel {
    analog {
        port string = "DAC0"

        @doc value "drives an analog output on a DAC port."
    }
    digital {
        port string = "DIO4"

        @doc value "drives a digital output line on a DIO port."
    }

    @doc value  """
        is a single LabJack write channel. The type field selects the output mode.
    """
    @go marshal
}

ReadConfig struct extends task.ReadConfig {
    device                            device.Key = "" {
        @doc value "is the key of the device the task acquires from."
    }
    channels                          ReadChannel[] {
        @doc value "are the channels the task acquires."
    }
    device_scan_backlog_warn_on_count uint32 = 0 {
        @doc value """
            is the device-side scan backlog above which the task reports a skew warning.
            Zero lets the Driver pick two seconds of scans.
        """
    }
    ljm_scan_backlog_warn_on_count    uint32 = 0 {
        @doc value """
            is the LJM-side scan backlog above which the task reports a skew warning.
            Zero lets the Driver pick one second of scans.
        """
    }

    @doc value  "configures a LabJack read task."
    @go imex    body
    @go marshal
    @go migrate
}

WriteConfig struct extends task.WriteConfig {
    state_rate telem.Rate = 10 {
        @doc value   """
            is the rate at which output state is reported to Synnax, in Hertz.
        """
        @validate gt 0
    }
    channels   WriteChannel[] {
        @doc value "are the channels the task drives."
    }

    @doc value  "configures a LabJack write task."
    @go imex    body
    @go marshal
    @go migrate
}

ScanConfig struct extends task.ScanConfig {
    tcp_scan_multiplier int32 = 10 {
        @doc value """
            is the number of scan cycles between TCP device scans. USB devices scan
            every cycle; TCP scans are slower, so they run every Nth cycle.
        """
    }

    @doc value  "configures a LabJack scan task."
    @go imex    body
    @go marshal
    @go migrate
}
