import "schemas/x/versions/telem/v0"

Key = v0.Key

MessageKey = v0.MessageKey

FieldKey = v0.FieldKey

ByteOrder = v0.ByteOrder

Identifier = v0.Identifier

BaseField = v0.BaseField

BinaryField = v0.BinaryField

TextField = v0.TextField

JSONBaseField = v0.JSONBaseField

JSONField = v0.JSONField

JSONBaseMatch = v0.JSONBaseMatch

JSONMatch = v0.JSONMatch

Payload = v0.Payload

Message struct extends v0.Message {
    cycle_time telem.TimeSpan? {
        @doc value """
            is the send cycle that the protocol states for the message. When absent the
            protocol states none.
        """
    }
}

ICD struct extends v0.ICD {}

ReadBinding = v0.ReadBinding

ReadMessage = v0.ReadMessage
