import "schemas/synnax/versions/lineplot/v6"

Key = v0.Key

TimestampConfig = v2.TimestampConfig

ChannelEntry = v2.ChannelEntry

Log struct {
    key                      Key = create {
        @doc value "is the unique identifier for this log."
        @key
    }
    name                     string                {
        @doc value "is a human-readable name for the log."
    }
    channels                 ChannelEntry[] = [] {
        @doc value "are the channels displayed in this log, in order."
    }
    timestamp_precision      int32 = 0 {
        @doc value "is the precision of displayed timestamps (0-3)."
    }
    channel_names_hidden     bool = false {
        @doc value "is true when channel names are hidden."
    }
    receipt_timestamp_hidden bool = false {
        @doc value "is true when the receipt timestamp column is hidden."
    }
    range                    string = "rolling7d" {
        @doc value """
            is the key of the range the log displays: a rolling window, a persisted
            range, or "custom".
        """
    }
    custom                   lineplot.CustomRange? {
        @doc value "is the window the \"custom\" range key resolves to."
    }

    @go imex
    @go marshal
    @go migrate
}
