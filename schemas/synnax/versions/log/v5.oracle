import "schemas/synnax/versions/channel/v0"
import "schemas/synnax/versions/group/v1"
import "schemas/synnax/versions/project/v3"
import "schemas/synnax/versions/ranger/v1"
import "schemas/x/versions/color/v2"
import "schemas/x/versions/notation/v0"
import "schemas/x/versions/telem/v0"

Key = v0.Key

TimestampConfig = v3.TimestampConfig

ChannelEntry struct extends v3.ChannelEntry {
    color color.Color? {
        @doc value """
            is the display color for the channel. Absent uses the text color of the log.
        """
    }
}

Log struct extends v4.Log {}
