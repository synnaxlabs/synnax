import "schemas/synnax/versions/resource/v0"
import "schemas/synnax/versions/secret/v1"
import "schemas/synnax/versions/task/v4"
import "schemas/x/versions/telem/v0"

Key = v0.Key

Grant struct extends v0.Grant {
    secrets
    command task.Command {
        @doc value """
            is the command the subject runs with the secrets. Its task is on the subject
            rack, and answers on the key of the command that carries the grant.
        """
    }
}
