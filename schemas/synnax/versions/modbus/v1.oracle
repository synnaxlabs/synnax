import "schemas/synnax/versions/channel/v0"
import "schemas/synnax/versions/device/v0"
import "schemas/synnax/versions/task/v2"
import "schemas/x/versions/telem/v0"

RegisterValue struct {
    data_type  telem.DataType = "uint8" {
        @doc value "is the data type the register contents are interpreted as."
    }
    swap_bytes bool = false {
        @doc value "is true when the byte order within each 16-bit word is swapped."
    }
    swap_words bool = false {
        @doc value "is true when the word order of multi-register values is swapped."
    }

    @doc value  "interprets one or more 16-bit registers as a single typed value."
    @go marshal
}

BaseReadChannel struct {
    key      string = "" {
        @doc value "uniquely identifies the channel within the task."
        @key
    }
    name     string = "" {
        @doc value "is the human-readable channel name."
    }
    disabled bool = false {
        @doc value "is true when the channel is excluded from acquisition."
    }
    channel  channel.Key = 0 {
        @doc value "is the Synnax channel that samples are written to."
    }
    address  uint16 = 0 {
        @doc value "is the Modbus address the channel reads from."
    }

    @doc value  "carries the fields every Modbus read channel shares."
    @go marshal
}

ReadChannel union on type extends BaseReadChannel {
    coil {
        @doc value "reads a single bit from a coil."
    }
    discrete_input {
        @doc value "reads a single bit from a discrete input."
    }
    holding_register extends RegisterValue {
        string_length int32 = 0 {
            @doc value "is the length, in characters, when data_type is a string."
        }

        @doc value "reads a typed value from one or more holding registers."
    }
    input_register extends RegisterValue {
        string_length int32 = 0 {
            @doc value "is the length, in characters, when data_type is a string."
        }

        @doc value "reads a typed value from one or more input registers."
    }

    @doc value  """
        is a single Modbus read channel. The type field selects the register space the
        channel reads from and the fields that accompany it.
    """
    @go marshal
}

BaseWriteChannel struct {
    key      string = "" {
        @doc value "uniquely identifies the channel within the task."
        @key
    }
    name     string = "" {
        @doc value "is the human-readable channel name."
    }
    disabled bool = false {
        @doc value "is true when the channel is excluded from the task."
    }
    channel  channel.Key = 0 {
        @doc value "is the Synnax channel commands are read from."
    }
    address  uint16 = 0 {
        @doc value "is the Modbus address the channel writes to."
    }

    @doc value  "carries the fields every Modbus write channel shares."
    @go marshal
}

WriteChannel union on type extends BaseWriteChannel {
    coil {
        @doc value "writes a single bit to a coil."
    }
    holding_register extends RegisterValue {
        @doc value "writes a typed value to one or more holding registers."
    }

    @doc value  """
        is a single Modbus write channel. The type field selects the register space the
        channel writes to and the fields that accompany it.
    """
    @go marshal
}

ReadConfig struct extends task.BaseReadConfig {
    device   device.Key = "" {
        @doc value "is the key of the device the task acquires from."
    }
    channels ReadChannel[] {
        @doc value "are the channels the task acquires."
    }

    @doc value  "configures a Modbus read task."
    @go marshal
    @go migrate
}

WriteConfig struct extends task.BaseWriteConfig {
    channels WriteChannel[] {
        @doc value "are the channels the task drives."
    }

    @doc value  "configures a Modbus write task."
    @go marshal
    @go migrate
}

ScanConfig struct extends task.BaseScanConfig {
    @doc value  "configures a Modbus scan task."
    @go marshal
    @go migrate
}
