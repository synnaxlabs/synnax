import "schemas/synnax/versions/bus/v0"
import "schemas/synnax/versions/task/v2"

Properties struct {
    host string = "" {
        @doc value "is the host name or IP address of the device."
    }
    port uint16 = 0 {
        @doc value "is the TCP port the device listens on."
    }

    @doc value  "are the properties of a device the Driver reaches as a TCP client."
    @go marshal
}

ReadConfig struct extends bus.ReadConfig, bus.PollConfig {
    framing bus.Framing = delimiter {
        @doc value "is how the task splits the received byte stream into frames."
    }

    @doc value  "configures a TCP read task."
    @go marshal
    @go migrate
}

WriteConfig struct extends bus.WriteConfig {
    framing bus.Framing = delimiter {
        @doc value "is how the task frames each message it sends."
    }

    @doc value  "configures a TCP write task."
    @go marshal
    @go migrate
}

ScanConfig struct extends task.ScanConfig {
    @doc value  "configures the scan task that checks each TCP device is reachable."
    @go marshal
    @go migrate
}
