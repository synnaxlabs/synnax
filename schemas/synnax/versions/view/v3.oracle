import "schemas/synnax/versions/ranger/v3"
import "schemas/synnax/versions/status/v2"
import "schemas/x/versions/color/v2"

Key = v0.Key

Base struct extends v1.Base {
    icon  string?      {
        @doc value """
            is the key of the icon that marks the view in lists. When null, the Console
            draws its default view icon.
        """
    }
    color color.Color? {
        @doc value "is the color of the view's icon. When null, the theme picks it."
    }
}

Type = v2.Type

RangeSort enum {
    newest = "newest" {
        @doc value "puts the range that starts latest first."
    }
    oldest = "oldest" {
        @doc value "puts the range that starts earliest first."
    }
    name   = "name" {
        @doc value "puts the ranges in order of name."
    }

    @doc value "is the order of the ranges in a range view."
}

RangeLayout enum {
    tree     = "tree" {
        @doc value "shows each range under the range it is nested in."
    }
    list     = "list" {
        @doc value "shows the ranges in one flat list."
    }
    timeline = "timeline" {
        @doc value "shows the ranges as lanes over a time axis."
    }

    @doc value "is how a range view shows its ranges."
}

View union on type Type extends Base {
    range {
        where  ranger.Where? {
            @doc value "selects the ranges the view shows. An absent where shows all."
        }
        sort   RangeSort = newest {
            @doc value "is the order of the ranges."
        }
        layout RangeLayout = tree {
            @doc value "is how the view lays out the ranges."
        }

        @doc value "is a saved view of ranges."
    }
    status {
        where status.Where? {
            @doc value """
                selects the statuses the view shows. An absent where shows all.
            """
        }

        @doc value "is a saved view of statuses."
    }

    @doc value  """
        is a saved, named filter over a list of resources. The type selects the resource
        the view lists and the shape of its where.
    """
    @go marshal
    @go migrate
}
