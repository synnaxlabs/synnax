Key = uuid {
    @doc value "is a unique identifier for a saved view configuration."
}

View struct {
    key   Key = create {
        @doc value "is the unique identifier for this view."
        @key
    }
    name  string {
        @doc value "is a human-readable name for the view."
    }
    type  string {
        @doc value "is the view type identifier (e.g., 'lineplot', 'table', 'schematic')."
    }
    query record {
        @doc value """is a type-agnostic JSON object containing view-specific configuration
and query parameters."""
    }

    @doc value  """is a persisted view configuration storing visualization settings and
query parameters for line plots, tables, schematics, and other view
types."""
    @go migrate
    @go marshal
}
