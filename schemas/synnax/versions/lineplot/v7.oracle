import "schemas/synnax/versions/channel/v0"
import "schemas/x/versions/spatial/v0"
import "schemas/x/versions/telem/v0"
import "schemas/x/versions/text/v0"

Key = v0.Key

TickType = v5.TickType

DownsampleMode = v5.DownsampleMode

XAxisKey = v5.XAxisKey

YAxisKey = v5.YAxisKey

AxisKey = v5.AxisKey

XAxisMode enum {
    samples  = "samples"
    spectrum = "spectrum"

    @doc value """
        selects what an x-axis plots: the channel samples, or the spectrum of each
        line's channel over the axis window with frequency on the axis.
    """
}

WindowFunction enum {
    hann        = "hann"
    rectangular = "rectangular"
    flat_top    = "flat_top"

    @doc value "names the window function applied to each FFT block."
}

MagnitudeScale enum {
    linear  = "linear"
    decibel = "decibel"

    @doc value "selects the scale of spectrum magnitudes."
}

TriggerEdge enum {
    rising  = "rising"
    falling = "falling"

    @doc value "selects the direction of the level crossing that fires a trigger."
}

Title = v5.Title

Legend = v5.Legend

Channels = v5.Channels

CustomRange union on variant {
    dynamic {
        span telem.TimeSpan = 0 {
            @doc value "is the span of the window, which ends now."
            @ts type   telem.NumericTimeSpan
        }

        @doc value "is a rolling window."
    }
    static {
        start telem.TimeStamp {
            @doc value "is the inclusive start of the fixed window."
            @ts type   telem.StringTimeStamp
        }
        end   telem.TimeStamp {
            @doc value "is the exclusive end of the fixed window."
            @ts type   telem.StringTimeStamp
        }

        @doc value "is a fixed window."
    }
    triggered {
        channel    channel.Key = 0 {
            @doc value """
                is the channel scanned for the level crossing. Zero means the first
                channel plotted on the axis.
            """
        }
        level      float64 = 0 {
            @doc value "is the value the trigger channel crosses to fire."
        }
        edge       TriggerEdge = TriggerEdgeRising {
            @doc value "is the crossing direction that fires."
        }
        span       telem.TimeSpan = 0 {
            @doc value "is the span of one frame."
            @ts type   telem.NumericTimeSpan
        }
        pretrigger float64 = 0.1 {
            @doc value "is the fraction of the span shown before the crossing."
        }
        timeout    telem.TimeSpan = 1000000000 {
            @doc value """
                is how long the plot waits for a crossing before it shows the latest
                span of data instead.
            """
            @ts type   telem.NumericTimeSpan
        }

        @doc value """
            is a one-frame window cut around a level crossing on a trigger channel,
            plotted against time since the crossing.
        """
    }

    @doc value  "is the window a plot's synthetic \"custom\" range key resolves to."
    @go marshal
}

Ranges struct {
    x1     string[]     {
        @doc value """
            are the range keys plotted against the x1 axis. Range keys are opaque
            strings rather than UUIDs because the console layers synthetic
            rolling-window ranges (e.g. "recent", "rolling1m") alongside persisted
            ranges; the server stores whatever the client sends.
        """
    }
    x2     string[]     {
        @doc value "are the range keys plotted against the x2 axis."
    }
    custom CustomRange? {
        @doc value "is the window the \"custom\" range key resolves to."
    }

    @doc value  "binds range keys to each x-axis."
    @go marshal
}

ManualBounds = v5.ManualBounds

Spectrum struct {
    window      WindowFunction = WindowFunctionHann {
        @doc value "is the window function applied to each FFT block."
    }
    scale       MagnitudeScale = MagnitudeScaleLinear {
        @doc value "is the scale of the magnitudes."
    }
    point_limit uint32 = 65536 {
        @doc value "is the most samples one FFT block reads."
    }

    @doc value  "configures the spectrum an x-axis plots in spectrum mode."
    @go marshal
}

Axis struct {
    key             AxisKey           {
        @doc value "identifies which of the six axes this configuration applies to."
    }
    label           string = "" {
        @doc value "is the human-readable label rendered along the axis."
    }
    label_direction spatial.Direction = spatial.DirectionX {
        @doc value "is the orientation in which the label text is laid out."
    }
    label_level     text.Level = text.LevelSmall {
        @doc value "is the typography level of the label."
    }
    bounds          spatial.Bounds = { lower = 0, upper = 0 } {
        @doc value """
            is the value-space window of the axis. When the matching entry in
            manual_bounds is false the field is overwritten locally on every render;
            otherwise it is the user-set fixed bound.
        """
    }
    manual_bounds   ManualBounds = {} {
        @doc value "controls per-edge manual bound override."
    }
    tick_spacing    float64 = 75 {
        @doc value "is the target pixel distance between adjacent tick marks."
    }
    type            TickType?         {
        @doc value """
            selects the tick label style. Null means default (linear). X-axes typically
            carry "time" when bound to a timestamp channel.
        """
    }
    mode            XAxisMode = XAxisModeSamples {
        @doc value "selects what the axis plots. Read on x-axes only."
    }
    spectrum        Spectrum = {} {
        @doc value "configures the spectrum plotted in spectrum mode."
    }

    @doc value  "is the configuration for a single plot axis."
    @go marshal
}

Axes struct {
    x1 Axis = { key = AxisKeyX1 } {
        @doc value "is the x1 axis configuration."
    }
    x2 Axis = { key = AxisKeyX2 } {
        @doc value "is the x2 axis configuration."
    }
    y1 Axis = { key = AxisKeyY1, label_direction = spatial.DirectionY } {
        @doc value "is the y1 axis configuration."
    }
    y2 Axis = { key = AxisKeyY2, label_direction = spatial.DirectionY } {
        @doc value "is the y2 axis configuration."
    }
    y3 Axis = { key = AxisKeyY3, label_direction = spatial.DirectionY } {
        @doc value "is the y3 axis configuration."
    }
    y4 Axis = { key = AxisKeyY4, label_direction = spatial.DirectionY } {
        @doc value "is the y4 axis configuration."
    }

    @doc value  "bundles configuration for all six fixed plot axes."
    @go marshal
}

Line = v5.Line

Rule = v5.Rule

LinePlot struct {
    key      Key = create {
        @doc value "is the unique identifier for this line plot."
        @key
    }
    name     string   {
        @doc value "is a human-readable name for the line plot."
    }
    title    Title = {} {
        @doc value "is the plot title configuration."
    }
    legend   Legend = {} {
        @doc value "is the plot legend configuration."
    }
    channels Channels = {} {
        @doc value "binds channel keys to each axis."
    }
    ranges   Ranges = {} {
        @doc value "binds range keys to each x-axis."
    }
    axes     Axes = {} {
        @doc value "bundles per-axis configuration."
    }
    lines    Line[]   {
        @doc value """
            holds per-line styling and downsampling configuration. Each entry
            corresponds to one channel and range combination produced by the channels
            and ranges bindings.
        """
    }
    rules    Rule[]   {
        @doc value "holds annotation rules drawn over the plot."
    }

    @go imex
    @go marshal
    @go migrate
}
