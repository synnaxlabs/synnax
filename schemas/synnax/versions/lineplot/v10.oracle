import "schemas/synnax/versions/channel/v0"
import "schemas/synnax/versions/color/v0"
import "schemas/synnax/versions/group/v1"
import "schemas/synnax/versions/project/v3"
import "schemas/synnax/versions/ranger/v1"

Key = v0.Key

TickType = v5.TickType

Aggregation = v7.Aggregation

Detail = v7.Detail

XAxisKey = v5.XAxisKey

YAxisKey = v5.YAxisKey

AxisKey = v5.AxisKey

Title = v5.Title

Legend = v5.Legend

Channels = v5.Channels

ManualBounds = v5.ManualBounds

Axis = v5.Axis

Axes = v5.Axes

Line struct extends v8.Line {
    color color.Ref? {
        @doc value """
            is the line color, a named color or a fixed color. A write with no color
            gets the series color that the fewest other lines use, and a tie goes to the
            first.
        """
    }
}

Rule struct extends v5.Rule {
    color color.Ref? {
        @doc value """
            is the display color of the rule, a named color or a fixed color. A write
            with no color gets the series color that the fewest other rules use, and a
            tie goes to the first.
        """
    }
}

LinePlot struct extends v9.LinePlot {}
