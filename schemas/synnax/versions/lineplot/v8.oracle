import "schemas/x/versions/color/v0"

Key = v0.Key

TickType = v5.TickType

Aggregation = v7.Aggregation

Detail = v7.Detail

XAxisKey = v5.XAxisKey

YAxisKey = v5.YAxisKey

AxisKey = v5.AxisKey

Title = v5.Title

Legend = v5.Legend

Channels = v5.Channels

CustomRange = v6.CustomRange

Ranges = v6.Ranges

ManualBounds = v5.ManualBounds

Axis = v5.Axis

Axes = v5.Axes

Line struct extends v7.Line {
    stroke_width float64? {
        @doc value """
            is the line stroke width in pixels. Absent draws the default width of 2.
        """
    }
}

Rule = v5.Rule

LinePlot struct extends v7.LinePlot {}
