import "schemas/synnax/versions/device/v0"
import "schemas/synnax/versions/status/v0"
import "schemas/x/versions/telem/v0"

Key uint64 {
    @doc value  """
        is a composite identifier for a task. The high 32 bits contain the rack key, and
        the low 32 bits contain the local task key within that rack.
    """
    @go marshal flex
}

StatusDetails struct<Data? = record> {
    task    Key = 0 {
        @doc value "is the key of the task this status pertains to."
    }
    running bool   {
        @doc value "is true if the task is currently executing."
    }
    cmd     string = "" {
        @doc value "is the last command executed on this task."
    }
    data    Data?  {
        @doc value "contains task-specific status data."
    }

    @doc value "contains task-specific status details including execution state."
}

Status = status.Status<StatusDetails> {
    @doc value """
        is task-specific status information including execution state and task-specific
        data.
    """
}

Task struct {
    key      Key = 0 {
        @doc value "is the composite identifier for this task."
        @key
    }
    name     string  {
        @doc value "is a human-readable name for the task."
    }
    type     string  {
        @doc value """
            is the task type (e.g., 'modbus_read', 'labjack_write', 'opc_scan').
            Determines which hardware integration handles the task.
        """
    }
    config   record  {
        @doc value """
            is task-specific configuration stored as JSON. Structure varies by task
            type.
        """
    }
    internal bool = false {
        @doc value "is true if this is an internal system task."
    }
    snapshot bool = false {
        @doc value "indicates whether to persist this task's configuration."
    }
    status   Status? {
        @doc value "is the current execution status of the task."
    }

    @doc value  """
        is an executable unit of work in the Driver system. Tasks represent specific
        hardware operations such as reading sensor data, writing control signals, or
        scanning for devices.
    """
    @go marshal
    @go migrate
}

KeyedConfig struct {
    key uuid = create {
        @doc value "is the unique identifier for the stored configuration record."
        @key
    }

    @doc value "is the base for every stored task configuration record."
}

BaseStartConfig struct extends KeyedConfig {
    auto_start bool = false {
        @doc value "is true when the task should start as soon as it is configured."
    }

    @doc value "carries the configuration fields shared by every task."
}

BasePersistConfig struct extends BaseStartConfig {
    data_saving_disabled bool = false {
        @doc value "is true when task telemetry is not persisted to disk."
    }

    @doc value "carries the configuration fields shared by tasks that write telemetry."
}

BaseReadConfig struct extends BasePersistConfig {
    sample_rate telem.Rate = 10 {
        @doc value "is the per-channel hardware sample rate, in hertz."
    }
    stream_rate telem.Rate = 5 {
        @doc value "is the rate at which samples are streamed to Synnax, in hertz."
    }

    @doc value "carries the configuration fields shared by hardware acquisition tasks."
}

BaseWriteConfig struct extends BasePersistConfig {
    device device.Key = "" {
        @doc value "is the key of the device the task writes to."
    }

    @doc value "carries the configuration fields shared by hardware control tasks."
}

BaseScanConfig struct extends KeyedConfig {
    rate     telem.Rate = 0.2 {
        @doc value "is the rate at which the scan runs, in hertz."
    }
    disabled bool = false {
        @doc value "is true when scanning is paused."
    }

    @doc value "carries the fields shared by every scan task configuration."
}
