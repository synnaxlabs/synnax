import "schemas/synnax/versions/device/v1"
import "schemas/synnax/versions/rack/v2"
import "schemas/synnax/versions/status/v1"
import "schemas/x/versions/telem/v0"

Key = uuid {
    @doc value "is a unique identifier for a task."
}

StatusDetails struct<Data? = record> {
    running     bool     {
        @doc value "is true if the task is currently executing."
    }
    cmd         string = "" {
        @doc value "is the last command executed on this task."
    }
    config_hash string = "" {
        @doc value """
            is the hash of the config the running task instance was built from. Empty
            when no instance exists.
        """
    }
    rack        rack.Key = 0 {
        @doc value "is the key of the rack running the task instance."
    }
    data        Data?    {
        @doc value "contains task-specific status data."
    }

    @doc value "contains task-specific status details including execution state."
}

Status<Data? = record> = status.Status<StatusDetails<Data>>

Task struct<
    Type extends string = string,
    Config extends record = record,
    StatusData? = record
> {
    key         Key = create {
        @doc value "is the unique identifier for this task."
        @key
    }
    rack        rack.Key = 0 {
        @doc value """
            is the key of the rack this task deploys to. Zero for a draft that has not
            been assigned a rack; required to start.
        """
    }
    name        string              {
        @doc value "is a human-readable name for the task."
    }
    type        Type                {
        @doc value """
            is the task type (e.g., 'modbus_read', 'labjack_write', 'opc_scan').
            Determines which hardware integration handles the task.
        """
    }
    config      Config              {
        @doc value """
            is task-specific configuration stored as JSON. Structure varies by task
            type.
        """
    }
    config_hash string = "" {
        @doc value """
            is the Core-assigned hash of config, rewritten on every write and ignored on
            writes from clients. Compare against a status's config_hash to detect drift.
        """
    }
    internal    bool = false {
        @doc value "is true if this is an internal system task."
    }
    snapshot    bool = false {
        @doc value "is true if this task is an immutable snapshot copy of another task."
    }
    status      Status<StatusData>? {
        @doc value  "is the current execution status of the task."
        @go marshal omit
    }

    @doc value  """
        is an executable unit of work in the Driver system. Tasks represent specific
        hardware operations such as reading sensor data, writing control signals, or
        scanning for devices.
    """
    @go marshal
    @go migrate
}

KeyedConfig struct {
    key uuid = create {
        @doc value "is the unique identifier for the stored configuration record."
        @key
    }

    @doc value "is the base for every stored task configuration record."
}

StartConfig struct extends KeyedConfig {
    auto_start bool = false {
        @doc value "is true when the task should start as soon as it is configured."
    }

    @doc value "carries the configuration fields shared by every task."
}

PersistConfig struct extends StartConfig {
    data_saving_disabled bool = false {
        @doc value "is true when task telemetry is not persisted to disk."
    }

    @doc value "carries the configuration fields shared by tasks that write telemetry."
}

ReadConfig struct extends PersistConfig {
    sample_rate telem.Rate = 10 {
        @doc value   "is the per-channel hardware sample rate, in Hertz."
        @validate gt 0
    }
    stream_rate telem.Rate = 5 {
        @doc value "is the rate at which samples are streamed to Synnax, in Hertz."
    }

    @doc value "carries the configuration fields shared by hardware acquisition tasks."
}

WriteConfig struct extends PersistConfig {
    device device.Key = "" {
        @doc value "is the key of the device the task writes to."
    }

    @doc value "carries the configuration fields shared by hardware control tasks."
}

ScanConfig struct extends KeyedConfig {
    rate     telem.Rate = 0.2 {
        @doc value   "is the rate at which the scan runs, in Hertz."
        @validate gt 0
    }
    disabled bool = false {
        @doc value "is true when scanning is paused."
    }

    @doc value "carries the fields shared by every scan task configuration."
}

Scale union on type {
    linear {
        slope  float64 = 1 {
            @doc value "is the multiplier applied to the raw value."
        }
        offset float64 = 0 {
            @doc value "is the offset added after scaling."
        }

        @doc value "maps raw values to engineering units with a slope and offset."
    }
    map {
        pre_scaled_min float64 = 0 {
            @default group "pre_scaled"
            @doc value     "is the lower bound of the raw input range."
        }
        pre_scaled_max float64 = 1 {
            @default group "pre_scaled"
            @doc value     "is the upper bound of the raw input range."
        }
        scaled_min     float64 = 0 {
            @default group "scaled"
            @doc value     "is the lower bound of the scaled output range."
        }
        scaled_max     float64 = 1 {
            @default group "scaled"
            @doc value     "is the upper bound of the scaled output range."
        }

        @doc value "maps a raw range linearly onto a scaled range."
    }
    polynomial {
        coeffs float64[] = [] {
            @doc value """
                are the coefficients from the constant term up, so that index i holds
                the coefficient of x^i.
            """
        }

        @doc value "maps raw values to engineering units with a polynomial."
    }
    table {
        pre_scaled_vals float64[] = [] {
            @doc value "are the raw breakpoints, in increasing order."
        }
        scaled_vals     float64[] = [] {
            @doc value "are the engineering-unit values at each breakpoint."
        }

        @doc value """
            maps raw values to engineering units by linear interpolation between the
            breakpoints, and clips raw values outside the table to its first or last
            scaled value.
        """
    }
    none {
        @doc value "applies no scaling; the raw value is used directly."
    }

    @doc value  """
        determines how the raw values of a hardware read channel are transformed to
        engineering units.
    """
    @go marshal
}
