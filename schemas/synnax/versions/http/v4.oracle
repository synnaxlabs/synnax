import "schemas/synnax/versions/channel/v0"
import "schemas/synnax/versions/device/v0"
import "schemas/synnax/versions/task/v2"
import "schemas/x/versions/telem/v0"

Method = v2.Method

TimeFormat = v2.TimeFormat

Header = v2.Header

QueryParam = v2.QueryParam

EnumEntry = v2.EnumEntry

ReadField struct extends v2.ReadField {
    disabled
    optional   bool = false {
        @doc value """
            is true when a missing value is normal for this field. The task writes
            fill_value, or NaN on a float channel, and sends no warning.
        """
    }
    fill_value any? {
        @doc value """
            is the value written when an optional field is missing, typed by the
            channel. Unset writes NaN, which needs a float channel.
        """
    }
}

ReadEndpoint struct {
    key          string = create {
        @doc value "uniquely identifies the endpoint within the task."
        @key
    }
    method       Method = get {
        @doc value "is the HTTP method used to poll the endpoint."
    }
    path         string = "" {
        @doc value "is the URL path appended to the device's base URL."
    }
    headers      Header[]     {
        @doc value "contains additional headers merged into the request."
    }
    query_params QueryParam[] {
        @doc value "contains query parameters appended to the request URL."
    }
    body         string = "" {
        @doc value "is a static body sent with each request. Empty sends no body."
    }
    fields       ReadField[]  {
        @doc value "contains the values to extract from the response."
    }
    index        string = "" {
        @doc value """
            is the key of the field whose channel indexes the others. Empty when the
            task stamps samples on arrival.
        """
    }

    @doc value  "is a single HTTP endpoint polled by a read task."
    @go marshal
}

ReadConfig struct extends task.PersistConfig {
    device           device.Key = "" {
        @doc value "is the key of the HTTP server device to poll."
    }
    rate             telem.Rate = 1 {
        @doc value   "is the polling rate applied to all endpoints, in Hertz."
        @validate gt 0
    }
    endpoints        ReadEndpoint[] {
        @doc value "contains the endpoints to poll."
    }
    nan_fill_enabled bool = false {
        @doc value """
            is true when a float field that is missing or fails to convert is written as
            NaN. When false, the task skips every field that shares the endpoint and
            index channel with it.
        """
    }

    @doc value  """
        configures an HTTP read task, which polls one or more endpoints on an HTTP
        server device and writes extracted JSON values to Synnax channels.
    """
    @go imex    body
    @go marshal
    @go migrate
}

JSONType = v2.JSONType

GeneratorType = v2.GeneratorType

ChannelField = v2.ChannelField

BaseWriteField = v2.BaseWriteField

WriteField = v2.WriteField

WriteEndpoint = v2.WriteEndpoint

WriteConfig = v2.WriteConfig

ScanConfig = v2.ScanConfig
