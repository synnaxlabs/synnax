import "schemas/synnax/versions/channel/v0"
import "schemas/synnax/versions/device/v0"
import "schemas/synnax/versions/task/v2"
import "schemas/x/versions/payload/v1"
import "schemas/x/versions/telem/v0"

Method = v2.Method

Header = v2.Header

QueryParam = v2.QueryParam

BaseReadField struct {
    key      string = create {
        @doc value "uniquely identifies the field within the endpoint."
        @key
    }
    name     string = "" {
        @doc value "is the human-readable field name."
    }
    disabled bool = false {
        @doc value "is true when the field is excluded from polling."
    }
    channel  channel.Key = 0 {
        @doc value "is the Synnax channel the extracted value is written to."
    }
    pointer  string = "" {
        @doc value "is the JSON Pointer to the value within the response body."
    }

    @doc value  "carries the fields every read field shares."
    @go marshal
}

ReadField union on type payload.Kind extends BaseReadField {
    float extends payload.FloatRead {
        @doc value "reads a float."
    }
    integer extends payload.IntegerRead {
        @doc value "reads a signed integer."
    }
    unsigned extends payload.UnsignedRead {
        @doc value "reads an unsigned integer."
    }
    string extends payload.StringRead {
        @doc value "reads a string."
    }
    boolean extends payload.BooleanRead {
        @doc value "reads a boolean."
    }
    timestamp extends payload.TimestampRead {
        @doc value "reads a timestamp."
    }
    json {
        @doc value "reads any JSON value."
    }
    uuid {
        @doc value "reads a UUID."
    }
    bytes {
        @doc value "reads bytes."
    }

    @doc value  """
        is a single value extracted from an endpoint's JSON response. The type field is
        the kind of the value, which matches the kind of the channel's data type.
    """
    @go marshal
}

ReadEndpoint struct extends v4.ReadEndpoint {}

ReadConfig struct extends v4.ReadConfig {}

BaseChannelField struct {
    pointer   string = "" {
        @doc value """
            is the JSON Pointer where the channel value is placed in the body. An empty
            pointer sends the bare value as the entire body, in which case the endpoint
            may not declare any additional fields.
        """
    }
    channel   channel.Key = 0 {
        @doc value "is the Synnax command channel that triggers the request."
    }
    name      string = "" {
        @doc value "is the human-readable name of the command channel."
    }
    data_type telem.DataType? {
        @doc value "is the data type of a new channel. Absent for an existing one."
    }

    @doc value  "carries the fields every command channel field shares."
    @go marshal
}

ChannelField union on type payload.Kind extends BaseChannelField {
    float {
        enum_values payload.FloatEntry[] = [] {
            @doc value "maps channel values to the labels written in their place."
        }

        @doc value "writes each sample as a JSON number."
    }
    integer {
        enum_values payload.IntegerEntry[] = [] {
            @doc value "maps channel values to the labels written in their place."
        }

        @doc value "writes each sample as a JSON number."
    }
    unsigned {
        enum_values payload.UnsignedEntry[] = [] {
            @doc value "maps channel values to the labels written in their place."
        }

        @doc value "writes each sample as a JSON number."
    }
    string {
        enum_values payload.StringEntry[] = [] {
            @doc value "maps channel values to the labels written in their place."
        }

        @doc value "writes each sample as a JSON string."
    }
    boolean {
        enum_values payload.BooleanEntry[] = [] {
            @doc value "maps channel values to the labels written in their place."
        }

        @doc value "writes each sample as a JSON boolean."
    }
    timestamp {
        time_format payload.TimeFormat {
            @doc value "is the encoding of each sample."
        }

        @doc value "writes each sample of a timestamp channel in a time format."
    }
    json {
        @doc value "writes each sample of a JSON channel as its JSON value."
    }
    uuid {
        @doc value "writes each sample of a UUID channel as a JSON string."
    }
    bytes {
        @doc value "writes each sample of a bytes channel as a base64 JSON string."
    }

    @doc value  """
        is the command channel value placed into the body of a write endpoint. The type
        selects the JSON value of each sample. A sample that matches an entry of
        enum_values is written as the entry's label.
    """
    @go marshal
}

WriteEndpoint struct extends v4.WriteEndpoint {
    channel ChannelField = float {
        @doc value "is the command channel whose writes trigger this endpoint."
    }
    fields  payload.WriteField[] {
        @doc value "contains additional fixed or generated body fields."
    }
}

WriteConfig struct extends v4.WriteConfig {}

ScanConfig = v2.ScanConfig
