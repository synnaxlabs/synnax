Key = uuid {
    @doc value "is a unique identifier for a role, represented as a UUID."
}

Role struct {
    key         Key = create {
        @doc value "is the unique identifier for this role."
        @key
    }
    name        string {
        @doc value """is a human-readable name for the role (e.g., 'Administrator',
'Engineer')."""
    }
    description string = "" {
        @doc value """is an optional description explaining what permissions the role
provides."""
    }
    internal    bool = false {
        @doc value "is true if this is a built-in system role that cannot be deleted."
    }

    @doc value  """is a named collection of policies that can be assigned to users, enabling
group-based permission management. Roles define what actions users can
perform on resources."""
    @go marshal
    @go migrate
}
