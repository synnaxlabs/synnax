import "schemas/synnax/versions/rack/v3"
import "schemas/synnax/versions/secret/v1"

Key = v0.Key

Details = v0.Details

Base = v0.Base

Certificate union on source secret.Source extends v0.Certificate {
    file {
        details
        rack    rack.Key {
            @doc value "is the rack that reads the files."
        }
    }
}
