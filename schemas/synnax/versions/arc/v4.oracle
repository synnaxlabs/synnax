import "schemas/arc/program"
import "schemas/arc/versions/graph/v1"
import "schemas/arc/versions/text/v1"

Key = v1.Key

Mode = v1.Mode

Type enum {
    automation = "automation"
    module     = "module"

    @doc value """
        specifies whether an Arc runs on a rack as an automation or holds code for other
        Arcs to import as a module.
    """
}

Source union on mode Mode {
    text {
        text text.Text = {} {
            @doc value "is the text-based Arc source code."
        }

        @doc value "is Arc source code written as text."
    }
    graph {
        graph graph.Graph = {} {
            @doc value "is the visual dataflow graph representation of the module."
        }

        @doc value "is Arc source code drawn as a visual dataflow graph."
    }

    @doc value  "is the source code of an Arc. The mode selects text or a graph."
    @go marshal
}

Base struct {
    key    Key = create {
        @doc value "is the unique identifier for this module."
        @key
    }
    name   string {
        @doc value "is a human-readable name for the module."
    }
    source Source = text {
        @doc value "is the Arc's source code, written as text or drawn as a graph."
    }

    @doc value  "carries the fields that every Arc shares."
    @go marshal
}

Arc union on type Type extends Base {
    automation {
        program program.Program? {
            @doc value  """
                is the compiled module output including IR and WebAssembly bytecode.
            """
            @go marshal omit
        }

        @doc value "is an Arc that runs on a rack as a task."
    }
    module {
        @doc value "is an Arc that holds code for other Arcs to import."
    }

    @go imex
    @go marshal
    @go migrate
}
