import "schemas/arc/program"
import "schemas/synnax/versions/channel/v2"

Key = v0.Key

Mode = v0.Mode

Type = v4.Type

Source = v4.Source

Base struct extends v4.Base {
    reads  channel.Key[] = [] {
        @doc value """
            are the channels that the Arc reads, as the last compile of its source that
            succeeded found them.
        """
    }
    writes channel.Key[] = [] {
        @doc value """
            are the channels that the Arc writes, as the last compile of its source that
            succeeded found them.
        """
    }
}

Status = v4.Status

ChangeKind = v4.ChangeKind

Change = v4.Change

Calculation struct {
    channel channel.Key     {
        @doc value "is the key of the calculated channel."
    }
    program program.Program {
        @doc value "is the compiled module that computes the channel."
    }

    @doc value "is a calculated channel that an automation reads, compiled to a module."
}

Arc union on type Type extends Base {
    automation {
        program      program.Program? {
            @doc value  """
                is the compiled module output including IR and WebAssembly bytecode.
            """
            @go marshal omit
        }
        changes      Change[]         {
            @doc value  "is what changed in the automation since its task was deployed."
            @go marshal omit
        }
        calculations Calculation[]    {
            @doc value  """
                are the calculated channels that the program reads, nested ones
                included. Dependencies come before the channels that read them.
            """
            @go marshal omit
        }

        @doc value "is an Arc that runs on a rack as a task."
    }
    module {
        status Status? {
            @doc value  "is the result of the module's last compile on the Core."
            @go marshal omit
        }

        @doc value "is an Arc that holds code for other Arcs to import."
    }

    @go imex
    @go marshal
    @go migrate
}
