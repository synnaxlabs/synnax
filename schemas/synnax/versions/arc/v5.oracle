import "schemas/synnax/versions/channel/v2"

Key = v0.Key

Mode = v0.Mode

Type = v4.Type

Source = v4.Source

Base struct extends v4.Base {
    reads  channel.Key[] = [] {
        @doc value """
            are the channels that the Arc reads, as the last compile of its source that
            succeeded found them.
        """
    }
    writes channel.Key[] = [] {
        @doc value """
            are the channels that the Arc writes, as the last compile of its source that
            succeeded found them.
        """
    }
}

Status = v4.Status

ChangeKind = v4.ChangeKind

Change = v4.Change

Calculation = v4.Calculation

Arc = v4.Arc
