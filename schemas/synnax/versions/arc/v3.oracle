import "schemas/arc/program"
import "schemas/arc/versions/graph/v1"
import "schemas/arc/versions/text/v1"

Key = v1.Key

Mode = v1.Mode

StatusDetails = v1.StatusDetails

Status = v1.Status

Arc struct {
    key     Key = create {
        @doc value "is the unique identifier for this module."
        @key
    }
    name    string           {
        @doc value "is a human-readable name for the module."
    }
    mode    Mode             {
        @doc value """
            specifies the representation mode for this module. Either "text" for
            text-based Arc code or "graph" for visual dataflow.
        """
    }
    graph   graph.Graph = {} {
        @doc value "is the visual dataflow graph representation of the module."
    }
    text    text.Text = {} {
        @doc value "is the text-based Arc source code."
    }
    program program.Program? {
        @doc value  """
            is the compiled module output including IR and WebAssembly bytecode.
        """
        @go marshal omit
    }
    status  Status?          {
        @doc value  "is the current execution status of the module."
        @go marshal omit
    }

    @go imex
    @go marshal
    @go migrate
}

ExecutionMode = v1.ExecutionMode

TaskConfig = v1.TaskConfig
