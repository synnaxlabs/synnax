import "schemas/arc/program"
import "schemas/arc/versions/graph/v0"
import "schemas/arc/versions/text/v0"
import "schemas/synnax/status"
import "schemas/synnax/versions/task/v0"

Key = v0.Key

Mode = v0.Mode

StatusDetails = v0.StatusDetails

Status = status.Status<StatusDetails> {
    @doc value "is the status of an Arc module including execution state."
}

Arc struct {
    key     Key = create {
        @doc value "is the unique identifier for this module."
        @key
    }
    name    string           {
        @doc value "is a human-readable name for the module."
    }
    mode    Mode             {
        @doc value """
            specifies the representation mode for this module. Either "text" for
            text-based Arc code or "graph" for visual dataflow.
        """
    }
    graph   graph.Graph = {} {
        @doc value "is the visual dataflow graph representation of the module."
    }
    text    text.Text = {} {
        @doc value "is the text-based Arc source code."
    }
    program program.Program? {
        @doc value  """
            is the compiled module output including IR and WebAssembly bytecode.
        """
        @go marshal omit
    }
    status  Status?          {
        @doc value  "is the current execution status of the module."
        @go marshal omit
    }

    @doc value  """
        is an Arc module combining visual graph representation and text-based source
        code for reactive control systems. Compiles to WebAssembly for sandboxed
        execution.
    """
    @go marshal
    @go migrate
}

ExecutionMode enum {
    auto         = "AUTO"
    busy_wait    = "BUSY_WAIT"
    high_rate    = "HIGH_RATE"
    rt_event     = "RT_EVENT"
    hybrid       = "HYBRID"
    event_driven = "EVENT_DRIVEN"

    @doc value "selects how the Arc runtime loop schedules execution."
}

TaskConfig struct extends task.BasePersistConfig {
    arc_key        Key           {
        @doc value "is the key of the Arc module the task executes."
    }
    hash           string = "" {
        @doc value "is the semantic hash of the Arc module at deploy time."
    }
    execution_mode ExecutionMode = auto {
        @doc value "overrides the runtime's automatic loop mode selection."
    }
    rt_priority    int32 = 47 {
        @doc value "is the thread priority used by real-time loop modes."
    }
    cpu_affinity   int32 = -1 {
        @doc value "pins the loop to a CPU core. -1 selects automatically."
    }
    lock_memory    bool = false {
        @doc value "locks the runtime's memory to prevent paging."
    }

    @doc value  "configures an Arc task, which runs a compiled Arc module."
    @go marshal
    @go migrate
}
