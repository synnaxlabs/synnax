import "schemas/arc/versions/graph/v1"
import "schemas/arc/versions/ir/v1"
import "schemas/arc/versions/text/v1"
import "schemas/synnax/versions/status/v1"
import "schemas/x/versions/crdt/v0"
import "schemas/x/versions/spatial/v0"

Key = v0.Key

Mode = v0.Mode

StatusDetails struct {
    running bool {
        @doc value "indicates whether the Arc module is currently executing."
    }

    @go pinned
}

Status = status.Status<StatusDetails> {
    @go pinned
}

Arc struct {
    key   Key = create {
        @doc value "is the unique identifier for this module."
        @key
    }
    name  string      {
        @doc value "is a human-readable name for the module."
    }
    mode  Mode        {
        @doc value """specifies the representation mode for this module.
Either "text" for text-based Arc code or "graph" for visual dataflow."""
    }
    graph graph.Graph = {} {
        @doc value "is the visual dataflow graph representation of the module."
    }
    text  text.Text = {} {
        @doc value "is the text-based Arc source code."
    }

    action Rename {
        name string

        @doc value "renames the Arc module."
    }

    action SetNode {
        node graph.Node

        @doc value """inserts the node if no node with the same key exists, otherwise
replaces the existing node in place. Operates only on the node's
position; the node's function type and inputs are set separately
via SetNodeInputs."""
    }

    action SetNodePosition {
        key      string
        position spatial.XY

        @doc value "moves a graph node to a new canvas position."
    }

    action SetNodeInputs {
        key    string
        inputs record

        @doc value """merges the given inputs into the entry for the given key in the
graph inputs map. Top-level fields present in the payload overwrite
existing fields; fields absent from the payload are preserved. The
node's function type is held under "type"."""
    }

    action RemoveNode {
        key string

        @doc value """removes the node with the given key along with its inputs entry and
any edges connected to it."""
    }

    action AddEdge {
        edge graph.Edge

        @doc value """appends the edge to the graph. No-op when an edge with the same
source and target handles already exists, so concurrent additions of
the same connection converge regardless of differing keys."""
    }

    action RemoveEdge {
        key string

        @doc value "removes the edge with the given key, if present."
    }

    action ReconnectEdge {
        key    string
        source ir.Handle
        target ir.Handle

        @doc value """rewrites the endpoints of the edge with the given key, preserving its
key and kind. No-op when no edge with the key exists."""
    }

    action InsertChar {
        id     crdt.ID           {
            @doc value "is the identity of the inserted character."
        }
        origin crdt.ID           {
            @doc value """is the existing character this one anchors to. The root sentinel anchors to
the start of the document."""
        }
        side   spatial.XLocation {
            @doc value """is the side of origin the character anchors to: left places it immediately
before the origin, right immediately after."""
        }
        char   int32             {
            @doc value "is the inserted Unicode code point."
        }

        @doc value """carries a single collaborative-edit character insertion against the
module's text. The payload is a sequence CRDT operation; the server relays
it to the other editors of the module without interpreting it."""
    }

    action DeleteChar {
        id crdt.ID {
            @doc value "is the identity of the character to tombstone."
        }

        @doc value """carries a single collaborative-edit character deletion against the module's
text. The payload is a sequence CRDT operation; the server relays it to the
other editors of the module without interpreting it."""
    }

    action ForgetChars {
        ids crdt.ID[]

        @doc value """removes the given already-deleted characters from the module's text document,
dropping both their insert and delete operations from the replicated op-log.
The server emits it after a quiet editing period to reclaim the space held by
tombstoned characters. Because the characters are already deleted, and thus
invisible, applying it never changes the materialized text."""
    }

    @go migrate
    @go marshal
}
