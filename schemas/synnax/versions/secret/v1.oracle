import "schemas/synnax/versions/rack/v3"

Key = v0.Key

Source = v0.Source

Base = v0.Base

Secret union on source Source extends v0.Secret {
    file {
        file_name
        rack      rack.Key {
            @doc value "is the rack that reads the file."
        }
    }
}
