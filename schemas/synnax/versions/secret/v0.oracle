import "schemas/synnax/versions/resource/v0"
import "schemas/x/versions/telem/v0"

Key = uuid {
    @doc value "is a unique identifier for a secret."
}

Source enum {
    stored = "stored"
    file   = "file"

    @doc value "is where the value of a secret or certificate lives."
}

Base struct {
    key     Key = create {
        @doc value "is the unique identifier for this secret."
        @key
    }
    name    string          {
        @doc value "is a human-readable name for the secret."
    }
    updated telem.TimeStamp {
        @doc value "is when the value or file name of the secret last changed."
    }
    uses    resource.ID[]?  {
        @doc value  """
            are the resources that use the secret and that the caller can read, filled
            only when a retrieve request asks for them.
        """
        @go marshal omit
    }

    @doc value  "carries the fields shared by every secret."
    @go marshal
}

Secret union on source Source extends Base {
    stored {
        value bytes {
            @doc value "is the value, encrypted with AES-256-GCM under the data key."
            @go wire   omit
        }

        @doc value "is a secret whose value the Core stores."
    }
    file {
        file_name string {
            @doc value "is the name of the file in the secrets folder of the rack."
        }

        @doc value """
            is a secret whose value is a file in the secrets folder that an admin sets
            on the rack that uses it.
        """
    }

    @doc value  """
        is a hidden value that a device or task uses to connect, such as a password, a
        token, an API key, or a private key. Only the program that connects reads it.
    """
    @go marshal
    @go migrate
}
