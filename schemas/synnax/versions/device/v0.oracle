import "schemas/synnax/versions/ontology/v0"
import "schemas/synnax/versions/rack/v0"
import "schemas/synnax/versions/status/v0"

Key = string {
    @doc value "is the device's serial number, used as its unique identifier."
    @go hand
}

StatusDetails struct {
    rack   rack.Key {
        @doc value "is the key of the rack this device belongs to."
    }
    device Key      {
        @doc value "is the device identifier."
    }

    @doc value  """contains device-specific status details identifying the device and
its associated rack."""
    @go hand
}

Status = status.Status<StatusDetails> {
    @doc value """is device-specific status information including operational state
and device identification."""
    @go hand
}

Device struct {
    key        Key      {
        @doc value "is the unique identifier for this device."
        @key
    }
    rack       rack.Key {
        @doc value "is the key of the rack that owns this device."
    }
    location   string   {
        @doc value "is the physical location or address of the device."
    }
    make       string   {
        @doc value """is the manufacturer of the device (e.g., 'LabJack', 'National
Instruments')."""
    }
    model      string   {
        @doc value "is the device model identifier."
    }
    name       string   {
        @doc value "is a human-readable name for the device."
    }
    configured bool = false {
        @doc value """indicates whether the device has been successfully configured
and is ready for use."""
    }
    properties record   {
        @doc value """contains device-specific configuration properties stored as JSON.
Structure varies by device make and model."""
    }
    status     Status?  {
        @doc value "is the current operational status of the device."
    }
    parent     ontology.ID? {
        @doc value """is an optional parent resource ID for hierarchical device
organization (e.g., NI chassis containing modules)."""
    }

    @doc value  """is a physical piece of hardware connected to Synnax through the
Driver system. Devices represent external equipment like LabJack, National
Instruments, OPC UA servers, or Modbus devices."""
    @go marshal
    @go migrate
    @go hand
}
