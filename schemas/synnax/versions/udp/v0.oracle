import "schemas/synnax/versions/bus/v0"

Properties struct {
    port            uint16 = 0 {
        @doc value "is the local port the task binds to."
    }
    remote_host     string = "" {
        @doc value """
            is the host that writes and queries are sent to. Empty when the task only
            receives.
        """
    }
    remote_port     uint16 = 0 {
        @doc value "is the port that writes and queries are sent to."
    }
    multicast_group string = "" {
        @doc value "is the multicast group the task joins. Empty for unicast."
    }

    @doc value  "are the properties of a UDP device."
    @go marshal
}

ReadConfig struct extends bus.ReadConfig, bus.PollConfig {
    @doc value  "configures a UDP read task. Each datagram is one frame."
    @go marshal
    @go migrate
}

WriteConfig struct extends bus.WriteConfig {
    @doc value  "configures a UDP write task. Each message is sent as one datagram."
    @go marshal
    @go migrate
}
