import "schemas/synnax/versions/group/v1"
import "schemas/synnax/versions/role/v0"

Key = v0.Key

Status = v2.Status

Rack struct extends v2.Rack {
    group group.Key? {
        @doc value "is the group the rack sits in, if any."
    }
    roles role.Key[] = [] {
        @doc value "are the roles that grant the rack its permissions."
    }
}
