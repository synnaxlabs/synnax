Key = v0.Key

StatusDetails = v0.StatusDetails

Status = v1.Status

Rack struct extends v2.Rack {
    version string? {
        @doc value """
            is the version of the Driver that runs the rack, written at each connect.
            Absent until a Driver reports it.
        """
    }
}
