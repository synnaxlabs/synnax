import "schemas/synnax/versions/group/v1"
import "schemas/synnax/versions/role/v0"
import "schemas/synnax/versions/status/v2"

Key = v0.Key

StatusDetails struct {
    running bool = false {
        @doc value "is true when the status comes from a running Driver."
    }

    @doc value "contains rack-specific status details."
}

Status = status.Status<StatusDetails>

Rack struct extends v2.Rack {
    version string?    {
        @doc value """
            is the version of the Driver that runs the rack, written at each connect.
            Absent until a Driver reports it.
        """
    }
    group   group.Key? {
        @doc value "is the group the rack sits in, if any."
    }
    role    role.Key   {
        @doc value "is the role that grants the rack its permissions."
    }
}
