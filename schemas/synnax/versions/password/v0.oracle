import "schemas/synnax/versions/ontology/v0"
import "schemas/x/versions/telem/v0"

Key = uuid {
    @doc value "is a unique identifier for a stored password."
}

Password struct {
    key      Key = create {
        @doc value "is the unique identifier for this password."
        @key
    }
    subject  ontology.ID     {
        @doc value "is the user the password belongs to."
    }
    username string          {
        @doc value "is the unique login name presented with the password."
    }
    hash     bytes           {
        @doc value "is the password hash, tagged with the algorithm that made it."
    }
    created  telem.TimeStamp {
        @doc value "is when the password was set."
    }

    @doc value  "is a stored password. A subject holds at most one."
    @go marshal
    @go migrate
}
