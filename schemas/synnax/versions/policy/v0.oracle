import "schemas/synnax/versions/access/v0"
import "schemas/synnax/versions/ontology/v0"

Key = uuid {
    @doc value "is a unique identifier for a policy, represented as a UUID."
}

Policy struct {
    subjects ontology.ID[]
    objects  ontology.ID[]
    actions  access.Action[]
    key      Key             {
        @key
    }

    @doc value  """
        represents the old policy format with a subjects field that associated policies
        directly with users. Used only for reading legacy data during migration.
    """
    @go migrate
}
