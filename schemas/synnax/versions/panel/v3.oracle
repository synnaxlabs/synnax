import "schemas/synnax/resource"
import "schemas/synnax/versions/group/v1"
import "schemas/synnax/versions/project/v3"
import "schemas/synnax/versions/ranger/v1"
import "schemas/x/versions/color/v1"

TabKey = v0.TabKey

TabBase = v0.TabBase

View = v1.View

Tab = v1.Tab

Node = v1.Node

Key = v0.Key

Panel struct extends v2.Panel {
    -parent
    group   group.Key?   {
        @doc value "is the group the panel sits in, if any."
    }
    project project.Key? {
        @doc value """
            is the project that owns the panel, if any. Exactly one of project and range
            is set.
        """
    }
    range   ranger.Key?  {
        @doc value """
            is the range that owns the panel, if any. Exactly one of project and range
            is set.
        """
    }
}
