import "schemas/synnax/versions/ontology/v0"
import "schemas/x/versions/spatial/v0"

TabKey = uuid

TabBase struct {
    key TabKey = create {
        @doc value """
            is the stable unique identifier of this tab within the panel. It is
            independent of the tab's content, so a tab's content may be swapped without
            changing the tab's identity or position.
        """
    }

    @doc value  "carries the identity shared by every tab variant."
    @go marshal
}

View struct {
    type string {
        @doc value """
            is the Console-owned view type identifier (e.g., 'docs', 'selector') used to
            select a renderer.
        """
    }
    args record = {} {
        @doc value """
            is an opaque, Console-owned configuration payload for the view. Core never
            interprets it; it round-trips as-is.
        """
    }

    @doc value  """
        is an inline, self-describing view: a Console-owned type plus an opaque
        configuration payload, with no backing core document. Used for app-views and
        tools (docs, explorers, task forms, and the selector pickers).
    """
    @go marshal
}

Tab union on variant extends TabBase {
    resource {
        resource ontology.ID {
            @doc value """
                is the visualization resource displayed by this tab, set via
                SetTabResource.
            """
        }

        @doc value "is a tab displaying a backing core document."
    }
    view View {
        @doc value """
            is a tab displaying an inline, self-describing view. Unlike a resource, a
            view has no backing core document: it carries its own type and opaque args.
            Used for app-views and tools (docs, explorers, task forms, and the selector
            pickers).
        """
    }

    @doc value  """
        is a single tab in a leaf. Tab content is a discriminated union: a resource (a
        backing core document, e.g. a line plot) or a view (an inline, self-describing
        app-view, e.g. docs). A freshly created tab is a view whose type is a selector
        picker; SetTabResource or SetTabView swaps content in place. Display attributes
        (name, icon, closability) are resolved at render time from the content. A
        resource may back at most one tab per panel; views may repeat.
    """
    @go marshal
}

Node union on variant {
    leaf {
        tabs Tab[] {
            @doc value "is the ordered list of tabs in this leaf."
        }

        @doc value "is a leaf node in the panel tree displaying a tab strip."
    }
    split {
        direction spatial.Direction {
            @doc value "is the axis along which this node is split."
        }
        size      spatial.Decimal   {
            @doc value """
                is the fraction in [0, 1] of the parent area allocated to first. The
                remainder is allocated to last.
            """
        }
        first     Node              {
            @doc value "is the first child (left for x, top for y)."
        }
        last      Node              {
            @doc value "is the second child (right for x, bottom for y)."
        }

        @doc value "is an interior split node dividing its area between two children."
    }

    @doc value  """
        is a node in the panel tree: either a leaf displaying a tab strip or an interior
        split. Nodes are identified by path-derived numeric keys during traversal (1 =
        root, 2k = first child, 2k+1 = last child).
    """
    @go marshal
}

Key = uuid {
    @doc value "is a unique identifier for a panel, represented as a UUID."
}

Panel struct {
    key    Key = create {
        @doc value "is the unique identifier for this panel."
        @key
    }
    name   string       {
        @doc value "is a human-readable name for the panel."
    }
    root   Node = { variant = "leaf", tabs = [] } {
        @doc value "is the root of the panel tree."
    }
    parent ontology.ID? {
        @doc value  """
            is the parent resource for the panel in the ontology, required on create.
            Parenthood lives in the ontology graph, so the field is not persisted on the
            panel record and is absent on retrieve.
        """
        @go marshal omit
    }

    @doc value  "is a project-owned tab holding a tree of visualization tabs."
    @go marshal
    @go migrate
}
