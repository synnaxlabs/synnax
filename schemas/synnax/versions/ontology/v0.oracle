import "schemas/synnax/versions/resource/v0"

RelationshipType string {
    @doc value "is the kind of link between two resources."
    @go hand
}

Resource struct {
    id   resource.ID {
        @doc value "is the unique identifier for this resource."
    }
    name string      {
        @doc value  "is a human-readable name for the resource."
        @go marshal omit
    }
    data record = {} {
        @doc value  "is optional metadata associated with the resource."
        @go marshal omit
    }

    @doc value  """
        is a resource in the ontology system with its identifier, name, and optional
        metadata.
    """
    @go hand
    @go marshal
}

Relationship struct {
    from resource.ID      {
        @doc value "is the source resource of the relationship."
    }
    type RelationshipType {
        @doc value "is the type of relationship (e.g., 'parent', 'labeled_by')."
    }
    to   resource.ID      {
        @doc value "is the target resource of the relationship."
    }

    @doc value  """
        is a directional relationship between two resources in the ontology system.
    """
    @go hand
    @go marshal
}
