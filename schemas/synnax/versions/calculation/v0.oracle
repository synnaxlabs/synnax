import "schemas/synnax/versions/channel/v2"
import "schemas/synnax/versions/status/v2"
import "schemas/x/versions/telem/v0"

Key = uuid {
    @doc value "is the key of a calculation."
}

Window struct {
    reset    channel.Key?   {
        @doc value """
            is the channel whose samples reset the window. When absent, only the
            duration resets it.
        """
    }
    duration telem.TimeSpan = 0 {
        @doc value """
            is the interval at which the window resets. Zero resets it on no timer.
        """
    }

    @doc value  "is the span of samples that a windowed operation aggregates."
    @go marshal
}

Operation union on type {
    min extends Window {
        @doc value "keeps the lowest sample of the window."
    }
    max extends Window {
        @doc value "keeps the highest sample of the window."
    }
    avg extends Window {
        @doc value "keeps the mean of the samples of the window."
    }
    derivative {
        @doc value "computes the rate of change of the samples."
    }

    @doc value  "is an operation that a calculation applies to the samples it computes."
    @go marshal
}

Status = status.Status<nil> {
    @doc value "is the status of a calculation."
}

Calculation struct {
    key        Key = create {
        @doc value "is the key of the calculation."
        @key
    }
    output     channel.Key   {
        @doc value """
            is the channel that the calculation writes. A channel holds at most one
            calculation, and a delete of the channel deletes it.
        """
    }
    expression string        {
        @doc value "is the Arc expression that computes each output sample."
    }
    operations Operation[] = [] {
        @doc value "are the operations applied to the computed samples, in order."
    }
    primary    channel.Key?  {
        @doc value """
            is the channel that the expression reads whose samples time the output.
        """
    }
    reads      channel.Key[] = [] {
        @doc value """
            are the channels that the expression reads, as its last compile that
            succeeded found them.
        """
    }
    status     Status?       {
        @doc value  "is the status of the calculation, joined on retrieve."
        @go marshal omit
    }

    @doc value  """
        computes the samples of its output channel from an Arc expression over other
        channels. It has no name or folder of its own: both are those of its output.
    """
    @go marshal
    @go migrate
}
