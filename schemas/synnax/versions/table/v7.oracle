import "schemas/synnax/versions/channel/v0"
import "schemas/synnax/versions/color/v0"
import "schemas/synnax/versions/group/v1"
import "schemas/synnax/versions/project/v3"
import "schemas/synnax/versions/ranger/v1"
import "schemas/x/versions/color/v2"
import "schemas/x/versions/notation/v0"
import "schemas/x/versions/text/v0"

Key = v0.Key

FlexAlignment = v2.FlexAlignment

CellConfig union on variant extends v6.CellConfig {
    text {
        fill_color color.Ref? {
            @doc value """
                is the background color of the cell, a named color or a fixed color.
                When absent the theme picks the fill; a fully transparent value paints
                nothing.
            """
        }
        text_color color.Ref? {
            @doc value """
                is the color of the cell text, a named color or a fixed color. When
                absent the theme picks the color.
            """
        }
    }
    value {
        fill_color      color.Ref? {
            @doc value """
                is the fill behind the value where no redline band paints, a named color
                or a fixed color. When absent the cell paints no fill.
            """
        }
        text_color      color.Ref? {
            @doc value """
                is the color of the displayed text, a named color or a fixed color. When
                absent the value renders with a theme-derived legible color.
            """
        }
        staleness_color color.Ref? {
            @doc value """
                is the color applied when the value is stale, a named color or a fixed
                color. When absent the value renders with the theme warning color.
            """
        }
    }
}

Cell struct extends v6.Cell {}

Row struct extends v6.Row {}

Column = v3.Column

Table struct extends v6.Table {}
