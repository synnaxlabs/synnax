import "schemas/synnax/versions/resource/v0"

Key = v0.Key

Group struct extends v0.Group {
    name   {
        @validate required
    }
    scope  resource.Type {
        @doc value """
            is the type of resource the group's tree holds. It stays the same down a
            chain of groups.
        """
    }
    parent resource.ID?  {
        @doc value "is the group, project, or rack the group sits in, if any."
    }

    @doc value """
        is a named folder that holds records of the types its scope allows. A group sits
        in its parent, or at the top of its tree when it has none.
    """
}
