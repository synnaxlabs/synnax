WaveType = v2.WaveType

BaseAOChannel = v3.BaseAOChannel

CommandedAOChannel = v3.CommandedAOChannel

AOChannel union on type extends BaseAOChannel {
    ao_current extends MinMaxVal, CustomScale, CommandedAOChannel {
        @doc value "drives a current output."
    }
    ao_func_gen {
        wave_type WaveType = sine {
            @doc value "selects the waveform to generate."
        }
        frequency float64  {
            @doc value   "is the waveform frequency, in Hertz."
            @validate gt 0
        }
        amplitude float64 = 0 {
            @doc value "is the waveform amplitude."
        }
        offset    float64 = 0 {
            @doc value "is the waveform DC offset."
        }

        @doc value """
            generates a waveform from task start to task stop, with no commands.
        """
    }
    ao_voltage extends MinMaxVal, CustomScale, CommandedAOChannel {
        @doc value "drives a voltage output."
    }

    @doc value  """
        is a single NI analog output channel. The type field selects the output mode and
        the fields that accompany it.
    """
    @go marshal
}

