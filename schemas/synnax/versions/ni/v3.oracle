import "schemas/synnax/versions/channel/v0"
import "schemas/synnax/versions/device/v0"
import "schemas/synnax/versions/task/v2"

Units = v2.Units

AccelSensitivityUnits = v2.AccelSensitivityUnits

AccelChargeSensitivityUnits = v2.AccelChargeSensitivityUnits

AccelUnits = v2.AccelUnits

ForceUnits = v2.ForceUnits

ElectricalUnits = v2.ElectricalUnits

ExcitationSource = v2.ExcitationSource

TerminalConfig = v2.TerminalConfig

BridgeConfig = v2.BridgeConfig

ShuntResistorLocation = v2.ShuntResistorLocation

ForceSensitivityUnits = v2.ForceSensitivityUnits

PressureUnits = v2.PressureUnits

TorqueUnits = v2.TorqueUnits

ResistanceConfig = v2.ResistanceConfig

TemperatureUnits = v2.TemperatureUnits

RTDType = v2.RTDType

StrainConfig = v2.StrainConfig

ThermocoupleType = v2.ThermocoupleType

CJC union on source extends v2.CJC {
    chan {
        port uint32 = 0 {
            @doc value "is the port of the channel that measures the reference."
        }
    }
}

VelocityUnits = v2.VelocityUnits

VelocitySensitivityUnits = v2.VelocitySensitivityUnits

ChargeUnits = v2.ChargeUnits

Scale = v2.Scale

MinMaxVal = v2.MinMaxVal

Terminal = v2.Terminal

Sensitivity = v2.Sensitivity

CurrentExcitation = v2.CurrentExcitation

VoltageExcitation = v2.VoltageExcitation

Bridge = v2.Bridge

BridgePolynomial = v2.BridgePolynomial

Resistance = v2.Resistance

Table = v2.Table

TwoPointLin = v2.TwoPointLin

CustomScale = v2.CustomScale

BaseAIChannel struct extends v2.BaseAIChannel {
    port uint32 = 0 {
        @doc value "is the physical port the channel reads from."
    }
}

AIChannel union on type extends v2.AIChannel {}

CIEdge = v2.CIEdge

CIMeasMethod = v2.CIMeasMethod

CIFreqUnits = v2.CIFreqUnits

CITimeUnits = v2.CITimeUnits

CICountDirection = v2.CICountDirection

CIDecodingType = v2.CIDecodingType

CILinearVelocityUnits = v2.CILinearVelocityUnits

CIAngularVelocityUnits = v2.CIAngularVelocityUnits

CILinearPositionUnits = v2.CILinearPositionUnits

CIAngularPositionUnits = v2.CIAngularPositionUnits

ZIndexPhase = v2.ZIndexPhase

ZIndex = v2.ZIndex

BaseCIChannel struct extends v2.BaseCIChannel {
    port uint32 = 0 {
        @doc value "is the physical counter the channel uses."
    }
}

CIChannel union on type extends v2.CIChannel {
    ci_frequency {
        divisor uint32 = 4 {
            @doc value "is the counter divisor for large-range measurement."
        }
    }
    ci_edge_count {
        initial_count uint32 = 0 {
            @doc value "is the value the counter starts at."
        }
    }
    ci_period {
        divisor uint32 = 4 {
            @doc value "is the counter divisor for large-range measurement."
        }
    }
    ci_velocity_angular {
        pulses_per_rev uint32 = 24 {
            @doc value "is the number of encoder pulses per revolution."
        }
    }
    ci_position_angular {
        pulses_per_rev uint32 = 24 {
            @doc value "is the number of encoder pulses per revolution."
        }
    }
}

WaveType = v2.WaveType

BaseAOChannel struct extends v2.BaseAOChannel {
    -cmd_channel
    -state_channel
    -cmd_channel_name
    -state_channel_name
    port uint32 = 0 {
        @doc value "is the physical port the channel writes to."
    }
}

CommandedAOChannel struct {
    cmd_channel        channel.Key = 0 {
        @doc value "is the Synnax channel commands are read from."
    }
    state_channel      channel.Key = 0 {
        @doc value "is the Synnax channel the output state is written to."
    }
    cmd_channel_name   string = "" {
        @doc value "is the human-readable name of the command channel."
    }
    state_channel_name string = "" {
        @doc value "is the human-readable name of the state channel."
    }

    @doc value  "carries the command and state channels of a commanded analog output."
    @go marshal
}

AOChannel union on type extends BaseAOChannel {
    ao_current extends MinMaxVal, CustomScale, CommandedAOChannel {
        @doc value "drives a current output."
    }
    ao_func_gen {
        wave_type WaveType = sine {
            @doc value "selects the waveform to generate."
        }
        frequency float64 = 0 {
            @doc value "is the waveform frequency, in Hertz."
        }
        amplitude float64 = 0 {
            @doc value "is the waveform amplitude."
        }
        offset    float64 = 0 {
            @doc value "is the waveform DC offset."
        }

        @doc value """
            generates a waveform from task start to task stop, with no commands.
        """
    }
    ao_voltage extends MinMaxVal, CustomScale, CommandedAOChannel {
        @doc value "drives a voltage output."
    }

    @doc value  """
        is a single NI analog output channel. The type field selects the output mode and
        the fields that accompany it.
    """
    @go marshal
}

DIChannel struct extends v2.DIChannel {
    port uint32 = 0 {
        @doc value "is the physical port the channel reads from."
    }
    line uint8 = 0 {
        @doc value    "is the digital line within the port the channel reads from."
        @validate max 31
    }
}

DOChannel struct extends v2.DOChannel {
    port uint32 = 0 {
        @doc value "is the physical port the channel writes to."
    }
    line uint8 = 0 {
        @doc value    "is the digital line within the port the channel writes to."
        @validate max 31
    }
}

AnalogReadConfig struct extends v2.AnalogReadConfig {}

CounterReadConfig struct extends v2.CounterReadConfig {}

WriteConfig = v2.WriteConfig

AnalogWriteConfig struct extends v2.AnalogWriteConfig {}

DigitalReadConfig struct extends v2.DigitalReadConfig {}

DigitalWriteConfig struct extends v2.DigitalWriteConfig {}

ScanConfig struct extends v2.ScanConfig {
    -ignored_models
}
