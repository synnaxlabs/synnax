import "schemas/synnax/versions/color/v0"
import "schemas/synnax/versions/label/v0"
import "schemas/x/versions/color/v2"
import "schemas/x/versions/telem/v0"

Key = v0.Key

Range struct extends v3.Range {
    color color.Ref? {
        @doc value """
            is an optional display color for visual identification of the range in user
            interfaces, a named color or a fixed color.
        """
    }
}

