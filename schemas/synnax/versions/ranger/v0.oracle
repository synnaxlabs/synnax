import "schemas/x/versions/color/v0"
import "schemas/x/versions/telem/v0"

Key = uuid {
    @doc value "is a unique identifier for a range, represented as a UUID."
}

Range struct {
    key        Key             {
        @doc value "is the unique identifier for this range."
        @key
    }
    name       string          {
        @doc value "is a human-readable name for the range."
    }
    time_range telem.TimeRange {
        @doc value """is the temporal extent of the range, defining its start and end
timestamps."""
    }
    color      color.Color     {
        @doc value """is the display color for visual identification of the range in
user interfaces."""
    }

    @doc value  """is a user-defined region of time in the Synnax cluster. Ranges act as
a method for labeling and categorizing telemetry data within specific time
periods."""
    @go marshal
    @go migrate
}
