import "schemas/synnax/versions/label/v0"
import "schemas/x/versions/color/v0"
import "schemas/x/versions/filter/v0"
import "schemas/x/versions/telem/v0"

Key = v0.Key

Range struct {
    key        Key             {
        @doc value "is the unique identifier for this range."
        @key
    }
    name       string          {
        @doc value "is a human-readable name for the range."
    }
    time_range telem.TimeRange {
        @doc value """
            is the temporal extent of the range, defining its start and end timestamps.
        """
    }
    color      color.Color?    {
        @doc value """
            is an optional display color for visual identification of the range in user
            interfaces.
        """
    }
    labels     label.Key[] = [] {
        @doc value "are the keys of the labels attached to the range."
    }
    parent     Key?            {
        @doc value """
            is the key of the range this range is nested in. Empty for a top-level
            range.
        """
    }

    @go marshal
    @go migrate
}

Where filter Range {
    key
    name
    overlaps telem.TimeRange {
        @doc value "matches ranges whose time range overlaps the given range."
    }
    labels   label.Key[]     {
        @doc value "matches ranges that have any of the given labels."
    }
    parents  Key[]           {
        @doc value "matches the ranges nested in any of the given ranges."
    }

    @doc value  "is a filter that selects ranges."
    @go marshal
}

Ref = v1.Ref
