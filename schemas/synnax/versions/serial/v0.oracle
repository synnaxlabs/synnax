import "schemas/synnax/versions/device/v1"
import "schemas/synnax/versions/icd/v1"
import "schemas/synnax/versions/task/v2"

ReadConfig struct extends task.PersistConfig {
    device  device.Key = "" {
        @doc value "is the key of the serial device to read from."
    }
    entries icd.ReadEntry[] {
        @doc value "contains the devices on the port and the messages each one sends."
    }

    @doc value  """
        configures a serial read task, which reads the frames of a serial port as ICD
        messages and writes their fields to channels.
    """
    @go entry   "serial_read_config"
    @go imex    body
    @go marshal
    @go migrate
}

WriteConfig struct extends task.StartConfig {
    device  device.Key = "" {
        @doc value "is the key of the serial device to write to."
    }
    targets icd.WriteTarget[] {
        @doc value "contains the messages the task sends on the port."
    }

    @doc value  """
        configures a serial write task, which sends ICD messages on a serial port from
        the commands of channels.
    """
    @go entry   "serial_write_config"
    @go imex    body
    @go marshal
    @go migrate
}
