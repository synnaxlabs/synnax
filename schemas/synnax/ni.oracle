import "schemas/synnax/channel"
import "schemas/synnax/device"
import "schemas/synnax/ni_device"
import "schemas/synnax/task"
import "schemas/x/telem"

@cpp output "client/cpp/ni"
@go output  "core/pkg/service/ni"
@py output  "client/py/synnax/ni"
@ts output  "client/ts/src/ni"

Units enum {
    volts                     = "Volts" {
        @doc value "is volts."
    }
    amps                      = "Amps" {
        @doc value "is amperes."
    }
    deg_f                     = "DegF" {
        @doc value "is degrees Fahrenheit."
    }
    deg_c                     = "DegC" {
        @doc value "is degrees Celsius."
    }
    deg_r                     = "DegR" {
        @doc value "is degrees Rankine."
    }
    kelvins                   = "Kelvins" {
        @doc value "is kelvins."
    }
    strain                    = "Strain" {
        @doc value "is strain."
    }
    ohms                      = "Ohms" {
        @doc value "is ohms."
    }
    hz                        = "Hz" {
        @doc value "is hertz."
    }
    seconds                   = "Seconds" {
        @doc value "is seconds."
    }
    meters                    = "Meters" {
        @doc value "is meters."
    }
    inches                    = "Inches" {
        @doc value "is inches."
    }
    degrees                   = "Degrees" {
        @doc value "is degrees."
    }
    radians                   = "Radians" {
        @doc value "is radians."
    }
    g                         = "g" {
        @doc value "is acceleration in g."
    }
    meters_per_second_squared = "MetersPerSecondSquared" {
        @doc value "is meters per second squared."
    }
    newtons                   = "Newtons" {
        @doc value "is newtons."
    }
    pounds                    = "Pounds" {
        @doc value "is pounds."
    }
    kilogram_force            = "KilogramForce" {
        @doc value "is kilograms of force."
    }
    pounds_per_square_inch    = "PoundsPerSquareInch" {
        @doc value "is pounds per square inch."
    }
    bar                       = "Bar" {
        @doc value "is bar."
    }
    pascals                   = "Pascals" {
        @doc value "is pascals."
    }
    volts_per_volt            = "VoltsPerVolt" {
        @doc value "is volts per volt."
    }
    m_volts_per_volt          = "mVoltsPerVolt" {
        @doc value "is millivolts per volt."
    }
    newton_meters             = "NewtonMeters" {
        @doc value "is newton meters."
    }
    inch_pounds               = "InchPounds" {
        @doc value "is inch-pounds."
    }
    inch_ounces               = "InchOunces" {
        @doc value "is inch-ounces."
    }
    foot_pounds               = "FootPounds" {
        @doc value "is foot-pounds."
    }

    @doc value "enumerates the engineering units for NI analog channel values."
}

AccelSensitivityUnits enum {
    m_volts_per_g = "mVoltsPerG" {
        @doc value "is millivolts per g."
    }
    volts_per_g   = "VoltsPerG" {
        @doc value "is volts per g."
    }

    @doc value "are the units of an accelerometer's sensitivity rating."
}

AccelUnits enum {
    g                         = "g" {
        @doc value "is acceleration in g."
    }
    meters_per_second_squared = "MetersPerSecondSquared" {
        @doc value "is meters per second squared."
    }
    inches_per_second_squared = "InchesPerSecondSquared" {
        @doc value "is inches per second squared."
    }

    @doc value "are the engineering units for an acceleration measurement."
}

ForceUnits enum {
    newtons        = "Newtons" {
        @doc value "is newtons."
    }
    pounds         = "Pounds" {
        @doc value "is pounds."
    }
    kilogram_force = "KilogramForce" {
        @doc value "is kilograms of force."
    }

    @doc value "are the engineering units for a force measurement."
}

ElectricalUnits enum {
    m_volts_per_volt = "mVoltsPerVolt" {
        @doc value "is millivolts per volt."
    }
    volts_per_volt   = "VoltsPerVolt" {
        @doc value "is volts per volt."
    }

    @doc value "are the electrical output units of a bridge-based sensor."
}

ExcitationSource enum {
    internal = "Internal" {
        @doc value "is an internal excitation source."
    }
    external = "External" {
        @doc value "is an external excitation source."
    }
    none     = "None" {
        @doc value "uses no excitation."
    }

    @doc value "selects the source of a sensor's excitation signal."
}

BridgeConfig enum {
    full_bridge    = "FullBridge" {
        @doc value "is a full bridge."
    }
    half_bridge    = "HalfBridge" {
        @doc value "is a half bridge."
    }
    quarter_bridge = "QuarterBridge" {
        @doc value "is a quarter bridge."
    }

    @doc value "selects the physical bridge wiring of a bridge-based sensor."
}

ShuntResistorLocation enum {
    default  = "Default" {
        @doc value "uses the default location."
    }
    internal = "Internal" {
        @doc value "uses an internal shunt resistor."
    }
    external = "External" {
        @doc value "uses an external shunt resistor."
    }

    @doc value """
        selects where the shunt resistor used for current measurement is located.
    """
}

ForceSensitivityUnits enum {
    m_volts_per_newton = "mVoltsPerNewton" {
        @doc value "is millivolts per newton."
    }
    m_volts_per_pound  = "mVoltsPerPound" {
        @doc value "is millivolts per pound."
    }

    @doc value "are the units of a force IEPE sensor's sensitivity rating."
}

PressureUnits enum {
    pounds_per_square_inch = "PoundsPerSquareInch" {
        @doc value "is pounds per square inch."
    }
    pascals                = "Pascals" {
        @doc value "is pascals."
    }
    bar                    = "Bar" {
        @doc value "is bar."
    }

    @doc value "are the engineering units for a pressure measurement."
}

TorqueUnits enum {
    newton_meters = "NewtonMeters" {
        @doc value "is newton meters."
    }
    inch_ounces   = "InchOunces" {
        @doc value "is inch-ounces."
    }
    inch_pounds   = "InchPounds" {
        @doc value "is inch-pounds."
    }
    foot_pounds   = "FootPounds" {
        @doc value "is foot-pounds."
    }

    @doc value "are the engineering units for a torque measurement."
}

ResistanceConfig enum {
    wire_2 = "2Wire" {
        @doc value "uses two wires."
    }
    wire_3 = "3Wire" {
        @doc value "uses three wires."
    }
    wire_4 = "4Wire" {
        @doc value "uses four wires."
    }

    @doc value "selects the number of wires used for a resistance measurement."
}

TemperatureUnits enum {
    deg_c   = "DegC" {
        @doc value "is degrees Celsius."
    }
    deg_f   = "DegF" {
        @doc value "is degrees Fahrenheit."
    }
    kelvins = "Kelvins" {
        @doc value "is kelvins."
    }
    deg_r   = "DegR" {
        @doc value "is degrees Rankine."
    }

    @doc value "are the engineering units for a temperature measurement."
}

RTDType enum {
    pt_3750 = "Pt3750" {
        @doc value "is a low-cost platinum RTD with a coefficient of 0.00375."
    }
    pt_3851 = "Pt3851" {
        @doc value "is an IEC 60751 platinum RTD with a coefficient of 0.003851."
    }
    pt_3911 = "Pt3911" {
        @doc value "is a platinum RTD with a coefficient of 0.003911."
    }
    pt_3916 = "Pt3916" {
        @doc value "is a JISC 1604 platinum RTD with a coefficient of 0.003916."
    }
    pt_3920 = "Pt3920" {
        @doc value "is a D-100 platinum RTD with a coefficient of 0.00392."
    }
    pt_3928 = "Pt3928" {
        @doc value "is an ITS-90 platinum RTD with a coefficient of 0.003928."
    }

    @doc value "selects the resistance-temperature curve of an RTD sensor."
}

StrainConfig enum {
    full_bridge_i     = "FullBridgeI" {
        @doc value "measures bending strain with four active gauges."
    }
    full_bridge_ii    = "FullBridgeII" {
        @doc value "measures bending strain with two Poisson gauges of four."
    }
    full_bridge_iii   = "FullBridgeIII" {
        @doc value "measures axial strain with two Poisson gauges of four."
    }
    half_bridge_i     = "HalfBridgeI" {
        @doc value "measures axial or bending strain with one Poisson gauge."
    }
    half_bridge_ii    = "HalfBridgeII" {
        @doc value "measures bending strain with tension and compression gauges."
    }
    quarter_bridge_i  = "QuarterBridgeI" {
        @doc value "measures axial or bending strain with one active gauge."
    }
    quarter_bridge_ii = "QuarterBridgeII" {
        @doc value "pairs one active gauge with a dummy gauge for temperature."
    }

    @doc value "selects the strain-gauge bridge configuration."
}

ThermocoupleType enum {
    j = "J" {
        @doc value "pairs iron with copper-nickel."
    }
    k = "K" {
        @doc value "pairs nickel-chromium with nickel-aluminum."
    }
    n = "N" {
        @doc value "pairs nickel-chromium-silicon with nickel-silicon-magnesium."
    }
    r = "R" {
        @doc value "pairs platinum-13% rhodium with platinum."
    }
    s = "S" {
        @doc value "pairs platinum-10% rhodium with platinum."
    }
    t = "T" {
        @doc value "pairs copper with copper-nickel."
    }
    b = "B" {
        @doc value "pairs platinum-30% rhodium with platinum-6% rhodium."
    }
    e = "E" {
        @doc value "pairs nickel-chromium with copper-nickel."
    }

    @doc value "selects the thermocouple alloy type."
}

CJC union on source {
    built_in {
        @doc value "reads the reference temperature from the device's own sensor."
    }
    const_val {
        val float64 = 0 {
            @doc value "is the reference temperature, in the channel's units."
        }

        @doc value "uses a fixed reference temperature."
    }
    chan {
        port uint16 = 0 {
            @doc value "is the port of the channel that measures the reference."
        }

        @doc value "reads the reference temperature from another channel."
    }

    @doc value  """
        is the cold-junction compensation for a thermocouple. The source selects where
        the reference temperature comes from.
    """
    @go marshal
}

VelocityUnits enum {
    meters_per_second = "MetersPerSecond" {
        @doc value "is meters per second."
    }
    inches_per_second = "InchesPerSecond" {
        @doc value "is inches per second."
    }

    @doc value "are the engineering units for a velocity measurement."
}

VelocitySensitivityUnits enum {
    m_volts_per_mm_per_second   = "MillivoltsPerMillimeterPerSecond" {
        @doc value "is millivolts per millimeter per second."
    }
    m_volts_per_inch_per_second = "MilliVoltsPerInchPerSecond" {
        @doc value "is millivolts per inch per second."
    }

    @doc value "are the units of a velocity IEPE sensor's sensitivity rating."
}

ChargeUnits enum {
    coulombs      = "Coulombs" {
        @doc value "is coulombs."
    }
    pico_coulombs = "PicoCoulombs" {
        @doc value "is picocoulombs."
    }

    @doc value "are the units of a charge measurement."
}

Scale union on type {
    linear {
        slope            float64 = 1 {
            @doc value "is the multiplier applied to the raw value."
        }
        y_intercept      float64 = 0 {
            @doc value "is the offset added after scaling."
        }
        pre_scaled_units Units = volts {
            @doc value "are the units of the raw value before scaling."
        }
        scaled_units     string = "Volts" {
            @doc value "are the units of the value after scaling."
        }

        @doc value "maps raw values to engineering units with a slope and intercept."
    }
    map {
        pre_scaled_min   float64 = 0 {
            @default group "pre_scaled"
            @doc value     "is the lower bound of the raw input range."
        }
        pre_scaled_max   float64 = 1 {
            @default group "pre_scaled"
            @doc value     "is the upper bound of the raw input range."
        }
        scaled_min       float64 = 0 {
            @default group "scaled"
            @doc value     "is the lower bound of the scaled output range."
        }
        scaled_max       float64 = 1 {
            @default group "scaled"
            @doc value     "is the upper bound of the scaled output range."
        }
        pre_scaled_units Units = volts {
            @doc value "are the units of the raw value before scaling."
        }
        scaled_units     string = "Volts" {
            @doc value "are the units of the value after scaling."
        }

        @doc value "maps a raw range linearly onto a scaled range."
    }
    table {
        pre_scaled_vals  float64[] = [] {
            @doc value "are the raw breakpoints, monotonically increasing."
        }
        scaled_vals      float64[] = [] {
            @doc value "are the engineering-unit values at each breakpoint."
        }
        pre_scaled_units Units = volts {
            @doc value "are the units of the raw values before scaling."
        }
        scaled_units     string = "Volts" {
            @doc value "are the units of the values after scaling."
        }

        @doc value "maps raw values to engineering units via a lookup table."
    }
    polynomial {
        forward_coeffs   float64[] = [] {
            @doc value "are the coefficients mapping pre-scaled to scaled values."
        }
        reverse_coeffs   float64[] = [] {
            @doc value "are the coefficients mapping scaled to pre-scaled values."
        }
        pre_scaled_units Units = volts {
            @doc value "are the units of the raw value before scaling."
        }
        scaled_units     string = "Volts" {
            @doc value "are the units of the value after scaling."
        }

        @doc value "maps raw values to engineering units with a polynomial."
    }
    none {
        @doc value "applies no scaling; the raw value is used directly."
    }

    @doc value  "determines how raw sensor values are transformed to engineering units."
    @go marshal
}

MinMaxVal struct {
    min_val float64 = 0 {
        @default group "range"
        @doc value     "is the minimum expected value, in scaled units."
    }
    max_val float64 = 1 {
        @default group "range"
        @doc value     "is the maximum expected value, in scaled units."
    }

    @doc value  "bounds the expected signal range in scaled units."
    @go marshal
}

Terminal struct {
    terminal_config ni_device.TerminalConfig = cfg_default {
        @doc value "selects the terminal configuration (RSE, NRSE, Diff, ...)."
    }

    @doc value  "configures the terminal wiring of an analog input channel."
    @go marshal
}

Sensitivity struct {
    sensitivity float64 = 0 {
        @doc value "is the sensor's sensitivity rating."
    }

    @doc value  "specifies a sensor's sensitivity rating."
    @go marshal
}

CurrentExcitation struct {
    current_excit_source ExcitationSource = internal {
        @doc value "selects the source of the current excitation signal."
    }
    current_excit_val    float64 = 0 {
        @doc value "is the current excitation level, in Amps."
    }

    @doc value  "configures the current excitation supplied to a sensor."
    @go marshal
}

VoltageExcitation struct {
    voltage_excit_source ExcitationSource = internal {
        @doc value "selects the source of the voltage excitation signal."
    }
    voltage_excit_val    float64 = 0 {
        @doc value "is the voltage excitation level, in Volts."
    }

    @doc value  "configures the voltage excitation supplied to a sensor."
    @go marshal
}

Bridge struct {
    bridge_config             BridgeConfig = full_bridge {
        @doc value "selects the physical bridge wiring."
    }
    nominal_bridge_resistance float64 = 1 {
        @doc value "is the nominal resistance of the bridge, in Ohms."
    }

    @doc value  "configures the wiring and nominal resistance of a bridge-based sensor."
    @go marshal
}

BridgePolynomial struct {
    forward_coeffs   float64[] = [] {
        @doc value "are the coefficients mapping electrical to physical values."
    }
    reverse_coeffs   float64[] = [] {
        @doc value "are the coefficients mapping physical to electrical values."
    }
    electrical_units ElectricalUnits = m_volts_per_volt {
        @doc value "are the electrical output units of the bridge."
    }

    @doc value  "scales bridge electrical output to physical units with a polynomial."
    @go marshal
}

Resistance struct {
    resistance_config ResistanceConfig = wire_2 {
        @doc value "selects the number of wires used for the resistance measurement."
    }

    @doc value  "configures the wiring of a resistance measurement."
    @go marshal
}

Table struct {
    electrical_vals  float64[] = [] {
        @doc value "are the electrical breakpoints of the calibration table."
    }
    electrical_units ElectricalUnits = m_volts_per_volt {
        @doc value "are the units of the electrical breakpoints."
    }
    physical_vals    float64[] = [] {
        @doc value """
            are the physical values corresponding to each electrical breakpoint.
        """
    }

    @doc value  "scales bridge electrical output to physical units with a lookup table."
    @go marshal
}

TwoPointLin struct {
    first_electrical_val  float64 = 0 {
        @default group "electrical"
        @doc value     "is the first electrical calibration point."
    }
    second_electrical_val float64 = 1 {
        @default group "electrical"
        @doc value     "is the second electrical calibration point."
    }
    electrical_units      ElectricalUnits = m_volts_per_volt {
        @doc value "are the units of the electrical calibration points."
    }
    first_physical_val    float64 = 0 {
        @default group "physical"
        @doc value     "is the physical value at the first electrical point."
    }
    second_physical_val   float64 = 1 {
        @default group "physical"
        @doc value     "is the physical value at the second electrical point."
    }

    @doc value  """
        scales bridge electrical output to physical units between two calibration
        points.
    """
    @go marshal
}

CustomScale struct {
    custom_scale Scale = none {
        @doc value "is the scale applied to the raw measurement."
    }

    @doc value  "applies a user-defined scale to the raw measurement."
    @go marshal
}

BaseAIChannel struct {
    key      string = create {
        @doc value "uniquely identifies the channel within the task."
        @key
    }
    name     string = "" {
        @doc value "is the human-readable channel name."
    }
    disabled bool = false {
        @doc value "is true when the channel is excluded from acquisition."
    }
    channel  channel.Key = 0 {
        @doc value     "is the Synnax channel that raw samples are written to."
        @ref kind      use
        @ref on_delete restrict
    }
    port     uint16 = 0 {
        @doc value "is the physical port the channel reads from."
    }
    device   device.Key = "" {
        @doc value     "is the key of the device the channel belongs to."
        @ref kind      use
        @ref on_delete restrict
    }

    @doc value  "carries the fields every NI analog input channel shares."
    @go marshal
}

AIChannel union on type extends BaseAIChannel {
    ai_voltage extends MinMaxVal, Terminal, CustomScale {
        @doc value "reads a voltage."
    }
    ai_accel extends MinMaxVal, Terminal, Sensitivity, CurrentExcitation, CustomScale {
        units             AccelUnits = g {
            @doc value "are the units of the acceleration measurement."
        }
        sensitivity_units AccelSensitivityUnits = m_volts_per_g {
            @doc value "are the units of the accelerometer sensitivity."
        }

        @doc value "reads acceleration from an accelerometer."
    }
    ai_bridge extends MinMaxVal, Bridge, VoltageExcitation, CustomScale {
        units ElectricalUnits = m_volts_per_volt {
            @doc value "are the electrical output units of the bridge."
        }

        @doc value "reads a generic bridge-based sensor."
    }
    ai_current extends MinMaxVal, Terminal, CustomScale {
        shunt_resistor_loc     ShuntResistorLocation = default {
            @doc value "selects where the shunt resistor is located."
        }
        ext_shunt_resistor_val float64 = 1 {
            @doc value "is the external shunt resistor value, in Ohms."
        }

        @doc value "reads a current."
    }
    ai_force_bridge_table extends MinMaxVal, Bridge, VoltageExcitation, Table, CustomScale {
        units          ForceUnits = newtons {
            @doc value "are the units of the force measurement."
        }
        physical_units ForceUnits = newtons {
            @doc value "are the physical units of the calibration table."
        }

        @doc value "reads force from a bridge with a calibration table."
    }
    ai_force_bridge_two_point_lin extends MinMaxVal, Bridge, VoltageExcitation, TwoPointLin, CustomScale {
        units          ForceUnits = newtons {
            @doc value "are the units of the force measurement."
        }
        physical_units ForceUnits = newtons {
            @doc value "are the physical units of the two-point calibration."
        }

        @doc value "reads force from a bridge with two-point linear calibration."
    }
    ai_force_iepe extends MinMaxVal, Terminal, Sensitivity, CurrentExcitation, CustomScale {
        units             ForceUnits = newtons {
            @doc value "are the units of the force measurement."
        }
        sensitivity_units ForceSensitivityUnits = m_volts_per_newton {
            @doc value "are the units of the IEPE sensor sensitivity."
        }

        @doc value "reads force from an IEPE sensor."
    }
    ai_microphone extends Terminal, CurrentExcitation, CustomScale {
        mic_sensitivity     float64 = 0 {
            @doc value "is the microphone sensitivity, in mV/Pa."
        }
        max_snd_press_level float64 = 0 {
            @doc value "is the maximum expected sound pressure level, in dB."
        }

        @doc value "reads sound pressure from a microphone."
    }
    ai_pressure_bridge_table extends MinMaxVal, Bridge, VoltageExcitation, Table, CustomScale {
        units          PressureUnits = pounds_per_square_inch {
            @doc value "are the units of the pressure measurement."
        }
        physical_units PressureUnits = pounds_per_square_inch {
            @doc value "are the physical units of the calibration table."
        }

        @doc value "reads pressure from a bridge with a calibration table."
    }
    ai_pressure_bridge_two_point_lin extends MinMaxVal, Bridge, VoltageExcitation, TwoPointLin, CustomScale {
        units          PressureUnits = pounds_per_square_inch {
            @doc value "are the units of the pressure measurement."
        }
        physical_units PressureUnits = pounds_per_square_inch {
            @doc value "are the physical units of the two-point calibration."
        }

        @doc value "reads pressure from a bridge with two-point linear calibration."
    }
    ai_resistance extends MinMaxVal, Resistance, CurrentExcitation, CustomScale {
        @doc value "reads a resistance."
    }
    ai_rtd extends MinMaxVal, Resistance, CurrentExcitation {
        units    TemperatureUnits = deg_c {
            @doc value "are the units of the temperature measurement."
        }
        rtd_type RTDType = pt_3750 {
            @doc value "selects the RTD resistance-temperature curve."
        }
        r0       float64 = 0 {
            @doc value "is the sensor resistance at 0 degrees Celsius, in Ohms."
        }

        @doc value "reads temperature from an RTD."
    }
    ai_strain_gauge extends MinMaxVal, VoltageExcitation, CustomScale {
        strain_config           StrainConfig = full_bridge_i {
            @doc value "selects the strain-gauge bridge configuration."
        }
        gage_factor             float64 = 0 {
            @doc value "is the gauge factor of the strain gauge."
        }
        initial_bridge_voltage  float64 = 0 {
            @doc value "is the bridge output voltage in the unloaded state."
        }
        nominal_gage_resistance float64 = 0 {
            @doc value "is the nominal gauge resistance, in Ohms."
        }
        poisson_ratio           float64 = 0 {
            @doc value "is the Poisson ratio of the measured material."
        }
        lead_wire_resistance    float64 = 0 {
            @doc value "is the resistance of the lead wires, in Ohms."
        }

        @doc value "reads strain from a strain gauge."
    }
    ai_temp_builtin {
        -port
        units TemperatureUnits = deg_c {
            @doc value "are the units of the temperature measurement."
        }

        @doc value "reads temperature from the device's built-in sensor."
    }
    ai_thermocouple extends MinMaxVal {
        units             TemperatureUnits = deg_c {
            @doc value "are the units of the temperature measurement."
        }
        thermocouple_type ThermocoupleType = j {
            @doc value "selects the thermocouple alloy type."
        }
        cjc               CJC = built_in {
            @doc value "is the cold-junction compensation applied to the reading."
        }

        @doc value "reads temperature from a thermocouple."
    }
    ai_torque_bridge_table extends MinMaxVal, Bridge, VoltageExcitation, Table, CustomScale {
        units          TorqueUnits = newton_meters {
            @doc value "are the units of the torque measurement."
        }
        physical_units TorqueUnits = newton_meters {
            @doc value "are the physical units of the calibration table."
        }

        @doc value "reads torque from a bridge with a calibration table."
    }
    ai_torque_bridge_two_point_lin extends MinMaxVal, Bridge, VoltageExcitation, TwoPointLin, CustomScale {
        units          TorqueUnits = newton_meters {
            @doc value "are the units of the torque measurement."
        }
