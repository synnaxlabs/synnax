        }

        @doc value "measures pulse width."
    }
    ci_semi_period extends CustomScale, MinMaxVal {
        min_val  float64 = 0.000001 {
            @default group "range"
            @doc value     "is the minimum expected semi-period, in the selected units."
        }
        max_val  float64 = 0.1 {
            @default group "range"
            @doc value     "is the maximum expected semi-period, in the selected units."
        }
        units    CITimeUnits = seconds {
            @doc value "are the units of the semi-period measurement."
        }
