            @default group "range"
            @doc value     "is the maximum expected frequency."
        }
        units       CIFreqUnits = hz {
            @doc value "are the units of the frequency measurement."
        }
        edge        CIEdge = rising {
            @doc value "selects the edge the counter responds to."
        }
        meas_method CIMeasMethod = dynamic_avg {
            @doc value "selects the measurement method."
        }
        meas_time   float64 = 0.000006 {
            @doc value """
                is the averaging window for high-frequency measurement, in seconds.
            """
        }
        divisor     uint32 = 4 {
            @doc value    "is the counter divisor for large-range measurement."
            @validate min 1
        }
        terminal    string = "" {
            @doc value "is the terminal the counter signal is wired to."
        }

