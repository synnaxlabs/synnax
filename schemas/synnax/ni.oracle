    }
    ci_edge_count {
        active_edge     CIEdge = rising {
            @doc value "selects the edge that increments the count."
        }
        count_direction CICountDirection = count_up {
            @doc value "selects the direction the counter counts."
        }
        initial_count   uint32 = 0 {
