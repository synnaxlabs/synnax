    ci_two_edge_sep extends CustomScale, MinMaxVal {
        min_val         float64 = 0.000001 {
            @default group "range"
            @doc value     "is the minimum expected separation, in the selected units."
        }
        max_val         float64 = 1 {
            @default group "range"
            @doc value     "is the maximum expected separation, in the selected units."
        }
        units           CITimeUnits = seconds {
            @doc value "are the units of the two-edge-separation measurement."
        }
        first_edge      CIEdge = rising {
            @doc value "selects the edge that starts the measurement."
        }
        second_edge     CIEdge = falling {
            @doc value "selects the edge that stops the measurement."
        }
        first_terminal  string = "" {
