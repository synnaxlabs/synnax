        }
        terminal      string = "" {
            @doc value "is the terminal the counter signal is wired to."
        }

        @doc value "measures signal period."
    }
    ci_pulse_width extends CustomScale, MinMaxVal {
        min_val       float64 = 0.000001 {
            @default group "range"
            @doc value     "is the minimum expected pulse width, in the selected units."
        }
        max_val       float64 = 0.1 {
            @default group "range"
            @doc value     "is the maximum expected pulse width, in the selected units."
        }
        units         CITimeUnits = seconds {
            @doc value "are the units of the pulse-width measurement."
        }
