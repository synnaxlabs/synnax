    ci_period extends CustomScale, MinMaxVal {
        min_val       float64 = 0.000001 {
            @default group "range"
            @doc value     "is the minimum expected period, in the selected units."
        }
        max_val       float64 = 0.1 {
            @default group "range"
            @doc value     "is the maximum expected period, in the selected units."
        }
        units         CITimeUnits = seconds {
            @doc value "are the units of the period measurement."
        }
        starting_edge CIEdge = rising {
            @doc value "selects the edge that starts a period measurement."
        }
        meas_method   CIMeasMethod = dynamic_avg {
            @doc value "selects the measurement method."
        }
        meas_time     float64 = 0.001 {
            @doc value """
                is the averaging window for high-frequency measurement, in seconds.
            """
        }
        divisor       uint32 = 4 {
            @doc value    "is the counter divisor for large-range measurement."
