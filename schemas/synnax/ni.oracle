    ci_duty_cycle extends CustomScale, MinMaxVal {
        min_val     float64 = 2 {
            @default group "range"
            @doc value     "is the minimum expected duty-cycle frequency."
        }
        max_val     float64 = 10000 {
            @default group "range"
            @doc value     "is the maximum expected duty-cycle frequency."
        }
        active_edge CIEdge = rising {
            @doc value "selects the edge the counter responds to."
        }
        terminal    string = "" {
