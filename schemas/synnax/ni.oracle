    @patch
}

AccelChargeSensitivityUnits enum {
    pico_coulombs_per_g                         = "PicoCoulombsPerG" {
        @doc value "is picocoulombs per g."
    }
    pico_coulombs_per_meters_per_second_squared = "PicoCoulombsPerMetersPerSecondSquared" {
        @doc value "is picocoulombs per meter per second squared."
    }
    pico_coulombs_per_inches_per_second_squared = "PicoCoulombsPerInchesPerSecondSquared" {
        @doc value "is picocoulombs per inch per second squared."
    }

    @doc value "are the units of a charge-mode accelerometer's sensitivity rating."
}

CommandedAOChannel struct {
    cmd_channel        channel.Key = 0 {
        @doc value     "is the Synnax channel commands are read from."
        @ref kind      use
        @ref on_delete restrict
    }
    state_channel      channel.Key = 0 {
        @doc value     "is the Synnax channel the output state is written to."
        @ref kind      use
        @ref on_delete restrict
    }
    cmd_channel_name   string = "" {
        @doc value "is the human-readable name of the command channel."
    }
    state_channel_name string = "" {
        @doc value "is the human-readable name of the state channel."
    }

    @doc value  "carries the command and state channels of a commanded analog output."
    @go marshal
}
