CIMeasMethod enum {
    low_freq_1_ctr  = "LowFreq1Ctr" {
        @doc value "uses one counter, for low frequency signals."
    }
    high_freq_2_ctr = "HighFreq2Ctr" {
        @doc value """
            uses two counters and a measurement time, for high frequency signals.
        """
    }
    large_rng_2_ctr = "LargeRng2Ctr" {
        @doc value "uses two counters and divides the input signal by a divisor."
