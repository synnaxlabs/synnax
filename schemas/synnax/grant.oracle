import "schemas/synnax/resource"
import "schemas/synnax/secret"
import "schemas/x/telem"

@go output "core/pkg/service/secret/grant"

Key = uuid {
    @doc value "is a unique identifier for a grant."
}

Grant struct {
    key        Key = create {
        @doc value "is the unique identifier for this grant."
        @key
    }
    subject    resource.ID     {
        @doc value "is the subject that may read the secrets."
    }
    secrets    secret.Key[]    {
        @doc value "are the secrets the subject may read."
    }
    expires_at telem.TimeStamp {
        @doc value "is when the grant stops working, if no read has used it."
    }

    @doc value  """
        lets a subject read secrets once, such as for a rack to test a connection before
        the device that uses them is saved.
    """
    @go marshal
    @go migrate
}
