import "schemas/synnax/auth"
import "schemas/synnax/ontology"
import "schemas/synnax/secret"

@go output "core/pkg/service/secret/grant"

Key = uuid {
    @doc value "is a unique identifier for a grant."
}

Grant struct {
    key     Key = create {
        @doc value "is the unique identifier for this grant."
        @key
    }
    rack    ontology.ID     {
        @doc value "is the rack that may read the secrets."
    }
    secrets secret.Key[]    {
        @doc value "are the secrets the rack may read."
    }
    session auth.SessionKey {
        @doc value    "is the session that created the grant. The grant ends with it."
        @filter
        @index lookup
    }

    @doc value  """
        lets a rack read secrets that nothing on the rack uses yet, such as to test a
        connection before the device that uses them is saved.
    """
    @go marshal
    @go migrate
    @retrieve
}
