import "schemas/synnax/ontology"
import "schemas/x/telem"

@go output "core/pkg/service/auth/apikey"

Key = uuid {
    @doc value "is a unique identifier for an API key."
}

APIKey struct {
    key     Key = create {
        @doc value "is the unique identifier for this API key."
        @key
    }
    subject ontology.ID     {
        @doc value    "is the user or rack the key logs in as."
        @filter
        @index lookup
    }
    hash    bytes           {
        @doc value "is the SHA-256 hash of the secret in the key."
    }
    name    string          {
        @doc value "is a label that tells the subject's keys apart."
    }
    created telem.TimeStamp {
        @doc value "is when the key was created."
    }

    @doc value  "is a stored API key. A subject holds any number of them."
    @go marshal
    @go migrate
    @retrieve
}
