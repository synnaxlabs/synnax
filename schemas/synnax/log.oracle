import "schemas/synnax/channel"
import "schemas/synnax/group"
import "schemas/synnax/project"
import "schemas/synnax/ranger"
import "schemas/x/color"
import "schemas/x/filter"
import "schemas/x/notation"
import "schemas/x/patch"
import "schemas/x/telem"

@go output "core/pkg/service/log"
@py output "client/py/synnax/log"
@ts output "client/ts/src/log"

Key = uuid {
    @doc value "is a unique identifier for a log, represented as a UUID."
}

TimestampConfig struct {
    format    telem.TimestampFormat {
        @doc value "is the format of the values of a timestamp channel."
    }
    time_zone telem.TimeZone        {
        @doc value "is the time zone of the values of a timestamp channel."
    }

    @doc value  "is how a timestamp channel shows its values."
    @go marshal
}

ChannelEntry struct {
    channel          channel.Key       {
        @doc value         "is the channel this entry references."
        @ref kind          use
        @ref on_delete     detach
        @validate required
    }
    color            color.Color       {
        @doc value "is the display color for the channel."
    }
    notation         notation.Notation = "standard" {
        @doc value "is the numeric notation used to render samples."
    }
    precision        uint8?            {
        @doc value    """
            is the number of digits after the decimal point, from 0 to 17. Absent shows
            each sample as it arrives.
        """
        @validate max 17
    }
    alias            string = "" {
        @doc value           """
            is a human-readable alias displayed in place of the channel name.
        """
        @validate max_length 64
    }
    timestamp_config TimestampConfig = { format = "preciseDate", time_zone = "local" } {
        @doc value """
            formats the values of a timestamp channel. It has no effect on line times.
        """
    }

    @doc value  "is a per-channel display configuration entry within a log."
    @go marshal
}

Log struct {
    key                  Key = create {
        @doc value "is the unique identifier for this log."
        @key
    }
    name                 string         {
        @doc value         "is a human-readable name for the log."
        @index sorted
        @search
        @validate required
    }
    channels             ChannelEntry[] = [] {
        @doc value "are the channels displayed in this log."
    }
    timestamp_precision  uint8 = 0 {
        @doc value    "is the precision of displayed timestamps (0-9)."
        @validate max 9
    }
    channel_names_hidden bool = false {
        @doc value "is true when channel names are hidden."
    }
    timestamps_hidden    bool = false {
        @doc value "is true when entry timestamps are hidden."
    }
    time_zone            telem.TimeZone = "local" {
        @doc value "is the time zone of the line times and day rows of the log."
    }
    group                group.Key?     {
        @doc value     "is the group the log sits in, if any."
        @group scope   project
        @ref kind      place
        @ref on_delete detach
    }
    project              project.Key?   {
        @doc value     """
            is the project that owns the log, if any. Exactly one of project and range
            is set.
        """
        @ref kind      place
        @ref on_delete cascade
    }
    range                ranger.Key?    {
        @doc value     """
            is the range that owns the log, if any. Exactly one of project and range is
            set.
        """
        @ref kind      place
        @ref on_delete cascade
    }

    action Create {
        log Log

        @doc value """
            replaces the document with the given created state. Emitted by the Core on
            create so remote caches ingest new documents; clients never dispatch it.
        """
    }

    action AddChannel {
        channel channel.Key

        @doc value """
            appends a default channel entry for the given channel. No-op when the
            channel is already present.
        """
    }

    action RemoveChannel {
        channel channel.Key

        @doc value """
            removes the channel entry for the given channel. No-op when the channel is
            not present.
        """
    }

    action SetChannelEntry {
        entry ChannelEntry

        @doc value """
            inserts the channel entry if no entry with the same channel exists,
            otherwise replaces the existing entry in place. The fine-grained setChannel*
            actions cover per-field edits; this full-object form inserts new entries and
            restores an entry dropped by reconciliation.
        """
    }

    action SetChannelColor {
        channel channel.Key
        color   color.Color

        @doc value """
            sets the display color of the entry identified by channel. The zero color
            resets it to the text color of the log. No-op when no entry references the
            channel.
        """
    }

    action SetChannelNotation {
        channel  channel.Key
        notation notation.Notation

        @doc value """
            sets the numeric notation of the entry identified by channel. No-op when no
            entry references the channel.
        """
    }

    action SetChannelPrecision {
        channel   channel.Key
        precision uint8?

        @doc value """
            sets the number of digits after the decimal point for the entry identified
            by channel. Absent clears it, so samples show as they arrive. No-op when no
            entry references the channel.
        """
    }

    action SetChannelAlias {
        channel channel.Key
        alias   string

        @doc value """
            sets the human-readable alias of the entry identified by channel. An empty
            alias falls back to the channel name. No-op when no entry references the
            channel.
        """
    }

    action SetChannelTimestampFormat {
        channel channel.Key
        format  telem.TimestampFormat

        @doc value """
            sets the format of the values of the timestamp channel identified by
            channel. No-op when no entry references the channel.
        """
    }

    action SetChannelTimestampTimeZone {
        channel   channel.Key
        time_zone telem.TimeZone

        @doc value """
            sets the time zone of the values of the timestamp channel identified by
            channel. No-op when no entry references the channel.
        """
    }

    action SwapChannel {
        from channel.Key
        to   channel.Key

        @doc value """
            repoints the entry referencing the "from" channel at the "to" channel in
            place, preserving the entry's position and display configuration. No-op when
            no entry references "from" or an entry already references "to".
        """
    }

    action SetTimestampPrecision {
        timestamp_precision uint8

        @doc value "sets the precision of displayed timestamps (0-9)."
    }

    action SetChannelNamesHidden {
        channel_names_hidden bool

        @doc value "sets whether channel names are hidden."
    }

    action SetTimestampsHidden {
        timestamps_hidden bool

        @doc value "sets whether entry timestamps are hidden."
    }

    action SetTimeZone {
        time_zone telem.TimeZone

        @doc value "sets the time zone of the line times and day rows of the log."
    }

    action Set = patch.Set {
        @doc value "replaces the value at a path in the log."
    }

    action Remove = patch.Remove {
        @doc value """
            removes an entry from a list or a field from an object in the log.
        """
    }

    action Insert = patch.Insert {
        @doc value "adds an entry to a list in the log."
    }

    action Move = patch.Move {
        @doc value "moves an entry in a list in the log."
    }

    @create
    @doc value     """
        is a visualization that shows the samples of its channels as text, one line per
        sample, in time order.
    """
    @go imex
    @go marshal
    @go migrate
    @resource type "log"
    @retrieve
}

Where filter Log {
    key
    groups   group.Key[]   {
        @doc value "matches the logs in any of the given groups."
    }
    grouped  bool          {
        @doc value "matches the logs in a group, or in no group when false."
    }
    projects project.Key[] {
        @doc value "matches the logs owned by any of the given projects."
    }
    ranges   ranger.Key[]  {
        @doc value "matches the logs owned by any of the given ranges."
    }

    @doc value         "is a filter that selects logs."
    @go request_output "core/pkg/api/log"
}
