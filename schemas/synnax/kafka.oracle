import "schemas/synnax/channel"
import "schemas/synnax/device"
import "schemas/synnax/http"
import "schemas/synnax/task"
import "schemas/x/payload"

@go output "core/pkg/service/kafka"
@py output "client/py/synnax/kafka"
@ts output "client/ts/src/kafka"

Credentials struct {
    username string = "" {
        @doc value "is the SASL username."
    }
    password string = "" {
        @doc value "is the SASL password."
    }

    @doc value "carries the username and password of a SASL mechanism."
}

SASL union on mechanism {
    none {
        @doc value "authenticates with no credentials."
    }
    plain extends Credentials {
        @doc value "authenticates with the PLAIN mechanism."
    }
    scram_sha_256 extends Credentials {
        @doc value "authenticates with the SCRAM-SHA-256 mechanism."
    }
    scram_sha_512 extends Credentials {
        @doc value "authenticates with the SCRAM-SHA-512 mechanism."
    }

    @doc value "selects the SASL mechanism and the credentials it carries."
}

Properties struct {
    brokers        string[] {
        @doc value "contains the bootstrap broker addresses, as host:port."
    }
    secure         bool = false {
        @doc value "is true when every broker connection uses TLS."
    }
    ca_certificate string = "" {
        @doc value """
            is the PEM-encoded certificate authority that signs the brokers'
            certificates. Empty trusts the system roots.
        """
    }
    sasl           SASL = none {
        @doc value "is the authentication the brokers require."
    }

    @doc value "configures the connection to a Kafka cluster device."
}

StartOffset enum {
    latest   = "latest" {
        @doc value "starts at the end of the topic and reads only new records."
    }
    earliest = "earliest" {
        @doc value "starts at the oldest record the topic retains."
    }
    none     = "none" {
        @doc value "fails the start."
    }

    @doc value """
        is where a consumer group with no committed offset starts reading a topic. none
        fails the start instead of guessing.
    """
}

RecordKey enum {
    none         = "none" {
        @doc value "writes records with no key."
    }
    channel_name = "channel_name" {
        @doc value "uses the name of the source channel as the key."
    }

    @doc value "is the source of the key placed on every record a write task produces."
}

ScanConfig struct extends task.ScanConfig {
    @doc value  "configures a Kafka scan task."
    @go imex    body
    @go marshal
    @go migrate
    @patch
}

BaseReadField struct {
    key      string = create {
        @doc value "uniquely identifies the field within the task."
        @key
    }
    disabled bool = false {
        @doc value "is true when the field is excluded from the task."
    }
    name     string = "" {
        @doc value "is the name given to the channel when the task creates it."
    }
    channel  channel.Key = 0 {
        @doc value     "is the Synnax channel the extracted value is written to."
        @ref kind      use
        @ref on_delete restrict
    }
    pointer  string = "" {
        @doc value "is the JSON Pointer to the value within the record value."
    }

    @doc value  "carries the fields every Kafka read field shares."
    @go marshal
}

ReadField union on type payload.Kind extends BaseReadField {
    float extends payload.FloatRead {
        @doc value "reads a number into a float channel."
    }
    integer extends payload.IntegerRead {
        @doc value "reads a number into a signed integer channel."
    }
    unsigned extends payload.UnsignedRead {
        @doc value "reads a number into an unsigned integer channel."
    }
    string extends payload.StringRead {
        @doc value "reads a string into a string channel."
    }
    boolean extends payload.BooleanRead {
        @doc value "reads a boolean into a boolean channel."
    }
    timestamp extends payload.TimestampRead {
        @doc value "reads a timestamp into a timestamp channel."
    }
    json {
        @doc value "reads any JSON value into a JSON channel."
    }
    uuid {
        @doc value "reads a UUID string into a UUID channel."
    }
    bytes {
        @doc value "reads a base64 string into a bytes channel."
    }

    @doc value  """
        is a single value extracted from a record's JSON value. The type is the kind of
        value the field reads.
    """
    @go marshal
}

ReadConfig struct extends task.PersistConfig {
    device       device.Key = "" {
        @doc value     "is the key of the Kafka cluster device to consume from."
        @ref kind      use
        @ref on_delete restrict
    }
    topic        string = "" {
        @doc value "is the topic the task consumes."
    }
    group        string = "" {
        @doc value """
            is the consumer group the task joins. Empty derives the group from the task
            key.
        """
    }
    start_offset StartOffset = latest {
        @doc value "is where the group starts when it has no committed offset."
    }
    records      ReadRecord[] {
        @doc value "contains the records the task reads, one per record key."
    }

    @doc value           """
        configures a Kafka read task, which consumes a topic and writes record fields
        into channels.
    """
    @go imex             body
    @go marshal
    @go migrate
    @patch
    @retrieve references
}

BaseWriteChannel struct {
    key      string = create {
        @doc value "uniquely identifies the channel within the task."
        @key
    }
    disabled bool = false {
        @doc value "is true when the channel is excluded from the task."
    }
    channel  channel.Key = 0 {
        @doc value     "is the Synnax channel whose samples are produced."
        @ref kind      use
        @ref on_delete restrict
    }

    @doc value  "carries the fields every Kafka write channel shares."
    @go marshal
}

Record struct {
    value_pointer     string = "/value" {
        @doc value "is the JSON Pointer where the sample value is placed."
    }
    channel_pointer   string?            {
        @doc value """
            is the JSON Pointer where the channel name is placed. Absent omits the name.
        """
    }
    timestamp_pointer string?            {
        @doc value """
            is the JSON Pointer where the sample timestamp is placed. Absent omits the
            timestamp.
        """
    }
    time_format       payload.TimeFormat = unix_ns {
        @doc value "is the encoding of the sample timestamp."
    }
    fields            http.WriteField[]  {
        @doc value "contains additional static or generated record fields."
    }

    @doc value  "is the shape of every record a write task produces."
    @go marshal
}

WriteConfig struct extends task.StartConfig {
    device     device.Key = "" {
        @doc value     "is the key of the Kafka cluster device to produce to."
        @ref kind      use
        @ref on_delete restrict
    }
    topic      string = "" {
        @doc value "is the topic the task produces to."
    }
    record_key RecordKey = channel_name {
        @doc value "is the source of the key placed on every record."
    }
    record     Record = {} {
        @doc value "is the shape of every record."
    }
    channels   WriteChannel[] {
        @doc value "contains the channels whose samples are produced."
    }

    @doc value           """
        configures a Kafka write task, which produces one record per sample of each
        channel to a topic.
    """
    @go imex             body
    @go marshal
    @go migrate
    @patch
    @retrieve references
}

ReadRecord struct {
    key        string = create {
        @doc value "uniquely identifies the record within the task."
        @key
    }
    record_key string = "" {
        @doc value """
            is the Kafka key of the records read here. Empty reads every record that no
            other record of the task claims, keyless ones included.
        """
    }
    index      string = "" {
        @doc value """
            is the key of the field whose channel indexes the others. Empty when the
            task stamps samples on arrival.
        """
    }
    fields     ReadField[] {
        @doc value "contains the values to extract from the record."
    }

    @doc value  "is a set of fields read from the records with one Kafka key."
    @go marshal
}

WriteChannel union on type payload.Kind extends BaseWriteChannel {
    float {
        enum_values payload.FloatEntry[] {
            @doc value "maps channel values to the labels written in their place."
        }

        @doc value "writes each sample as a JSON number."
    }
    integer {
        enum_values payload.IntegerEntry[] {
            @doc value "maps channel values to the labels written in their place."
        }

        @doc value "writes each sample as a JSON number."
    }
    unsigned {
        enum_values payload.UnsignedEntry[] {
            @doc value "maps channel values to the labels written in their place."
        }

        @doc value "writes each sample as a JSON number."
    }
    string {
        enum_values payload.StringEntry[] {
            @doc value "maps channel values to the labels written in their place."
        }

        @doc value "writes each sample as a JSON string."
    }
    boolean {
        enum_values payload.BooleanEntry[] {
            @doc value "maps channel values to the labels written in their place."
        }

        @doc value "writes each sample as a JSON boolean."
    }
    timestamp {
        time_format payload.TimeFormat {
            @doc value "is the encoding of each sample."
        }

        @doc value "writes each sample of a timestamp channel in a time format."
    }
    json {
        @doc value "writes each sample of a JSON channel as its JSON value."
    }
    uuid {
        @doc value "writes each sample of a UUID channel as a JSON string."
    }
    bytes {
        @doc value "writes each sample of a bytes channel as a base64 JSON string."
    }

    @doc value  """
        is a channel whose samples a write task produces as records. The type selects
        the JSON value of each sample. A sample that matches an entry of enum_values is
        written as the entry's label.
    """
    @go marshal
}
