import "schemas/synnax/user"

@ts output "client/ts/src/project"
@py output "client/py/synnax/project"
@go output "core/pkg/service/project"
@pb

Key = uuid {
    @doc value "is a unique identifier for a project, represented as a UUID."
}

Project struct {
    key    Key       {
        @doc value "is the unique identifier for this project."
        @key
    }
    name   string    {
        @doc value         "is a human-readable name for the project."
        @validate required
    }
    author user.Key? {
        @doc value     "is the UUID of the user who created this project."
        @filter scalar
    }
    layout record    {
        @doc value        """
            is the mosaic tree structure that defines how visualizations are
            arranged. Contains tab layout, split configurations, and window
            positions.
        """
        @ts preserve_case
    }

    @doc value     """
        is a named, persistable container that stores the layout and organization
        of the Console application. Projects allow users to save and restore
        custom arrangements of visualizations, tabs, and window configurations.
    """
    @ontology type "project"
    @retrieve
    @search
    @go marshal
    @go migrate
}

New struct extends Project {
    -author
    key?

    @doc value    "contains parameters for creating a new project."
    @ts use_input
    @go omit
    @pb omit
}
