import "schemas/synnax/group"
import "schemas/x/filter"
import "schemas/x/patch"

@go output "core/pkg/service/project"
@py output "client/py/synnax/project"
@ts output "client/ts/src/project"

Key = uuid {
    @doc value "is a unique identifier for a project, represented as a UUID."
}

Project struct {
    key   Key = create {
        @doc value "is the unique identifier for this project."
        @key
    }
    name  string     {
        @doc value         "is a human-readable name for the project."
        @index sorted
        @search
        @validate required
    }
    group group.Key? {
        @doc value     "is the group the project sits in, if any."
        @group pinned
        @group scope   project
        @ref kind      place
        @ref on_delete detach
    }

    action Create {
        project Project

        @doc value """
            replaces the project with the given created state. Emitted by the Core when
            a project is created; clients never dispatch it.
        """
    }

    action Set = patch.Set

    action Remove = patch.Remove

    action Insert = patch.Insert

    action Move = patch.Move

    @create
    @doc value     """
        is a named, persistable container that groups the panels of the Console
        application.
    """
    @go marshal
    @go migrate
    @resource type "project"
    @retrieve
}

Where filter Project {
    key
    groups  group.Key[] {
        @doc value "matches the projects in any of the given groups."
    }
    grouped bool        {
        @doc value "matches the projects in a group, or in no group when false."
    }

    @doc value         "is a filter that selects projects."
    @go request_output "core/pkg/api/project"
}
