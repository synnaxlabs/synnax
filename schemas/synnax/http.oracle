import "schemas/synnax/channel"
import "schemas/synnax/device"
import "schemas/synnax/task"
import "schemas/x/payload"
import "schemas/x/telem"

@cpp output "client/cpp/http"
@go output  "core/pkg/service/http"
@py output  "client/py/synnax/http"
@ts output  "client/ts/src/http"

Method enum {
    get     = "GET" {
        @doc value "reads a resource."
    }
    head    = "HEAD" {
        @doc value "reads the headers of a resource, with no body."
    }
    post    = "POST" {
        @doc value "submits data to a resource."
    }
    put     = "PUT" {
        @doc value "replaces a resource."
    }
    delete  = "DELETE" {
        @doc value "removes a resource."
    }
    patch   = "PATCH" {
        @doc value "changes part of a resource."
    }
    options = "OPTIONS" {
        @doc value "asks which communication options a resource supports."
    }
    trace   = "TRACE" {
        @doc value "asks the server to echo the request it receives."
    }
    connect = "CONNECT" {
        @doc value "opens a tunnel to the server."
    }

    @doc value "is the HTTP method used when requesting an endpoint."
}

Header struct {
    name  string = "" {
        @doc value "is the header name, unique within a request."
    }
    value string = "" {
        @doc value "is the header value."
    }

    @doc value  "is a single HTTP header sent with a request."
    @go marshal
}

QueryParam struct {
    parameter string = "" {
        @doc value "is the parameter name, unique within a request."
    }
    value     string = "" {
        @doc value "is the parameter value."
    }

    @doc value  "is a single URL query parameter sent with a request."
    @go marshal
}

ReadField union on type payload.Kind extends BaseReadField {
    float extends payload.FloatRead {
        @doc value "reads a float."
    }
    integer extends payload.IntegerRead {
        @doc value "reads a signed integer."
    }
    unsigned extends payload.UnsignedRead {
        @doc value "reads an unsigned integer."
    }
    string extends payload.StringRead {
        @doc value "reads a string."
    }
    boolean extends payload.BooleanRead {
        @doc value "reads a boolean."
    }
    timestamp extends payload.TimestampRead {
        @doc value "reads a timestamp."
    }
    json {
        @doc value "reads any JSON value."
    }
    uuid {
        @doc value "reads a UUID."
    }
    bytes {
        @doc value "reads bytes."
    }

    @doc value  """
        is a single value extracted from an endpoint's JSON response. The type field is
        the kind of the value, which matches the kind of the channel's data type.
    """
    @go marshal
}

ReadEndpoint struct {
    key          string = create {
        @doc value "uniquely identifies the endpoint within the task."
        @key
    }
    method       Method = get {
        @doc value "is the HTTP method used to poll the endpoint."
    }
    path         string = "" {
        @doc value "is the URL path appended to the device's base URL."
    }
    headers      Header[]     {
        @doc value "contains additional headers merged into the request."
    }
    query_params QueryParam[] {
        @doc value "contains query parameters appended to the request URL."
    }
    body         string = "" {
        @doc value "is a static body sent with each request. Empty sends no body."
    }
    fields       ReadField[]  {
        @doc value "contains the values to extract from the response."
    }
    index        string = "" {
        @doc value """
            is the key of the field whose channel indexes the others. Empty when the
            task stamps samples on arrival.
        """
    }

    @doc value  "is a single HTTP endpoint polled by a read task."
    @go marshal
}

ReadConfig struct extends task.PersistConfig {
    device           device.Key = "" {
        @doc value     "is the key of the HTTP server device to poll."
        @ref kind      use
        @ref on_delete restrict
    }
    rate             telem.Rate = 1 {
        @doc value   "is the polling rate applied to all endpoints, in Hertz."
        @ts type     "number"
        @validate gt 0
    }
    endpoints        ReadEndpoint[] {
        @doc value "contains the endpoints to poll."
    }
    nan_fill_enabled bool = false {
        @doc value """
            is true when a float field that is missing or fails to convert is written as
            NaN. When false, the task skips every field that shares the endpoint and
            index channel with it.
        """
    }

    @doc value           """
        configures an HTTP read task, which polls one or more endpoints on an HTTP
        server device and writes extracted JSON values to Synnax channels.
    """
    @go imex             body
    @go marshal
    @go migrate
    @patch
    @retrieve references
}

ChannelField struct {
    pointer     string = "" {
        @doc value """
            is the JSON Pointer where the channel value is placed in the body. An empty
            pointer sends the bare value as the entire body, in which case the endpoint
            may not declare any additional fields.
        """
    }
    json_type   payload.JSONType = number {
        @doc value "is the JSON type the channel value is serialized as."
    }
    channel     channel.Key = 0 {
        @doc value     "is the Synnax command channel that triggers the request."
        @ref kind      use
        @ref on_delete restrict
    }
    name        string = "" {
        @doc value "is the human-readable name of the command channel."
    }
    data_type   telem.DataType = "float64" {
        @doc value "is the data type of the command channel."
        @ts type   "string"
    }
    time_format payload.TimeFormat? {
        @doc value """
            is the output encoding when the command channel holds timestamps. An unset
            format is ISO 8601.
        """
    }
    enum_values payload.EnumEntry[] {
        @doc value """
            maps numeric channel values to string labels. Only valid when json_type is
            'string'.
        """
    }

    @doc value  "is the command channel value placed into a write endpoint's body."
    @go marshal
}

BaseWriteField struct {
    key     string = create {
        @doc value "uniquely identifies the field within the endpoint."
        @key
    }
    pointer string = "" {
        @doc value "is the JSON Pointer where the value is placed in the body."
    }

    @doc value  "carries the fields every write body field shares."
    @go marshal
}

WriteField union on type extends BaseWriteField {
    static {
        json_type payload.JSONType = number {
            @doc value "is the JSON type the value is serialized as."
        }
        value     any              {
            @doc value "is the fixed JSON value placed at the pointer."
        }

        @doc value "places a fixed value in the request body."
    }
    generated {
        generator   payload.GeneratorType = uuid {
            @doc value "is the generator that produces a fresh value per request."
        }
        time_format payload.TimeFormat?   {
            @doc value """
                is the output encoding for timestamp generators. Defaults to iso8601.
            """
        }

        @doc value "places a freshly generated UUID or timestamp in the body."
    }

    @doc value  """
        is an additional body field on a write endpoint. The type field selects whether
        the value is fixed or generated per request.
    """
    @go marshal
}

WriteEndpoint struct {
    key          string = create {
        @doc value "uniquely identifies the endpoint within the task."
        @key
    }
    disabled     bool = false {
        @doc value "is true when the endpoint is excluded from the task."
    }
    method       Method = post {
        @doc value "is the HTTP method used to send the request."
    }
    path         string = "" {
        @doc value "is the URL path appended to the device's base URL."
    }
    headers      Header[]     {
        @doc value "contains additional headers merged into the request."
    }
    query_params QueryParam[] {
        @doc value "contains query parameters appended to the request URL."
    }
    channel      ChannelField = {} {
        @doc value "is the command channel whose writes trigger this endpoint."
    }
    fields       WriteField[] {
        @doc value "contains additional static or generated body fields."
    }

    @doc value  "is a single HTTP endpoint written to by a write task."
    @go marshal
}

WriteConfig struct extends task.StartConfig {
    device    device.Key = "" {
        @doc value     "is the key of the HTTP server device to write to."
        @ref kind      use
        @ref on_delete restrict
    }
    endpoints WriteEndpoint[] {
        @doc value "contains the endpoints to write to."
    }

    @doc value           """
        configures an HTTP write task, which sends an HTTP request whenever a value is
        written to an endpoint's command channel.
    """
    @go imex             body
    @go marshal
    @go migrate
    @patch
    @retrieve references
}

ScanConfig struct extends task.ScanConfig {
    @doc value  "configures an HTTP scan task."
    @go imex    body
    @go marshal
    @go migrate
    @patch
}

BaseReadField struct {
    key      string = create {
        @doc value "uniquely identifies the field within the endpoint."
        @key
    }
    name     string = "" {
        @doc value "is the human-readable field name."
    }
    disabled bool = false {
        @doc value "is true when the field is excluded from polling."
    }
    channel  channel.Key = 0 {
        @doc value     "is the Synnax channel the extracted value is written to."
        @ref kind      use
        @ref on_delete restrict
    }
    pointer  string = "" {
        @doc value "is the JSON Pointer to the value within the response body."
    }

    @doc value  "carries the fields every read field shares."
    @go marshal
}
