import "schemas/synnax/channel"
import "schemas/synnax/group"
import "schemas/synnax/project"
import "schemas/synnax/ranger"
import "schemas/x/filter"
import "schemas/x/patch"

@go output "core/pkg/service/video"
@ts output "client/ts/src/video"

Key = uuid {
    @doc value "is a unique identifier for a video view, represented as a UUID."
}

Video struct {
    key            Key = create {
        @doc value "is the unique identifier for this video view."
        @key
    }
    name           string       {
        @doc value         "is a human-readable name for the video view."
        @index sorted
        @search
        @validate required
    }
    channel        channel.Key = 0 {
        @doc value "is the video channel the view shows."
    }
    playback_range ranger.Ref?  {
        @doc value "is the range the view plays back. Absent shows live video."
    }
    group          group.Key?   {
        @doc value     "is the group the video view sits in, if any."
        @group scope   project
        @ref kind      place
        @ref on_delete detach
    }
    project        project.Key? {
        @doc value     """
            is the project that owns the video view, if any. Exactly one of project and
            range is set.
        """
        @ref kind      place
        @ref on_delete cascade
    }
    range          ranger.Key?  {
        @doc value     """
            is the range that owns the video view, if any. Exactly one of project and
            range is set.
        """
        @ref kind      place
        @ref on_delete cascade
    }

    action Create {
        video Video

        @doc value """
            replaces the document with the given created state. Emitted by the Core on
            create so remote caches ingest new documents; clients never dispatch it.
        """
    }

    action SetChannel {
        channel channel.Key

        @doc value "sets the video channel the view shows."
    }

    action SetPlaybackRange {
        playback_range ranger.Ref?

        @doc value "sets the range the view plays back. Absent shows live video."
    }

    action Set = patch.Set {
        @doc value "replaces the value at a path in the video view."
    }

    action Remove = patch.Remove {
        @doc value """
            removes an entry from a list or a field from an object in the video view.
        """
    }

    action Insert = patch.Insert {
        @doc value "adds an entry to a list in the video view."
    }

    action Move = patch.Move {
        @doc value "moves an entry in a list in the video view."
    }

    @create
    @doc value     "is a view that shows the frames of one video channel."
    @go marshal
    @go migrate
    @resource type "video"
    @retrieve
}

Where filter Video {
    key
    groups   group.Key[]   {
        @doc value "matches the video views in any of the given groups."
    }
    grouped  bool          {
        @doc value "matches the video views in a group, or in no group when false."
    }
    projects project.Key[] {
        @doc value "matches the video views owned by any of the given projects."
    }
    ranges   ranger.Key[]  {
        @doc value "matches the video views owned by any of the given ranges."
    }

    @doc value         "is a filter that selects video views."
    @go request_output "core/pkg/api/video"
}
