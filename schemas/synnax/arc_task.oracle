import "schemas/synnax/arc"
import "schemas/synnax/task"

@go output "core/pkg/service/arc/task"
@py output "client/py/synnax/arc/task"
@ts output "client/ts/src/arc/task"

Performance enum {
    auto   = "auto" {
        @doc value "spins the timer for the default time of the platform."
    }
    low    = "low" {
        @doc value "never spins the timer."
    }
    medium = "medium" {
        @doc value "spins the timer for up to 1 millisecond before a deadline."
    }
    high   = "high" {
        @doc value "spins the timer for the whole of each wait."
    }

    @doc value """
        sets how closely the Arc runtime holds timer deadlines. A higher level is more
        precise and uses more CPU.
    """
}

Config struct extends task.PersistConfig {
    arc_key     arc.Key     {
        @doc value     "is the key of the Arc module the task executes."
        @ref kind      use
        @ref on_delete restrict
    }
    hash        string = "" {
        @doc value """
            is the hash of the automation's compiled program, or of its source when it
            does not compile.
        """
    }
    performance Performance = auto {
        @doc value "sets how closely the runtime holds timer deadlines."
    }

    @doc value        "configures an Arc task, which runs a compiled Arc module."
    @go imex          body
    @go marshal
    @go migrate
    @patch
    @retrieve indexes
}
