import "schemas/synnax/arc"
import "schemas/synnax/task"

@go output "core/pkg/service/arc/task"
@ts output "client/ts/src/arc/task"

Performance enum {
    auto   = "auto"
    low    = "low"
    medium = "medium"
    high   = "high"

    @doc value """
        sets how closely the Arc runtime holds timer deadlines. A higher level is more
        precise and uses more CPU.
    """
}

Config struct extends task.PersistConfig {
    arc_key     arc.Key     {
        @doc value "is the key of the Arc module the task executes."
    }
    hash        string = "" {
        @doc value "is the semantic hash of the Arc module at deploy time."
    }
    performance Performance = auto {
        @doc value "sets how closely the runtime holds timer deadlines."
    }

    @doc value  "configures an Arc task, which runs a compiled Arc module."
    @go marshal
    @go migrate
}
