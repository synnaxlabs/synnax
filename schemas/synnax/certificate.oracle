import "schemas/synnax/secret"
import "schemas/x/filter"
import "schemas/x/patch"
import "schemas/x/telem"

@go output "core/pkg/service/certificate"
@py output "client/py/synnax/certificate"
@ts output "client/ts/src/certificate"

Key = uuid {
    @doc value "is a unique identifier for a certificate."
}

Details struct {
    subject    string          {
        @doc value "is the distinguished name of the certificate's subject."
    }
    issuer     string          {
        @doc value "is the distinguished name of the certificate's issuer."
    }
    not_before telem.TimeStamp {
        @doc value "is when the certificate becomes valid."
    }
    not_after  telem.TimeStamp {
        @doc value "is when the certificate expires."
    }
    sha1       string          {
        @doc value "is the SHA-1 hash of the DER bytes as hex, the OPC UA thumbprint."
    }
    sha256     string          {
        @doc value "is the SHA-256 hash of the DER bytes as hex."
    }

    @doc value  "describes the leaf certificate of a chain."
    @go marshal
}

Base struct {
    key  Key = create {
        @doc value "is the unique identifier for this certificate."
        @key
    }
    name string {
        @doc value         "is a human-readable name for the certificate."
        @index sorted
        @search
        @validate required
    }

    @doc value  "carries the fields shared by every certificate."
    @go marshal
}

Certificate union on source secret.Source extends Base {
    stored {
        pem         string      {
            @doc value "is the certificate chain as PEM, leaf first."
        }
        private_key secret.Key? {
            @doc value     """
                is the secret that holds the private key, when there is one.
            """
            @ref kind      use
            @ref on_delete restrict
        }
        details     Details     {
            @doc value "describes the leaf, as the Core read it from the PEM."
        }

        @doc value "is a certificate whose contents the Core stores."
    }
    file {
        certificate_path string   {
            @doc value "is the path of the certificate on the computer that uses it."
        }
        private_key_path string?  {
            @doc value "is the path of the private key, when there is one."
        }
        details          Details? {
            @doc value "describes the leaf, as the file browser read it."
        }

        @doc value "is a certificate in files on the computer that uses it."
    }

    action Create {
        certificate Certificate

        @doc value """
            replaces the certificate with the given created state. Emitted by the Core
            when a certificate is created or replaced; clients never dispatch it.
        """
    }

    action Set extends patch.Set {
        @doc value "replaces the value at a path in the certificate."
    }

    action Remove extends patch.Remove {
        @doc value """
            removes an entry from a list or a field from an object in the certificate.
        """
    }

    action Insert extends patch.Insert {
        @doc value "adds an entry to a list in the certificate."
    }

    action Move extends patch.Move {
        @doc value "moves an entry in a list in the certificate."
    }

    @doc value     """
        is a public certificate that a device uses to secure a connection, with the
        private key that proves it when there is one.
    """
    @go marshal
    @go migrate
    @resource type "certificate"
    @retrieve
}

Where filter Certificate {
    key
    name

    @doc value         "is a filter that selects certificates."
    @go request_output "core/pkg/api/certificate"
}
