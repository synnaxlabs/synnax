import "schemas/synnax/role"
import "schemas/x/filter"
import "schemas/x/patch"

@go output "core/pkg/service/user"
@py output "client/py/synnax/user"
@ts output "client/ts/src/user"

Key = uuid {
    @doc value "is a unique identifier for a user, represented as a UUID."
}

User struct {
    key       Key      {
        @doc value "is the unique identifier for this user."
        @key
    }
    name      string   {
        @doc value           "is the user's display name."
        @index sorted
        @search
        @validate min_length 1
    }
    root_user bool = false {
        @doc value """
            is true if this is a root/admin user with full system access. Root users
            cannot be deleted.
        """
        @filter
    }
    role      role.Key {
        @doc value         "is the role that grants the user its permissions."
        @ref kind          place
        @ref on_delete     restrict
        @validate required
    }

    action Create {
        user User

        @doc value """
            replaces the user with the given created state. Emitted by the Core when a
            user is created; clients never dispatch it.
        """
    }

    action Set = patch.Set

    action Remove = patch.Remove

    action Insert = patch.Insert

    action Move = patch.Move

    action SetUsername {
        username string

        @doc value """
            changes the username of the user's password. The Core refuses a username
            that another user holds.
        """
    }

    @doc value       """
        is an account entity representing a person accessing the Synnax system. Each
        user holds one role, which grants its permissions.
    """
    @go marshal
    @go migrate
    @resource type   "user"
    @retrieve custom
}

Where filter User {
    key
    usernames string[]   {
        @doc value "matches the users whose password has any of the given usernames."
    }
    roles     role.Key[] {
        @doc value "matches the users that hold any of the given roles."
    }

    @doc value         "is a filter that selects users."
    @go request_output "core/pkg/api/user"
}

New struct extends User {
    -root_user
    key?
    username string {
        @doc value         "is the login name for the new user's password."
        @validate required
    }
    password string {
        @doc value           "is the password for the new user account."
        @validate min_length 1
    }
    name?

    @cpp omit
    @doc value    "contains parameters for creating a new user."
    @go omit
    @py omit
    @ts use_input
}
