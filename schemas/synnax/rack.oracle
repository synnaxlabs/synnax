import "schemas/synnax/status"
import "schemas/synnax/task"

@ts output  "client/ts/src/rack"
@py output  "client/py/synnax/rack"
@cpp output "client/cpp/rack"
@go output  "core/pkg/service/rack"
@pb

Key uint32 {
    @go version  2
    @doc value   """
        is a composite identifier for a rack. The high 16 bits contain the Core key, and
        the low 16 bits contain the local sequential key. A rack is leased to the Core
        named in its high bits, so writes route to the Core running its Driver.
    """
    @go marshal  flex
    @cpp include "client/cpp/rack/key.h"
}

StatusDetails struct {
    rack Key {
        @doc value "is the key of the rack this status pertains to."
    }

    @go version 2
    @doc value  "contains rack-specific status details."
}

Status = status.Status<StatusDetails> {
    @go version 2
    @doc value  "is rack-specific status information including operational state."
}

Rack struct {
    key          Key      {
        @doc value         "is the composite identifier for this rack."
        @key
        @validate required
    }
    name         string   {
        @doc value         "is a human-readable name for the rack."
        @validate required
        @filter
    }
    embedded     bool = false {
        @doc value """
            is true if this rack is embedded within the Synnax server process.
        """
        @filter
    }
    status       Status?  {
        @doc value  "is the current operational status of the rack."
        @go marshal omit
    }
    integrations string[] = [] {
        @doc value """
            is the list of hardware integrations this rack supports (e.g., "ni", "opc",
            "labjack"). An empty or nil list means the rack supports no integrations.
        """
        @filter
    }

    @go version      2
    @doc value       """
        is a collection container for hardware devices and tasks running on a specific
        Core. Racks are the integration point between the Core and physical hardware
        through the Driver.
    """
    @ts name         "Payload"
    @ontology type   "rack"
    @go marshal
    @go migrate
    @retrieve custom
    @search
    @py name         "Base"
    @cpp methods     "task::Client tasks"
    @cpp includes    "client/cpp/task/task.h"
}

New struct extends Rack {
    -embedded
    key = 0

    @doc value    "contains parameters for creating a new rack."
    @ts use_input
    @go omit
    @pb omit
    @cpp omit
    @py name      "Rack"
}

StatusTaskConfig struct extends task.ConfigRecord {
    @doc value  "configures the rack status reporting task, which carries no settings."
    @go version 0
    @go output  "core/pkg/service/rack/task"
    @go marshal
    @go migrate
    @pb omit
    @ts omit
    @py omit
    @cpp omit
}
