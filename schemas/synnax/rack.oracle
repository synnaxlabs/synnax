import "schemas/synnax/status"

@cpp output "client/cpp/rack"
@go output  "core/pkg/service/rack"
@pb
@py output  "client/py/synnax/rack"
@ts output  "client/ts/src/rack"

Key uint32 {
    @doc value  """
        is a composite identifier for a rack. The high 16 bits contain the node key, and
        the low 16 bits contain the local sequential key. Racks are leased to specific
        nodes because task configuration signals are passed through gossip operations,
        which can take 15s+ to propagate through a large cluster. This structure
        minimizes hops and configuration latency.
    """
    @go marshal flex
}

StatusDetails struct {
    rack Key {
        @doc value "is the key of the rack the status describes."
    }

    @doc value "is the rack-specific detail payload carried in a rack Status."
}

Status = status.Status<StatusDetails> {
    @doc value "is rack-specific status information including operational state."
}

Rack struct {
    key          Key      {
        @doc value         "is the composite identifier for this rack."
        @key
        @validate required
    }
    name         string   {
        @doc value         "is a human-readable name for the rack."
        @filter
        @validate required
    }
    task_counter uint32 = 0 {
        @doc value "is an internal counter used for generating unique local task keys."
    }
    embedded     bool = false {
        @doc value "is true if this rack is embedded within the Synnax server process."
        @filter
    }
    status       Status?  {
        @doc value  "is the current operational status of the rack."
        @go marshal omit
    }
    integrations string[] = [] {
        @doc value """
            is the list of hardware integrations this rack supports (e.g., "ni", "opc",
            "labjack"). An empty or nil list means the rack supports no integrations.
        """
        @filter
    }

    @cpp includes    "client/cpp/task/task.h"
    @cpp methods     "task::Client tasks"
    @doc value       """
        is a collection container for hardware devices and tasks running on a specific
        cluster node. Racks serve as the integration point between the Synnax server and
        physical hardware via the Driver system.
    """
    @go marshal
    @go migrate
    @ontology type   "rack"
    @py name         "Base"
    @retrieve custom
    @search
    @ts name         "Payload"
}

New struct extends Rack {
    -task_counter
    -embedded
    key = 0

    @cpp omit
    @doc value    "contains parameters for creating a new rack."
    @go omit
    @pb omit
    @py name      "Rack"
    @ts use_input
}
