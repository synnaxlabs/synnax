import "schemas/synnax/channel"
import "schemas/synnax/rack"
import "schemas/synnax/status"
import "schemas/x/telem"

@cpp output "client/cpp/modbus/server"
@go output  "core/pkg/service/modbus/server"
@py output  "client/py/synnax/modbus/server"
@ts output  "client/ts/src/modbus/server"

Key = uuid {
    @doc value "uniquely identifies a Modbus server."
}

Parity enum {
    none = "none" {
        @doc value "sends no parity bit."
    }
    even = "even" {
        @doc value "sends an even parity bit."
    }
    odd  = "odd" {
        @doc value "sends an odd parity bit."
    }

    @doc value "is the parity of a serial line."
}

BaudRate enum {
    b1200   = 1200 {
        @doc value "is 1200 baud."
    }
    b2400   = 2400 {
        @doc value "is 2400 baud."
    }
    b4800   = 4800 {
        @doc value "is 4800 baud."
    }
    b9600   = 9600 {
        @doc value "is 9600 baud."
    }
    b19200  = 19200 {
        @doc value "is 19200 baud."
    }
    b38400  = 38400 {
        @doc value "is 38400 baud."
    }
    b57600  = 57600 {
        @doc value "is 57600 baud."
    }
    b115200 = 115200 {
        @doc value "is 115200 baud."
    }
    b230400 = 230400 {
        @doc value "is 230400 baud."
    }

    @doc value "is a serial line rate that the Driver sets on every platform."
}

WriteFunction enum {
    multiple = "multiple" {
        @doc value "writes with function codes 15 and 16."
    }
    single   = "single" {
        @doc value "writes with function codes 5 and 6."
    }

    @doc value "selects the function codes that write tasks use."
}

StopBits enum {
    one = 1 {
        @doc value "is one stop bit."
    }
    two = 2 {
        @doc value "is two stop bits."
    }

    @doc value "is the number of stop bits of a serial line."
}

BaseConnection struct {
    bytes_swapped bool = false {
        @doc value "is true when the bytes of each 16-bit register are swapped."
    }
    words_swapped bool = false {
        @doc value "is true when the low word of a multi-register value comes last."
    }
    timeout       telem.TimeSpan = 1s {
        @doc value    "is the connect and response timeout."
        @ts type      telem.NumericTimeSpan
        @validate max 60000000000
        @validate min 1000000
    }
    retries       uint8 = 1 {
        @doc value    "is the number of immediate retries after a temporary error."
        @validate max 10
    }

    @doc value  "carries the fields that every Modbus connection shares."
    @go marshal
}

Connection union on transport extends BaseConnection {
    tcp {
        host    string {
            @doc value         "is the hostname, IPv4, or IPv6 address of the server."
            @validate required
        }
        port    uint16 = 502 {
            @doc value    "is the TCP port of the server."
            @validate min 1
        }
        unit_id uint8 = 255 {
            @doc value "is the unit that requests address."
        }

        @doc value "connects to a server over Modbus TCP."
    }
    rtu {
        serial_port string   {
            @doc value         """
                is the serial port of the line, such as /dev/ttyUSB0 or COM3.
            """
            @validate required
        }
        baud_rate   BaudRate = b19200 {
            @doc value "is the baud rate of the line."
        }
        parity      Parity = even {
            @doc value "is the parity of the line."
        }
        stop_bits   StopBits = one {
            @doc value """
                is the number of stop bits of the line. Modbus asks for two with no
                parity, but many devices use one, so no rule ties it to parity.
            """
        }
        unit_id     uint8 = 1 {
            @doc value    "is the unit that requests address."
            @validate max 247
            @validate min 1
        }

        @doc value "connects to a unit on a serial line over Modbus RTU."
    }

    @doc value  "holds the settings that the Driver connects to a server with."
    @go marshal
}

RequestPolicy struct {
    max_read_registers   uint16 = 125 {
        @doc value    "is the most registers that one read requests."
        @validate max 125
        @validate min 1
    }
    max_write_registers  uint16 = 123 {
        @doc value    "is the most registers that one write sets."
        @validate max 123
        @validate min 1
    }
    max_read_bits        uint16 = 2000 {
        @doc value    "is the most coils or discrete inputs that one read requests."
        @validate max 2000
        @validate min 1
    }
    max_write_bits       uint16 = 1968 {
        @doc value    "is the most coils that one write sets."
        @validate max 1968
        @validate min 1
    }
    max_gap              uint16 = 125 {
        @doc value    """
            is the most unbound addresses between two values that one read spans. A read
            still requests at most max_read_registers or max_read_bits.
        """
        @validate max 125
    }
    write_function       WriteFunction = multiple {
        @doc value "selects the function codes that write tasks use."
    }
    mask_write_supported bool = false {
        @doc value "is true when bit writes use function code 22."
    }
    delay                telem.TimeSpan = 0 {
        @doc value    "is the wait between two requests."
        @ts type      telem.NumericTimeSpan
        @validate max 5000000000
        @validate min 0
    }

    @doc value  "limits and paces the requests that the Driver sends to a server."
    @go marshal
}

Number struct {
    data_type     telem.NumericDataType = uint16 {
        @doc value "is the type of the value in the registers."
    }
    bytes_swapped bool?                 {
        @doc value "overrides the bytes_swapped of the connection for the value."
    }
    words_swapped bool?                 {
        @doc value "overrides the words_swapped of the connection for the value."
    }

    @doc value  "is a number that fills one or more registers."
    @go marshal
}

RegisterBit struct {
    bit uint8 = 0 {
        @doc value    "is the bit of the register, from 0 to 15."
        @validate max 15
    }

    @doc value  "is one bit of a register."
    @go marshal
}

Value union on type {
    whole extends Number {
        @doc value "is a number that fills one or more registers."
    }
    bit extends RegisterBit {
        @doc value "is one bit of a register."
    }
    string {
        length        uint16 {
            @doc value    "is the number of characters, two to each register."
            @validate max 250
            @validate min 1
        }
        bytes_swapped bool?  {
            @doc value "overrides the bytes_swapped of the connection for the value."
        }

        @doc value "is a fixed-length string that read tasks read."
    }

    @doc value  "is how one or more registers hold a value."
    @go marshal
}

BaseLocation struct {
    address uint16 = 0 {
        @doc value "is the address of the coil, discrete input, or first register."
    }

    @doc value  "carries the address that every location has."
    @go marshal
}

Location union on table extends BaseLocation {
    coil {
        @doc value "is a coil, which tasks can read and write."
    }
    discrete_input {
        @doc value "is a discrete input, which tasks can only read."
    }
    holding_register {
        value Value {
            @doc value "is how the registers hold the value."
        }

        @doc value "is a holding register value, which tasks can read and write."
    }
    input_register {
        value Value {
            @doc value "is how the registers hold the value."
        }

        @doc value "is an input register value, which tasks can only read."
    }

    @doc value  "identifies a value by its Modbus table and address."
    @go marshal
}

WriteValue union on type {
    whole extends Number {
        @doc value "is a number that fills one or more registers."
    }
    bit extends RegisterBit {
        @doc value "is one bit of a register."
    }

    @doc value  "is how a holding register holds a value that write tasks write."
    @go marshal
}

WriteLocation union on table extends BaseLocation {
    coil {
        @doc value "is a coil."
    }
    holding_register {
        value WriteValue {
            @doc value "is how the registers hold the value."
        }

        @doc value "is a holding register value."
    }

    @doc value  """
        identifies a value that write tasks write, by its Modbus table and address.
    """
    @go marshal
}

Read struct {
    location Location    {
        @doc value "is the value that the channel holds."
    }
    index    channel.Key {
        @doc value         "is the index channel of the channel."
        @ref kind          use
        @ref on_delete     restrict
        @validate required
    }
    channel  channel.Key {
        @doc value         "is the channel that holds the samples of the value."
        @ref kind          use
        @ref on_delete     restrict
        @validate required
    }

    @doc value  "binds a value that read tasks read to its channel."
    @go marshal
}

Write struct {
    location WriteLocation {
        @doc value "is the value that the channel commands."
    }
    channel  channel.Key   {
        @doc value         """
            is the channel whose commands write tasks send to the value.
        """
        @ref kind          use
        @ref on_delete     restrict
        @validate required
    }

    @doc value  "binds a value that write tasks write to its command channel."
    @go marshal
}

Stats struct {
    requests      uint64 = 0 {
        @doc value "is the number of requests tried, retries included."
        @ts type   "number"
    }
    retries       uint64 = 0 {
        @doc value "is the number of requests tried again after a temporary error."
        @ts type   "number"
    }
    timeouts      uint64 = 0 {
        @doc value "is the number of requests that the unit did not answer in time."
        @ts type   "number"
    }
    exceptions    uint64 = 0 {
        @doc value "is the number of requests answered with an exception."
        @ts type   "number"
    }
    last_response telem.TimeSpan = 0 {
        @doc value "is the time from sending the last answered request to its reply."
    }
    max_response  telem.TimeSpan = 0 {
        @doc value "is the longest time from sending a request to its reply."
    }

    @doc value "holds the request counters of a server."
}

StatusDetails struct {
    rack      rack.Key {
        @doc value "is the key of the rack the server belongs to."
    }
    server    Key      {
        @doc value "is the key of the server."
    }
    connected bool = false {
        @doc value "is true when the server answered the last probe."
    }
    stats     Stats?   {
        @doc value """
            holds the request counters. Absent until the first scan counts them.
        """
    }

    @doc value "identifies the server and rack that a status pertains to."
}

Status = status.Status<StatusDetails> {
    @doc value "is the connection status of a server."
}

Server struct {
    key            Key = create {
        @doc value "uniquely identifies the server."
        @key
    }
    rack           rack.Key      {
        @doc value     "is the key of the rack whose Driver connects to the server."
        @ref kind      place
        @ref on_delete restrict
    }
    name           string        {
        @doc value         "is a human-readable name for the server."
        @filter
        @search
        @validate required
    }
    connection     Connection    {
        @doc value "holds the settings that the Driver connects with."
    }
    request_policy RequestPolicy = {} {
        @doc value "limits and paces the requests that the Driver sends."
    }
    reads          Read[] = [] {
        @doc value "bind the values that read tasks read to their channels."
    }
    writes         Write[] = [] {
        @doc value "bind the values that write tasks write to their command channels."
    }
    status         Status?       {
        @doc value  "is the current connection status of the server."
        @go marshal omit
        @include
    }

    @create
    @doc value     "is a Modbus server that a rack's Driver connects to."
    @go marshal
    @go migrate
    @resource type "modbus_server"
    @retrieve
}
