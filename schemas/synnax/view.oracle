import "schemas/synnax/ranger"
import "schemas/synnax/status"

@go output "core/pkg/service/view"
@py output "client/py/synnax/view"
@ts output "client/ts/src/view"

Key = uuid {
    @doc value "is a unique identifier for a saved view configuration."
}

View union on type extends Base {
    range {
        where ranger.Where? {
            @doc value "selects the ranges the view shows. An absent where shows all."
        }

        @doc value "is a saved view of ranges."
    }
    status {
        where status.Where? {
            @doc value "selects the statuses the view shows. An absent where shows all."
        }

        @doc value "is a saved view of statuses."
    }

    @create
    @doc value       """
        is a saved, named filter over a list of resources. The type selects the resource
        the view lists and the shape of its where.
    """
    @go marshal
    @go migrate
    @ontology type   "view"
    @retrieve custom
}

Base struct {
    key  Key = create {
        @doc value "is the unique identifier for this view."
        @key
    }
    name string {
        @doc value         "is a human-readable name for the view."
        @validate required
    }

    @doc value  "carries the fields shared by every view variant."
    @go marshal
}
