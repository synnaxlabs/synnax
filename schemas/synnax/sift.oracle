import "schemas/synnax/secret"
import "schemas/synnax/task"

@go output "core/pkg/service/sift"

Properties struct {
    uri     string = "" {
        @doc value """
            is the address of the Sift gRPC API, as host:port. A local host connects
            without TLS.
        """
    }
    api_key secret.Key {
        @doc value "is the key of the secret that holds the Sift API key."
    }

    @doc value "configures the connection to a Sift device."
}

ScanConfig struct extends task.ScanConfig {
    @doc value  "configures a Sift scan task."
    @go imex    body
    @go marshal
    @go migrate
    @patch
}
