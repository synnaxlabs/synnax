import "schemas/synnax/ontology"
import "schemas/x/telem"

@go output "core/pkg/service/auth"
@py output "client/py/synnax/auth"
@ts output "client/ts/src/auth"

Method enum {
    password = "password"

    @doc value "names an authentication method."
}

SessionKey = uuid {
    @doc value "is a unique identifier for a session."
}

Session struct {
    key         SessionKey = create {
        @doc value "is the unique identifier for this session."
        @key
    }
    hash        bytes           {
        @doc value "is the SHA-256 hash of the secret in the session's token."
    }
    subject     ontology.ID     {
        @doc value    "is the user or rack that logged in."
        @filter
        @index lookup
    }
    method      Method          {
        @doc value "is the method the subject logged in with."
    }
    credential  uuid            {
        @doc value    "is the key of the credential record the login matched."
        @filter
        @index lookup
    }
    address     string          {
        @doc value "is the network address the login came from."
    }
    created     telem.TimeStamp {
        @doc value "is when the subject logged in."
    }
    last_active telem.TimeStamp {
        @doc value """
            is the last time a request used the session, to the nearest quarter of the
            idle timeout.
        """
    }

    @doc value  """
        is a logged-in subject. It ends when it is revoked or when no request has used
        it for the idle timeout.
    """
    @go marshal
    @go migrate
    @py omit
    @retrieve
    @ts omit
}

APISession struct {
    key         SessionKey      {
        @doc value "is the unique identifier for this session."
    }
    subject     ontology.ID     {
        @doc value "is the user or rack that logged in."
    }
    method      Method          {
        @doc value "is the method the subject logged in with."
    }
    credential  uuid            {
        @doc value "is the key of the credential record the login matched."
    }
    address     string          {
        @doc value "is the network address the login came from."
    }
    created     telem.TimeStamp {
        @doc value "is when the subject logged in."
    }
    last_active telem.TimeStamp {
        @doc value """
            is the last time a request used the session, to the nearest quarter of the
            idle timeout.
        """
    }

    @doc value "is a session as the API returns it: the stored record without its hash."
    @go omit
    @py name   "Session"
    @ts name   "Session"
}

Credentials struct {
    username string {
        @doc value         "is the login name of the password being proven."
        @validate required
    }
    password string {
        @doc value         "is the plaintext password. It is never stored."
        @validate required
    }

    @doc value "is a plaintext username and password pair presented at login."
}

Proof union on method Method {
    password Credentials {
        @doc value "proves a password."
    }

    @doc value """
        is what a subject presents to log in. The method selects the authenticator that
        checks it.
    """
}
