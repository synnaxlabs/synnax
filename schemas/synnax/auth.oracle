@go output "core/pkg/service/auth"

Method enum {
    password = "password"

    @doc value "names an authentication method."
}

Credentials struct {
    username string {
        @doc value         "is the login name of the password being proven."
        @validate required
    }
    password string {
        @doc value         "is the plaintext password. It is never stored."
        @validate required
    }

    @doc value "is a plaintext username and password pair presented at login."
}

Proof union on method Method {
    password Credentials {
        @doc value "proves a password."
    }

    @doc value """
        is what a subject presents to log in. The method selects the authenticator that
        checks it.
    """
}
