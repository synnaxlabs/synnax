@go output "core/pkg/service/auth"

SecureCredentials struct {
    username string {
        @doc value "is the unique login name the credentials belong to."
    }
    password bytes  {
        @doc value "is the bcrypt hash of the user's password."
    }

    @go version 1
    @doc value  """
        is a persisted username and password-hash pair used to authenticate a
        user.
    """
    @go marshal
    @go migrate
}
