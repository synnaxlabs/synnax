@go output "core/pkg/service/auth"

Key = uuid {
    @doc value "is the key of the user the credentials belong to."
}

SecureCredentials struct {
    key      Key    {
        @doc value "is the key of the user the credentials belong to."
        @key
    }
    username string {
        @doc value "is the unique login name that the credentials answer to."
    }
    password bytes  {
        @doc value "is the bcrypt hash of the user's password."
    }

    @doc value  "is the persisted login name and password hash of a user."
    @go marshal
    @go migrate
}
