import "schemas/synnax/certificate"

@go output "core/pkg/service/tls"
@py output "client/py/synnax/tls"
@ts output "client/ts/src/tls"

TLS struct {
    ca_certificate                  certificate.Key? {
        @doc value """
            is the certificate authority that signs the certificate of the server.
            Absent trusts the system roots.
        """
    }
    client_certificate              certificate.Key? {
        @doc value """
            is the certificate and private key that the client presents to the server.
            Absent presents no certificate.
        """
    }
    certificate_validation_disabled bool = false {
        @doc value "is true when the client accepts any server certificate."
    }

    @doc value  "configures a TLS connection to a server."
    @go marshal
}
