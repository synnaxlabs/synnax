import "schemas/synnax/channel"
import "schemas/x/filter"
import "schemas/x/patch"
import "schemas/x/payload"
import "schemas/x/telem"

@cpp output "client/cpp/icd"
@go output  "core/pkg/service/icd"
@pb
@py output  "client/py/synnax/icd"
@ts output  "client/ts/src/icd"

Key = uuid {
    @doc value "is a unique identifier for an ICD."
}

MessageKey = uuid {
    @doc value "is a unique identifier for a message within an ICD."
}

FieldKey = uuid {
    @doc value "is a unique identifier for a field within a message."
}

ImportFormat enum {
    dbc  = "dbc" {
        @doc value "is a Vector CAN database file."
    }
    csv  = "csv" {
        @doc value """
            is a field table in comma-separated values. The first row is a header that
            names each column, in any case: message, id, extended, length, field,
            start_bit, bit_length, byte_order, kind, scale, offset, units, min, and max.
            The message, field, start_bit, and bit_length columns are required. A kind
            is float, integer, or unsigned, and defaults to unsigned. Each other row is
            one binary field, and the rows of one message form one message, with a CAN
            identifier when an id is present.
        """
    }
    xlsx = "xlsx" {
        @doc value """
            is a field table, laid out as for csv, in the first sheet of an Excel
            workbook. A numeric cell is read as its value, whatever its number format.
        """
    }

    @doc value "is the file format of an ICD that an import reads."
    @pb omit
}

ByteOrder enum {
    little_endian = "little_endian"
    big_endian    = "big_endian"

    @doc value "is the byte order of a multi-byte binary field."
}

Identifier union on type {
    can {
        id               uint32 = 0 {
            @doc value "is the CAN arbitration identifier."
        }
        extended         bool = false {
            @doc value "is true when the identifier is a 29-bit extended identifier."
        }
        fd               bool = false {
            @doc value "is true when the message is sent as a CAN FD frame."
        }
        bitrate_switched bool = false {
            @doc value "is true when a CAN FD frame switches to the data bitrate."
        }
        mask             uint32? {
            @doc value """
                is the bit mask applied to both identifiers before matching. When absent
                the identifiers must match exactly.
            """
        }

        @doc value "matches a CAN frame by arbitration identifier."
    }
    field {
        field FieldKey {
            @doc value "is the key of the message field that holds the identifier."
        }
        value int32 = 0 {
            @doc value "is the raw value the field must hold."
        }

        @doc value "matches a binary frame by the raw value of one of its fields."
    }

    @doc value  "selects which frames on a bus belong to a binary message."
    @go marshal
}

BaseField struct {
    key    FieldKey = create {
        @doc value "is the unique identifier for the field within its message."
    }
    name   string   {
        @doc value           "is the name of the field, unique within its message."
        @validate min_length 1
    }
    scale  float64 = 1 {
        @doc value "multiplies the raw value on decode."
    }
    offset float64 = 0 {
        @doc value "is added to the scaled value on decode."
    }
    units  string = "" {
        @doc value "is the engineering unit of the decoded value."
    }
    min    float64? {
        @doc value """
            is the smallest decoded value a write task accepts. When absent the field's
            encoding sets the limit.
        """
    }
    max    float64? {
        @doc value """
            is the largest decoded value a write task accepts. When absent the field's
            encoding sets the limit.
        """
    }

    @doc value  "carries the parts every message field shares."
    @go marshal
}

BinaryField union on kind extends BinaryBaseField {
    float {
        default payload.Float? {
            @doc value """
                is the raw value, before scale and offset, when a read finds none or no
                channel is bound.
            """
        }

        @doc value "is a field whose raw bits are an IEEE 754 float of 32 or 64 bits."
    }
    integer {
        default payload.Integer? {
            @doc value """
                is the raw value, before scale and offset, when a read finds none or no
                channel is bound.
            """
        }

        @doc value "is a field whose raw bits are a two's complement integer."
    }
    unsigned {
        default payload.Unsigned? {
            @doc value """
                is the raw value, before scale and offset, when a read finds none or no
                channel is bound.
            """
        }

        @doc value "is a field whose raw bits are an unsigned integer."
    }

    @doc value  """
        is a field read from a bit range of a binary payload. With no default, a write
        needs a channel.
    """
    @go marshal
}

TextBaseField struct extends BaseField {
    default payload.Float? {
        @doc value """
            is the raw number, before scale and offset, when a read finds none or no
            channel is bound.
        """
    }

    @doc value  "carries the parts every text field shares."
    @go marshal
}

TextField union on encoding extends TextBaseField {
    delimited {
        position uint32 = 0 {
            @doc value "is the zero-based item index after splitting on the delimiter."
        }

        @doc value "is a field read from one item of a delimited text line."
    }
    tagged {
        tag string {
            @doc value "is the text that comes just before the value in the line."
        }

        @doc value "is a field read from the text that follows a tag."
    }

    @doc value  """
        is a field read from a text line. With no default, a write needs a channel.
    """
    @go marshal
}

TimestampDefault union on type {
    constant {
        value telem.TimeStamp {
            @doc value "is the timestamp that the default gives."
        }

        @doc value "is one fixed timestamp."
    }
    now {
        @doc value "is the time of each read or write."
    }

    @doc value  "is the default of a timestamp field."
    @go marshal
}

UUIDDefault union on type {
    constant {
        value uuid {
            @doc value "is the UUID that the default gives."
        }

        @doc value "is one fixed UUID."
    }
    random {
        @doc value "is a new random UUID for each read or write."
    }

    @doc value  "is the default of a UUID field."
    @go marshal
}

JSONBaseField struct extends BaseField {
    pointer string = "" {
        @doc value """
            is the JSON Pointer to the value in the document. An empty pointer is the
            whole document.
        """
    }

    @doc value  "carries the parts every JSON field shares."
    @go marshal
}

JSONField union on type payload.Kind extends JSONBaseField {
    float {
        enum_values payload.FloatEntry[] {
            @doc value "maps text labels in the document to values."
        }
        default     payload.Float?       {
            @doc value """
                is the raw value, before scale and offset, when a read finds none or no
                channel is bound.
            """
        }

        @doc value "is a JSON number read as a float."
    }
    integer {
        enum_values payload.IntegerEntry[] {
            @doc value "maps text labels in the document to values."
        }
        default     payload.Integer?       {
            @doc value """
                is the raw value, before scale and offset, when a read finds none or no
                channel is bound.
            """
        }

        @doc value "is a JSON number read as a signed integer."
    }
    unsigned {
        enum_values payload.UnsignedEntry[] {
            @doc value "maps text labels in the document to values."
        }
        default     payload.Unsigned?       {
            @doc value """
                is the raw value, before scale and offset, when a read finds none or no
                channel is bound.
            """
        }

        @doc value "is a JSON number read as an unsigned integer."
    }
    string {
        enum_values payload.StringEntry[] {
            @doc value "maps text labels in the document to values."
        }
        default     string?               {
            @doc value "is the value when a read finds none or no channel is bound."
        }

        @doc value "is a JSON string."
    }
    boolean {
        enum_values payload.BooleanEntry[] {
            @doc value "maps text labels in the document to values."
        }
        default     bool?                  {
            @doc value "is the value when a read finds none or no channel is bound."
        }

        @doc value "is a JSON boolean."
    }
    timestamp {
        time_format payload.TimeFormat {
            @doc value "is the encoding of the timestamp."
        }
        default     TimestampDefault?  {
            @doc value "is the value when a read finds none or no channel is bound."
        }

        @doc value "is a timestamp held in a JSON number or string."
    }
    json {
        default string? {
            @doc value """
                is the JSON text of the value when a read finds none or no channel is
                bound.
            """
        }

        @doc value "is any JSON value."
    }
    uuid {
        default UUIDDefault? {
            @doc value "is the value when a read finds none or no channel is bound."
        }

        @doc value "is a UUID held in a JSON string."
    }
    bytes {
        default string? {
            @doc value """
                is the base64 text of the value when a read finds none or no channel is
                bound.
            """
        }

        @doc value "is base64 text held in a JSON string."
    }

    @doc value  """
        is a field read from a JSON document. With no default, a read needs its value
        and a write needs a channel.
    """
    @go marshal
}

JSONBaseMatch struct {
    pointer string = "" {
        @doc value "is the JSON Pointer to the value the rule tests."
    }

    @doc value  "carries the parts every JSON match rule shares."
    @go marshal
}

JSONMatch union on type extends JSONBaseMatch {
    float {
        value payload.Float {
            @doc value "is the float the value must equal."
        }

        @doc value "matches a JSON number equal to a float."
    }
    integer {
        value payload.Integer {
            @doc value "is the signed integer the value must equal."
        }

        @doc value "matches a JSON number equal to a signed integer."
    }
    unsigned {
        value payload.Unsigned {
            @doc value "is the unsigned integer the value must equal."
        }

        @doc value "matches a JSON number equal to an unsigned integer."
    }
    string {
        value string {
            @doc value "is the string the value must equal."
        }

        @doc value "matches an equal JSON string."
    }
    boolean {
        value bool {
            @doc value "is the boolean the value must equal."
        }

        @doc value "matches an equal JSON boolean."
    }
    present {
        @doc value """
            matches a document that holds a value other than null at the pointer.
        """
    }

    @doc value  "selects the JSON documents that belong to a message."
    @go marshal
}

Payload union on format payload.Format {
    binary {
        length     uint16?       {
            @doc value """
                is the payload length in bytes. When absent the length is variable.
            """
        }
        identifier Identifier?   {
            @doc value """
                selects the frames that belong to the message. When absent every frame
                on the bus belongs to it.
            """
        }
        fields     BinaryField[] = [] {
            @doc value "are the values the payload carries."
        }

        @doc value "is a payload of raw bytes."
    }
    text {
        delimiter string = "," {
            @doc value           "splits the items of the line."
            @validate min_length 1
        }
        prefix    string = "" {
            @doc value """
                is the text a line must start with to belong to the message. An empty
                prefix matches every line.
            """
        }
        fields    TextField[] = [] {
            @doc value "are the values the line carries."
        }

        @doc value "is a payload of one text line."
    }
    json {
        match  JSONMatch?  {
            @doc value """
                selects the documents that belong to the message. When absent every
                document belongs to it.
            """
        }
        fields JSONField[] = [] {
            @doc value "are the values the document carries."
        }

        @doc value "is a payload of one JSON document."
    }

    @doc value  "is the layout of a message's payload."
    @go marshal
}

Message struct {
    key        MessageKey = create {
        @doc value "is the unique identifier for the message within its ICD."
    }
    name       string          {
        @doc value           "is the name of the message, unique within its ICD."
        @validate min_length 1
    }
    payload    Payload         {
        @doc value "is the layout of the message's payload."
    }
    cycle_time telem.TimeSpan? {
        @doc value """
            is the send cycle that the protocol states for the message. When absent the
            protocol states none.
        """
    }

    @doc value  "is the layout of one message a system sends or receives."
    @go marshal
}

ChecksumAlgorithm enum {
    crc16_ccitt_false = "crc16_ccitt_false" {
        @doc value "has polynomial 0x1021 and initial value 0xFFFF, with no reflection."
    }
    crc16_modbus      = "crc16_modbus" {
        @doc value "has polynomial 0x8005 and initial value 0xFFFF, reflected."
    }
    crc32             = "crc32" {
        @doc value "is the CRC of Ethernet and zlib."
    }

    @doc value "is a CRC that ends a sync frame."
}

Checksum struct {
    algorithm  ChecksumAlgorithm {
        @doc value "is the CRC that the checksum holds."
    }
    byte_order ByteOrder = little_endian {
        @doc value "is the byte order of the checksum."
    }

    @doc value  "is the CRC that ends a sync frame and covers every byte before it."
    @go marshal
}

LengthSize enum {
    one  = "one" {
        @doc value "is a 1-byte length field."
    }
    two  = "two" {
        @doc value "is a 2-byte length field."
    }
    four = "four" {
        @doc value "is a 4-byte length field."
    }

    @doc value "is the number of bytes in the length field of a sync frame."
}

Framing union on type {
    delimited {
        delimiter string = "\n" {
            @doc value           "is the text whose UTF-8 bytes end each frame."
            @validate min_length 1
        }

        @doc value "ends each frame with a delimiter."
    }
    fixed {
        length uint32 = 1 {
            @doc value    "is the number of bytes in each frame, from 1 to 65536."
            @validate max 65536
            @validate min 1
        }

        @doc value "splits the stream into frames of one length."
    }
    sync {
        sync              bytes      {
            @doc value           "is the byte sequence that starts each frame."
            @validate min_length 1
        }
        length_offset     uint32 = 0 {
            @doc value "is the offset of the length field from the start of the frame."
        }
        length_size       LengthSize = one {
            @doc value "is the number of bytes in the length field."
        }
        byte_order        ByteOrder = little_endian {
            @doc value "is the byte order of the length field."
        }
        length_adjustment int32 = 0 {
            @doc value """
                is added to the length field to give the number of bytes after the
                length field, checksum included.
            """
        }
        checksum          Checksum?  {
            @doc value "is the CRC that ends each frame. Absent when frames have none."
        }
        max_length        uint32 = 65536 {
            @doc value    """
                is the most bytes in a frame, sync included and checksum excluded, from
                1 to 65536. A length field that gives a longer frame marks a corrupt
                frame.
            """
            @validate max 65536
            @validate min 1
        }

        @doc value """
            starts each frame with a sync sequence and a length field. A frame that the
            task reads starts at the sync sequence and has no checksum, so the message
            layout of an ICD can hold the header fields.
        """
    }
    cobs {
        @doc value """
            stuffs each frame with consistent overhead byte stuffing (COBS) and ends it
            with a zero byte.
        """
    }
    slip {
        @doc value """
            escapes each frame with the serial line internet protocol (SLIP, RFC 1055)
            and ends it with an END byte.
        """
    }

    @doc value  "splits a byte stream into frames. The type field selects how."
    @go marshal
}

ICD struct {
    key      Key = create {
        @doc value "is the unique identifier for the ICD."
        @key
    }
    name     string    {
        @doc value           "is a human-readable name for the ICD."
        @search
        @validate min_length 1
    }
    messages Message[] = [] {
        @doc value "are the messages the ICD holds."
    }
    framing  Framing?  {
        @doc value """
            is how a byte stream splits into the ICD's messages, or absent when each
            message arrives whole.
        """
    }

    action Create {
        icd ICD

        @doc value """
            replaces the ICD with the given created state. Emitted by the Core when an
            ICD is created or imported; clients never dispatch it.
        """
    }

    action Set extends patch.Set {
        @doc value "replaces the value at a path in the ICD."
    }

    action Remove extends patch.Remove {
        @doc value "removes an entry from a list or a field from an object in the ICD."
    }

    action Insert extends patch.Insert {
        @doc value "adds an entry to a list in the ICD."
    }

    action Move extends patch.Move {
        @doc value "moves an entry in a list in the ICD."
    }

    @create
    @doc value     """
        is an interface control document: the messages a system sends and receives, and
        how to parse each one.
    """
    @go imex
    @go marshal
    @go migrate
    @resource type "icd"
    @retrieve
}

Where filter ICD {
    key

    @doc value         "is a filter that selects ICDs."
    @go request_output "core/pkg/api/icd"
}

ReadBinding struct {
    field     FieldKey       {
        @doc value "is the key of the message field to read."
    }
    channel   channel.Key = 0 {
        @doc value     "is the channel the value of the field is written to."
        @ref direction write
        @ref kind      use
        @ref on_delete restrict
    }
    data_type telem.DataType = "" {
        @doc value """
            is the data type of the channel that a client creates for the field. Empty
            takes the default of the field's kind. The Core ignores it once the channel
            exists.
        """
        @ts type   "string"
    }

    @doc value  "writes the value of one message field to a channel."
    @go marshal
    @pb omit
}

ReadMessage struct {
    message  MessageKey    {
        @doc value "is the key of the ICD message to read."
    }
    index    FieldKey?     {
        @doc value """
            is the key of the field whose channel indexes the others. Absent when the
            task stamps samples on arrival, or with the timestamp of the Kafka record.
        """
    }
    bindings ReadBinding[] = [] {
        @doc value "are the fields the task reads. A field with no binding is not read."
    }

    @doc value  "reads one message of an ICD."
    @go marshal
    @pb omit
}

WriteValue union on type payload.Kind {
    float {
        value payload.Float {
            @doc value "is the raw value, before scale and offset."
        }

        @doc value "is a fixed float."
    }
    integer {
        value payload.Integer {
            @doc value "is the raw value, before scale and offset."
        }

        @doc value "is a fixed signed integer."
    }
    unsigned {
        value payload.Unsigned {
            @doc value "is the raw value, before scale and offset."
        }

        @doc value "is a fixed unsigned integer."
    }
    string {
        value string {
            @doc value "is the string."
        }

        @doc value "is a fixed string."
    }
    boolean {
        value bool {
            @doc value "is the boolean."
        }

        @doc value "is a fixed boolean."
    }
    timestamp {
        value telem.TimeStamp {
            @doc value "is the timestamp."
        }

        @doc value "is a fixed timestamp."
    }
    json {
        value string {
            @doc value "is the JSON text of the value."
        }

        @doc value "is a fixed JSON value."
    }
    uuid {
        value uuid {
            @doc value "is the UUID."
        }

        @doc value "is a fixed UUID."
    }
    bytes {
        value string {
            @doc value "is the base64 text of the value."
        }

        @doc value "is fixed bytes."
    }

    @doc value  """
        is a fixed value that a write binding sends as its field. Its type is the kind
        of the field.
    """
    @go marshal
    @pb omit
}

WriteBaseBinding struct {
    field FieldKey {
        @doc value "is the key of the message field to fill."
    }

    @doc value  "carries the parts every write binding shares."
    @go marshal
    @pb omit
}

WriteBinding union on type extends WriteBaseBinding {
    channel {
        channel   channel.Key = 0 {
            @doc value     """
                is the command channel whose values the field sends. 0 means that a
                client creates the channel on configure.
            """
            @ref kind      use
            @ref on_delete restrict
        }
        data_type telem.DataType? {
            @doc value """
                is the data type of the command channel that a client creates for the
                field. Absent takes float64 for a scaled field and the default of the
                field's kind for any other. The Core ignores it once the channel exists.
            """
            @ts type   "string"
        }

        @doc value "fills a field with the values of a command channel."
    }
    value {
        value WriteValue {
            @doc value "is the fixed value that the field sends."
        }

        @doc value "fills a field with a fixed value."
    }

    @doc value  "fills one message field with a command channel or a fixed value."
    @go marshal
    @pb omit
}

WriteMessage struct {
    message  MessageKey     {
        @doc value "is the key of the ICD message to send."
    }
    bindings WriteBinding[] = [] {
        @doc value """
            are the fields that command channels or fixed values fill. Each other field
            sends its default.
        """
    }

    @doc value  "sends one message of an ICD."
    @go marshal
    @pb omit
}

BinaryBaseField struct extends BaseField {
    start_bit        uint16 = 0 {
        @doc value """
            is the bit where the field starts, numbered as in a DBC file: the least
            significant bit for little-endian fields and the most significant bit for
            big-endian fields.
        """
    }
    bit_length       uint8 = 8 {
        @doc value    "is the number of bits in the field, from 1 to 64."
        @validate max 64
        @validate min 1
    }
    byte_order       ByteOrder = little_endian {
        @doc value "is the byte order of the field."
    }
    multiplexor      FieldKey? {
        @doc value """
            is the key of the field that selects whether this field is present. When
            absent the field is always present.
        """
    }
    multiplex_values int32[] = [] {
        @doc value """
            are the raw values of the multiplexor for which this field is present.
        """
    }

    @doc value  "carries the parts every binary field shares."
    @go marshal
}
