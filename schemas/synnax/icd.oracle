import "schemas/synnax/channel"
import "schemas/x/filter"
import "schemas/x/patch"
import "schemas/x/payload"
import "schemas/x/telem"

@go output "core/pkg/service/icd"
@py output "client/py/synnax/icd"
@ts output "client/ts/src/icd"

Key = uuid {
    @doc value "is a unique identifier for an ICD."
}

MessageKey = uuid {
    @doc value "is a unique identifier for a message within an ICD."
}

FieldKey = uuid {
    @doc value "is a unique identifier for a field within a message."
}

ImportFormat enum {
    dbc  = "dbc" {
        @doc value "is a Vector CAN database file."
    }
    csv  = "csv" {
        @doc value """
            is a field table in comma-separated values. The first row is a header that
            names each column, in any case: message, id, extended, length, field,
            start_bit, bit_length, byte_order, kind, scale, offset, units, min, and max.
            The message, field, start_bit, and bit_length columns are required. A kind
            is float, integer, or unsigned, and defaults to unsigned. Each other row is
            one binary field, and the rows of one message form one message, with a CAN
            identifier when an id is present.
        """
    }
    xlsx = "xlsx" {
        @doc value """
            is a field table, laid out as for csv, in the first sheet of an Excel
            workbook. A numeric cell is read as its value, whatever its number format.
        """
    }

    @doc value "is the file format of an ICD that an import reads."
}

ByteOrder enum {
    little_endian = "little_endian"
    big_endian    = "big_endian"

    @doc value "is the byte order of a multi-byte binary field."
}

Identifier union on type {
    can {
        id               uint32 = 0 {
            @doc value "is the CAN arbitration identifier."
        }
        extended         bool = false {
            @doc value "is true when the identifier is a 29-bit extended identifier."
        }
        fd               bool = false {
            @doc value "is true when the message is sent as a CAN FD frame."
        }
        bitrate_switched bool = false {
            @doc value "is true when a CAN FD frame switches to the data bitrate."
        }
        mask             uint32? {
            @doc value """
                is the bit mask applied to both identifiers before matching. When absent
                the identifiers must match exactly.
            """
        }

        @doc value "matches a CAN frame by arbitration identifier."
    }
    field {
        field FieldKey {
            @doc value "is the key of the message field that holds the identifier."
        }
        value int32 = 0 {
            @doc value "is the raw value the field must hold."
        }

        @doc value "matches a binary frame by the raw value of one of its fields."
    }

    @doc value  "selects which frames on a bus belong to a binary message."
    @go marshal
}

BaseField struct {
    key    FieldKey = create {
        @doc value "is the unique identifier for the field within its message."
    }
    name   string   {
        @doc value           "is the name of the field, unique within its message."
        @validate min_length 1
    }
    scale  float64 = 1 {
        @doc value "multiplies the raw value on decode."
    }
    offset float64 = 0 {
        @doc value "is added to the scaled value on decode."
    }
    units  string = "" {
        @doc value "is the engineering unit of the decoded value."
    }
    min    float64? {
        @doc value """
            is the smallest decoded value a write task accepts. When absent the field's
            encoding sets the limit.
        """
    }
    max    float64? {
        @doc value """
            is the largest decoded value a write task accepts. When absent the field's
            encoding sets the limit.
        """
    }

    @doc value  "carries the parts every message field shares."
    @go marshal
}

BinaryField struct extends BaseField {
    start_bit        uint16 = 0 {
        @doc value """
            is the bit where the field starts, numbered as in a DBC file: the least
            significant bit for little-endian fields and the most significant bit for
            big-endian fields.
        """
    }
    bit_length       uint8 = 8 {
        @doc value    "is the number of bits in the field, from 1 to 64."
        @validate max 64
        @validate min 1
    }
    byte_order       ByteOrder = little_endian {
        @doc value "is the byte order of the field."
    }
    kind             payload.Kind = unsigned {
        @doc value """
            is the kind of the raw bits: an IEEE 754 float of 32 or 64 bits, a two's
            complement integer, or an unsigned integer. No other kind is valid.
        """
    }
    multiplexor      FieldKey?    {
        @doc value """
            is the key of the field that selects whether this field is present. When
            absent the field is always present.
        """
    }
    multiplex_values int32[] = [] {
        @doc value """
            are the raw values of the multiplexor for which this field is present.
        """
    }

    @doc value  "is a field read from a bit range of a binary payload."
    @go marshal
}

TextField union on encoding extends BaseField {
    delimited {
        position uint32 = 0 {
            @doc value "is the zero-based item index after splitting on the delimiter."
        }

        @doc value "is a field read from one item of a delimited text line."
    }
    tagged {
        tag string {
            @doc value "is the text that comes just before the value in the line."
        }

        @doc value "is a field read from the text that follows a tag."
    }

    @doc value  "is a field read from a text line."
    @go marshal
}

JSONBaseField struct extends BaseField {
    pointer string = "" {
        @doc value """
            is the JSON Pointer to the value in the document. An empty pointer is the
            whole document.
        """
    }

    @doc value  "carries the parts every JSON field shares."
    @go marshal
}

JSONField union on type payload.Kind extends JSONBaseField {
    float {
        enum_values payload.FloatEntry[] {
            @doc value "maps text labels in the document to values."
        }
        default     payload.Float?       {
            @doc value "is the value when the document has none. Absent requires one."
        }

        @doc value "is a JSON number read as a float."
    }
    integer {
        enum_values payload.IntegerEntry[] {
            @doc value "maps text labels in the document to values."
        }
        default     payload.Integer?       {
            @doc value "is the value when the document has none. Absent requires one."
        }

        @doc value "is a JSON number read as a signed integer."
    }
    unsigned {
        enum_values payload.UnsignedEntry[] {
            @doc value "maps text labels in the document to values."
        }
        default     payload.Unsigned?       {
            @doc value "is the value when the document has none. Absent requires one."
        }

        @doc value "is a JSON number read as an unsigned integer."
    }
    string {
        enum_values payload.StringEntry[] {
            @doc value "maps text labels in the document to values."
        }
        default     string?               {
            @doc value "is the value when the document has none. Absent requires one."
        }

        @doc value "is a JSON string."
    }
    boolean {
        enum_values payload.BooleanEntry[] {
            @doc value "maps text labels in the document to values."
        }
        default     bool?                  {
            @doc value "is the value when the document has none. Absent requires one."
        }

        @doc value "is a JSON boolean."
    }
    timestamp {
        time_format payload.TimeFormat {
            @doc value "is the encoding of the timestamp."
        }
        default     telem.TimeStamp?   {
            @doc value "is the value when the document has none. Absent requires one."
        }

        @doc value "is a timestamp held in a JSON number or string."
    }
    json {
        @doc value "is any JSON value."
    }
    uuid {
        @doc value "is a UUID held in a JSON string."
    }
    bytes {
        @doc value "is base64 text held in a JSON string."
    }

    @doc value  "is a field read from a JSON document."
    @go marshal
}

JSONBaseMatch struct {
    pointer string = "" {
        @doc value "is the JSON Pointer to the value the rule tests."
    }

    @doc value  "carries the parts every JSON match rule shares."
    @go marshal
}

JSONMatch union on type extends JSONBaseMatch {
    float {
        value payload.Float {
            @doc value "is the float the value must equal."
        }

        @doc value "matches a JSON number equal to a float."
    }
    integer {
        value payload.Integer {
            @doc value "is the signed integer the value must equal."
        }

        @doc value "matches a JSON number equal to a signed integer."
    }
    unsigned {
        value payload.Unsigned {
            @doc value "is the unsigned integer the value must equal."
        }

        @doc value "matches a JSON number equal to an unsigned integer."
    }
    string {
        value string {
            @doc value "is the string the value must equal."
        }

        @doc value "matches an equal JSON string."
    }
    boolean {
        value bool {
            @doc value "is the boolean the value must equal."
        }

        @doc value "matches an equal JSON boolean."
    }

    @doc value  "selects the JSON documents that belong to a message."
    @go marshal
}

Payload union on format payload.Format {
    binary {
        length     uint16?       {
            @doc value """
                is the payload length in bytes. When absent the length is variable.
            """
        }
        identifier Identifier?   {
            @doc value """
                selects the frames that belong to the message. When absent every frame
                on the bus belongs to it.
            """
        }
        fields     BinaryField[] = [] {
            @doc value "are the values the payload carries."
        }

        @doc value "is a payload of raw bytes."
    }
    text {
        delimiter string = "," {
            @doc value           "splits the items of the line."
            @validate min_length 1
        }
        prefix    string = "" {
            @doc value """
                is the text a line must start with to belong to the message. An empty
                prefix matches every line.
            """
        }
        fields    TextField[] = [] {
            @doc value "are the values the line carries."
        }

        @doc value "is a payload of one text line."
    }
    json {
        match  JSONMatch?  {
            @doc value """
                selects the documents that belong to the message. When absent every
                document belongs to it.
            """
        }
        fields JSONField[] = [] {
            @doc value "are the values the document carries."
        }

        @doc value "is a payload of one JSON document."
    }

    @doc value  "is the layout of a message's payload."
    @go marshal
}

Message struct {
    key     MessageKey = create {
        @doc value "is the unique identifier for the message within its ICD."
    }
    name    string     {
        @doc value           "is the name of the message, unique within its ICD."
        @validate min_length 1
    }
    payload Payload    {
        @doc value "is the layout of the message's payload."
    }

    @doc value  "is the layout of one message a system sends or receives."
    @go marshal
}

ICD struct {
    key      Key = create {
        @doc value "is the unique identifier for the ICD."
        @key
    }
    name     string    {
        @doc value           "is a human-readable name for the ICD."
        @search
        @validate min_length 1
    }
    messages Message[] = [] {
        @doc value "are the messages the ICD holds."
    }

    action Create {
        icd ICD

        @doc value """
            replaces the ICD with the given created state. Emitted by the Core when an
            ICD is created or imported; clients never dispatch it.
        """
    }

    action Set extends patch.Set {
        @doc value "replaces the value at a path in the ICD."
    }

    action Remove extends patch.Remove {
        @doc value "removes an entry from a list or a field from an object in the ICD."
    }

    action Insert extends patch.Insert {
        @doc value "adds an entry to a list in the ICD."
    }

    action Move extends patch.Move {
        @doc value "moves an entry in a list in the ICD."
    }

    @create
    @doc value     """
        is an interface control document: the messages a system sends and receives, and
        how to parse each one.
    """
    @go imex
    @go marshal
    @go migrate
    @resource type "icd"
    @retrieve
}

Where filter ICD {
    key

    @doc value         "is a filter that selects ICDs."
    @go request_output "core/pkg/api/icd"
}

ReadBinding struct {
    field     FieldKey       {
        @doc value "is the key of the message field to read."
    }
    channel   channel.Key = 0 {
        @doc value     "is the channel the value of the field is written to."
        @ref kind      use
        @ref on_delete restrict
    }
    data_type telem.DataType = "" {
        @doc value """
            is the data type of the channel that a client creates for the field. Empty
            takes the default of the field's kind. The Core ignores it once the channel
            exists.
        """
        @ts type   "string"
    }

    @doc value  "writes the value of one message field to a channel."
    @go marshal
}

ReadMessage struct {
    message  MessageKey    {
        @doc value "is the key of the ICD message to read."
    }
    index    FieldKey?     {
        @doc value """
            is the key of the field whose channel indexes the others. Absent when the
            task stamps samples on arrival, or with the timestamp of the Kafka record.
        """
    }
    bindings ReadBinding[] = [] {
        @doc value "are the fields the task reads. A field with no binding is not read."
    }

    @doc value  "reads the documents of one ICD message."
    @go marshal
}
