import "schemas/synnax/channel"
import "schemas/synnax/device"
import "schemas/synnax/task"
import "schemas/x/telem"

@cpp output "client/cpp/ethercat"
@go output  "core/pkg/service/ethercat"
@py output  "client/py/synnax/ethercat"
@ts output  "client/ts/src/ethercat"

BaseReadChannel struct {
    key      string = create {
        @doc value "uniquely identifies the channel within the task."
        @key
    }
    name     string = "" {
        @doc value "is the human-readable channel name."
    }
    disabled bool = false {
        @doc value "is true when the channel is excluded from acquisition."
    }
    channel  channel.Key = 0 {
        @doc value "is the Synnax channel that raw samples are written to."
    }
    device   device.Key = "" {
        @doc value "is the key of the slave device the channel reads from."
    }

    @doc value  "carries the fields every EtherCAT read channel shares."
    @go marshal
}

ReadChannel union on type extends BaseReadChannel {
    entry {
        index     uint16         {
            @doc value "is the CoE object dictionary index of the PDO entry."
        }
        sub_index uint8          {
            @doc value "is the CoE object dictionary sub-index of the PDO entry."
        }
        data_type telem.DataType {
            @doc value "is the data type of the PDO entry."
            @ts type   "string"
        }
        scale     Scale = none {
            @doc value """
                is the scale applied to raw samples after acquisition. A scaled channel
                writes to a float Synnax channel.
            """
        }

        @doc value "addresses a PDO entry by its CoE index and sub-index."
    }
    unresolved {
        pdo string {
            @doc value "is the entry name that matched no single entry on the slave."
        }

        @doc value """
            is a channel whose PDO entry name matched no single entry on its slave. It
            must be given an entry before the task runs.
        """
    }

    @doc value  """
        is a single EtherCAT read channel (TxPDO, slave to master). The type field
        selects how the PDO entry is addressed.
    """
    @go marshal
}

BaseWriteChannel struct {
    key                string = create {
        @doc value "uniquely identifies the channel within the task."
        @key
    }
    name               string = "" {
        @doc value "is the human-readable channel name."
    }
    disabled           bool = false {
        @doc value "is true when the channel is excluded from the task."
    }
    cmd_channel        channel.Key = 0 {
        @doc value "is the Synnax channel commands are read from."
    }
    state_channel      channel.Key = 0 {
        @doc value "is the Synnax channel the output state is written to."
    }
    cmd_channel_name   string = "" {
        @doc value "is the human-readable name of the command channel."
    }
    state_channel_name string = "" {
        @doc value "is the human-readable name of the state channel."
    }
    device             device.Key = "" {
        @doc value "is the key of the slave device the channel writes to."
    }

    @doc value  "carries the fields every EtherCAT write channel shares."
    @go marshal
}

WriteChannel union on type extends BaseWriteChannel {
    entry {
        index     uint16         {
            @doc value "is the CoE object dictionary index of the PDO entry."
        }
        sub_index uint8          {
            @doc value "is the CoE object dictionary sub-index of the PDO entry."
        }
        data_type telem.DataType {
            @doc value "is the data type of the PDO entry."
            @ts type   "string"
        }

        @doc value "addresses a PDO entry by its CoE index and sub-index."
    }
    unresolved {
        pdo string {
            @doc value "is the entry name that matched no single entry on the slave."
        }

        @doc value """
            is a channel whose PDO entry name matched no single entry on its slave. It
            must be given an entry before the task runs.
        """
    }

    @doc value  """
        is a single EtherCAT write channel (RxPDO, master to slave). The type field
        selects how the PDO entry is addressed.
    """
    @go marshal
}

ReadConfig struct extends task.ReadConfig {
    channels ReadChannel[] {
        @doc value "are the channels the task acquires."
    }

    @doc value  """
        configures an EtherCAT read task. Each channel addresses a PDO entry on its own
        slave; all slaves must share one network interface.
    """
    @go imex    body
    @go marshal
    @go migrate
}

WriteConfig struct extends task.PersistConfig {
    state_rate     telem.Rate = 25 {
        @doc value "is the rate at which output state is reported to Synnax, in Hertz."
        @ts type   "number"
    }
    execution_rate telem.Rate = 1000 {
        @doc value "is the rate at which commands are applied to the bus, in Hertz."
        @ts type   "number"
    }
    channels       WriteChannel[] {
        @doc value "are the channels the task drives."
    }

    @doc value  """
        configures an EtherCAT write task. Each channel addresses a PDO entry on its own
        slave; all slaves must share one network interface.
    """
    @go imex    body
    @go marshal
    @go migrate
}

ScanConfig struct extends task.ScanConfig {
    @doc value  "configures an EtherCAT scan task."
    @go imex    body
    @go marshal
    @go migrate
}

Scale union on type {
    linear {
        slope  float64 = 1 {
            @doc value "is the multiplier applied to the raw value."
        }
        offset float64 = 0 {
            @doc value "is the offset added after scaling."
        }

        @doc value "maps raw values to engineering units with a slope and offset."
    }
    map {
        pre_scaled_min float64 = 0 {
            @default group "pre_scaled"
            @doc value     "is the lower bound of the raw input range."
        }
        pre_scaled_max float64 = 1 {
            @default group "pre_scaled"
            @doc value     "is the upper bound of the raw input range."
        }
        scaled_min     float64 = 0 {
            @default group "scaled"
            @doc value     "is the lower bound of the scaled output range."
        }
        scaled_max     float64 = 1 {
            @default group "scaled"
            @doc value     "is the upper bound of the scaled output range."
        }

        @doc value "maps a raw range linearly onto a scaled range."
    }
    none {
        @doc value "applies no scaling; the raw value is used directly."
    }

    @doc value  "determines how raw PDO values are transformed to engineering units."
    @go marshal
}
