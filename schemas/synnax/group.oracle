import "schemas/synnax/resource"
import "schemas/x/filter"
import "schemas/x/patch"

@go output "core/pkg/service/group"
@py output "client/py/synnax/group"
@ts output "client/ts/src/group"

Key = uuid {
    @doc value "is a unique identifier for a group, represented as a UUID."
}

Group struct {
    key    Key           {
        @doc value "is the unique identifier for this group."
        @key
    }
    name   string        {
        @doc value         "is a human-readable name for the group."
        @filter
        @index sorted
        @search
        @validate required
    }
    scope  resource.Type {
        @doc value """
            is the type of resource the group's tree holds. It stays the same down a
            chain of groups.
        """
        @filter
    }
    parent resource.ID?  {
        @doc value     "is the group, project, or rack the group sits in, if any."
        @ref acyclic
        @ref kind      place
        @ref on_delete cascade
        @ref types     group project rack
    }

    action Create {
        group Group

        @doc value """
            replaces the group with the given created state. Emitted by the Core when a
            group is created; clients never dispatch it.
        """
    }

    action Set extends patch.Set {
        @doc value "replaces the value at a path in the group."
    }

    action Remove extends patch.Remove {
        @doc value """
            removes an entry from a list or a field from an object in the group.
        """
    }

    action Insert extends patch.Insert {
        @doc value "adds an entry to a list in the group."
    }

    action Move extends patch.Move {
        @doc value "moves an entry in a list in the group."
    }

    action SetParent {
        parent resource.ID?

        @doc value """
            moves the group under parent, or to the top level when parent is empty. A
            move under a new top parent moves the records in the group to the project of
            that top parent.
        """
    }

    @doc value     """
        is a named folder that holds records of the types its scope allows. A group sits
        in its parent, or at the top of its tree when it has none.
    """
    @go marshal
    @go migrate
    @resource type "group"
    @retrieve
}

Where filter Group {
    key
    name
    scope
    parents resource.ID[] {
        @doc value "matches the groups that sit in any of the given resources."
    }
    nested  bool          {
        @doc value """
            matches the groups that sit in a parent, or the top groups when false.
        """
    }

    @doc value         "is a filter that selects groups."
    @go request_output "core/pkg/api/group"
}
