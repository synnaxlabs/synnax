import "schemas/synnax/channel"
import "schemas/synnax/ranger"
import "schemas/x/patch"

@go output "core/pkg/service/ranger/alias"
@ts output "client/ts/src/ranger/alias"

Alias struct {
    range   ranger.Key  {
        @doc value     "is the unique identifier of the range containing this alias."
        @ref kind      place
        @ref on_delete cascade
    }
    channel channel.Key {
        @doc value "is the unique identifier of the channel being aliased."
    }
    alias   string      {
        @doc value    """
            is the human-readable name for the channel within this range context.
        """
        @index lookup
    }

    action Create {
        alias Alias

        @doc value """
            replaces the alias with the given created state. Emitted by the Core when an
            alias is created or overwritten whole; clients never dispatch it.
        """
    }

    action Set = patch.Set

    action Remove = patch.Remove

    action Insert = patch.Insert

    action Move = patch.Move

    @doc value        """
        associates a human-readable string alias with a channel within the context of a
        specific range. Enables semantic naming of channels that varies by range
        context.
    """
    @go marshal
    @go migrate
    @resource type    "range-alias"
    @retrieve indexes
    @retrieve key     "string"
}
