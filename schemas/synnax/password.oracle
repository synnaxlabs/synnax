import "schemas/synnax/ontology"
import "schemas/x/telem"

@go output "core/pkg/service/auth/password"
@py output "client/py/synnax/auth/password"
@ts output "client/ts/src/auth/password"

Key = uuid {
    @doc value "is a unique identifier for a stored password."
    @py omit
    @ts omit
}

Password struct {
    key      Key = create {
        @doc value "is the unique identifier for this password."
        @key
    }
    subject  ontology.ID     {
        @doc value    "is the user the password belongs to."
        @filter
        @index lookup
    }
    username string          {
        @doc value    "is the unique login name presented with the password."
        @filter
        @index lookup
    }
    hash     bytes           {
        @doc value "is the password hash, tagged with the algorithm that made it."
    }
    created  telem.TimeStamp {
        @doc value "is when the password was set."
    }

    @doc value  "is a stored password. A subject holds at most one."
    @go marshal
    @go migrate
    @py omit
    @retrieve
    @ts omit
}

APIPassword struct {
    subject  ontology.ID {
        @doc value "is the user the password logs in as."
    }
    username string      {
        @doc value "is the name the password logs in with."
    }

    @doc value """
        is a password as the API returns it: its subject and username, without its hash.
    """
    @go name   "Password"
    @go output "core/pkg/api/auth/password"
    @py name   "Password"
    @ts name   "Password"
}
