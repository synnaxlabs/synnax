@cpp output "client/cpp/resource"
@go output  "core/pkg/service/resource"
@py output  "client/py/synnax/resource"
@ts output  "client/ts/src/resource"

Type enum {
    arc              = "arc" {
        @doc value "identifies an Arc module."
    }
    builtin          = "builtin" {
        @doc value "identifies a resource that the Core defines."
    }
    channel          = "channel" {
        @doc value "identifies a channel."
    }
    device           = "device" {
        @doc value "identifies a device."
    }
    framer           = "framer" {
        @doc value "identifies the telemetry of a channel."
    }
    group            = "group" {
        @doc value "identifies a group of resources."
    }
    label            = "label" {
        @doc value "identifies a label."
    }
    lineplot         = "lineplot" {
        @doc value "identifies a line plot."
    }
    log              = "log" {
        @doc value "identifies a log."
    }
    node             = "node" {
        @doc value "identifies a node of a cluster."
    }
    panel            = "panel" {
        @doc value "identifies a panel."
    }
    policy           = "policy" {
        @doc value "identifies an access control policy."
    }
    project          = "project" {
        @doc value "identifies a project."
    }
    rack             = "rack" {
        @doc value "identifies a rack."
    }
    range            = "range" {
        @doc value "identifies a range."
    }
    range_alias      = "range-alias" {
        @doc value "identifies a range alias. The Core no longer stores range aliases."
    }
    role             = "role" {
        @doc value "identifies an access control role."
    }
    schematic        = "schematic" {
        @doc value "identifies a schematic."
    }
    schematic_symbol = "schematic_symbol" {
        @doc value "identifies a schematic symbol."
    }
    status           = "status" {
        @doc value "identifies a status."
    }
    table            = "table" {
        @doc value "identifies a table."
    }
    task             = "task" {
        @doc value "identifies a task."
    }
    user             = "user" {
        @doc value "identifies a user."
    }
    view             = "view" {
        @doc value "identifies a view."
    }
    ethercat_master  = "ethercat_master"
    ethercat_slave   = "ethercat_slave"
    http_server      = "http_server"
    labjack_device   = "labjack_device"
    modbus_server    = "modbus_server"
    ni_chassis       = "ni_chassis"
    ni_device        = "ni_device"
    opcua_server     = "opcua_server"
    arc_directory    = "arc_directory"
    secret           = "secret" {
        @doc value "identifies a secret."
    }
    certificate      = "certificate" {
        @doc value "identifies a certificate."
    }

    @doc value "is the type of the resource."
    @pb
}

ID struct {
    type Type   {
        @doc value """
            defines the type of resource the key refers to. For example, a channel is a
            resource of type "channel". A user is a resource of type "user".
        """
    }
    key  string {
        @doc value "is the unique key identifying the resource within its type."
    }

    @cpp hand
    @cpp include "client/cpp/resource/id.h"
    @doc value   """
        is a unique identifier for a Resource. An example:

        userID := ID{
             Key:  "748d31e2-5732-4cb5-8bc9-64d4ad51efe8",
             Type: "user",
        }

        The ID has two elements for several reasons. First, by storing the Type we know
        which service to query for additional info on the Resource. Second, while a Key
        may be unique for a particular resource (e.g. channel), it might not be unique
        across all resources. We need something universally unique across the entire
        Synnax Core.
    """
    @go marshal
    @pb
    @py hand
    @ts hand
}

Resource struct {
    id   ID     {
        @doc value "identifies the record."
    }
    name string {
        @doc value "is the human-readable name of the record."
    }

    @cpp omit
    @doc value "is the ID and name of a record of any type."
    @py hand
    @ts hand
}
