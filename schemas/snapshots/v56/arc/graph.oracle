import "schemas/x/spatial"
import "schemas/arc/ir"

@ts output  "client/ts/src/arc/graph"
@py output  "client/py/synnax/arc/graph"
@go output  "arc/go/graph"
@go version 2
@cpp output "arc/cpp/graph"
@pb

Node struct {
    key      string     {
        @doc value "is the unique identifier for this node instance."
    }
    position spatial.XY {
        @doc value "is the canvas position (x, y) for visual layout."
    }

    @doc value """
        is a visual node in the Arc graph editor representing a function
        instantiation with position data. The function type and input
        parameter values are stored in the graph's inputs map, keyed by the
        node key.
    """
}

Nodes Node[] {
    @doc value "is a collection of visual nodes in an Arc graph."
}

Edge struct extends ir.Edge {
    key string {
        @doc value "is the stable identifier for this edge within the graph."
    }

    @doc value """
        is a dataflow connection between node parameters carrying a stable
        identifier. The key persists across endpoint edits, distinguishing the
        editable graph edge from the keyless ir.Edge consumed by the compiler.
    """
}

Edges Edge[] {
    @doc value "is a collection of graph edges in an Arc graph."
}

Graph struct {
    functions ir.Functions = [] {
        @doc value "contains function definitions available in this graph."
    }
    edges     Edges = [] {
        @doc value "contains dataflow connections between node parameters."
    }
    nodes     Nodes = [] {
        @doc value "contains visual nodes with canvas positions."
    }
    inputs    map<string, record> = {} {
        @doc value        """
            contains per-node inputs keyed by node key. Each value is a JSON
            object holding the node's function type under "type" plus its input
            parameter values. The wire format stores it as an opaque record; the
            client types it per function.
        """
        @ts preserve_case
    }

    @doc value """
        is a visual dataflow graph representation combining IR elements with
        canvas layout for the Arc graph editor.
    """
}
