@ts output  "x/ts/src/text"
@go output  "x/go/text"
@go version 0
@py output  "x/py/x/text"
@cpp output "x/cpp/text"
@pb

Level enum {
    h1    = "h1"    { @doc value "is the largest heading level." }
    h2    = "h2"    { @doc value "is the second-largest heading level." }
    h3    = "h3"    { @doc value "is the third-largest heading level." }
    h4    = "h4"    { @doc value "is the fourth-largest heading level." }
    h5    = "h5"    { @doc value "is the smallest heading level." }
    p     = "p"     { @doc value "is the standard paragraph level." }
    small = "small" { @doc value "is the smallest level, used for captions and annotations." }

    @doc value """
        is a typography level identifier shared across visualizations.
        Mirrors the heading ladder (h1 through h5) plus paragraph (p) and
        small. Order is descending: h1 is the largest, small is the
        smallest.
    """
    @py omit
    @cpp omit
}
