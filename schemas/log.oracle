import "schemas/channel"
import "schemas/color"
import "schemas/notation"
import "schemas/telem"

@ts output "client/ts/src/log"
@go output "core/pkg/service/log"

Key = uuid {
    @doc value "is a unique identifier for a log, represented as a UUID."
}

TimestampConfig struct {
    format telem.TimestampFormat {
        @doc value "controls how channel timestamps are rendered."
    }
    tz     telem.TimeZone        {
        @doc value "is the time zone used when rendering timestamps."
    }

    @doc value "is per-channel timestamp display configuration."
}

ChannelEntry struct {
    channel   channel.Key       {
        @doc value "is the channel this entry references."
    }
    color     color.Color       {
        @doc value "is the display color for the channel."
    }
    notation  notation.Notation = "standard" {
        @doc value "is the numeric notation used to render samples."
    }
    precision int32 = -1 {
        @doc value    """
            is the number of decimal digits to display. -1 means "use the
            log-level precision"; 17 is the maximum significant digits for a
            float64.
        """
        @validate min -1
        @validate max 17
    }
    alias     string = "" {
        @doc value "is a human-readable alias displayed in place of the channel name."
    }
    timestamp TimestampConfig = { format "preciseDate", tz "local" } {
        @doc value "is the per-channel timestamp display configuration."
    }

    @doc value "is a per-channel display configuration entry within a log."
}

Log struct {
    key                    Key            {
        @doc value "is the unique identifier for this log."
        @key
    }
    name                   string         {
        @doc value "is a human-readable name for the log."
    }
    channels               ChannelEntry[] = empty {
        @doc value "are the channels displayed in this log, in order."
    }
    remote_created         bool = false {
        @doc value "indicates whether the log was created on a remote client."
    }
    timestamp_precision    int32 = 0 {
        @doc value    "is the precision of displayed timestamps (0-3)."
        @validate min 0
        @validate max 3
    }
    show_channel_names     bool = true {
        @doc value "controls whether channel names are displayed."
    }
    show_receipt_timestamp bool = true {
        @doc value "controls whether the receipt timestamp column is displayed."
    }

    @doc value     """
        is a timestamped event and message logging component. Logs display
        chronological records of events, system messages, and audit trails with
        filtering and formatting capabilities.
    """
    @ontology type "log"
    @go marshal
    @go migrate
    @retrieve
}

New struct extends Log {
    key Key? {
        @doc value """
            is an optional key for the log. If not provided, one will be
            automatically assigned.
        """
    }

    @doc value    "contains parameters for creating a new log."
    @ts use_input
    @go omit
}
