import "schemas/spatial"
import "schemas/ontology"

@ts output "client/ts/src/panel"
@go output "core/pkg/service/panel"
@pb

TabKey = uuid

Tab struct {
    key  TabKey {
        @doc value """
            is the stable unique identifier of this tab within the panel. It is
            independent of the tab's content, so a tab's content may be swapped
            without changing the tab's identity or position.
        """
    }
    type string {
        @doc value """
            selects the renderer for the tab's content (e.g. 'lineplot',
            'schematic', 'docs', 'selector'). For core-backed content it is also
            the ontology resource type.
        """
    }
    args record {
        @doc value        """
            is an opaque, Console-owned payload carrying the tab's content
            configuration (e.g. a backing resource key, name, view-specific
            settings). Core never interprets it; it round-trips as-is.
        """
        @ts preserve_case
    }

    @doc value """
        is a single tab in a leaf: a stable key, a renderer type, and an opaque,
        Console-owned args payload. The same content may be referenced by multiple
        tabs in the same or other panels.
    """
}

Leaf struct {
    tabs Tab[] {
        @doc value "is the ordered list of tabs in this leaf."
    }

    @doc value "is a leaf node in the panel tree displaying a tab strip."
}

Split struct {
    direction spatial.Direction {
        @doc value "is the axis along which this node is split."
    }
    size      spatial.Decimal   {
        @doc value """
            is the fraction in [0, 1] of the parent area allocated to first.
            The remainder is allocated to last.
        """
    }
    first     Node              {
        @doc value "is the first child (left for x, top for y)."
    }
    last      Node              {
        @doc value "is the second child (right for x, bottom for y)."
    }

    @doc value "is an interior split node dividing its area between two children."
}

Node union on variant {
    leaf  Leaf
    split Split

    @doc value """
        is a node in the panel tree: either a leaf displaying a tab strip
        or an interior split. Nodes are identified by path-derived numeric
        keys during traversal (1 = root, 2k = first child, 2k+1 = last child).
    """
}

Key = uuid {
    @doc value "is a unique identifier for a panel, represented as a UUID."
}

Panel struct {
    key    Key           {
        @doc value "is the unique identifier for this panel."
        @key
    }
    name   string        {
        @doc value         "is a human-readable name for the panel."
        @validate required
    }
    root   Node          {
        @doc value "is the root of the panel tree."
    }
    parent ontology.ID?? {
        @doc value  """
            is an optional parent resource for the panel in the ontology.
            When absent on create, the panel is parented to the creating
            user as a draft. Parenthood lives in the ontology graph, so the
            field is not persisted on the panel record and is absent on
            retrieve.
        """
        @go marshal omit
    }

    action Rename {
        name string

        @doc value """
            renames the panel. When the panel is owned by a user (draft),
            the writer promotes it to project ownership in the same
            transaction.
        """
    }

    action InsertTab {
        tab         Tab
        target_leaf int32??
        target_tab  TabKey??
        index       int32??
        location    spatial.Location??

        @doc value """
            inserts a tab into a leaf at the given index, appending when index
            is absent. The destination leaf is resolved from target_tab (the
            leaf holding that tab) when set, otherwise from the target_leaf
            path-derived key, otherwise the first leaf in traversal order. When
            location is an edge, the resolved leaf is first split at that
            location and the tab is inserted into the new empty leaf; a center
            location places the tab directly in the resolved leaf, equivalent
            to absent.
        """
    }

    action RemoveTab {
        key uuid

        @doc value """
            removes the tab with the given key. If the containing leaf
            becomes empty and has a sibling, the reducer collapses the
            parent split.
        """
    }

    action MoveTab {
        key         uuid
        target_leaf int32
        index       int32??
        location    spatial.Location??

        @doc value """
            moves a tab to a position within the panel. When location is an
            edge, the target leaf is first split at that location and the
            tab moves into the new empty leaf; moving a leaf's only tab to
            an edge of its own leaf is a no-op. A center location places the
            tab directly in the target leaf, equivalent to absent.
            Cross-panel moves are RemoveTab on the source plus InsertTab on
            the destination (two dispatches; not atomic).
        """
    }

    action SplitTab {
        key       uuid
        direction spatial.Direction

        @doc value """
            splits the tab with the given key off its leaf into a new sibling
            pane, moving the tab into it. direction x places the new pane to
            the right, y to the bottom. The tab must share its leaf with at
            least one other tab; splitting the only tab in a leaf is a no-op.
        """
    }

    action ResizeSplit {
        split int32
        size  spatial.Decimal

        @doc value "adjusts the size ratio of a split node. size in [0, 1]."
    }

    action SetTabType {
        key  uuid
        type string

        @doc value """
            replaces the renderer type of the tab with the given key, leaving its
            args untouched and without changing the tab's identity or position.
        """
    }

    action SetTabArgs {
        key  uuid
        args record {
            @ts preserve_case
        }

        @doc value """
            replaces the args of the tab with the given key, leaving its type
            untouched and without changing the tab's identity or position.
        """
    }

    @doc value     """
        is a tab in a project owning a tree of visualization tabs. A panel
        is owned by a project (project panel) or by a user (draft);
        renaming a draft promotes it to project ownership.
    """
    @ontology type "panel"
    @retrieve
    @search
    @go marshal
    @go migrate
}

New struct extends Panel {
    key  = create
    root = { variant = "leaf", tabs = [] }

    @doc value    "contains parameters for creating a new panel."
    @ts use_input
    @go omit
    @pb omit
}
