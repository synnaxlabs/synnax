@cpp output "x/cpp/color"
@go output  "x/go/color"
@pb
@py output  "x/py/x/color"
@ts output  "x/ts/src/color"

Color struct {
    r uint8   {
        @doc value "is the red component (0-255)."
    }
    g uint8   {
        @doc value "is the green component (0-255)."
    }
    b uint8   {
        @doc value "is the blue component (0-255)."
    }
    a float64 {
        @doc value "is the alpha component (0-1)."
    }

    @cpp hand
    @cpp include "x/cpp/color/color.h"
    @doc value   "is an RGBA color with RGB as 0-255 and alpha as 0-1."
    @go marshal
    @py hand
    @ts hand
    @ts include  "x/ts/src/color/color"
}

Stop struct {
    key      string  {
        @doc value "is the unique identifier for the stop."
    }
    color    Color   {
        @doc value "is the color at this stop."
    }
    position float64 {
        @doc value "is the normalized position of the stop along the gradient [0, 1]."
    }
    switched bool?   {
        @doc value "indicates whether the stop's color has been switched by the user."
    }

    @doc value  "is a single color stop in a gradient."
    @go marshal
    @py omit
    @ts hand
}

Band struct {
    key       string  {
        @doc value "is the unique identifier for the band."
    }
    threshold float64 {
        @doc value "is the lowest value, in the value's units, that the band paints."
    }
    color     Color   {
        @doc value "is the fill painted while the value is in the band."
    }
    flashing  bool = false {
        @doc value "is true when the fill blinks while the value is in the band."
    }

    @cpp omit
    @doc value  "is a colored range of values starting at a threshold."
    @go marshal
    @pb omit
    @py omit
}

Scale struct {
    bands  Band[] = [] {
        @doc value """
            is the list of threshold bands. A band paints values at or above its
            threshold and below the next higher threshold.
        """
    }
    smooth bool = false {
        @doc value "is true when the fill interpolates between band colors."
    }

    @cpp omit
    @doc value  "maps a value to a color through threshold bands."
    @go marshal
    @pb omit
    @py omit
}
