@cpp output "x/cpp/filter"
@go output  "x/go/filter"
@pb
@py output  "x/py/x/filter"
@ts output  "x/ts/src/filter"

String struct {
    eq               string?   {
        @doc value "matches a value equal to eq."
    }
    in               string[]? {
        @doc value "matches a value equal to an element of in."
    }
    contains         string?   {
        @doc value "matches a value that holds contains."
    }
    starts_with      string?   {
        @doc value "matches a value that begins with starts_with."
    }
    regex            string?   {
        @doc value "matches a value that the unanchored RE2 pattern regex matches."
    }
    case_insensitive bool = false {
        @doc value "makes every operator on the slot ignore case."
    }

    @doc value  "selects string values. A value must match every operator that is set."
    @go marshal
}

Bool struct {
    eq bool? {
        @doc value "matches a value equal to eq."
    }

    @doc value  "selects boolean values."
    @go marshal
}

Set struct<T> {
    eq T?   {
        @doc value "matches a value equal to eq."
    }
    in T[]? {
        @doc value "matches a value equal to an element of in."
    }

    @doc value  """
        selects values that only compare for equality, such as keys, enum values, and
        UUIDs. A value must match every operator that is set.
    """
    @go marshal
    @pb omit
}

Ordered struct<T> {
    eq  T?   {
        @doc value "matches a value equal to eq."
    }
    in  T[]? {
        @doc value "matches a value equal to an element of in."
    }
    gt  T?   {
        @doc value "matches a value greater than gt."
    }
    gte T?   {
        @doc value "matches a value greater than or equal to gte."
    }
    lt  T?   {
        @doc value "matches a value less than lt."
    }
    lte T?   {
        @doc value "matches a value less than or equal to lte."
    }

    @doc value  """
        selects numbers and times. A value must match every operator that is set.
    """
    @go marshal
    @pb omit
}

Contains struct<T> {
    any T[]? {
        @doc value "matches an array that holds an element of any."
    }

    @doc value  "selects arrays by the elements they hold."
    @go marshal
    @pb omit
}
