@cpp output "x/cpp/patch"
@go output  "x/go/patch"
@py output  "x/py/x/patch"
@ts output  "x/ts/src/patch"

Guard struct {
    path  string[] {
        @doc value "is the path to a discriminator that the action's path crosses."
    }
    value string   {
        @doc value "is the discriminator value that the action was written for."
    }

    @doc value """
        holds an action to the variant of a discriminated union that it was written for.
        An action with a guard that does not match the document does nothing.
    """
}

Set struct {
    path   string[] {
        @doc value """
            is the path to the value. A segment into a list names the key of an entry.
        """
    }
    value  any      {
        @doc value        "is the new value."
        @ts preserve_case
    }
    guards Guard[] = [] {
        @doc value "are the variant guards for the path."
    }

    @doc value """
        replaces the value at a path. It creates the absent objects on the path, and
        does nothing when the path goes through a missing list entry.
    """
}

Remove struct {
    path   string[] {
        @doc value "is the path to the list or object."
    }
    key    string   {
        @doc value "is the key of the list entry or the name of the object field."
    }
    guards Guard[] = [] {
        @doc value "are the variant guards for the path."
    }

    @doc value "removes an entry from a list or a field from an object."
}

Insert struct {
    path   string[] {
        @doc value "is the path to the list."
    }
    value  any      {
        @doc value        "is the new entry. It is an object with a string key."
        @ts preserve_case
    }
    after  string?  {
        @doc value """
            is the key of the entry that the new entry goes after. The entry goes first
            when absent, and last when no entry has the key.
        """
    }
    guards Guard[] = [] {
        @doc value "are the variant guards for the path."
    }

    @doc value """
        adds an entry to a list. It does nothing when an entry with the same key exists.
    """
}

Move struct {
    path   string[] {
        @doc value "is the path to the list."
    }
    key    string   {
        @doc value "is the key of the entry to move."
    }
    after  string?  {
        @doc value """
            is the key of the entry that the moved entry goes after. The entry goes
            first when absent, and last when no other entry has the key.
        """
    }
    guards Guard[] = [] {
        @doc value "are the variant guards for the path."
    }

    @doc value "moves an entry in a list. It does nothing when the entry is missing."
}

ListMove struct<K> {
    key   K  {
        @doc value "is the key of the entry to move."
    }
    after K? {
        @doc value """
            is the key of the entry that the moved entry goes after. The entry goes
            first when after is absent or null.
        """
    }

    @doc value "moves an entry of a list after another entry."
    @pb omit
}

List struct<E, K, U> {
    set    E[]?           {
        @doc value "replaces the whole list. It cannot hold any other operator."
    }
    insert E[]?           {
        @doc value "adds entries at the end of the list."
    }
    remove K[]?           {
        @doc value "removes the entries with these keys."
    }
    update U[]?           {
        @doc value "merges partial entries into the entries with the same keys."
    }
    move   ListMove<K>[]? {
        @doc value "moves entries in the order given."
    }

    @doc value  """
        changes a list of entries that have a key. The operators apply in the order
        remove, update, insert, then move. A key that is missing, or an insert of a key
        that exists, fails the update.
    """
    @pb omit
    @ts hand
    @ts include "x/ts/src/patch/field"
}

ValueList struct<E> {
    set    E[]?           {
        @doc value "replaces the whole list. It cannot hold any other operator."
    }
    insert E[]?           {
        @doc value "adds values at the end of the list."
    }
    remove E[]?           {
        @doc value "removes these values."
    }
    move   ListMove<E>[]? {
        @doc value "moves values in the order given."
    }

    @doc value  """
        changes a list of values that are their own keys. The operators apply in the
        order remove, insert, then move. A value that is missing, or an insert of a
        value that exists, fails the update.
    """
    @pb omit
    @ts hand
    @ts include "x/ts/src/patch/field"
}

Update struct<V> {
    value  V       {
        @doc value "is the partial record that the update applies."
    }
    guards Guard[] = [] {
        @doc value """
            are the variant guards that must hold in the stored record before the update
            applies.
        """
    }

    @doc value  "changes a record by a partial record."
    @pb omit
    @py hand
    @py include "x/py/x/patch/update"
}

Change struct<T> {
    @cpp hand
    @cpp include "x/cpp/patch/change.h"
    @doc value   """
        is the change that an update makes to one field: none, a new value, or a clear.
        Its JSON form is absent for no change, null for a clear, and the value
        otherwise.
    """
    @go hand
    @pb omit
    @py hand
    @ts hand
    @ts include  "x/ts/src/patch/field"
}

Struct struct<U, T> {
    @cpp hand
    @cpp include "x/cpp/patch/change.h"
    @doc value   """
        is the change that an update makes to a struct field: a merge of the partial U,
        or a replacement by the whole T. Its JSON form is an object with only a "set"
        member for a replacement, and the partial otherwise.
    """
    @go hand
    @pb omit
    @py hand
    @ts hand
    @ts include  "x/ts/src/patch/field"
}
