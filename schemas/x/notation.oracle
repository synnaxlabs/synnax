@ts output  "x/ts/src/notation"
@go output  "x/go/notation"
@go version 0
@py output  "x/py/x/notation"
@cpp output "x/cpp/notation"
@pb

Notation enum {
    standard    = "standard" {
        @doc value "renders samples as plain decimal numbers."
    }
    scientific  = "scientific" {
        @doc value "renders samples in scientific notation with a single leading digit."
    }
    engineering = "engineering" {
        @doc value "renders samples in engineering notation with exponents in multiples of three."
    }

    @doc value "is the numeric notation used to render samples."
    @py omit
    @cpp omit
}
