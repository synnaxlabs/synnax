@go output "x/go/notation"
@py output "x/py/x/notation"
@ts output "x/ts/src/notation"

Notation enum {
    standard    = "standard" {
        @doc value "renders a plain decimal number."
    }
    scientific  = "scientific" {
        @doc value "renders a mantissa below 10 and an exponent."
    }
    engineering = "engineering" {
        @doc value """
            renders a mantissa below 1000 and an exponent that is a multiple of 3.
        """
    }

    @doc value "is the numeric notation used to render samples."
}
