@cpp output "x/cpp/http"
@go output  "x/go/http"
@py output  "x/py/x/http"
@ts output  "x/ts/src/http"

Method enum {
    get     = "GET" {
        @doc value "reads a resource."
    }
    head    = "HEAD" {
        @doc value "reads the headers of a resource, with no body."
    }
    post    = "POST" {
        @doc value "submits data to a resource."
    }
    put     = "PUT" {
        @doc value "replaces a resource."
    }
    delete  = "DELETE" {
        @doc value "removes a resource."
    }
    patch   = "PATCH" {
        @doc value "changes part of a resource."
    }
    options = "OPTIONS" {
        @doc value "asks which communication options a resource supports."
    }
    query   = "QUERY" {
        @doc value "reads a resource with a query in the body, safely and idempotently."
    }

    @doc value "is the HTTP method used when requesting an endpoint."
}

Header struct {
    name  string {
        @doc value         "is the header name."
        @go validate       pattern "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$" "Header name must be a token, with no spaces or separators"
        @validate required
    }
    value string = "" {
        @doc value   "is the header value."
        @go validate pattern "^([^[:cntrl:]]|[[:blank:]])*$" "Header value must not contain a control character other than a space or a tab"
    }

    @doc value  "is a single HTTP header sent with a request."
    @go marshal
}

QueryParam struct {
    parameter string {
        @doc value         "is the parameter name."
        @validate required
    }
    value     string = "" {
        @doc value "is the parameter value."
    }

    @doc value  "is a single URL query parameter sent with a request."
    @go marshal
}
