@cpp output "x/cpp/telem"
@go output  "x/go/telem"
@pb
@py output  "x/py/x/telem"
@ts output  "x/ts/src/telem"

TimeStamp int64 {
    @cpp hand
    @doc value """
        is a 64-bit signed integer representing nanoseconds since the Unix epoch
        (1970-01-01 00:00:00 UTC). Provides nanosecond precision for high-frequency
        telemetry timestamps.
    """
    @py hand
    @ts hand
}

TimeSpan int64 {
    @cpp hand
    @doc value """
        is a 64-bit signed integer representing a duration in nanoseconds. Used for
        expressing time intervals, sampling periods, and durations throughout the
        telemetry system.
    """
    @py hand
    @ts hand
}

TimeRange struct {
    start TimeStamp {
        @doc value "is the inclusive start of the time range."
    }
    end   TimeStamp {
        @doc value "is the exclusive end of the time range."
    }

    @cpp hand
    @doc value  """
        is a time interval defined by a start and end timestamp. The range is
        start-inclusive and end-exclusive, following standard interval conventions for
        predictable boundary handling.
    """
    @go marshal
    @py hand
    @ts hand
}

TimeRangeBounded = TimeRange {
    @cpp omit
    @doc value """
        is a TimeRange alias used for type-safety in contexts requiring bounded time
        ranges.
    """
    @go omit
    @py omit
    @ts hand
}

NumericTimeSpan = TimeSpan {
    @cpp omit
    @doc value """
        is a TimeSpan alias whose TypeScript form is a plain number, for plain-data
        document state.
    """
    @go omit
    @py omit
    @ts hand
}

NumericTimeStamp = TimeStamp {
    @cpp omit
    @doc value """
        is a TimeStamp alias whose TypeScript form is a plain number, for plain-data
        document state.
    """
    @go omit
    @py omit
    @ts hand
}

Rate float64 {
    @cpp hand
    @doc value """
        is a data sampling rate expressed in Hertz (Hz). Used to specify acquisition
        frequencies and calculate sample counts over time intervals.
    """
    @py hand
    @ts hand
}

Size int64 {
    @cpp hand
    @doc value """
        is a byte measurement used for storage capacity and data volume representation.
        Supports conversion to human-readable formats (B, kB, MB, GB, TB).
    """
    @py hand
    @ts hand
}

Alignment uint64 {
    @cpp hand
    @doc value """
        is a 64-bit index for positioning samples within multi-array structures. Packs a
        domain index (which array) and sample index (position within array) into a
        single value for efficient multi-dimensional data access.
    """
    @py hand
    @ts hand
}

DataType string {
    @cpp hand
    @doc value """
        is a string identifier specifying the format of telemetry samples. Supports
        fixed-density types (float64, int32, timestamp, etc.) with known byte sizes and
        variable-density types (String, JSON, Bytes) for flexible data storage.
    """
    @py hand
    @ts hand
}

TimestampFormat enum {
    iso         = "ISO"
    isoDate     = "ISODate"
    time        = "time"
    preciseTime = "preciseTime"
    date        = "date"
    preciseDate = "preciseDate"
    dateTime    = "dateTime"

    @cpp omit
    @doc value "is the rendered form of a timestamp displayed alongside a sample."
    @pb omit
    @py omit
}

TimeZone enum {
    local = "local"
    utc   = "UTC"

    @cpp omit
    @doc value "is the time zone used when rendering timestamps."
    @pb omit
    @py omit
}
