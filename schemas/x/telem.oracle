@cpp output "x/cpp/telem"
@go output  "x/go/telem"
@pb
@py output  "x/py/x/telem"
@ts output  "x/ts/src/telem"

TimeStamp int64 {
    @cpp hand
    @doc value """
        is a 64-bit signed integer representing nanoseconds since the Unix epoch
        (1970-01-01 00:00:00 UTC). Provides nanosecond precision for high-frequency
        telemetry timestamps.
    """
    @py hand
    @ts hand
}

TimeSpan int64 {
    @cpp hand
    @doc value  """
        is a 64-bit signed integer representing a duration in nanoseconds. Used for
        expressing time intervals, sampling periods, and durations throughout the
        telemetry system.
    """
    @py hand
    @py include "x/py/x/telem/telem"
    @ts hand
}

TimeRange struct {
    start TimeStamp {
        @doc value "is the inclusive start of the time range."
    }
    end   TimeStamp {
        @doc value "is the exclusive end of the time range."
    }

    @cpp hand
    @doc value  """
        is a time interval defined by a start and end timestamp. The range is
        start-inclusive and end-exclusive, following standard interval conventions for
        predictable boundary handling.
    """
    @go marshal
    @py hand
    @py include "x/py/x/telem/telem"
    @ts hand
}

TimeRangeBounded = TimeRange {
    @cpp omit
    @doc value """
        is a TimeRange alias used for type-safety in contexts requiring bounded time
        ranges.
    """
    @go omit
    @py omit
    @ts hand
}

NumericTimeSpan = TimeSpan {
    @cpp omit
    @doc value """
        is a TimeSpan alias whose TypeScript form is a plain number, for plain-data
        document state.
    """
    @go omit
    @py omit
    @ts hand
}

StringTimeStamp = TimeStamp {
    @cpp omit
    @doc value """
        is a TimeStamp alias whose TypeScript form is a decimal string, keeping int64
        precision in plain-data document state.
    """
    @go omit
    @py omit
    @ts hand
}

Window union on variant {
    dynamic {
        time_span TimeSpan = 0 {
            @doc value "is the span of the window, which ends at the newest sample."
        }

        @doc value "is a rolling window."
    }
    static {
        time_range TimeRange {
            @doc value "is the fixed window, start-inclusive and end-exclusive."
        }

        @doc value "is a fixed window."
    }

    @cpp omit
    @doc value  "is a window of time: a rolling span or a fixed range."
    @go marshal
    @pb omit
    @ts hand
    @ts include "x/ts/src/telem/telem"
}

Rate float64 {
    @cpp hand
    @doc value    """
        is a data sampling rate expressed in Hertz (Hz). Used to specify acquisition
        frequencies and calculate sample counts over time intervals. A rate is never
        negative.
    """
    @py hand
    @ts hand
    @validate min 0
}

Size int64 {
    @cpp hand
    @doc value """
        is a byte measurement used for storage capacity and data volume representation.
        Supports conversion to human-readable formats (B, kB, MB, GB, TB).
    """
    @py hand
    @ts hand
}

Alignment uint64 {
    @cpp hand
    @doc value """
        is a 64-bit index for positioning samples within multi-array structures. Packs a
        domain index (which array) and sample index (position within array) into a
        single value for efficient multi-dimensional data access.
    """
    @py hand
    @ts hand
}

DataType string {
    @cpp hand
    @doc value """
        is a string identifier specifying the format of telemetry samples. Supports
        fixed-density types (float64, int32, timestamp, etc.) with known byte sizes and
        variable-density types (String, JSON, Bytes) for flexible data storage.
    """
    @py hand
    @ts hand
}

DataTypeCode enum {
    unknown   = 0 {
        @doc value "is never valid on the wire."
    }
    uint8     = 1 {
        @doc value "is the code of uint8."
    }
    uint16    = 2 {
        @doc value "is the code of uint16."
    }
    uint32    = 3 {
        @doc value "is the code of uint32."
    }
    uint64    = 4 {
        @doc value "is the code of uint64."
    }
    int8      = 5 {
        @doc value "is the code of int8."
    }
    int16     = 6 {
        @doc value "is the code of int16."
    }
    int32     = 7 {
        @doc value "is the code of int32."
    }
    int64     = 8 {
        @doc value "is the code of int64."
    }
    float32   = 9 {
        @doc value "is the code of float32."
    }
    float64   = 10 {
        @doc value "is the code of float64."
    }
    timestamp = 11 {
        @doc value "is the code of timestamp."
    }
    uuid      = 12 {
        @doc value "is the code of uuid."
    }
    string    = 13 {
        @doc value "is the code of string."
    }
    bytes     = 14 {
        @doc value "is the code of bytes."
    }
    json      = 15 {
        @doc value "is the code of json."
    }
    boolean   = 16 {
        @doc value "is the code of boolean."
    }

    @cpp includes "x/cpp/telem/telem.h"
    @doc value    """
        is the one-byte code of a data type in the frame codec and in Cesium segments. A
        code never changes once a stable release ships it. Code 255 is reserved for a
        wider code.
    """
    @pb omit
}

Aggregation enum {
    min_max  = "min_max" {
        @doc value """
            keeps the lowest and highest sample of each group in the order they
            occurred.
        """
    }
    average  = "average" {
        @doc value "keeps the mean of each group."
    }
    decimate = "decimate" {
        @doc value "keeps the first sample of each group."
    }

    @cpp omit
    @doc value """
        selects how a limited read collapses each group of samples into points. min_max
        keeps the lowest and highest sample of each group in the order they occurred,
        average keeps the mean of each group, and decimate keeps the first sample of
        each group.
    """
}

Reduction union on variant {
    stride {
        factor uint32 {
            @doc value "is the stride. Values below 2 keep every sample."
        }

        @doc value "keeps every factor-th sample of each series read."
    }
    limit {
        aggregation Aggregation = min_max {
            @doc value "selects the points each group of samples reduces to."
        }
        point_limit uint32      {
            @doc value    "is the number of points each channel reduces to."
            @validate min 1
        }

        @doc value """
            reduces each group of samples so that each channel comes back as about
            point_limit points. Channels on one index reduce over the same groups.
        """
    }

    @cpp omit
    @doc value """
        selects how a read reduces samples. A read without one keeps every sample.
    """
}

TimestampFormat enum {
    iso         = "ISO" {
        @doc value "renders the full ISO 8601 timestamp."
    }
    isoDate     = "ISODate" {
        @doc value "renders only the date of the ISO 8601 form."
    }
    time        = "time" {
        @doc value "renders the time of day to the second."
    }
    preciseTime = "preciseTime" {
        @doc value "renders the time of day to the millisecond."
    }
    date        = "date" {
        @doc value "renders the short month and the day."
    }
    preciseDate = "preciseDate" {
        @doc value "renders the short month, the day, and the time to the millisecond."
    }
    dateTime    = "dateTime" {
        @doc value "renders the short month, the day, and the time to the second."
    }

    @cpp omit
    @doc value "is the rendered form of a timestamp displayed alongside a sample."
    @pb omit
}

TimeZone enum {
    local = "local" {
        @doc value "renders the time in the local time zone."
    }
    utc   = "UTC" {
        @doc value "renders the time in UTC."
    }

    @cpp omit
    @doc value "is the time zone used when rendering timestamps."
    @pb omit
}
