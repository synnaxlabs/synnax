Color struct {
    r uint8 {
        @doc value "is the red component (0-255)."
    }
    g uint8 {
        @doc value "is the green component (0-255)."
    }
    b uint8 {
        @doc value "is the blue component (0-255)."
    }
    a uint8 {
        @doc value "is the alpha component (0-255)."
    }

    @doc value  "is an RGBA color with every component 0-255."
    @go json    hand
    @go marshal hand
}

Stop struct extends v0.Stop {}

Band struct extends v1.Band {}

Scale struct extends v1.Scale {}
