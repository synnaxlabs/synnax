TimeStamp int64 {
    @doc value """is a 64-bit signed integer representing nanoseconds since the Unix epoch
(1970-01-01 00:00:00 UTC). Provides nanosecond precision for high-frequency
telemetry timestamps."""
}

TimeSpan int64 {
    @doc value """is a 64-bit signed integer representing a duration in nanoseconds. Used
for expressing time intervals, sampling periods, and durations throughout
the telemetry system."""
}

TimeRange struct {
    start TimeStamp {
        @doc value "is the inclusive start of the time range."
    }
    end   TimeStamp {
        @doc value "is the exclusive end of the time range."
    }

    @doc value  """is a time interval defined by a start and end timestamp. The range is
start-inclusive and end-exclusive, following standard interval conventions
for predictable boundary handling."""
    @go marshal
}

DataType string {
    @doc value """is a string identifier specifying the format of telemetry samples.
Supports fixed-density types (Float64, Int32, TimeStamp, etc.) with
known byte sizes and variable-density types (String, JSON, Bytes) for
flexible data storage."""
}

TimestampFormat enum {
    iso         = "ISO"
    isoDate     = "ISODate"
    time        = "time"
    preciseTime = "preciseTime"
    date        = "date"
    preciseDate = "preciseDate"
    dateTime    = "dateTime"

    @doc value "is the rendered form of a timestamp displayed alongside a sample."
}

TimeZone enum {
    local = "local"
    utc   = "UTC"

    @doc value "is the time zone used when rendering timestamps."
}
