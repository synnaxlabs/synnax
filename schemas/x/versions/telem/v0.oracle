TimeStamp int64 {
    @doc value """
        is a 64-bit signed integer representing nanoseconds since the Unix epoch
        (1970-01-01 00:00:00 UTC). Provides nanosecond precision for high-frequency
        telemetry timestamps.
    """
}

TimeSpan int64 {
    @doc value """
        is a 64-bit signed integer representing a duration in nanoseconds. Used for
        expressing time intervals, sampling periods, and durations throughout the
        telemetry system.
    """
}

TimeRange struct {
    start TimeStamp {
        @doc value "is the inclusive start of the time range."
    }
    end   TimeStamp {
        @doc value "is the exclusive end of the time range."
    }

    @doc value  """
        is a time interval defined by a start and end timestamp. The range is
        start-inclusive and end-exclusive, following standard interval conventions for
        predictable boundary handling.
    """
    @go marshal
}

Window union on variant {
    dynamic {
        time_span TimeSpan = 0 {
            @doc value "is the span of the window, which ends now."
        }

        @doc value "is a rolling window."
    }
    static {
        time_range TimeRange {
            @doc value "is the fixed window, start-inclusive and end-exclusive."
        }

        @doc value "is a fixed window."
    }

    @doc value  "is a window of time: a rolling span that ends now, or a fixed range."
    @go marshal
}

Rate float64 {
    @doc value    """
        is a data sampling rate expressed in Hertz (Hz). Used to specify acquisition
        frequencies and calculate sample counts over time intervals. A rate is never
        negative.
    """
    @validate min 0
}

Size int64 {
    @doc value """
        is a byte measurement used for storage capacity and data volume representation.
        Supports conversion to human-readable formats (B, kB, MB, GB, TB).
    """
}

DataType string {
    @doc value """
        is a string identifier specifying the format of telemetry samples. Supports
        fixed-density types (float64, int32, timestamp, etc.) with known byte sizes and
        variable-density types (String, JSON, Bytes) for flexible data storage.
    """
}

TimestampFormat enum {
    iso         = "ISO" {
        @doc value "renders the full ISO 8601 timestamp."
    }
    isoDate     = "ISODate" {
        @doc value "renders only the date of the ISO 8601 form."
    }
    time        = "time" {
        @doc value "renders the time of day to the second."
    }
    preciseTime = "preciseTime" {
        @doc value "renders the time of day to the millisecond."
    }
    date        = "date" {
        @doc value "renders the short month and the day."
    }
    preciseDate = "preciseDate" {
        @doc value "renders the short month, the day, and the time to the millisecond."
    }
    dateTime    = "dateTime" {
        @doc value "renders the short month, the day, and the time to the second."
    }

    @doc value "is the rendered form of a timestamp displayed alongside a sample."
}

TimeZone enum {
    local = "local" {
        @doc value "renders the time in the local time zone."
    }
    utc   = "UTC" {
        @doc value "renders the time in UTC."
    }

    @doc value "is the time zone used when rendering timestamps."
}
