Kind = v0.Kind

TimeFormat = v0.TimeFormat

Format = v0.Format

Float = v0.Float

Integer = v0.Integer

Unsigned = v0.Unsigned

FloatEntry = v0.FloatEntry

IntegerEntry = v0.IntegerEntry

UnsignedEntry = v0.UnsignedEntry

StringEntry = v0.StringEntry

BooleanEntry = v0.BooleanEntry

EnumEntry = v0.EnumEntry

JSONType = v0.JSONType

Scalar union on type {
    number {
        value float64 {
            @doc value "is the number."
        }

        @doc value "is a JSON number."
    }
    string {
        value string {
            @doc value "is the string."
        }

        @doc value "is a JSON string."
    }
    boolean {
        value bool {
            @doc value "is the boolean."
        }

        @doc value "is a JSON boolean."
    }
    null {
        @doc value "is JSON null."
    }

    @doc value  "is a JSON scalar: a number, a string, a boolean, or null."
    @go marshal
}

GeneratorType = v0.GeneratorType
