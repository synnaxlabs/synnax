import "schemas/x/telem"

@cpp output "x/cpp/payload"
@go output  "x/go/payload"
@py output  "x/py/x/payload"
@ts output  "x/ts/src/payload"

Float float64 {
    @cpp hand
    @cpp include "x/cpp/payload/number.h"
    @doc value   """
        is a 64-bit float. It is a JSON number when finite, and the text "NaN",
        "Infinity", or "-Infinity" when not.
    """
    @go hand
    @py hand
    @py include  "x/py/x/payload/float"
    @ts hand
    @ts include  "x/ts/src/payload/number"
}

Integer int64 {
    @cpp hand
    @cpp include "x/cpp/payload/number.h"
    @doc value   """
        is a signed 64-bit integer. It is a JSON string of decimal digits, so it keeps
        every digit.
    """
    @py hand
    @py include  "x/py/x/payload/integer"
    @ts hand
    @ts include  "x/ts/src/payload/number"
}

Unsigned uint64 {
    @cpp hand
    @cpp include "x/cpp/payload/number.h"
    @doc value   """
        is an unsigned 64-bit integer. It is a JSON string of decimal digits, so it
        keeps every digit.
    """
    @py hand
    @py include  "x/py/x/payload/integer"
    @ts hand
    @ts include  "x/ts/src/payload/number"
}

Kind enum {
    float     = "float" {
        @doc value "is a floating point number."
    }
    integer   = "integer" {
        @doc value "is a signed integer."
    }
    unsigned  = "unsigned" {
        @doc value "is an unsigned integer."
    }
    string    = "string" {
        @doc value "is a string."
    }
    boolean   = "boolean" {
        @doc value "is a boolean."
    }
    timestamp = "timestamp" {
        @doc value "is a timestamp in a TimeFormat."
    }
    json      = "json" {
        @doc value "is any JSON value."
    }
    uuid      = "uuid" {
        @doc value "is a UUID string."
    }
    bytes     = "bytes" {
        @doc value "is a byte string."
    }

    @doc value "is the kind of value a payload field holds."
}

TimeFormat enum {
    iso8601  = "iso8601" {
        @doc value "is an ISO 8601 string."
    }
    unix_sec = "unix_sec" {
        @doc value "is a count of seconds since the Unix epoch."
    }
    unix_ms  = "unix_ms" {
        @doc value "is a count of milliseconds since the Unix epoch."
    }
    unix_us  = "unix_us" {
        @doc value "is a count of microseconds since the Unix epoch."
    }
    unix_ns  = "unix_ns" {
        @doc value "is a count of nanoseconds since the Unix epoch."
    }

    @doc value "is the encoding of a timestamp value within a payload."
}

FloatEntry struct {
    label string {
        @doc value "is the label in the payload."
    }
    value Float  {
        @doc value "is the channel value the label maps to."
    }

    @doc value  "maps a payload label to a float channel value."
    @go marshal
}

IntegerEntry struct {
    label string  {
        @doc value "is the label in the payload."
    }
    value Integer {
        @doc value "is the channel value the label maps to."
    }

    @doc value  "maps a payload label to a signed integer channel value."
    @go marshal
}

UnsignedEntry struct {
    label string   {
        @doc value "is the label in the payload."
    }
    value Unsigned {
        @doc value "is the channel value the label maps to."
    }

    @doc value  "maps a payload label to an unsigned integer channel value."
    @go marshal
}

StringEntry struct {
    label string {
        @doc value "is the label in the payload."
    }
    value string {
        @doc value "is the channel value the label maps to."
    }

    @doc value  "maps a payload label to a string channel value."
    @go marshal
}

BooleanEntry struct {
    label string {
        @doc value "is the label in the payload."
    }
    value bool   {
        @doc value "is the channel value the label maps to."
    }

    @doc value  "maps a payload label to a boolean channel value."
    @go marshal
}

FloatRead struct {
    data_type   telem.DataType? {
        @doc value "is the data type of a new channel. Absent for an existing one."
    }
    enum_values FloatEntry[]    {
        @doc value "maps payload labels to channel values."
    }
    fill        Float?          {
        @doc value "is written when the payload has no value. Absent requires one."
    }

    @doc value  "holds the options of a field that reads a float."
    @go marshal
}

IntegerRead struct {
    data_type   telem.DataType? {
        @doc value "is the data type of a new channel. Absent for an existing one."
    }
    enum_values IntegerEntry[]  {
        @doc value "maps payload labels to channel values."
    }
    fill        Integer?        {
        @doc value "is written when the payload has no value. Absent requires one."
    }

    @doc value  "holds the options of a field that reads a signed integer."
    @go marshal
}

UnsignedRead struct {
    data_type   telem.DataType? {
        @doc value "is the data type of a new channel. Absent for an existing one."
    }
    enum_values UnsignedEntry[] {
        @doc value "maps payload labels to channel values."
    }
    fill        Unsigned?       {
        @doc value "is written when the payload has no value. Absent requires one."
    }

    @doc value  "holds the options of a field that reads an unsigned integer."
    @go marshal
}

StringRead struct {
    enum_values StringEntry[] {
        @doc value "maps payload labels to channel values."
    }
    fill        string?       {
        @doc value "is written when the payload has no value. Absent requires one."
    }

    @doc value  "holds the options of a field that reads a string."
    @go marshal
}

BooleanRead struct {
    enum_values BooleanEntry[] {
        @doc value "maps payload labels to channel values."
    }
    fill        bool?          {
        @doc value "is written when the payload has no value. Absent requires one."
    }

    @doc value  "holds the options of a field that reads a boolean."
    @go marshal
}

TimestampRead struct {
    time_format TimeFormat       {
        @doc value "is the encoding of the timestamp in the payload."
    }
    fill        telem.TimeStamp? {
        @doc value "is written when the payload has no value. Absent requires one."
    }

    @doc value  "holds the options of a field that reads a timestamp."
    @go marshal
}

BaseWriteField struct {
    key     string = create {
        @doc value "uniquely identifies the field within its payload."
        @key
    }
    pointer string = "" {
        @doc value "is the JSON Pointer where the value is placed in the payload."
    }

    @doc value  "carries the fields every write field shares."
    @go marshal
}

WriteField union on type Kind extends BaseWriteField {
    float {
        value Float {
            @doc value "is the number placed at the pointer. It must be finite."
        }

        @doc value "places a JSON number in every payload."
    }
    integer {
        value Integer {
            @doc value "is the number placed at the pointer."
        }

        @doc value "places a JSON number in every payload."
    }
    unsigned {
        value Unsigned {
            @doc value "is the number placed at the pointer."
        }

        @doc value "places a JSON number in every payload."
    }
    string {
        value string {
            @doc value "is the string placed at the pointer."
        }

        @doc value "places a JSON string in every payload."
    }
    boolean {
        value bool {
            @doc value "is the boolean placed at the pointer."
        }

        @doc value "places a JSON boolean in every payload."
    }
    json {
        value string {
            @doc value "is the JSON text of the value placed at the pointer."
        }

        @doc value "places a JSON value in every payload."
    }
    uuid {
        @doc value "places a new UUID string in each payload."
    }
    timestamp {
        time_format TimeFormat = iso8601 {
            @doc value "is the encoding of the timestamp."
        }

        @doc value "places the time of each payload."
    }
    bytes {
        value string {
            @doc value "is the base64 text placed at the pointer."
        }

        @doc value "places base64 text in every payload."
    }

    @doc value  """
        is an additional field of a write payload. The type selects a fixed value, or a
        value generated for each payload.
    """
    @go marshal
}

EnumEntry struct {
    label string = "" {
        @doc value "is the string label in the payload."
    }
    value float64 = 0 {
        @doc value "is the numeric channel value the label maps to."
    }

    @doc value  """
        maps a string label in a payload to a numeric channel value for enum-style
        parsing (e.g. "ON" -> 1, "OFF" -> 0).
    """
    @go marshal
}

JSONType enum {
    number  = "number" {
        @doc value "writes the value as a JSON number."
    }
    string  = "string" {
        @doc value "writes the value as a JSON string."
    }
    boolean = "boolean" {
        @doc value "writes the value as a JSON boolean."
    }

    @doc value "is the JSON type a channel value is serialized as in a payload."
}

GeneratorType enum {
    uuid      = "uuid" {
        @doc value "produces a new UUID for each payload."
    }
    timestamp = "timestamp" {
        @doc value "produces the time of the payload."
    }

    @doc value "is the kind of value produced for a generated write field."
}
