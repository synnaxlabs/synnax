@ts output  "client/ts/src/hardware/ni"
@go output  "core/pkg/hardware/ni"
@py output  "client/py/synnax/hardware/ni"
@cpp output "driver/ni/types"

Units enum {
    volts = "Volts"
    amps  = "Amps"
    deg_c = "DegC"
    deg_f = "DegF"

    @doc value "enumerates the engineering units an NI analog channel can report."
}

LinearScale struct {
    slope            float64 {
        @doc value "is the multiplier applied to the raw value."
    }
    y_intercept      float64 {
        @doc value "is the offset added after scaling."
    }
    pre_scaled_units Units   {
        @doc value "are the units of the raw value before scaling."
    }
    scaled_units     string  {
        @doc value "are the units of the value after scaling."
    }

    @doc value "maps raw values to engineering units with a slope and intercept."
}

MapScale struct {
    pre_scaled_min float64
    pre_scaled_max float64
    scaled_min     float64
    scaled_max     float64

    @doc value "maps a raw range linearly onto a scaled range."
}

TableScale struct {
    pre_scaled_vals float64[] {
        @doc value "are the raw breakpoints, monotonically increasing."
    }
    scaled_vals     float64[] {
        @doc value "are the engineering-unit values at each breakpoint."
    }

    @doc value "maps raw values to engineering units via a lookup table."
}

NoneScale struct {
    @doc value "applies no scaling; the raw value is used directly."
}

Scale union on type {
    linear LinearScale
    map    MapScale
    table  TableScale
    none   NoneScale

    @doc value "determines how raw sensor values are transformed to engineering units."
}

BaseAIChannel struct {
    key     string {
        @doc value "uniquely identifies the channel within the task."
        @key
    }
    name    string {
        @doc value "is the human-readable channel name."
    }
    enabled bool   {
        @doc value "is true when the channel is included in acquisition."
    }
    port    int32  {
        @doc value "is the physical port the channel reads from."
    }

    @doc value "carries the fields every NI analog input channel shares."
}

MinMaxVal struct {
    min_val float64 {
        @doc value "is the minimum expected value, in scaled units."
    }
    max_val float64 {
        @doc value "is the maximum expected value, in scaled units."
    }
}

Terminal struct {
    terminal_config string {
        @doc value "selects the terminal configuration (RSE, NRSE, Diff, ...)."
    }
}

AIVoltageFields struct extends MinMaxVal, Terminal {
    custom_scale Scale {
        @doc value "is the scale applied to the raw voltage."
    }

    @doc value "configures a basic voltage measurement."
}

AIAccelFields struct extends MinMaxVal, Terminal {
    sensitivity  float64 {
        @doc value "is the accelerometer sensitivity in mV/g."
    }
    custom_scale Scale   {
        @doc value "is the scale applied to the raw acceleration."
    }

    @doc value "configures an accelerometer measurement."
}

AIChannel union on type extends BaseAIChannel {
    ai_voltage AIVoltageFields {
        @doc value "reads a voltage."
    }
    ai_accel   AIAccelFields {
        @doc value "reads acceleration from an IEPE accelerometer."
    }

    @doc value """
        is a single NI analog input channel. The type field selects the
        measurement mode and the fields that accompany it.
    """
}
