import "schemas/telem"
import "schemas/label"
import "schemas/color"

@ts output  "client/ts/src/ranger"
@py output  "client/py/synnax/ranger"
@cpp output "client/cpp/ranger"
@go output  "core/pkg/service/ranger"
@pb

Key = uuid {
    @doc value "is a unique identifier for a range, represented as a UUID."
}

Range struct {
    key        Key             {
        @doc value "is the unique identifier for this range."
        @key
    }
    name       string          {
        @doc value           "is a human-readable name for the range."
        @validate min_length 1
        @filter
    }
    time_range telem.TimeRange {
        @doc value """
            is the temporal extent of the range, defining its start and end
            timestamps.
        """
        @ts type   telem.TimeRangeBounded
    }
    color      color.Color?    {
        @doc value """
            is an optional display color for visual identification of the range
            in user interfaces.
        """
    }
    labels     label.Label[]?  {
        @doc value  """
            contains optional labels attached to this range for categorization
            and filtering.
        """
        @go marshal omit
    }
    parent     Range??         {
        @doc value  """
            is an optional parent range for hierarchical organization. Ranges
            can be nested within other ranges.
        """
        @go marshal omit
    }

    @doc value       """
        is a user-defined region of time in the Synnax cluster. Ranges act as a
        method for labeling and categorizing telemetry data within specific time
        periods.
    """
    @retrieve custom
    @search type     "range"
    @ontology type   "range"
    @pb
    @go marshal
    @go migrate
    @cpp name        "Range"
    @ts name         "Payload"
    @py name         "Payload"
    @cpp methods     "ranger::kv::Client kv"
    @cpp includes    "client/cpp/ranger/kv/kv.h"
}

New struct extends Range {
    -parent
    -labels
    key?

    @doc value "contains parameters for creating a new range."
    @ts {
        name "New"
        use_input
    }
    @py omit
    @cpp omit
    @go omit
    @pb omit
}
