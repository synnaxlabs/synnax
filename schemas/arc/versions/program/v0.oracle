Program struct {
    WASM              bytes               {
        @doc value "is compiled WebAssembly bytecode for sandboxed execution."
    }
    OutputMemoryBases map<string, uint32> {
        @doc value """
            contains memory base addresses for multi-output functions, mapping function
            keys to their base addresses.
        """
    }

    @doc value  """
        is the persisted shape of a compiled Arc program: the compiled output only.
        Stored arc v0 records embed this layout; the intermediate representation never
        reached the stored bytes.
    """
    @go marshal
}
