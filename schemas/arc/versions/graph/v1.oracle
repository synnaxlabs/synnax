import "schemas/arc/versions/ir/v1"
import "schemas/x/versions/spatial/v0"

Node struct {
    key      string     {
        @doc value "is the unique identifier for this node instance."
    }
    position spatial.XY {
        @doc value "is the canvas position (x, y) for visual layout."
    }
}

Nodes Node[]

Edge struct extends ir.Edge {
    key string {
        @doc value "is the stable identifier for this edge within the graph."
    }

    @doc value """is a dataflow connection between node parameters carrying a stable
identifier. The key persists across endpoint edits, distinguishing the
editable graph edge from the keyless ir.Edge consumed by the compiler."""
}

Edges Edge[] {
    @doc value "is a collection of graph edges in an Arc graph."
}

Graph struct {
    functions ir.Functions = [] {
        @doc value "contains function definitions available in this graph."
    }
    edges     Edges = [] {
        @doc value "contains dataflow connections between node parameters."
    }
    nodes     Nodes = [] {
        @doc value "contains visual nodes with canvas positions."
    }
    inputs    map<string, record> = {} {
        @doc value """contains per-node inputs keyed by node key. Each value is a JSON
object holding the node's function type under "type" plus its input
parameter values. The wire format stores it as an opaque record; the
client types it per function."""
    }
}
